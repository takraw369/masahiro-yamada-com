{
  "name": "masahiro-yamada-com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node ./scripts/patch-worker.mjs",
    "preview": "node scripts/preview.mjs",
    "deploy": "astro build && node ./scripts/patch-worker.mjs && wrangler deploy",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "astro check",
    "test:preview": "node scripts/smoke-preview.mjs",
    "security:check": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/react": "^4.0.0",
    "astro": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "4.121.0"
  }
}
