{
  "name": "masahiro-yamada-com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node ./scripts/patch-worker.mjs && node scripts/verify-worker-config.mjs",
    "preview": "node scripts/preview.mjs",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "astro check",
    "typecheck:release": "node scripts/typecheck-release.mjs",
    "test:preview": "node scripts/smoke-preview.mjs",
    "security:check": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "4.129.0"
  }
}
