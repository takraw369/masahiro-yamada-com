{
  "name": "masahiro-yamada-com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "codex:bridge": "node scripts/codex-dashboard-bridge.mjs",
    "codex:server": "codex app-server --listen ws://127.0.0.1:4500",
    "build": "astro build && node ./scripts/patch-worker.mjs && node scripts/verify-worker-config.mjs",
    "preview": "node scripts/preview.mjs",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "astro check",
    "typecheck:release": "node scripts/typecheck-release.mjs",
    "test:preview": "node scripts/smoke-preview.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "devalue": "5.9.4",
    "undici": "7.30.0",
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
