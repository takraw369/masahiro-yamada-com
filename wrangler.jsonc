{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "masahiro-yamada-com",
  "preview_urls": true,
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunlovesflow-db",
      "database_id": "b3f9ad9b-3e6a-4a11-8059-b7997466db85"
    }
  ],
  "vars": {
    "SITE_NAME": "masahiro-yamada.com",
    "APP_ENV": "production",
    "HARNESS_PROXY_ENABLED": "false",
    "HARNESS_SIDE_EFFECTS_ENABLED": "false",
    "X_HARNESS_URL": "https://x-harness-worker.takraw501.workers.dev",
    "LINE_HARNESS_URL": "https://line-crm-worker.takraw501.workers.dev"
  },
  "previews": {
    "vars": {
      "SITE_NAME": "preview.masahiro-yamada.com",
      "APP_ENV": "preview",
      "HARNESS_PROXY_ENABLED": "false",
      "HARNESS_SIDE_EFFECTS_ENABLED": "false",
      "X_HARNESS_URL": "https://example.invalid",
      "LINE_HARNESS_URL": "https://example.invalid"
    },
    "kv_namespaces": [],
    "d1_databases": [],
    "ratelimits": []
  },
  "secrets": {
    "required": [
      "DASHBOARD_PASSWORD",
      "DASHBOARD_OPERATOR_PASSWORD",
      "DASHBOARD_SESSION_SECRET",
      "X_HARNESS_API_KEY",
      "LINE_HARNESS_API_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2026081201",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "HARNESS_READ_RATE_LIMITER",
      "namespace_id": "2026081202",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "HARNESS_WRITE_RATE_LIMITER",
      "namespace_id": "2026081203",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "env": {
    "development": {
      "vars": {
        "SITE_NAME": "localhost",
        "APP_ENV": "development",
        "HARNESS_PROXY_ENABLED": "false",
        "HARNESS_SIDE_EFFECTS_ENABLED": "false",
        "X_HARNESS_URL": "https://example.invalid",
        "LINE_HARNESS_URL": "https://example.invalid"
      },
      "secrets": {
        "required": [
          "DASHBOARD_DEV_PASSWORD",
          "DASHBOARD_DEV_OPERATOR_PASSWORD",
          "DASHBOARD_DEV_SESSION_SECRET"
        ]
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2026081211",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "HARNESS_READ_RATE_LIMITER",
          "namespace_id": "2026081212",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "HARNESS_WRITE_RATE_LIMITER",
          "namespace_id": "2026081213",
          "simple": { "limit": 3, "period": 60 }
        }
      ]
    }
  }
}
