---
import PublicPageLayout from '../layouts/PublicPageLayout.astro';
---
<PublicPageLayout
  title="お問い合わせ"
  description="MASA / ACE METHODへのお問い合わせ。FAQ、正式な問い合わせフォーム、公式LINEを用途別にご案内します。"
  eyebrow="CONTACT"
>
  <p slot="lead" class="public-lead">
    まず「よくある質問」を確認し、解決しない内容はフォームへ。ACEやサービスについて人と相談したい場合は公式LINEをご利用ください。
  </p>

  <section class="public-section public-grid" aria-label="問い合わせ方法">
    <article class="public-card route-card">
      <p class="route-no">01</p>
      <h2>まずFAQ</h2>
      <p>料金、キャンセル、個人情報、ACEの位置づけなど、よくある内容をまとめています。</p>
      <a class="public-btn" href="/faq">よくある質問を見る</a>
    </article>
    <article class="public-card route-card">
      <p class="route-no">02</p>
      <h2>個別相談はLINE</h2>
      <p>ACEやコーチングについて「自分の場合はどうか」を相談したい方はこちら。正式な契約・返金・法務連絡は下のフォームをご利用ください。</p>
      <a class="public-btn public-btn-line" href="https://lin.ee/pcAHpTBy" target="_blank" rel="noopener noreferrer">公式LINEで相談する</a>
    </article>
  </section>

  <section class="public-section">
    <h2>正式なお問い合わせフォーム</h2>
    <p class="public-callout">お支払い・キャンセル、サイト不具合、取材・企業連携、個人情報・法務など、記録を残して対応したい内容はこちらへ。</p>

    <form id="contact-form" class="contact-form" novalidate>
      <div class="profile-reuse" aria-label="JEVプロフィールから入力">
        <button type="button" id="profile-reuse-open" class="profile-reuse-open">保存済みプロフィールから入力する</button>
        <p class="profile-reuse-help">同じ端末・ブラウザのJEV Profileで保存した情報を使えます。自動入力・自動送信はしません。</p>
        <div id="profile-reuse-preview" class="profile-reuse-preview" hidden>
          <p class="profile-reuse-title">入力する項目を選んで確認</p>
          <label class="profile-reuse-choice">
            <input id="profile-reuse-name" type="checkbox" />
            <span>お名前：<strong id="profile-reuse-name-value"></strong></span>
          </label>
          <label class="profile-reuse-choice">
            <input id="profile-reuse-email" type="checkbox" />
            <span>メール：<strong id="profile-reuse-email-value"></strong></span>
          </label>
          <p class="profile-reuse-help">すでに入力されている項目は上書きしません。入力後も変更できます。送信は別操作です。</p>
          <div class="profile-reuse-actions">
            <button id="profile-reuse-apply" type="button">選択した項目を入力欄へ反映</button>
            <button id="profile-reuse-cancel" type="button">キャンセル</button>
          </div>
        </div>
        <p id="profile-reuse-status" class="profile-reuse-status" role="status" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for="category">お問い合わせ種別 <span>必須</span></label>
        <select id="category" name="category" required>
          <option value="">選択してください</option>
          <option value="service">ACE・サービスについて</option>
          <option value="payment">お支払い・キャンセルについて</option>
          <option value="technical">サイト・システムの不具合</option>
          <option value="business">取材・企業・提携について</option>
          <option value="privacy">個人情報・法務について</option>
          <option value="other">その他</option>
        </select>
      </div>

      <div class="field">
        <label for="name">お名前</label>
        <input id="name" name="name" type="text" maxlength="100" autocomplete="name" />
      </div>

      <div class="field">
        <label for="email">返信先メールアドレス <span>必須</span></label>
        <input id="email" name="email" type="email" maxlength="254" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="message">お問い合わせ内容 <span>必須</span></label>
        <textarea id="message" name="message" minlength="10" maxlength="5000" rows="9" required></textarea>
        <small>10〜5,000文字</small>
      </div>

      <div class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="consent-row">
        <input id="consent" name="consent" type="checkbox" required />
        <span><a href="/legal/privacy" target="_blank">プライバシーポリシー</a>を確認し、問い合わせ対応のために情報を利用することに同意します。</span>
      </label>

      <div class="submit-row">
        <button class="public-btn submit-btn" type="submit">送信する</button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </section>

  <section class="public-section">
    <h2>窓口の使い分け</h2>
    <div class="public-card">
      <ul>
        <li><strong>FAQ：</strong>その場で確認できる一般的な質問</li>
        <li><strong>フォーム：</strong>支払い、キャンセル、不具合、企業案件、個人情報・法務など正式な連絡</li>
        <li><strong>LINE：</strong>ACEやサービスについての個別相談、体験への入口</li>
      </ul>
      <p class="public-muted">将来的にはFAQを知識ベースにした案内チャットへ拡張できる設計にしています。</p>
    </div>
  </section>
</PublicPageLayout>

<style>
  .route-card { display: flex; flex-direction: column; align-items: flex-start; }
  .profile-reuse{border:1px solid var(--border-default);padding:17px;background:var(--bg-void);min-width:0}
  .profile-reuse-open,.profile-reuse-actions button{min-height:44px;padding:10px 16px;border:1px solid var(--border-accent);background:transparent;color:var(--text-primary);cursor:pointer;font-size:16px;text-align:left}
  .profile-reuse-open:focus-visible,.profile-reuse-actions button:focus-visible{outline:2px solid var(--gold-pure);outline-offset:2px}
  .profile-reuse-help,.profile-reuse-status{margin:8px 0 0;color:var(--text-muted);font-size:.83rem;line-height:1.65;overflow-wrap:anywhere}
  .profile-reuse-title{margin:0;color:var(--text-primary);font-weight:700}
  .profile-reuse-preview{display:grid;gap:12px;margin-top:16px;padding-top:16px;border-top:1px solid var(--border-default)}
  .profile-reuse-preview[hidden]{display:none}
  .profile-reuse-choice{display:flex;align-items:flex-start;gap:10px;min-width:0;font-size:.9rem;overflow-wrap:anywhere}
  .profile-reuse-choice input{width:18px;height:18px;flex:none;margin-top:4px}
  .profile-reuse-choice strong{font-weight:600;overflow-wrap:anywhere}
  .profile-reuse-actions{display:flex;flex-wrap:wrap;gap:10px}
  .profile-reuse-status:empty{display:none}
  .route-card h2 { margin-top: 0; }
  .route-card .public-btn { margin-top: auto; }
  .route-no { margin: 0 0 12px; color: var(--gold-dim); font-family: 'Cormorant Garamond', serif; letter-spacing: .18em; }
  .contact-form { margin-top: 22px; display: grid; gap: 18px; padding: 28px; background: var(--bg-surface); border: 1px solid var(--border-default); }
  .field { display: grid; gap: 8px; }
  .field label { color: var(--text-primary); font-size: .86rem; }
  .field label span { margin-left: 6px; color: var(--gold-muted); font-size: .7rem; }
  .field input, .field select, .field textarea {
    width: 100%;
    border: 1px solid var(--border-default);
    background: var(--bg-void);
    color: var(--text-primary);
    padding: 12px 13px;
    outline: none;
    border-radius: 0;
  }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--gold-muted); }
  .field small { color: var(--text-dim); }
  .consent-row { display: flex; align-items: flex-start; gap: 10px; color: var(--text-muted); font-size: .82rem; cursor: pointer; }
  .consent-row input { margin-top: 6px; }
  .consent-row a { color: var(--gold-pure); }
  .submit-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .submit-btn { min-width: 160px; }
  .submit-btn:disabled { opacity: .45; cursor: wait; transform: none; }
  .form-status { margin: 0; color: var(--text-muted); font-size: .84rem; }
  .form-status.success { color: var(--success); }
  .form-status.error { color: var(--danger); }
  .hp-field { position: absolute !important; width: 1px !important; height: 1px !important; overflow: hidden !important; clip: rect(0 0 0 0) !important; white-space: nowrap !important; }
  @media (max-width: 640px) { .contact-form { padding: 20px; } .submit-row, .submit-btn { width: 100%; } }
</style>

<script>
  import { PROFILE_STORAGE_KEY, parseProfileForContact } from '../lib/profileReuse.mjs';

  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('form-status');

  // LocalStorage is accessed only after the person clicks "use saved profile".
  // No profile data is sent to the server by this feature.
  const reuseOpen = document.getElementById('profile-reuse-open');
  const reusePreview = document.getElementById('profile-reuse-preview');
  const reuseStatus = document.getElementById('profile-reuse-status');
  const reuseName = document.getElementById('profile-reuse-name');
  const reuseEmail = document.getElementById('profile-reuse-email');
  const reuseNameValue = document.getElementById('profile-reuse-name-value');
  const reuseEmailValue = document.getElementById('profile-reuse-email-value');
  const formName = document.getElementById('name');
  const formEmail = document.getElementById('email');

  function closeProfilePreview() {
    if (reusePreview) reusePreview.hidden = true;
    if (reuseNameValue) reuseNameValue.textContent = '';
    if (reuseEmailValue) reuseEmailValue.textContent = '';
    if (reuseName instanceof HTMLInputElement) reuseName.checked = false;
    if (reuseEmail instanceof HTMLInputElement) reuseEmail.checked = false;
  }

  reuseOpen?.addEventListener('click', () => {
    closeProfilePreview();
    let saved = null;
    try {
      saved = parseProfileForContact(window.localStorage.getItem(PROFILE_STORAGE_KEY));
    } catch {
      // Storage can be unavailable in private browsing or locked-down browsers.
    }
    if (!saved || !(formName instanceof HTMLInputElement) || !(formEmail instanceof HTMLInputElement)
      || !(reuseName instanceof HTMLInputElement) || !(reuseEmail instanceof HTMLInputElement)
      || !reusePreview || !reuseNameValue || !reuseEmailValue) {
      if (reuseStatus) reuseStatus.textContent = 'このブラウザに利用できるプロフィールがありません。通常のフォーム入力は使えます。';
      return;
    }

    reuseNameValue.textContent = saved.name || '未登録';
    reuseEmailValue.textContent = saved.email || '未登録';
    reuseName.disabled = !saved.name || Boolean(formName.value.trim());
    reuseEmail.disabled = !saved.email || Boolean(formEmail.value.trim());
    reuseName.checked = false;
    reuseEmail.checked = false;
    reusePreview.hidden = false;
    if (reuseStatus) reuseStatus.textContent = reuseName.disabled && reuseEmail.disabled
      ? '利用可能な項目はありません。入力済み欄は上書きしません。'
      : '反映したい項目にチェックを付けてください。';
  });

  document.getElementById('profile-reuse-cancel')?.addEventListener('click', () => {
    closeProfilePreview();
    if (reuseStatus) reuseStatus.textContent = '反映せず閉じました。';
  });

  document.getElementById('profile-reuse-apply')?.addEventListener('click', () => {
    if (!(formName instanceof HTMLInputElement) || !(formEmail instanceof HTMLInputElement)
      || !(reuseName instanceof HTMLInputElement) || !(reuseEmail instanceof HTMLInputElement)
      || !reusePreview || reusePreview.hidden) return;

    // Recheck at confirmation time: a profile deleted in another tab must not be reused.
    let saved = null;
    try {
      saved = parseProfileForContact(window.localStorage.getItem(PROFILE_STORAGE_KEY));
    } catch {
      // Local storage is optional.
    }
    if (!saved) {
      closeProfilePreview();
      if (reuseStatus) reuseStatus.textContent = 'プロフィールが見つかりません。保存内容を確認してください。';
      return;
    }
    let updated = 0;
    if (reuseName.checked && !reuseName.disabled && !formName.value.trim()
      && saved.name && saved.name === reuseNameValue?.textContent) {
      formName.value = saved.name;
      formName.dispatchEvent(new Event('input', { bubbles: true }));
      updated += 1;
    }
    if (reuseEmail.checked && !reuseEmail.disabled && !formEmail.value.trim()
      && saved.email && saved.email === reuseEmailValue?.textContent) {
      formEmail.value = saved.email;
      formEmail.dispatchEvent(new Event('input', { bubbles: true }));
      updated += 1;
    }
    closeProfilePreview();
    if (reuseStatus) reuseStatus.textContent = updated
      ? `${updated}項目を入力欄へ反映しました。内容をご確認ください。送信はまだしていません。`
      : '項目は変更していません。必要な項目を選択し、入力済み欄は空にしてからお試しください。';
  });

  if (form instanceof HTMLFormElement && statusEl) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      statusEl.className = 'form-status';

      if (!form.reportValidity()) return;

      const button = form.querySelector('button[type="submit"]');
      if (button instanceof HTMLButtonElement) button.disabled = true;
      statusEl.textContent = '送信しています…';

      const data = new FormData(form);
      const payload = {
        category: String(data.get('category') || ''),
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        message: String(data.get('message') || ''),
        website: String(data.get('website') || ''),
        consent: data.get('consent') === 'on',
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || 'submit_failed');

        form.reset();
        statusEl.textContent = '送信しました。内容を確認のうえ、必要に応じて返信します。';
        statusEl.classList.add('success');
      } catch {
        statusEl.textContent = '送信できませんでした。時間をおいて再度お試しください。お急ぎのサービス相談は公式LINEをご利用ください。';
        statusEl.classList.add('error');
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  }
</script>
