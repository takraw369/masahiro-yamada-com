---
import Atlas from '../../components/vault/atlas/Atlas';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ATLAS — 7-DIM CANVAS</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { width: 100%; height: 100%; overflow: hidden; background: #0a0e1f; }
      #atlas-root { width: 100%; height: 100vh; }

      /* tldraw フォント読み込み */
      @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap');

      /* 右上にホームへ戻るリンク */
      .atlas-back {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 2000;
        font-family: 'Cormorant Garamond', serif;
        font-size: 0.8rem;
        color: rgba(212, 169, 67, 0.7);
        text-decoration: none;
        letter-spacing: 0.1em;
        background: rgba(10, 14, 31, 0.8);
        padding: 0.4rem 0.8rem;
        border: 1px solid rgba(212, 169, 67, 0.2);
      }
    </style>
  </head>
  <body>
    <a href="/vault" class="atlas-back">← VAULT</a>
    <div id="atlas-root">
      <Atlas client:only="react" />
    </div>
  </body>
</html>
