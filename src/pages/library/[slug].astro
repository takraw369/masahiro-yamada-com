---
import PublicPageLayout from '../../layouts/PublicPageLayout.astro';
import { libraryItemBySlug, yen } from '../../lib/libraryCatalog';

const item = libraryItemBySlug(Astro.params.slug);
if (!item) return new Response('Not found', { status: 404 });

const isLive = item.status === 'live' && Boolean(item.checkoutUrl);
---

<PublicPageLayout
  title={item.title}
  eyebrow={`${item.category} / ${item.format}`}
  description={`${item.title} — ${item.subtitle}`}
>
  <p slot="lead" class="public-lead">{item.subtitle}</p>

  <section class="public-section item-hero-grid">
    <div class={`item-cover cover-${item.coverNo}`}>
      <span class="item-no">{item.coverNo}</span>
      <span class="item-format">{item.format}</span>
      <strong>{item.title}</strong>
      <small>{item.subtitle}</small>
      <span class="item-author">MASA / 山田昌寛</span>
    </div>

    <div class="item-buybox">
      <div class="item-meta-row">
        <span>{item.category}</span>
        <span class:list={['item-status', isLive && 'is-live']}>{isLive ? 'LIVE' : 'PREVIEW'}</span>
      </div>
      <h2>{isLive ? yen(item.priceYen) : `予定価格 ${yen(item.priceYen)}`}</h2>
      <p>{item.description}</p>

      {isLive ? (
        <>
          <a class="public-btn item-primary" href={item.checkoutUrl}>今すぐ購入する</a>
          <p class="public-muted">決済後、購入者用ページまたはダウンロード導線へ案内します。</p>
        </>
      ) : (
        <>
          <div class="item-preview-note">
            <strong>{item.releaseLabel}</strong>
            <p>本編は制作中です。完成前の決済は行いません。登録者には公開時に優先案内します。</p>
          </div>

          <form class="library-lead-form" data-library-lead>
            <input type="hidden" name="productSlug" value={item.slug} />
            <div class="honeypot" aria-hidden="true">
              <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <label class="form-label" for={`email-${item.slug}`}>公開案内を受け取るメールアドレス</label>
            <div class="form-row">
              <input id={`email-${item.slug}`} name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
              <button class="public-btn" type="submit">先行案内に登録</button>
            </div>
            <label class="consent-row">
              <input type="checkbox" name="consent" required />
              <span>公開案内・関連教材の案内を受け取ることに同意します。</span>
            </label>
            <p class="form-message public-muted" aria-live="polite"></p>
          </form>

          <a class="public-btn public-btn-line item-line" href="https://lin.ee/pcAHpTBy" target="_blank" rel="noopener noreferrer">
            LINEで「{item.lineKeyword}」と送る
          </a>
        </>
      )}
    </div>
  </section>

  <section class="public-section">
    <p class="item-kicker">WHAT YOU WILL GET</p>
    <h2>この教材で扱うこと</h2>
    <div class="public-grid">
      {item.takeaways.map((takeaway, index) => (
        <div class="public-card takeaway-card">
          <span>0{index + 1}</span>
          <strong>{takeaway}</strong>
        </div>
      ))}
    </div>
  </section>

  <section class="public-section locked-section">
    <div class="locked-preview" aria-hidden="true">
      <p>01 / 観察する</p>
      <h3>問題を「根性不足」にしないための見方</h3>
      <p>起きている事実と、自分がそこに付けた意味を分ける。身体の反応、注意の向き、役割、環境を一つずつ……</p>
      <div class="fake-lines">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
    <div class="locked-overlay">
      <div class="lock-icon">✦</div>
      <strong>{isLive ? '購入者限定コンテンツ' : '本編は公開準備中'}</strong>
      <p>{isLive ? '決済後にこの続きを閲覧できます。' : '表紙・テーマ・構成を先に公開しています。'}</p>
    </div>
  </section>

  <section class="public-section public-card item-bridge">
    <p class="item-kicker">NEXT DEPTH</p>
    <h2>もっと深く知る必要が出たら。</h2>
    <p>{item.bridge}</p>
    <div class="item-actions">
      <a class="public-btn" href="/gate">勝ち筋OS 90分を見る</a>
      <a class="public-btn" href="/library">Libraryへ戻る</a>
    </div>
  </section>
</PublicPageLayout>

<script>
  const forms = document.querySelectorAll('[data-library-lead]');
  forms.forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;

      const button = form.querySelector('button[type="submit"]');
      const message = form.querySelector('.form-message');
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      const productSlug = String(data.get('productSlug') || '').trim();
      const website = String(data.get('website') || '').trim();
      const consent = data.get('consent') === 'on';

      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = '登録中…';
      }
      if (message) message.textContent = '';

      try {
        const response = await fetch('/api/library/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, productSlug, website, consent }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'submit_failed');

        form.reset();
        if (message) message.textContent = '登録しました。公開時に優先案内します。';
      } catch {
        if (message) message.textContent = '登録できませんでした。LINEから「先行案内」と送ってください。';
      } finally {
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.textContent = '先行案内に登録';
        }
      }
    });
  });
</script>

<style>
  .item-hero-grid {
    display: grid;
    grid-template-columns: minmax(240px, .8fr) minmax(0, 1.2fr);
    gap: 34px;
    align-items: start;
  }
  .item-cover {
    position: sticky;
    top: 92px;
    aspect-ratio: 3 / 4;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(201,169,110,.14), transparent 48%), #15120f;
    border: 1px solid var(--border-default);
    box-shadow: 0 24px 70px rgba(0,0,0,.26);
  }
  .item-cover::after { content: ''; position: absolute; inset: 16px; border: 1px solid rgba(201,169,110,.14); }
  .cover-02 { background: linear-gradient(160deg, rgba(90,77,58,.33), transparent 52%), #111315; }
  .cover-03 { background: radial-gradient(circle at 50% 35%, rgba(201,169,110,.18), transparent 30%), #16120d; }
  .cover-04 { background: linear-gradient(135deg, rgba(82,98,82,.2), transparent 50%), #101311; }
  .cover-05 { background: linear-gradient(150deg, rgba(130,75,68,.22), transparent 52%), #17100f; }
  .cover-06 { background: linear-gradient(145deg, rgba(64,73,95,.28), transparent 55%), #111219; }
  .item-no { position: absolute; top: 24px; right: 24px; color: var(--text-dim); font-family: 'Cormorant Garamond', serif; font-size: 3rem; }
  .item-format { margin-bottom: auto; color: var(--gold-muted); font-size: 10px; letter-spacing: .16em; }
  .item-cover strong { position: relative; z-index: 1; font-family: 'Cormorant Garamond', 'Zen Kaku Gothic New', serif; font-size: clamp(2rem, 4vw, 3.1rem); font-weight: 400; line-height: 1.1; }
  .item-cover small { position: relative; z-index: 1; margin-top: 12px; color: var(--text-muted); font-size: .82rem; line-height: 1.6; }
  .item-author { position: relative; z-index: 1; margin-top: 28px; color: var(--gold-muted); font-size: 10px; letter-spacing: .12em; }
  .item-buybox { padding-top: 4px; }
  .item-meta-row { display: flex; justify-content: space-between; gap: 12px; color: var(--text-dim); font-size: 10px; letter-spacing: .12em; }
  .item-status { border: 1px solid var(--border-default); padding: 4px 8px; }
  .item-status.is-live { color: var(--success); border-color: rgba(143,189,145,.3); }
  .item-buybox h2 { margin: 26px 0 10px; font-size: 2.4rem; color: var(--gold-pure); }
  .item-buybox > p { color: var(--text-muted); }
  .item-primary { width: 100%; margin-top: 18px; }
  .item-preview-note { margin: 24px 0 18px; padding: 16px 18px; border-left: 2px solid var(--gold-muted); background: var(--gold-glow); }
  .item-preview-note strong { color: var(--gold-pure); }
  .item-preview-note p { margin: 6px 0 0; color: var(--text-muted); font-size: .82rem; }
  .library-lead-form { margin-top: 18px; }
  .form-label { display: block; margin-bottom: 7px; color: var(--text-muted); font-size: .78rem; }
  .form-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
  .form-row input {
    min-width: 0;
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-default);
    padding: 11px 13px;
    outline: none;
  }
  .form-row input:focus { border-color: var(--gold-muted); }
  .consent-row { display: flex; gap: 8px; margin-top: 10px; color: var(--text-dim); font-size: .68rem; line-height: 1.5; }
  .consent-row input { margin-top: 3px; }
  .form-message { min-height: 1.4em; margin: 8px 0 0; }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .item-line { width: 100%; margin-top: 8px; }
  .item-kicker { margin: 0 0 8px; color: var(--gold-muted) !important; font-family: 'Cormorant Garamond', serif; font-size: 11px; letter-spacing: .18em; }
  .takeaway-card { display: flex; align-items: baseline; gap: 14px; }
  .takeaway-card span { color: var(--gold-dim); font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; }
  .takeaway-card strong { font-size: .9rem; }
  .locked-section { position: relative; min-height: 300px; overflow: hidden; border: 1px solid var(--border-default); background: var(--bg-surface); }
  .locked-preview { padding: 30px; filter: blur(4px); opacity: .38; user-select: none; }
  .locked-preview h3 { font-size: 1.4rem; }
  .fake-lines { display: grid; gap: 10px; margin-top: 22px; }
  .fake-lines span { display: block; height: 8px; background: var(--border-default); }
  .fake-lines span:nth-child(2) { width: 90%; }.fake-lines span:nth-child(3) { width: 82%; }.fake-lines span:nth-child(4) { width: 94%; }.fake-lines span:nth-child(5) { width: 72%; }
  .locked-overlay { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; padding: 24px; background: linear-gradient(to bottom, rgba(13,11,8,.38), rgba(13,11,8,.9)); }
  .lock-icon { color: var(--gold-pure); font-size: 2rem; margin-bottom: 10px; }
  .locked-overlay strong { color: var(--text-primary); }
  .locked-overlay p { margin: 5px 0 0; color: var(--text-muted); font-size: .82rem; }
  .item-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }

  @media (max-width: 760px) {
    .item-hero-grid { grid-template-columns: 1fr; }
    .item-cover { position: relative; top: 0; width: min(420px, 100%); margin: 0 auto; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
