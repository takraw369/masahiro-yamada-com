---
import PublicPageLayout from '../layouts/PublicPageLayout.astro';
---

<PublicPageLayout
  title="メンタル＆コンディション診断"
  description="本番で力を発揮するための目標・感情・身体感覚・行動習慣を整理するセルフチェック。"
  eyebrow="MENTAL & CONDITION CHECK"
>
  <p slot="lead" class="public-lead">
    「メンタルが強い・弱い」で片づけず、いま何が噛み合っていて、どこに伸びしろがあるのかを整理する約3〜5分のチェックです。
  </p>

  <section class="public-section intro-card">
    <div class="intro-grid">
      <div><strong>01</strong><span>目標</span><small>どこへ向かうか</small></div>
      <div><strong>02</strong><span>感情</span><small>どう戻れるか</small></div>
      <div><strong>03</strong><span>身体</span><small>何を感じているか</small></div>
      <div><strong>04</strong><span>行動</span><small>どう実装するか</small></div>
    </div>
    <p>医療的な診断ではありません。競技・仕事・日常で力を発揮するためのセルフチェック／ヒアリングとして利用します。</p>
  </section>

  <section class="public-section questionnaire-shell">
    <div class="progress-head">
      <div><span id="progress-label">質問を読み込んでいます…</span><small id="set-purpose"></small></div>
      <b id="progress-percent">0%</b>
    </div>
    <div class="progress-track"><i id="progress-bar"></i></div>

    <form id="mental-form" novalidate>
      <div id="question-list" class="question-list"><p class="loading-note">質問データを準備しています…</p></div>

      <section class="followup-card" id="followup-card" hidden>
        <p class="section-kicker">OPTIONAL FOLLOW-UP</p>
        <h2>回答を、次の一歩につなげたい方へ</h2>
        <p>希望する場合のみ、回答内容を見ながら簡単なフィードバックや案内をお送りします。匿名回答だけでも送信できます。</p>
        <label class="consent-box">
          <input id="followup-consent" type="checkbox" />
          <span>回答内容と連絡先を、フィードバック・関連案内のために利用することに同意する</span>
        </label>
        <div id="contact-fields" class="contact-fields" hidden>
          <label>お名前・呼ばれたい名前<input id="display-name" type="text" maxlength="160" autocomplete="name" placeholder="例：山田 昌寛" /></label>
          <label>メールアドレス <em>必須</em><input id="email" type="email" maxlength="254" autocomplete="email" placeholder="you@example.com" /></label>
          <label>その他の連絡先 <small>任意</small><input id="contact-route" type="text" maxlength="500" placeholder="LINE名 / Instagram ID など" /></label>
          <p class="privacy-note"><a href="/legal/privacy" target="_blank">プライバシーポリシー</a>をご確認ください。</p>
        </div>
      </section>

      <div class="hp-field" aria-hidden="true">
        <label>Website<input id="website" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div id="submit-wrap" class="submit-wrap" hidden>
        <button class="public-btn submit-btn" id="submit-btn" type="submit">診断を送信する</button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <div id="success-card" class="success-card" hidden>
      <p class="section-kicker">COMPLETE</p>
      <h2>回答ありがとうございました。</h2>
      <p>あなたの回答は、質問ごとの傾向と一人ひとりの変化を理解するためのデータとして蓄積されました。</p>
      <div class="success-actions">
        <a class="public-btn" href="/ace">ACEを見る</a>
        <a class="public-btn ghost" href="/">トップへ戻る</a>
      </div>
    </div>
  </section>
</PublicPageLayout>

<style>
  .intro-card{border:1px solid rgba(201,169,110,.18);background:linear-gradient(135deg,rgba(201,169,110,.06),transparent);padding:24px}.intro-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px}.intro-grid div{border-left:1px solid rgba(201,169,110,.25);padding:8px 12px}.intro-grid strong{display:block;font-family:'Cormorant Garamond',serif;font-size:1.65rem;color:#C9A96E;font-weight:300}.intro-grid span{display:block;font-weight:500}.intro-grid small{color:#827665;font-size:.72rem}.intro-card>p{color:#948775;font-size:.82rem;line-height:1.8}.questionnaire-shell{max-width:880px;margin-inline:auto}.progress-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:8px}.progress-head span{display:block;font-size:.82rem;color:#c9b99f}.progress-head small{display:block;color:#756a5c;font-size:.68rem;margin-top:3px}.progress-head b{font:300 1.3rem 'Cormorant Garamond',serif;color:#C9A96E}.progress-track{height:3px;background:#2e2822;margin-bottom:28px;overflow:hidden}.progress-track i{display:block;height:100%;width:0;background:#C9A96E;transition:width .25s ease}.question-list{display:grid;gap:14px}.domain-divider{margin:20px 0 2px;padding-top:8px;border-top:1px solid rgba(201,169,110,.14)}.domain-divider small{font-size:.62rem;letter-spacing:.16em;color:#8B7355;text-transform:uppercase}.question-card{border:1px solid #2E2822;background:#17130f;padding:20px}.question-no{font:300 1rem 'Cormorant Garamond',serif;color:#8B7355}.question-card h3{font-size:.95rem;font-weight:400;line-height:1.65;margin:4px 0 15px;color:#d4c5a9}.required-mark{color:#C9A96E;margin-left:5px}.choice-grid{display:grid;gap:8px}.choice-label{display:flex;gap:10px;align-items:flex-start;border:1px solid #312a23;padding:11px 12px;cursor:pointer;transition:.15s}.choice-label:hover{border-color:#6f5c43;background:rgba(201,169,110,.04)}.choice-label input{margin-top:3px;accent-color:#C9A96E}.choice-label span{font-size:.82rem;line-height:1.55}.scale-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.scale-label{display:grid;place-items:center;min-height:54px;border:1px solid #312a23;cursor:pointer}.scale-label input{position:absolute;opacity:0}.scale-label span{font:400 1rem 'Cormorant Garamond',serif}.scale-label:has(input:checked){border-color:#C9A96E;background:rgba(201,169,110,.08);color:#C9A96E}.scale-legend{display:flex;justify-content:space-between;color:#665b4f;font-size:.62rem;margin-top:7px}.text-answer{width:100%;min-height:92px;border:1px solid #312a23;background:#0f0d0a;color:#d4c5a9;padding:12px;font:inherit;resize:vertical}.followup-card{margin-top:28px;border:1px solid rgba(201,169,110,.22);background:#1a1612;padding:24px}.section-kicker{font-size:.62rem;letter-spacing:.17em;color:#8B7355}.followup-card h2,.success-card h2{font:300 1.7rem 'Cormorant Garamond',serif;color:#C9A96E;margin:4px 0 8px}.followup-card>p,.success-card>p{font-size:.82rem;line-height:1.8;color:#8f8271}.consent-box{display:flex;gap:10px;margin-top:18px;padding:13px;border:1px solid #312a23;cursor:pointer}.consent-box input{margin-top:4px;accent-color:#C9A96E}.consent-box span{font-size:.78rem;line-height:1.6}.contact-fields{display:grid;gap:13px;margin-top:16px}.contact-fields label{display:grid;gap:6px;font-size:.74rem;color:#9b8e7c}.contact-fields em{font-style:normal;color:#C9A96E}.contact-fields input{height:44px;border:1px solid #312a23;background:#0f0d0a;color:#d4c5a9;padding:0 12px;font:inherit}.privacy-note{font-size:.66rem}.privacy-note a{color:#C9A96E}.submit-wrap{margin-top:22px;text-align:center}.submit-btn{min-width:220px}.form-status{margin-top:10px;color:#a89780;font-size:.75rem;min-height:1.4em}.success-card{border:1px solid rgba(201,169,110,.3);background:linear-gradient(140deg,rgba(201,169,110,.08),#17130f);padding:32px;text-align:center}.success-actions{display:flex;justify-content:center;gap:10px;margin-top:20px}.ghost{background:transparent!important}.hp-field{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;overflow:hidden!important}.loading-note{text-align:center;color:#756a5c;padding:30px}.field-error{color:#c88e7d;font-size:.7rem;margin-top:8px}@media(max-width:700px){.intro-grid{grid-template-columns:repeat(2,1fr)}.question-card{padding:16px}.scale-grid{gap:4px}.scale-label{min-height:48px}.success-actions{display:grid}.progress-head{align-items:center}}
</style>

<script>
  const list = document.getElementById('question-list');
  const form = document.getElementById('mental-form');
  const followup = document.getElementById('followup-card');
  const submitWrap = document.getElementById('submit-wrap');
  const consent = document.getElementById('followup-consent');
  const contactFields = document.getElementById('contact-fields');
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');
  let questions = [];
  let sessionKey = sessionStorage.getItem('mental-check-session') || crypto.randomUUID();
  sessionStorage.setItem('mental-check-session', sessionKey);

  const esc = (value) => String(value ?? '').replace(/[&<>'"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c] || c));
  const inputName = (key) => `q_${key.replace(/[^a-zA-Z0-9_-]/g,'_')}`;

  function renderQuestion(q, index, previousDomain) {
    const name = inputName(q.question_key);
    const divider = q.domain !== previousDomain ? `<div class="domain-divider"><small>${esc(q.domain || 'question')}</small></div>` : '';
    let control = '';
    if (q.answer_type === 'single_choice') {
      control = `<div class="choice-grid">${(q.options || []).map(o => `<label class="choice-label"><input type="radio" name="${name}" value="${esc(o.option_key)}" ${q.required ? 'required' : ''}/><span>${esc(o.label)}</span></label>`).join('')}</div>`;
    } else if (q.answer_type === 'multi_choice' || q.answer_type === 'ranking') {
      control = `<div class="choice-grid">${(q.options || []).map(o => `<label class="choice-label"><input type="checkbox" name="${name}" value="${esc(o.option_key)}"/><span>${esc(o.label)}</span></label>`).join('')}</div>`;
    } else if (q.answer_type === 'scale') {
      const min = Number(q.config?.min || 1); const max = Number(q.config?.max || 5);
      const cells = Array.from({length:max-min+1},(_,i)=>min+i).map(v => `<label class="scale-label"><input type="radio" name="${name}" value="${v}" ${q.required ? 'required' : ''}/><span>${v}</span></label>`).join('');
      control = `<div class="scale-grid">${cells}</div><div class="scale-legend"><span>${esc(q.config?.min_label || '当てはまらない')}</span><span>${esc(q.config?.max_label || '当てはまる')}</span></div>`;
    } else if (q.answer_type === 'yes_no') {
      control = `<div class="choice-grid"><label class="choice-label"><input type="radio" name="${name}" value="true" ${q.required ? 'required' : ''}/><span>はい</span></label><label class="choice-label"><input type="radio" name="${name}" value="false" ${q.required ? 'required' : ''}/><span>いいえ</span></label></div>`;
    } else {
      control = `<textarea class="text-answer" name="${name}" maxlength="4000" ${q.required ? 'required' : ''} placeholder="自由に書いてください"></textarea>`;
    }
    return `${divider}<article class="question-card" data-question-key="${esc(q.question_key)}"><span class="question-no">${String(index+1).padStart(2,'0')}</span><h3>${esc(q.question_text)}${q.required ? '<span class="required-mark">*</span>' : ''}</h3>${control}<div class="field-error" hidden></div></article>`;
  }

  function updateProgress() {
    if (!questions.length) return;
    const answered = questions.filter(q => {
      const name = inputName(q.question_key);
      if (q.answer_type === 'multi_choice' || q.answer_type === 'ranking') return document.querySelectorAll(`[name="${name}"]:checked`).length > 0;
      const field = document.querySelector(`[name="${name}"]:checked`) || document.querySelector(`textarea[name="${name}"]`);
      return field && String(field.value || '').trim() !== '';
    }).length;
    const pct = Math.round((answered / questions.length) * 100);
    document.getElementById('progress-percent').textContent = `${pct}%`;
    document.getElementById('progress-bar').style.width = `${pct}%`;
    document.getElementById('progress-label').textContent = `${answered} / ${questions.length} 回答`;
  }

  async function loadQuestions() {
    try {
      const res = await fetch('/api/questionnaire/mental');
      const body = await res.json();
      if (!res.ok || !body.ok) throw new Error(body.error || 'load_failed');
      questions = body.data?.questions || [];
      document.getElementById('set-purpose').textContent = body.data?.set?.purpose || '';
      let previousDomain = '';
      list.innerHTML = questions.map((q,i) => { const html = renderQuestion(q,i,previousDomain); previousDomain=q.domain; return html; }).join('');
      followup.hidden = false;
      submitWrap.hidden = false;
      document.getElementById('progress-label').textContent = `0 / ${questions.length} 回答`;
      form.addEventListener('change', updateProgress);
      form.addEventListener('input', updateProgress);
    } catch (error) {
      list.innerHTML = `<p class="loading-note">質問を読み込めませんでした。ページを再読み込みしてください。<br><small>${esc(String(error))}</small></p>`;
    }
  }

  function collectAnswers() {
    const answers = [];
    let firstMissing = null;
    document.querySelectorAll('.field-error').forEach(el => { el.hidden = true; el.textContent=''; });
    for (const q of questions) {
      const name = inputName(q.question_key);
      let value = null;
      if (q.answer_type === 'multi_choice' || q.answer_type === 'ranking') {
        value = Array.from(document.querySelectorAll(`[name="${name}"]:checked`)).map(el => el.value);
        if (!value.length) value = null;
      } else if (q.answer_type === 'single_choice' || q.answer_type === 'scale' || q.answer_type === 'yes_no') {
        value = document.querySelector(`[name="${name}"]:checked`)?.value ?? null;
      } else {
        value = document.querySelector(`textarea[name="${name}"]`)?.value?.trim() || null;
      }
      if (q.required && (value === null || (Array.isArray(value) && !value.length))) {
        const card = document.querySelector(`[data-question-key="${CSS.escape(q.question_key)}"]`);
        const error = card?.querySelector('.field-error');
        if (error) { error.textContent='この質問は必須です。'; error.hidden=false; }
        if (!firstMissing) firstMissing = card;
      }
      if (value !== null) answers.push({ questionKey:q.question_key, value });
    }
    if (firstMissing) firstMissing.scrollIntoView({behavior:'smooth',block:'center'});
    return firstMissing ? null : answers;
  }

  consent?.addEventListener('change', () => {
    contactFields.hidden = !consent.checked;
    document.getElementById('email').required = consent.checked;
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const answers = collectAnswers();
    if (!answers) { status.textContent='必須の質問を確認してください。'; return; }
    const followupConsent = consent.checked;
    const email = document.getElementById('email').value.trim();
    if (followupConsent && (!email || !email.includes('@'))) { status.textContent='フィードバック希望の場合はメールアドレスを入力してください。'; document.getElementById('email').focus(); return; }

    submitBtn.disabled = true;
    status.textContent='送信しています…';
    try {
      const res = await fetch('/api/questionnaire/mental', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
          sessionKey,
          answers,
          displayName:document.getElementById('display-name').value.trim(),
          email,
          contactRoute:document.getElementById('contact-route').value.trim(),
          followupConsent,
          website:document.getElementById('website').value,
          sourceRef:location.pathname + location.search,
        }),
      });
      const body = await res.json();
      if (!res.ok || !body.ok) throw new Error(body.error || 'submit_failed');
      form.hidden = true;
      document.getElementById('success-card').hidden = false;
      sessionStorage.removeItem('mental-check-session');
      window.scrollTo({top:0,behavior:'smooth'});
    } catch (error) {
      status.textContent='送信できませんでした。少し時間をおいて再度お試しください。';
      submitBtn.disabled=false;
      console.error(error);
    }
  });

  loadQuestions();
</script>
