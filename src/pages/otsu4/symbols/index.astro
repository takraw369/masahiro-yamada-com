</head>
<body><main>
<nav class="top"><a href="/otsu4/jikahou/">← 自火報集中コース</a><span class="pill">シンボルマーク</span></nav>
<h1>自火報の図記号を覚える</h1>
<p class="intro">図面にあるマークを見て、<b>名称・役割・見分けるポイント</b>を答える。逆向きの「名前から記号を選ぶ」練習もできるよ。</p>
<section class="panel" aria-label="暗記モード設定">
<div class="controls">
<label>暗記する範囲
<select id="category">
<option value="all">全種類を混ぜる</option>
<option value="detector">感知器の記号</option>
<option value="receiver">受信機・中継器</option>
<option value="alarm">発信機・ベル・表示灯</option>
<option value="terminal">終端抵抗・光電式分離型</option>
</select></label>
<label>出題の向き
<select id="direction"><option value="symbol">図記号 → 名称</option><option value="reverse">名称 → 図記号を4択</option></select></label>
<label>復習の範囲
<select id="study-mode"><option value="priority">△・×・未出を優先（10問）</option><option value="weak">△・×だけ復習</option><option value="all">選択範囲をすべて</option></select></label>
</div>
<p class="hint">○は次回の出題を減らし、△・×は優先して再登場。記録はこのブラウザに保存されます。</p>
<button class="primary full" id="start">この条件で開始する ↻</button>
</section>
<section class="panel" id="study" aria-label="シンボルマーク暗記カード">
<div class="progress"><span id="counter"></span><span id="stats"></span></div>
<div class="bar"><span id="bar"></span></div>
<p id="question" class="subtitle">この記号は何を表す？</p>
<div id="symbol" class="symbol-area"></div>
<div id="choices" class="choice-grid" hidden></div>
<button class="primary full" id="reveal" hidden>名称・用途を見る →</button>
<div id="answer" class="answer" hidden>
<h2 id="answer-title"></h2>
<p id="answer-use"></p>
<p id="answer-hint" class="muted"></p>
<a id="source" href="https://www2.panasonic.biz/jp/basics/electric/electricity/symbols/fire-alarm/" target="_blank" rel="noopener noreferrer">原図・出典を確認 ↗</a>
<p id="verdict" class="muted" aria-live="polite"></p>
<div class="grade">
<button data-grade="ok">○ 覚えた</button>
<button data-grade="unsure">△ あやしい</button>
<button data-grade="miss">× もう一度</button>
</div>
</div>
<div id="complete" hidden>
<h2>今回の暗記が終わった！</h2>
<p id="complete-note"></p>
<button class="primary full" id="again">次の10問を学ぶ ↻</button>
</div>
</section>
<p class="muted">図記号は国土交通省官庁営繕部の電気設備工事標準図に基づく例を、学習用の線画として再描画したもの。実際の設計図では傍記・凡例で級別や種別を確認してください。<b>教材の写真鑑別とは別の練習</b>です。シンボルは見た目が似るため、公式の原図も確認してね。</p>
<div class="links"><a href="/otsu4/jikahou/">自火報の構成・設置基準へ →</a><a href="/otsu4/kambetsu/">器具の実物写真鑑別へ →</a><a href="https://www2.panasonic.biz/jp/basics/electric/electricity/symbols/fire-alarm/" target="_blank" rel="noopener noreferrer">図記号の原典一覧 ↗</a></div>
</main>
<script is:inline>
// Reconstructed simple vector symbols for active recall, not copied bitmap images.
// Source: Panasonic electrical-plan symbols quoting government standard drawings.
// The reference ID maps to the corresponding original symbol PNG on the linked page.
const markDefs=[
{id:'h-diff',cat:'detector',title:'差動式スポット型感知器（2種）',use:'急激な温度上昇に反応する熱感知器。',hint:'半円形の熱感知器記号。種別は線の描き方や傍記で確認。',kind:'semi',ref:'03-a01'},
{id:'h-fixed1',cat:'detector',title:'定温式スポット型感知器（1種）',use:'設定温度に達すると作動する熱感知器。',hint:'差動式と近い半円形。受け取った図面の凡例で確定する。',kind:'semiPlain',ref:'03-01'},
{id:'h-fixedspecial',cat:'detector',title:'定温式スポット型感知器（特種）',use:'所定の温度に達すると作動する熱感知器（特種）。',hint:'半円形に水平線を重ねる形。1種との違いも確認。',kind:'semiHorizontal',ref:'03-a02'},
{id:'h-waterproof',cat:'detector',title:'定温式スポット型感知器（防水形）',use:'湿気や水がかかる環境を考慮した熱感知器。',hint:'半円形の内側に縦線が入る図例。種別は傍記に注意。',kind:'semiVertical',ref:'03-02'},
{id:'h-exproof',cat:'detector',title:'定温式スポット型感知器（防爆形）',use:'爆発危険場所用に防爆構造とした熱感知器。',hint:'熱感知器の半円形に「EX」を傍記する。',kind:'semiEx',ref:'04-a01'},
{id:'s-surface',cat:'detector',title:'煙感知器（光電式スポット型など・露出形）',use:'煙を検出して火災信号を送る感知器。',hint:'四角の中にS。実際の型式・感度種別は凡例・傍記で確認。',kind:'smokeSquare',ref:'04-a02'},
{id:'s-flush',cat:'detector',title:'煙感知器（埋込形）',use:'天井などに埋め込んで設置する煙感知器。',hint:'四角のSの上にアーチ状の線。',kind:'smokeArch',ref:'04-a03'},
{id:'s-box',cat:'detector',title:'煙感知器（点検ボックス付）',use:'点検のためのボックスと組み合わせる煙感知器。',hint:'四角のSに、点検ボックスを示す上部の線。',kind:'smokeBox',ref:'04-a04'},
{id:'s-comp',cat:'detector',title:'煙複合式スポット型感知器（露出形）',use:'複数の感度条件を組み合わせた煙感知器。',hint:'S入りの四角に別の帯を重ねた形。',kind:'smokeBand',ref:'04-a05'},
{id:'r-main',cat:'receiver',title:'受信機',use:'感知器・発信機から火災信号を受け、警戒区域などを表示する。',hint:'横長の四角に対角線が交差する記号。P型・R型の違いは型式や傍記を確認。',kind:'boxCross',ref:'04-04'},
{id:'r-combined',cat:'receiver',title:'複合盤',use:'自火報・ガス漏れ警報・連動制御などの機能を一体化した盤。',hint:'受信機に似た四角と、別の区画が組み合わさる図例。',kind:'boxMulti',ref:'04-05'},
{id:'r-secondary',cat:'receiver',title:'副受信機',use:'主受信機の情報を離れた場所で確認するための機器。',hint:'四角の枠内が縦横に区切られる。',kind:'boxGrid',ref:'04-06'},
{id:'r-relay',cat:'receiver',title:'中継器',use:'感知器・受信機間などで信号を中継する。',hint:'小さな四角の上部を横線で区切った図例。',kind:'boxTop',ref:'04-07'},
{id:'a-manual',cat:'alarm',title:'P型発信機',use:'人が押しボタンを操作して火災信号を送る。',hint:'丸の中に P。1級・2級などは傍記で確認する。',kind:'circP',ref:'04-a14'},
{id:'a-manual-out',cat:'alarm',title:'P型発信機（屋外用）',use:'屋外向けの構造とした手動発信機。',hint:'P入りの丸に屋根形の線を重ねる。',kind:'roofP',ref:'04-01'},
{id:'a-bell',cat:'alarm',title:'警報ベル（地区音響装置）',use:'建物内にベル音で火災を知らせる。',hint:'丸の中に B。',kind:'circB',ref:'04-02'},
{id:'a-bell-out',cat:'alarm',title:'警報ベル（屋外用）',use:'屋外用のベル。屋外環境に適した機器を使用する。',hint:'B入りの丸に屋根形の線を重ねる。',kind:'roofB',ref:'04-03'},
{id:'a-indicator',cat:'alarm',title:'表示灯',use:'発信機などの設置位置を示す赤い灯。',hint:'一部が黒く塗られた丸として描く図例。',kind:'halfBlack',ref:'04-08'},
{id:'t-end',cat:'terminal',title:'終端抵抗器',use:'感知器回線の終端で、断線の監視に関係する。',hint:'ギリシャ文字のΩ（オーム）が手がかり。',kind:'omega',ref:'04-a09'},
{id:'t-beam',cat:'terminal',title:'光電式分離型感知器（送光部・受光部）',use:'送光部と受光部の間の光が煙で遮られることを検知する。',hint:'S入りの2つの四角を矢印で結んだ記号。',kind:'beam',ref:'04-a07'}
];
const root=$=>document.getElementById($);
const KEY='otsu4-symbol-cards-v1';
let memory={};
try{const candidate=JSON.parse(localStorage.getItem(KEY)||'{}');if(candidate&&typeof candidate==='object'&&!Array.isArray(candidate))memory=candidate;}catch{}
const nameSet={detector:'感知器',receiver:'受信機・中継器',alarm:'発信機・警報器',terminal:'終端など'};
const lines={
semi:'<path d="M43 62H117 A37 37 0 0 1 43 62"/><path d="M43 66H117"/>',
semiPlain:'<path d="M43 62H117 A37 37 0 0 1 43 62"/>',
semiHorizontal:'<path d="M43 62H117 A37 37 0 0 1 43 62"/><path d="M36 70H124"/>',
semiVertical:'<path d="M43 62H117 A37 37 0 0 1 43 62"/><path d="M80 62V99"/>',
semiEx:'<path d="M43 62H117 A37 37 0 0 1 43 62"/><text x="135" y="80" style="font-size:22px">EX</text>',
smokeSquare:'<rect x="57" y="45" width="46" height="46"/><text x="80" y="70">S</text>',
smokeArch:'<rect x="57" y="51" width="46" height="40"/><path d="M48 52A32 22 0 0 1 112 52"/><text x="80" y="71">S</text>',
smokeBox:'<rect x="57" y="51" width="46" height="40"/><path d="M57 45H103"/><text x="80" y="71">S</text>',
smokeBand:'<rect x="57" y="46" width="46" height="45"/><rect x="57" y="46" width="46" height="12"/><text x="80" y="77" style="font-size:32px">S</text>',
boxCross:'<rect x="38" y="50" width="84" height="42"/><path d="M38 50L122 92 M122 50L38 92 M38 71H122"/>',
boxMulti:'<rect x="22" y="50" width="116" height="42"/><path d="M22 50L65 92 M65 50L22 92 M65 50L105 92 M105 50L65 92 M105 50V92 M105 70H138 M122 50V92"/>',
boxGrid:'<rect x="40" y="47" width="80" height="50"/><path d="M40 64H120 M40 81H120 M80 47V97"/>',
boxTop:'<rect x="56" y="50" width="48" height="51"/><path d="M56 63H104 M72 50V63 M88 50V63"/>',
circP:'<circle cx="80" cy="70" r="34"/><text x="80" y="73">P</text>',
roofP:'<circle cx="80" cy="75" r="32"/><path d="M38 56L80 23L122 56"/><text x="80" y="78">P</text>',
circB:'<circle cx="80" cy="70" r="34"/><text x="80" y="73">B</text>',
roofB:'<circle cx="80" cy="75" r="32"/><path d="M38 56L80 23L122 56"/><text x="80" y="78">B</text>',
halfBlack:'<circle cx="80" cy="70" r="34"/><path class="solid" d="M80 36A34 34 0 0 0 80 104Z"/>',
omega:'<text x="80" y="77" style="font-size:78px">Ω</text>',
beam:'<rect x="18" y="52" width="41" height="43"/><text x="38" y="75" style="font-size:29px">S</text><rect x="102" y="52" width="41" height="43"/><text x="122" y="75" style="font-size:29px">S</text><path d="M65 65H96L88 59 M96 65L88 71 M96 82H65L72 76 M65 82L72 88"/>'
};
function svg(mark){return '<svg viewBox="0 0 160 130" role="img" aria-label="出題中の図記号" xmlns="http://www.w3.org/2000/svg">'+lines[mark.kind]+'</svg>';}
function samplePool(){const cat=root('category').value;return markDefs.filter(x=>cat==='all'||x.cat===cat);}
function history(item){return memory[item.id]||{attempts:0,streak:0,last:'',lastSeen:0};}
function rank(item){
  const x=history(item),elapsed=x.lastSeen?Math.min(12,(Date.now()-x.lastSeen)/(24*60*60*1000)):0;
  return (x.last==='miss'?14:x.last==='unsure'?9:0)+(!x.attempts?7:0)+(x.streak>=2?-8:0)+elapsed+Math.random()*3;
}
function buildDeck(){
  const mode=root('study-mode').value;
  const pool=samplePool().filter(item=>mode!=='weak'||['miss','unsure'].includes(history(item).last));
  pool.sort((a,b)=>rank(b)-rank(a));
  return pool.slice(0,mode==='all'?pool.length:10);
}
let deck=[],index=0,back=false,repeated=new Set(),choiceResult=null,options=[];
function shuffle(a){return [...a].sort(()=>Math.random()-.5);}
function opt(item){
  const pool=markDefs.filter(x=>x.id!==item.id&&x.cat===item.cat);
  const others=shuffle(pool.length>=3?pool:markDefs.filter(x=>x.id!==item.id)).slice(0,3);
  return shuffle([item,...others]);
}
function showCard(){
  const card=deck[index];
  root('answer').hidden=true;root('reveal').hidden=true;root('choices').hidden=true;root('complete').hidden=true;back=false;choiceResult=null;
  root('bar').style.width=deck.length?(100*index/deck.length)+'%':'0%';
  root('counter').textContent=card?(index+1)+' / '+deck.length:'今回のカード終了';
  root('stats').textContent=card?nameSet[card.cat]:(deck.length?'次回も△・×を優先':'復習対象なし');
  if(!card){
    root('symbol').hidden=true;root('question').hidden=true;
    root('complete').hidden=false;
    root('complete-note').textContent=deck.length?'○のカードは出現を減らし、△・×を優先します。':'この範囲に該当カードがありません。範囲かモードを変えてね。';
    return;
  }
  root('question').hidden=false;
  const reverse=root('direction').value==='reverse';
  root('symbol').hidden=reverse;
  if(reverse){
    root('question').textContent='「'+card.title+'」に当たる図記号はどれ？';
    options=opt(card);
    root('choices').hidden=false;
    root('choices').innerHTML=options.map((c,i)=>'<button type="button" data-index="'+i+'" aria-label="図記号 '+(i+1)+'">'+svg(c)+'<span>'+String.fromCharCode(65+i)+'</span></button>').join('');
    root('choices').querySelectorAll('button').forEach(b=>b.onclick=()=>choose(Number(b.dataset.index)));
  }else{
    root('question').textContent='この記号の名称と役割は？';
    root('symbol').innerHTML=svg(card);
    root('reveal').hidden=false;
  }
}
function reveal(){
  if(back||!deck[index])return;
  back=true;
  const card=deck[index];
  root('reveal').hidden=true;root('answer').hidden=false;
  root('answer-title').textContent=card.title;
  root('answer-use').textContent=card.use;
  root('answer-hint').textContent='見分け方：'+card.hint;
  const url='https://www2.panasonic.biz/jp/basics/electric/electricity/img/15/'+card.ref+'.png';
  root('source').href=url;
  root('source').textContent='対応する原図 '+card.ref+' を確認 ↗';
  root('verdict').textContent=choiceResult===null?'思い出せたか、○・△・×で記録しよう。':choiceResult?'正解！ あやしければ△で記録してもOK。':'不正解。正しい形と見分け方を確認して×で復習しよう。';
}
function choose(i){
  if(back||!deck[index])return;
  choiceResult=options[i].id===deck[index].id;
  root('choices').querySelectorAll('button').forEach((b,j)=>{b.disabled=true;if(options[j].id===deck[index].id)b.classList.add('correct');if(i===j)b.classList.add('selected');});
  reveal();
}
function grade(value){
  if(!back||!deck[index]||!['ok','unsure','miss'].includes(value))return;
  const card=deck[index],x=history(card);
  // A wrong 4-choice guess must not be registered as mastered, even if ○ was tapped.
  if(choiceResult===false&&value==='ok')value='miss';
  memory[card.id]={attempts:x.attempts+1,streak:value==='ok'?x.streak+1:0,last:value,lastSeen:Date.now()};
  try{localStorage.setItem(KEY,JSON.stringify(memory));}catch{}
  if(value!=='ok'&&!repeated.has(card.id)){
    deck.splice(Math.min(deck.length,index+3),0,card);
    repeated.add(card.id);
  }
  index++;showCard();
}
function start(){deck=buildDeck();index=0;repeated=new Set();showCard();}
root('start').addEventListener('click',start);
root('again').addEventListener('click',start);
root('reveal').addEventListener('click',reveal);
document.querySelectorAll('[data-grade]').forEach(b=>b.addEventListener('click',()=>grade(b.dataset.grade)));
start();
</script></body></html>