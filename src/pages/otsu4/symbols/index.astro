// Question-side images reuse the exact same original drawing as the answer reference.
function originalUrl(mark){return 'https://www2.panasonic.biz/jp/basics/electric/electricity/img/15/'+mark.ref+'.png';}
function originalImage(mark,which){
  const alt=which==='choice'?'選択肢の図記号':'出題中の図記号';
  const cls=which==='choice'?'original-choice':'original-symbol';
  // No title or source identifier is exposed in question-mode alt text.
  return '<img class="'+cls+'" src="'+originalUrl(mark)+'" alt="'+alt+'" loading="eager" decoding="async">';
}
function attachImageFallback(node){
  node.querySelectorAll('img').forEach(img=>{
    img.addEventListener('error',()=>{
      const msg=document.createElement('span');
      msg.className='symbol-load-error';
      msg.textContent='原図を読み込めません。通信環境を確認してください。';
      img.replaceWith(msg);
    },{once:true});
  });
}
function samplePool(){const cat=root('category').value;return markDefs.filter(x=>cat==='all'||x.cat===cat);}
function history(item){return memory[item.id]||{attempts:0,streak:0,last:'',lastSeen:0};}
function rank(item){
  const x=history(item),elapsed=x.lastSeen?Math.min(12,(Date.now()-x.lastSeen)/(24*60*60*1000)):0;
  return (x.last==='miss'?14:x.last==='unsure'?9:0)+(!x.attempts?7:0)+(x.streak>=2?-8:0)+elapsed+Math.random()*3;
}
function buildDeck(){
  const mode=root('study-mode').value;
  const pool=samplePool().filter(item=>mode!=='weak'||['miss','unsure'].includes(history(item).last));
  pool.sort((a,b)=>rank(b)-rank(a));
  return pool.slice(0,mode==='all'?pool.length:10);
}
let deck=[],index=0,back=false,repeated=new Set(),choiceResult=null,options=[];
function shuffle(a){return [...a].sort(()=>Math.random()-.5);}
function opt(item){
  const pool=markDefs.filter(x=>x.id!==item.id&&x.cat===item.cat);
  const others=shuffle(pool.length>=3?pool:markDefs.filter(x=>x.id!==item.id)).slice(0,3);
  return shuffle([item,...others]);
}
function showCard(){
  const card=deck[index];
  root('answer').hidden=true;root('reveal').hidden=true;root('choices').hidden=true;root('complete').hidden=true;back=false;choiceResult=null;
  root('bar').style.width=deck.length?(100*index/deck.length)+'%':'0%';
  root('counter').textContent=card?(index+1)+' / '+deck.length:'今回のカード終了';
  root('stats').textContent=card?nameSet[card.cat]:(deck.length?'次回も△・×を優先':'復習対象なし');
  if(!card){
    root('symbol').hidden=true;root('question').hidden=true;
    root('complete').hidden=false;
    root('complete-note').textContent=deck.length?'○のカードは出現を減らし、△・×を優先します。':'この範囲に該当カードがありません。範囲かモードを変えてね。';
    return;
  }
  root('question').hidden=false;
  const reverse=root('direction').value==='reverse';
  root('symbol').hidden=reverse;
  if(reverse){
    root('question').textContent='「'+card.title+'」に当たる図記号はどれ？';
    options=opt(card);
    root('choices').hidden=false;
    root('choices').innerHTML=options.map((c,i)=>'<button type="button" data-index="'+i+'" aria-label="図記号 '+(i+1)+'">'+originalImage(c,'choice')+'<span>'+String.fromCharCode(65+i)+'</span></button>').join('');
    attachImageFallback(root('choices'));
    root('choices').querySelectorAll('button').forEach(b=>b.onclick=()=>choose(Number(b.dataset.index)));
  }else{
    root('question').textContent='この記号の名称と役割は？';
    root('symbol').innerHTML=originalImage(card,'question');
    attachImageFallback(root('symbol'));
    root('reveal').hidden=false;
  }
}
function reveal(){
  if(back||!deck[index])return;
  back=true;
  const card=deck[index];
  root('reveal').hidden=true;root('answer').hidden=false;
  root('answer-title').textContent=card.title;
  root('answer-use').textContent=card.use;
  root('answer-hint').textContent='見分け方：'+card.hint;
  const url=originalUrl(card);
  root('source').href=url;
  root('reference-symbol').src=url;
  root('reference-symbol').alt=card.title+'の原図';
  root('source').textContent='対応する原図 '+card.ref+' を確認 ↗';
  root('verdict').textContent=choiceResult===null?'思い出せたか、○・△・×で記録しよう。':choiceResult?'正解！ あやしければ△で記録してもOK。':'不正解。正しい形と見分け方を確認して×で復習しよう。';
}
function choose(i){
  if(back||!deck[index])return;
  choiceResult=options[i].id===deck[index].id;
  root('choices').querySelectorAll('button').forEach((b,j)=>{b.disabled=true;if(options[j].id===deck[index].id)b.classList.add('correct');if(i===j)b.classList.add('selected');});
  reveal();
}
function grade(value){
  if(!back||!deck[index]||!['ok','unsure','miss'].includes(value))return;
  const card=deck[index],x=history(card);
  // A wrong 4-choice guess must not be registered as mastered, even if ○ was tapped.
  if(choiceResult===false&&value==='ok')value='miss';
  memory[card.id]={attempts:x.attempts+1,streak:value==='ok'?x.streak+1:0,last:value,lastSeen:Date.now()};
  try{localStorage.setItem(KEY,JSON.stringify(memory));}catch{}
  if(value!=='ok'&&!repeated.has(card.id)){
    deck.splice(Math.min(deck.length,index+3),0,card);
    repeated.add(card.id);
  }
  index++;showCard();
}
function start(){deck=buildDeck();index=0;repeated=new Set();showCard();}
root('start').addEventListener('click',start);
root('again').addEventListener('click',start);
root('reveal').addEventListener('click',reveal);
document.querySelectorAll('[data-grade]').forEach(b=>b.addEventListener('click',()=>grade(b.dataset.grade)));
start();
</script></body></html>