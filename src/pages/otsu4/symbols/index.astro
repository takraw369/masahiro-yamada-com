<style>
:root{font-family:-apple-system,BlinkMacSystemFont,"Noto Sans JP",sans-serif;color:#173147;background:#f1f6f9}*{box-sizing:border-box}body{margin:0}main{max-width:700px;margin:0 auto;padding:16px 15px calc(70px + env(safe-area-inset-bottom))}a{color:#22668e}h1{font-size:clamp(26px,6vw,34px);margin:10px 0 8px}h2{font-size:19px;margin:9px 0}.top{display:flex;justify-content:space-between;align-items:center;gap:8px}.pill{font-size:12px;font-weight:750;background:#e4eff6;padding:7px 10px;border-radius:99px}.intro{line-height:1.75;color:#4a6578}.panel{background:#fff;border:1px solid #d9e6ed;border-radius:19px;padding:18px;margin:14px 0;box-shadow:0 5px 24px #17324d08}.controls{display:grid;grid-template-columns:1fr 1fr;gap:12px}.controls label{display:grid;gap:6px;font-weight:750;font-size:14px}.controls select{max-width:100%;border:1px solid #b5cbd9;border-radius:11px;padding:11px;font-size:15px;color:#16384f;background:#fff}.controls label:first-child{grid-column:1/-1}.hint{color:#556d7d;font-size:13px;line-height:1.65}button{font:inherit;cursor:pointer;border-radius:12px;padding:12px 10px;border:1px solid #a7c5d9;background:#edf5fa;color:#154762;font-weight:800;min-height:47px}button:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #ffb44a;outline-offset:2px}.primary{background:#28648b;border-color:#28648b;color:#fff}.full{width:100%}.symbol-area{min-height:260px;display:grid;place-items:center;background:#f6fafc;border:1px solid #e2edf3;border-radius:17px;margin:14px 0;padding:16px}.symbol-area svg{display:block;width:min(100%,330px);height:225px}.symbol-area svg path,.symbol-area svg rect,.symbol-area svg circle,.symbol-area svg line,.symbol-area svg polyline{stroke:#172d3c;stroke-width:3.3;stroke-linecap:round;stroke-linejoin:round;fill:none}.symbol-area svg .solid{fill:#172d3c}.symbol-area svg text{font-weight:750;font-family:Arial,sans-serif;fill:#172d3c;font-size:37px;text-anchor:middle;dominant-baseline:middle}.subtitle{text-align:center;font-size:15px;font-weight:750;margin:0;color:#2b5f7b}.progress{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:13px;font-weight:750;color:#467188}.bar{height:7px;border-radius:20px;background:#e1ebf1;overflow:hidden;margin:11px 0}.bar>span{height:100%;display:block;background:#28648b;width:0;transition:width .2s}.answer{border:1px solid #c5dce9;background:#f4f9fc;border-radius:14px;padding:15px;margin-top:15px}.answer h2{color:#184a68}.answer p{line-height:1.75}.answer a{font-size:13px}.grade{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.grade button:first-child{background:#e5f4ea;color:#145a35;border-color:#9bd5b3}.grade button:nth-child(2){background:#fff4df;color:#7a5200;border-color:#ecd19a}.grade button:nth-child(3){background:#fbecea;color:#953b35;border-color:#e5aaa5}.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:15px}.choice-grid button{padding:8px;min-height:130px;background:#fff;border:2px solid #cadde8}.choice-grid button:disabled{cursor:default;opacity:1}.choice-grid button.selected{border-color:#28648b;background:#ebf5fb}.choice-grid button.correct{border-color:#29905c;background:#e9f6ed}.choice-grid svg{width:100%;height:93px;display:block}.choice-grid svg path,.choice-grid svg rect,.choice-grid svg circle,.choice-grid svg line,.choice-grid svg polyline{stroke:#172d3c;stroke-width:3.3;stroke-linecap:round;stroke-linejoin:round;fill:none}.choice-grid svg .solid{fill:#172d3c}.choice-grid svg text{font-weight:750;font-family:Arial,sans-serif;fill:#172d3c;font-size:37px;text-anchor:middle;dominant-baseline:middle}.muted{font-size:13px;color:#4e6c7b;line-height:1.8}.links{display:flex;flex-wrap:wrap;gap:12px;font-size:14px}.hidden,[hidden]{display:none!important}
@media(max-width:360px){.controls{grid-template-columns:1fr}.controls label:first-child{grid-column:auto}.grade button{font-size:13px}.panel{padding:14px}}
