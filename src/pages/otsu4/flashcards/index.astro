const $ = (id) => document.getElementById(id);
// 学習リンクから特定の写真教材へ直接移動できる。
const selectedCategory = new URLSearchParams(window.location.search).get("category");
if (selectedCategory && Object.prototype.hasOwnProperty.call(groups, selectedCategory)) $("category").value = selectedCategory;
const grades = (() => {try {const value=JSON.parse(localStorage.getItem(KEY));return value && typeof value==="object" && !Array.isArray(value)?value:{};} catch {return {};}})();
let mode = "list", masked = false, queue = [], cursor = 0, revealed = false;
function scopeCards(){const c=$("category").value;return cards.filter(x=>c==="all"||x.group===c);}
function getGrade(id){return ["ok","unsure","miss"].includes(grades[id])?grades[id]:null;}
function summary(){
 const rows=scopeCards(), ok=rows.filter(x=>getGrade(x.id)==="ok").length, unsure=rows.filter(x=>getGrade(x.id)==="unsure").length, miss=rows.filter(x=>getGrade(x.id)==="miss").length;
 $("totals").textContent = rows.length + "項目";
 $("rating-summary").textContent = "○ "+ok+" / △ "+unsure+" / × "+miss+" / 未出 "+(rows.length-ok-unsure-miss);
 $("track").style.width = (rows.length?100*ok/rows.length:0)+"%";
}
function renderList(){
 const root=$("list");root.replaceChildren();
 const rows=scopeCards();
 for(const [key,label] of Object.entries(groups)){
  const sub=rows.filter(x=>x.group===key);if(!sub.length)continue;
  const title=document.createElement("h3");title.className="group-title";title.textContent=label+"（"+sub.length+"項目）";root.appendChild(title);
  for(const item of sub){
   const line=document.createElement("div");line.className="row";
   const q=document.createElement("strong");q.textContent=item.q;
   const a=document.createElement("span");a.textContent=item.a;a.className="answer"+(masked?" masked":"");
   a.setAttribute("role","button");a.tabIndex=0;a.setAttribute("aria-label",masked?"答えを確認":"答え: "+item.a);
   const toggle=()=>{if(masked){a.classList.toggle("masked");a.setAttribute("aria-label",a.classList.contains("masked")?"答えを確認":"答え: "+item.a);}};
   a.addEventListener("click",toggle);
   a.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();toggle();}});
   line.append(q,a);root.appendChild(line);
  }
 }
 $("mask").textContent=masked?"答えを全部表示":"答えを隠す";
 summary();
}
function openMode(target){
 mode=target;
 $("tab-list").setAttribute("aria-pressed",String(mode==="list"));
 $("tab-card").setAttribute("aria-pressed",String(mode==="card"));
 $("list-panel").hidden=mode!=="list";
 $("card-panel").hidden=mode!=="card";
 if(mode==="list"){renderList();} else {begin();}
}
function begin(){
 const rows=scopeCards(), choice=$("scope").value;
 const ranked=[...rows].sort((a,b)=>{
  const weight=x=>({miss:4,unsure:3,ok:0}[getGrade(x.id)]??2);
  return weight(b)-weight(a)||cards.indexOf(a)-cards.indexOf(b);
 });
 queue=choice==="weak"?ranked.filter(x=>["miss","unsure"].includes(getGrade(x.id))):choice==="all"?ranked:ranked.slice(0,10);
 cursor=0;renderCard();
}
function renderCard(){
 $("card-body").hidden=cursor>=queue.length;
 $("complete").hidden=cursor<queue.length;
 $("card-counter").textContent=Math.min(cursor+1,queue.length)+" / "+queue.length+"枚";
 $("session-track").style.width=(queue.length?100*cursor/queue.length:0)+"%";
 if(cursor>=queue.length){
  $("complete-detail").textContent=queue.length?"○△×を保存しました。△・×は次回の復習で優先されます。":"この条件に該当するカードはまだありません。";
  $("restart").textContent=queue.length?"もう一度カードを学ぶ ↻":"全カードを選んで始める";
  summary();return;
 }
 revealed=false;const item=queue[cursor];
 $("card-category").textContent=groups[item.group];
 $("front").textContent=item.q;
 $("back").textContent=item.a;
 $("back").hidden=true;
 $("reveal").hidden=false;
 $("grade-block").hidden=true;
}
$("reveal").addEventListener("click",()=>{revealed=true;$("back").hidden=false;$("reveal").hidden=true;$("grade-block").hidden=false;});
document.querySelectorAll("[data-grade]").forEach(btn=>btn.addEventListener("click",()=>{
 if(!revealed||cursor>=queue.length)return;
 grades[queue[cursor].id]=btn.dataset.grade;
 try{localStorage.setItem(KEY,JSON.stringify(grades));}catch{}
 cursor++;renderCard();summary();
}));
$("tab-list").addEventListener("click",()=>openMode("list"));
$("tab-card").addEventListener("click",()=>openMode("card"));
$("start-from-list").addEventListener("click",()=>openMode("card"));
$("restart").addEventListener("click",()=>{if(!queue.length)$("scope").value="priority";begin();});
$("mask").addEventListener("click",()=>{masked=!masked;renderList();});
$("category").addEventListener("change",()=>{if(mode==="list")renderList();else begin();});
$("scope").addEventListener("change",()=>{if(mode==="card")begin();});
renderList();
})();
</script>
</body>
</html>