    -(own.last==='ok'&&own.streak>=2?250:0);
}
function beginFlash() {
  const scope=$('flash-scope').value;
  const both=[...foundationFlashCards,...photoFlashCards()];
  const selected=scope==='p294' ? both.filter(item=>item.photoTool && textbook294AndFlameTools.includes(item.title)) :
    scope==='tools308' ? both.filter(item=>item.photoTool && textbook308Tools.includes(item.title)) :
    scope==='photos' ? both.filter(item=>item.photoTool) :
    scope==='review' ? both.filter(item=>['miss','unsure'].includes(flashItemState(item).last) || (item.photoTool && ['miss','unsure'].includes(stateFor(item.photoTool).lastConfidence))) :
    foundationFlashCards;
  flashDeck=scope==='p294' ? [...selected].sort((a,b)=>textbook294AndFlameTools.indexOf(a.title)-textbook294AndFlameTools.indexOf(b.title)) : scope==='tools308' ? [...selected].sort((a,b)=>textbook308Tools.indexOf(a.title)-textbook308Tools.indexOf(b.title)) : [...selected].sort((a,b)=>flashRank(b)-flashRank(a)).slice(0,10);
  flashIndex=0;flashRevealed=false;flashRepeated=new Set();
  showFlash();
}
function showFlash() {
  const current=flashDeck[flashIndex];
  $('flash-flip').hidden=true;
  $('flash-grades').hidden=true;
  if (!current) {
    $('flash-photo').hidden=true;
    $('flash-visual').hidden=false;
    $('flash-back').hidden=true;
    $('flash-progress').textContent=flashDeck.length ? '今回のカードを学び終えました！' : 'まだ復習対象がないよ。基礎から進めよう。';
    $('flash-group').textContent='REVIEW COMPLETE';
    $('flash-question').textContent=flashDeck.length ? '△・×は次回も優先されます。次は記述テストへ！' : 'まず基礎・写真カードを選んでね。';
    return;
  }
  flashRevealed=false;
  $('flash-progress').textContent=`${flashIndex+1} / ${flashDeck.length}｜基礎 ${foundationFlashCards.length}枚＋写真 ${photoFlashCards().length}枚`;
  $('flash-group').textContent=current.group;
  $('flash-question').textContent=current.question;
  $('flash-back').hidden=true;
  $('flash-answer-title').textContent=current.title;
  $('flash-answer').textContent=current.answer;
  $('flash-hint').textContent=(textbook294AndFlameTools.includes(current.title) ? '講習p294／炎・重点｜' : current.lectureToolPage ? '講習教材 '+current.lectureToolPage+'頁｜' : '')+current.hint;
  $('flash-photo').hidden=!current.photoTool;
  if (current.photoTool) { loadPhoto(current.photoTool,'flash-photo'); $('flash-photo').alt='鑑別用参考写真または模式図（教材原版の転載ではありません）'; }
  $('flash-flip').hidden=false;
  $('flash-flip').textContent='裏面を見て覚える';
}
function revealFlash(){
  if (!flashDeck[flashIndex] || flashRevealed) return;
  flashRevealed=true;
  $('flash-back').hidden=false;
  $('flash-flip').hidden=true;
  $('flash-grades').hidden=false;
}
function gradeFlash(grade){
  const item=flashDeck[flashIndex];
  if (!flashRevealed||!item||!['ok','unsure','miss'].includes(grade))return;
  const old=flashItemState(item);
  flashState[item.id]={attempts:old.attempts+1,last:grade,streak:grade==='ok'?old.streak+1:0,lastSeen:Date.now()};
  try{localStorage.setItem(FLASH_KEY,JSON.stringify(flashState));}catch{/* Unavailable storage should not block study. */}
  if (grade!=='ok'&&!flashRepeated.has(item.id)) {
    const position=Math.min(flashDeck.length,flashIndex+3);
    flashDeck.splice(position,0,item);
    flashRepeated.add(item.id);
  }
  flashIndex++;
  showFlash();
}
function openTest(){
  $('flashcards').hidden=true;
  $('app').hidden=false;
  queue=buildQueue();i=0;ok=0;review=[];quizStarted=true;renderWeak();show();
  window.scrollTo({top:0,behavior:'instant'});
}
function openFlash(){
  $('app').hidden=true;
  $('flashcards').hidden=false;
  window.scrollTo({top:0,behavior:'instant'});
}
$('flash-scope').addEventListener('change',beginFlash);
$('flash-flip').addEventListener('click',revealFlash);
document.querySelectorAll('[data-flash-grade]').forEach(button=>button.addEventListener('click',()=>gradeFlash(button.dataset.flashGrade)));
$('flash-test').addEventListener('click',openTest);
$('back-to-flash').addEventListener('click',openFlash);

const entryParams=new URLSearchParams(location.search);
if(entryParams.get('cards')==='p308') $('flash-scope').value='tools308';
if(entryParams.get('cards')==='p294') $('flash-scope').value='p294';
if(['p294','all','tools308','priority'].includes(entryParams.get('scope'))) $('quiz-scope').value=entryParams.get('scope');
beginFlash();
if(entryParams.get('mode')==='test') openTest();
</script></body></html>