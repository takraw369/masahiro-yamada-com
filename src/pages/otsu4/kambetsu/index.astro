function loadPhoto(t, elementId='photo'){
  const photo=$(elementId);
  const urls=[...(t.urls||[]),...((t.files||[]).map(commons))];
  let n=0;
  photo.onerror=()=>{
    n++;
    if(n<urls.length){photo.src=urls[n];return}
    photo.onerror=null;
    photo.src=fallbackSvg(t);
  };
  photo.src=urls[0]||fallbackSvg(t);
}

const hiraToKata=s=>s.replace(/[ぁ-ゖ]/g,ch=>String.fromCharCode(ch.charCodeAt(0)+0x60));
const norm=s=>hiraToKata(String(s||'').normalize('NFKC').toLowerCase()).replace(/[\s　・、。,.!?！？「」『』（）()\-ー]/g,'');
function judgeName(t,value){
  const v=norm(value);
  if(!v)return false;
  return [t.name,...(t.aliases||[])].map(norm).some(a=>v===a||(v.length>=2&&a.length>=2&&(v.includes(a)||a.includes(v))));
}
function judgeUse(t,value){
  const v=norm(value);
  if(!v)return false;
  return (t.useGroups||[]).every(group=>group.some(term=>v.includes(norm(term))));
}

const K='otsu4-kambetsu-state-v2';
const OLD='otsu4-kambetsu-state-v1';
let hist={};
try{
  hist=JSON.parse(localStorage.getItem(K))||{};
  if(!Object.keys(hist).length){
    const old=JSON.parse(localStorage.getItem(OLD))||{};
    Object.entries(old).forEach(([name,x])=>{
      hist[name]={
        attempts:x.attempts||0,
        nameOk:x.ok||0,
        useOk:x.ok||0,
        fullOk:x.ok||0,
        unsure:0,
        miss:x.miss||0
      };
    });
  }
}catch{}

let queue=[],i=0,ok=0,review=[];
let lastResult=null;

function stateFor(t){
  const x=hist[t.name]||{};
  return {
    attempts:Number(x.attempts)||0,
    nameOk:Number(x.nameOk)||0,
    useOk:Number(x.useOk)||0,
    fullOk:Number(x.fullOk)||0,
    unsure:Number(x.unsure)||0,
    miss:Number(x.miss)||0,
    lastConfidence:String(x.lastConfidence||''),
    streakOk:Number(x.streakOk)||0,
    lastSeen:Number(x.lastSeen)||0
  };
}
function isMastered(t){
  const x=stateFor(t);
  return x.streakOk>=1&&x.lastConfidence==='ok';
}
function unlockedCount(){
  const mastered=orderedTools.reduce((n,t)=>n+(isMastered(t)?1:0),0);
  return Math.min(orderedTools.length,6+Math.floor(mastered/4)*3);
}
function activeTools(){
  const unlocked=unlockedCount();
  const active=orderedTools.slice(0,unlocked);
  // Highlighted lecture mistakes and flame detector must not be locked behind early sessions.
  const immediate=['紫外線式スポット型感知器','差動式分布型感知器（熱電対式）の検出器','差動式分布型感知器（熱電対式）の熱電対部','ウォーターポンププライヤー'];
  for(const name of immediate){const t=tools.find(x=>x.name===name);if(t&&!active.some(x=>x.name===name))active.push(t);}
  if(unlocked>=orderedTools.length) for(const t of extraTools)if(!active.some(x=>x.name===t.name))active.push(t);
  return active;
}
function priority(t){
  const x=stateFor(t);
  if(x.lastConfidence==='miss')return 0;
  if(x.lastConfidence==='unsure')return 1;
  if(!x.attempts)return 2;
  if(x.miss||x.unsure)return 3;
  return 4;
}
function saveGrade(t,result,confidence){
  const x=stateFor(t);
  x.attempts++;
  if(result.nameOk)x.nameOk++;
  if(result.useOk)x.useOk++;
  if(result.nameOk&&result.useOk)x.fullOk++;
  if(confidence==='unsure')x.unsure++;
  const autoMiss=!result.nameOk||!result.useOk;
  if(confidence==='miss'||autoMiss)x.miss++;
  x.lastConfidence=autoMiss?'miss':confidence;
  x.streakOk=(result.nameOk&&result.useOk&&confidence==='ok')?(x.streakOk+1):0;
  x.lastSeen=Date.now();
  hist[t.name]=x;
  localStorage.setItem(K,JSON.stringify(hist));
  renderWeak();
}
function adaptiveWeight(t){
  const x=stateFor(t);
  if(!x.attempts)return 7;
  let w=1;
  if(x.lastConfidence==='miss')w+=12;
  else if(x.lastConfidence==='unsure')w+=8;
  w+=Math.min(7,x.miss*1.8)+Math.min(5,x.unsure*1.2);
  if(x.streakOk>=2&&x.lastConfidence==='ok')w*=0.3;
  return Math.max(.5,w);
}
function insertRepeat(deck,t,minDelay,maxDelay){
  if(deck.length>=tools.length+12)return;
  const from=Math.min(deck.length,i+minDelay);
  const to=Math.min(deck.length,i+maxDelay);
  const pos=from+Math.floor(Math.random()*Math.max(1,to-from+1));
  if(deck.slice(Math.max(i+1,pos-1),pos+2).some(x=>x.name===t.name))return;
  deck.splice(pos,0,t);
}
function buildQueue(){
  const requested=$('quiz-scope')?.value||'priority';
  const focus=requested==='p294'?textbook294AndFlameTools:requested==='tools308'?textbook308Tools:null;
  const active=requested==='all'?[...orderedTools,...extraTools]:focus?focus.map(name=>tools.find(t=>t.name===name)).filter(Boolean):activeTools();
  const base=[...active].sort((a,b)=>{
    const p=priority(a)-priority(b);
    if(p)return p;
    return (lectureRank.get(a.name)??9999)-(lectureRank.get(b.name)??9999);
  });
  const extras=[];
  for(const t of active){
    const x=stateFor(t);
    let n=x.lastConfidence==='miss'?2:x.lastConfidence==='unsure'?1:(x.miss||x.unsure)?1:0;
    while(n-->0)extras.push(t);
  }
  for(const t of extras){
    if(base.length>=active.length+8)break;
    const pos=Math.min(base.length,2+Math.floor(Math.random()*Math.max(1,base.length-1)));
    if(!base.slice(Math.max(0,pos-1),pos+1).some(x=>x.name===t.name))base.splice(pos,0,t);
  }
  return base;
}
function renderWeak(){
  const rows=activeTools().map(t=>{
    const x=stateFor(t);
    const nameMastery=x.attempts?Math.round(x.nameOk/x.attempts*100):0;
    const useMastery=x.attempts?Math.round(x.useOk/x.attempts*100):0;
    const uncertainRate=x.attempts?x.unsure/x.attempts:0;
    const weakness=x.attempts?Math.min(100,Math.round(100-(nameMastery+useMastery)/2+uncertainRate*20)):100;
    return{name:t.name,nameMastery,useMastery,weakness,attempts:x.attempts,unsure:x.unsure};
  }).sort((a,b)=>b.weakness-a.weakness||a.attempts-b.attempts).slice(0,5);
  $('weakness').innerHTML=rows.map(r=>`<div class="weakrow"><span>${r.name} <small>(${r.attempts}回)</small><br><small>名称 ${r.nameMastery}% / 用途 ${r.useMastery}% / △ ${r.unsure}</small></span><strong>弱点 ${r.weakness}%</strong></div>`).join('');
}
function setMask(t){
  $('mask').innerHTML='';
  (t.mask||[]).forEach(m=>{
    const x=document.createElement('i');
    x.style.left=m[0];x.style.top=m[1];x.style.width=m[2];x.style.height=m[3];
    $('mask').appendChild(x);
  });
}
function show(){
  if(i>=queue.length){
    $('app').innerHTML=`<div class="done"><p>弱点優先セッション完了</p><strong>${ok}/${queue.length}</strong><p>${review.length?'復習候補 '+review.length+' 個。名称と用途を別々に見直そう。':'全問OK！名称・用途とも安定。'}</p><a href="/otsu4/kambetsu/" style="display:block;margin-top:18px;color:#28648b">もう1周</a><a href="/otsu4/" style="display:block;margin-top:18px;color:#28648b">乙4ホームへ</a></div>`;
    return;
  }
  const t=queue[i];
  lastResult=null;
  loadPhoto(t);setMask(t);
  $('counter').textContent=`${i+1} / ${queue.length}｜${$('quiz-scope')?.selectedOptions?.[0]?.textContent||'講習順'}｜通常解放 ${unlockedCount()} / ${orderedTools.length}`;
  if($('poolPill'))$('poolPill').textContent=`鑑別・${orderedTools.length}項目`;
  $('bar').style.width=`${i/queue.length*100}%`;
  $('name').value='';$('use').value='';
  $('answer').style.display='none';
  $('actions').style.display='none';
  $('reveal').style.display='block';
}
$('reveal').onclick=()=>{
  const t=queue[i];
  lastResult={
    nameOk:judgeName(t,$('name').value),
    useOk:judgeUse(t,$('use').value)
  };
  $('judge').innerHTML=
    `<span class="badge ${lastResult.nameOk?'ok':'ng'}">名称 ${lastResult.nameOk?'○':'×'}</span>`+
    `<span class="badge ${lastResult.useOk?'ok':'ng'}">用途 ${lastResult.useOk?'○':'×'}</span>`+
    (!lastResult.nameOk||!lastResult.useOk?'<span class="badge warn">部分正解も記録します</span>':'');
  $('correctName').textContent=t.name;
  $('correctUse').textContent=t.use;
  $('answer').style.display='block';
  $('actions').style.display='grid';
  $('reveal').style.display='none';
