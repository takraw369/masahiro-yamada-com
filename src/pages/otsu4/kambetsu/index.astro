document.querySelectorAll('[data-grade]').forEach(b=>b.onclick=()=>{
  const t=queue[i];
  const confidence=b.dataset.grade;
  const result=lastResult||{nameOk:false,useOk:false};
  const before=unlockedCount();
  saveGrade(t,result,confidence);
  const after=unlockedCount();
  const autoMiss=!result.nameOk||!result.useOk;
  if(result.nameOk&&result.useOk&&confidence==='ok')ok++;
  else if(!review.some(x=>x.name===t.name))review.push(t);
  if(autoMiss||confidence==='miss')insertRepeat(queue,t,2,4);
  else if(confidence==='unsure')insertRepeat(queue,t,3,6);
  if(after>before){
    const unlockedNow=orderedTools.slice(before,after);
    for(const next of unlockedNow) if(!queue.some(x=>x.name===next.name)) queue.push(next);
  }
  i++;show();
});

const foundationFlashCards = [{"id":"base-sense","group":"感知器","title":"熱・煙・炎の3系統","question":"感知器は、何を検出して火災を判断する？","answer":"熱感知器は温度変化や温度到達、煙感知器は煙、炎感知器は炎から出る光を捉える。","hint":"見た目より「何の変化を測るか」で分類する。"},{"id":"base-rate","group":"感知器","title":"差動式は「速さ」","question":"差動式感知器は、温度の何を見て作動する？","answer":"一定時間内の温度上昇の大きさ（上昇率）を捉える。急な上昇で作動する。","hint":"定温式の「温度そのもの」と対比する。"},{"id":"base-fixed","group":"感知器","title":"定温式は「到達」","question":"定温式スポット型感知器は何を条件に作動する？","answer":"感熱部が所定の温度に達すると作動する。バイメタル、サーミスタなどの方式がある。","hint":"差動式=上昇率／定温式=設定温度。"},{"id":"base-air","group":"感知器","title":"空気室・ダイヤフラム・リーク孔","question":"空気膨張式の差動式スポット型で、リーク孔は何のためにある？","answer":"緩やかな温度変化による空気の膨張を逃がし、急な温度上昇と区別する。","hint":"空気室→膨張→ダイヤフラム→接点、ゆっくり変化→リーク孔。"},{"id":"base-compound","group":"感知器","title":"補償式の2機能","question":"補償式スポット型は何の組み合わせ？","answer":"差動式（急激な温度上昇）と定温式（一定温度への到達）の両機能を備える。","hint":"『補償』の文字より「差動＋定温」で覚える。"},{"id":"base-distributed","group":"感知器","title":"分布型は広い範囲","question":"差動式「分布型」と「スポット型」の違いは？","answer":"分布型は空気管・熱電対などで複数の位置から変化を捉え、スポット型は点状の感知部で検知する。","hint":"空気管式・熱電対式・熱半導体式の区別も整理する。"},{"id":"base-smoke","group":"感知器","title":"煙感知器の光","question":"光電式スポット型と光電式分離型、光の見方はどう違う？","answer":"スポット型は煙による光の散乱、分離型は送光部と受光部の間を通る光が弱まることを利用する。","hint":"スポット=散乱／分離=減光。"},{"id":"base-ion","group":"感知器","title":"イオン化式と光電式","question":"イオン化式煙感知器が煙で検出する変化は？","answer":"煙の侵入による電離電流（イオン電流）の変化を利用する。","hint":"光電式は光／イオン化式は電流。"},{"id":"base-flame","group":"感知器","title":"炎感知器","question":"炎感知器には、どんな検知方法がある？","answer":"炎から出る紫外線や赤外線などの光を検出する。","hint":"煙ではなく炎の放射光を捉える。"},{"id":"base-tester","group":"試験器","title":"熱と煙の試験器","question":"加熱試験器と加煙試験器は、それぞれ何を調べる？","answer":"加熱試験器は熱感知器、加煙試験器は煙感知器の作動を確かめる。","hint":"『加えるもの』と『対象となる感知器』を対応させる。"},{"id":"base-filter","group":"試験器","title":"減光フィルター","question":"減光フィルターは、どんな感知器の試験に使う？","answer":"光電式分離型感知器の光を減らし、作動を確認する。","hint":"送光部→受光部の光が弱まった状況を再現する。"},{"id":"base-pressure","group":"試験器","title":"空気管の試験","question":"空気管式の分布型感知器の試験で使うマノメーターは何を測る？","answer":"差動式分布型感知器（空気管式）の流通試験や接点水高試験で圧力・水高を確認する。","hint":"テストポンプで空気を送り、マノメーターで圧力を確認する。"},{"id":"base-receivers","group":"受信・警報","title":"P型・R型・G型","question":"P型・R型・G型受信機の見分け方は？","answer":"P型は回線ごとの火災信号、R型は固有信号で発報位置、G型はガス漏れ信号を扱う。","hint":"P=回線／R=固有信号／G=ガス。"},{"id":"base-manual","group":"受信・警報","title":"発信機・表示灯・地区音響","question":"発信機・表示灯・地区音響装置は何をする？","answer":"発信機は人が押して通報、表示灯は発信機の位置を示し、地区音響装置は音で火災を知らせる。","hint":"押す・示す・鳴らす、の動詞で区別する。"},{"id":"base-end","group":"受信・警報","title":"終端抵抗と中継器","question":"終端抵抗と中継器、役割が違うのはどこ？","answer":"終端抵抗は感知器回線の断線監視に使い、中継器は端末から受信機へ信号を中継する。","hint":"終端=断線／中継=信号の橋渡し。"},{"id":"base-tools","group":"工具・計測","title":"工具は作業で分ける","question":"ニッパー・ストリッパー・圧着ペンチ・リーマは何をする？","answer":"ニッパーは切断、ストリッパーは被覆を剥く、圧着ペンチは接続部を圧着、リーマは管端のバリを取る。","hint":"工具の形より切る・剥く・圧着・バリ取りを言葉にする。"},{"id":"base-meters","group":"工具・計測","title":"計器の使い分け","question":"回路計・絶縁抵抗計・接地抵抗計の違いは？","answer":"回路計は電圧・電流・抵抗を測定、絶縁抵抗計は電路と大地等の間の絶縁状態、接地抵抗計は接地抵抗を測る。","hint":"抵抗という名前が同じでも測定対象が異なる。"},{"id":"base-method","group":"解き方","title":"写真鑑別の答え方","question":"写真鑑別では、どんな順番で答えを組み立てる？","answer":"①名称を特定 ②見分ける特徴 ③『何をどうする』という用途まで声に出す。似た器具との差を最後に確認する。","hint":"カードで覚えた知識を、記述式の答案へ変換する。"},{"id":"base-tool-cuts","group":"工具・計測","title":"切断工具3種の違い","question":"ニッパー、ワイヤーカッター、パイプカッター。切る対象はどう違う？","answer":"ニッパー＝電線など、ワイヤーカッター＝電線・ケーブル、パイプカッター＝金属管。管はローラーと丸刃で回しながら切る。","hint":"名前の『カッター』だけでは判定しない。刃と切断対象を見る。"},{"id":"base-tool-strip-crimp","group":"工具・計測","title":"剥く・つなぐの役割","question":"ワイヤーストリッパー、圧着ペンチ、リングスリーブの役割は？","answer":"ストリッパーで電線の被覆を剥き、電線をリングスリーブに挿入し、適切な圧着ペンチで圧着接続する。","hint":"ストリッパーは被覆除去／リングスリーブは接続金具／圧着ペンチは加工工具。"},{"id":"base-tool-pipe-flow","group":"工具・計測","title":"電線管工事の一連の作業","question":"金属管を切ったあと、内側のバリを取るのは？ 曲げるのは？","answer":"管を切る＝パイプカッター。管内のバリを取る＝リーマ。管を曲げる＝パイプベンダー。外周にねじを切る＝ねじ切り器。","hint":"切る→バリ取り→曲げる→ねじ切り、工程と道具を一対一で覚える。"},{"id":"base-tool-holes","group":"工具・計測","title":"穴を開ける工具","question":"ホルソー（ホールソー）は何に使う？ リーマとの違いは？","answer":"ホルソーは金属板やボックスに円形の穴を開ける。リーマは切断済み金属管の内側を面取りする。","hint":"ホルソー＝新しい穴／リーマ＝すでにある管の内面仕上げ。"},{"id":"base-tool-mall","group":"工具・計測","title":"モールとリングスリーブ","question":"モールとリングスリーブは電線に対して何をする材料？","answer":"モールは配線を収容し保護する部材。リングスリーブは複数の電線を圧着接続する接続金具。","hint":"モール＝線を通す・隠す／リングスリーブ＝線同士をつなぐ。"},{"id":"base-flame-uv-ir-compare","group":"感知器","title":"炎感知器｜紫外線と赤外線","question":"紫外線式と赤外線式はそれぞれ何を検知する？","answer":"紫外線式は炎からの紫外線、赤外線式は炎からの赤外線を受光して検知する。外観で区別が困難な場合は型式表示を確認する。","hint":"炎感知器は光、煙感知器は煙、熱感知器は温度変化。"},{"id":"base-p294-thermocouple-difference","group":"感知器","title":"p294｜検出器と熱電対部","question":"熱電対式の『検出器』と『熱電対部』は、どちらが熱起電力を発生させる？","answer":"熱電対部が温度差で熱起電力を発生させ、検出器はそれを受けて火災信号を送る。","hint":"写真⑧は端子のあるケース／⑨は天井に沿って配置する細長い熱電対部。"},{"id":"base-water-pump-vs-pipe","group":"工具・計測","title":"プライヤーとレンチ","question":"ウォーターポンププライヤーの外観と主な用途は？","answer":"支点を切り替えて口幅を調整できるギザギザのある工具で、管・ナット・継手をつかんで回す。","hint":"パイプカッター＝切断／パイプベンダー＝曲げ／ウォーターポンププライヤー＝つかんで回す。"}];
