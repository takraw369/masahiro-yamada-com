<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow"><title>乙4 鑑別｜12種</title><style>
*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans JP",sans-serif;background:#f4f7fa;color:#15202b}main{max-width:680px;margin:auto;padding:16px 16px 80px}.top{display:flex;justify-content:space-between;align-items:center}.top a{color:#28648b;text-decoration:none}.pill{font-size:12px;background:#dcecf6;color:#174e70;padding:6px 10px;border-radius:99px}.card{background:#fff;border-radius:20px;padding:16px;box-shadow:0 8px 30px #17324d12;margin-top:16px}.progress{height:7px;background:#e7edf2;border-radius:9px;overflow:hidden}.progress i{display:block;height:100%;background:#28648b}.photo{height:300px;display:flex;align-items:center;justify-content:center;margin:14px 0;background:#fff;border-radius:14px;overflow:hidden;position:relative}.photo img{width:100%;height:100%;object-fit:contain}.mask{position:absolute;inset:0;pointer-events:none}.mask i{position:absolute;background:#fff;border-radius:6px}.q{font-weight:800;font-size:20px;margin:10px 0}label{display:block;font-size:13px;font-weight:700;margin:12px 0 5px}input{width:100%;font-size:16px;padding:13px;border:1px solid #cbd6df;border-radius:11px}button{border:0;border-radius:12px;padding:14px 16px;font-size:16px;font-weight:800}.primary{width:100%;margin-top:16px;background:#28648b;color:#fff}.secondary{background:#e9f1f6;color:#174e70}.answer{margin-top:14px;padding:14px;background:#eef7f0;border-radius:12px;display:none}.answer b{display:block;font-size:19px;margin-bottom:6px}.actions{display:none;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.stats{font-size:13px;color:#607080;margin-top:10px;text-align:center}.weakbox{margin-top:14px;padding:12px;background:#f7f9fb;border-radius:12px}.weakbox b{display:block;margin-bottom:7px}.weakrow{display:flex;justify-content:space-between;font-size:13px;padding:4px 0}.weakrow strong{color:#174e70}.done{text-align:center;padding:30px 10px}.done strong{font-size:44px;color:#28648b;display:block}.tiny{font-size:11px;color:#7b8994;line-height:1.5;margin-top:12px}@media(max-width:480px){.photo{height:260px}}
</style></head><body><main><div class="top"><a href="/otsu4/">← 乙4ホーム</a><span class="pill">鑑別・12種</span></div><section class="card" id="app"><div class="progress"><i id="bar"></i></div><div class="stats" id="counter"></div><div class="photo"><img id="photo" alt="鑑別する工具・材料の図" onerror="this.onerror=null;this.src='/otsu4/kambetsu/fallback.svg'"><div class="mask" id="mask"></div></div><div class="q">この名称と用途は？</div><label for="name">名称</label><input id="name" autocomplete="off" placeholder="名称を書く"><label for="use">用途</label><input id="use" autocomplete="off" placeholder="何に使う？"><button class="primary" id="reveal">答え合わせ</button><div class="answer" id="answer"><b id="correctName"></b><span id="correctUse"></span></div><div class="actions" id="actions"><button class="secondary" data-grade="miss">× もう一度</button><button class="primary" style="margin:0" data-grade="ok">○ わかった</button></div><div class="weakbox"><b>鑑別の弱点</b><div id="weakness"></div></div><p class="tiny">教材内に保存した鑑別図を使用しています。外部画像に依存しないため、直リンク切れの影響を受けません。</p></section></main><script is:inline>
const tools=[
{name:'ラジオペンチ',use:'電線などを挟む・切断・曲げ加工する。',img:'/otsu4/kambetsu/radio-pliers.svg'},
{name:'ニッパー',use:'電線などを切断する。',img:'/otsu4/kambetsu/nippers.svg'},
{name:'圧着ペンチ',use:'リングスリーブを圧着する。',img:'/otsu4/kambetsu/crimper.svg'},
{name:'ワイヤーカッター',use:'電線・ケーブルなどを切断する。',img:'/otsu4/kambetsu/wire-cutter.svg'},
{name:'ワイヤーストリッパー',use:'電線・ケーブルの被覆を剥ぐ。',img:'/otsu4/kambetsu/stripper.svg'},
{name:'パイプカッター',use:'電線管を切断する。',img:'/otsu4/kambetsu/pipe-cutter.svg'},
{name:'パイプベンダー',use:'金属管の曲げ加工に用いる。',img:'/otsu4/kambetsu/pipe-bender.svg'},
{name:'ねじ切り器',use:'金属管にねじを切る。',img:'/otsu4/kambetsu/threader.svg'},
{name:'リーマ',use:'金属管内側のバリ取りに用いる。',img:'/otsu4/kambetsu/reamer.svg'},
{name:'ホルソ',use:'金属板などに穴を開ける。',img:'/otsu4/kambetsu/hole-saw.svg'},
{name:'モール',use:'電線を収め、保護・整理するために用いる。',img:'/otsu4/kambetsu/molding.svg'},
{name:'リングスリーブ',use:'電線相互を圧着接続するために用いる。',img:'/otsu4/kambetsu/ring-sleeve.svg'}];
const K='otsu4-kambetsu-state-v1';let hist={};try{hist=JSON.parse(localStorage.getItem(K))||{}}catch{};let queue=[...tools].sort(()=>Math.random()-.5),i=0,ok=0,miss=[];const $=id=>document.getElementById(id);function saveGrade(t,g){const x=hist[t.name]||{attempts:0,ok:0,miss:0};x.attempts++;x[g]++;hist[t.name]=x;localStorage.setItem(K,JSON.stringify(hist));renderWeak()}function renderWeak(){const rows=tools.map(t=>{const x=hist[t.name]||{attempts:0,ok:0,miss:0};const mastery=x.attempts?Math.round(x.ok/x.attempts*100):0;const weakness=x.attempts?100-mastery:100;return{name:t.name,mastery,weakness,attempts:x.attempts}}).sort((a,b)=>b.weakness-a.weakness||a.attempts-b.attempts).slice(0,5);$('weakness').innerHTML=rows.map(r=>`<div class="weakrow"><span>${r.name} <small>(${r.attempts}回)</small></span><strong>弱点 ${r.weakness}%</strong></div>`).join('')}function setMask(t){$('mask').innerHTML='';(t.mask||[]).forEach(m=>{const x=document.createElement('i');x.style.left=m[0];x.style.top=m[1];x.style.width=m[2];x.style.height=m[3];$('mask').appendChild(x)})}function show(){if(i>=queue.length){$('app').innerHTML=`<div class="done"><p>1周完了</p><strong>${ok}/${queue.length}</strong><p>${miss.length?'間違えた '+miss.length+' 個をもう1周しよう。':'全問OK！名称＋用途を紙にも書いて仕上げよう。'}</p><a href="/otsu4/kambetsu/" style="display:block;margin-top:18px;color:#28648b">もう1周</a><a href="/otsu4/" style="display:block;margin-top:18px;color:#28648b">乙4ホームへ</a></div>`;return}let t=queue[i];$('photo').src=t.img;setMask(t);$('counter').textContent=`${i+1} / ${queue.length}`;$('bar').style.width=`${i/queue.length*100}%`;$('name').value='';$('use').value='';$('answer').style.display='none';$('actions').style.display='none';$('reveal').style.display='block'}$('reveal').onclick=()=>{let t=queue[i];$('correctName').textContent=t.name;$('correctUse').textContent=t.use;$('answer').style.display='block';$('actions').style.display='grid';$('reveal').style.display='none'};document.querySelectorAll('[data-grade]').forEach(b=>b.onclick=()=>{const t=queue[i];if(b.dataset.grade==='ok')ok++;else miss.push(t);saveGrade(t,b.dataset.grade);i++;show()});renderWeak();show();
</script></body></html>