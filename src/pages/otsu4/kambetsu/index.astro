<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow"><title>乙4 鑑別｜工具10種</title><style>
*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans JP",sans-serif;background:#f4f7fa;color:#15202b}main{max-width:680px;margin:auto;padding:16px 16px 80px}.top{display:flex;justify-content:space-between;align-items:center}.top a{color:#28648b;text-decoration:none}.pill{font-size:12px;background:#dcecf6;color:#174e70;padding:6px 10px;border-radius:99px}.card{background:#fff;border-radius:20px;padding:16px;box-shadow:0 8px 30px #17324d12;margin-top:16px}.progress{height:7px;background:#e7edf2;border-radius:9px;overflow:hidden}.progress i{display:block;height:100%;background:#28648b}.photo{height:300px;display:flex;align-items:center;justify-content:center;margin:14px 0;background:#fff;border-radius:14px;overflow:hidden}.photo img{width:100%;height:100%;object-fit:contain}.q{font-weight:800;font-size:20px;margin:10px 0}label{display:block;font-size:13px;font-weight:700;margin:12px 0 5px}input{width:100%;font-size:16px;padding:13px;border:1px solid #cbd6df;border-radius:11px}button{border:0;border-radius:12px;padding:14px 16px;font-size:16px;font-weight:800}.primary{width:100%;margin-top:16px;background:#28648b;color:#fff}.secondary{background:#e9f1f6;color:#174e70}.answer{margin-top:14px;padding:14px;background:#eef7f0;border-radius:12px;display:none}.answer b{display:block;font-size:19px;margin-bottom:6px}.actions{display:none;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.stats{font-size:13px;color:#607080;margin-top:10px;text-align:center}.done{text-align:center;padding:30px 10px}.done strong{font-size:44px;color:#28648b;display:block}.tiny{font-size:11px;color:#7b8994;line-height:1.5;margin-top:12px}@media(max-width:480px){.photo{height:260px}}
</style></head><body><main><div class="top"><a href="/otsu4/">← 乙4ホーム</a><span class="pill">鑑別・工具</span></div><section class="card" id="app"><div class="progress"><i id="bar"></i></div><div class="stats" id="counter"></div><div class="photo"><img id="photo" alt="鑑別する工具の写真"></div><div class="q">この工具の名称と用途は？</div><label for="name">名称</label><input id="name" autocomplete="off" placeholder="例：○○ペンチ"><label for="use">用途</label><input id="use" autocomplete="off" placeholder="何をする工具？"><button class="primary" id="reveal">答え合わせ</button><div class="answer" id="answer"><b id="correctName"></b><span id="correctUse"></span></div><div class="actions" id="actions"><button class="secondary" data-grade="miss">× もう一度</button><button class="primary" style="margin:0" data-grade="ok">○ わかった</button></div><p class="tiny">画像は形状鑑別のための参考写真。メーカー・型式により外観は異なります。名称と用途を言葉で再生できることを優先。</p></section></main><script is:inline>
const tools=[
{name:'ラジオペンチ',use:'電線などを挟む・切断・曲げ加工する。',img:'https://shop.r10s.jp/handsman/cabinet/fujiwara/a/n4952520035061_1.jpg'},
{name:'ニッパー',use:'電線などを切断する。',img:'https://images-fe.ssl-images-amazon.com/images/I/418UTOYbJpL.jpg'},
{name:'圧着ペンチ',use:'リングスリーブを圧着する。',img:'https://thumbnail.image.rakuten.co.jp/%400_mall/lamd/cabinet/image88/495226911490_1.jpg'},
{name:'ワイヤーカッター',use:'電線・ケーブルなどを切断する。',img:'https://i.ebayimg.com/images/g/VMoAAOSwdvZj8yrI/s-l960.jpg'},
{name:'ワイヤーストリッパー',use:'電線・ケーブルの被覆を剥ぐ。',img:'https://neotoolgodo1.godohosting.com/js/data/goods/25/04/16/57787/57787_detail_076.jpg'},
{name:'パイプカッター',use:'電線管を切断する。',img:'https://images-na.ssl-images-amazon.com/images/I/71cf-uNq-oL._AC_SL1500_.jpg'},
{name:'パイプベンダー',use:'金属管の曲げ加工に用いる。',img:'https://marselectric.com/cdn-cgi/image/width%3D2000%2Cheight%3D2000%2Cformat%3Dauto%2Cfit%3Dcontain/assets/e6/a8/e6a8696f-33a2-42b0-9926-0785a7258df9/image.webp'},
{name:'ねじ切り器',use:'金属管にねじを切る。',img:'https://makeshop-multi-images.akamaized.net/prokougu5666/itemimages/000000005450.jpg'},
{name:'リーマ',use:'金属管内側のバリ取りに用いる。',img:'https://item-shopping.c.yimg.jp/i/n/tamatama2019_0721da022'},
{name:'ホルソ',use:'金属板などに穴を開ける。',img:'https://thumbnail.coupangcdn.com/thumbnails/remote/492x492ex/image/vendor_inventory/image_audit/prod/6aedd7df-9463-4368-92ea-c64d92d30b9d_fixing_v2.png'}];
let queue=[...tools].sort(()=>Math.random()-.5),i=0,ok=0,miss=[];const $=id=>document.getElementById(id);function show(){if(i>=queue.length){$('app').innerHTML=`<div class="done"><p>1周完了</p><strong>${ok}/${queue.length}</strong><p>${miss.length?'間違えた '+miss.length+' 個をもう1周しよう。':'全問OK！名称＋用途を紙にも書いて仕上げよう。'}</p>${miss.length?'<button class="primary" id="retry">ミスだけ復習</button>':''}<a href="/otsu4/" style="display:block;margin-top:18px;color:#28648b">乙4ホームへ</a></div>`;if(miss.length)document.getElementById('retry').onclick=()=>{queue=[...miss];miss=[];i=0;ok=0;document.location.reload()};return}let t=queue[i];$('photo').src=t.img;$('counter').textContent=`${i+1} / ${queue.length}`;$('bar').style.width=`${i/queue.length*100}%`;$('name').value='';$('use').value='';$('answer').style.display='none';$('actions').style.display='none';$('reveal').style.display='block'}$('reveal').onclick=()=>{let t=queue[i];$('correctName').textContent=t.name;$('correctUse').textContent=t.use;$('answer').style.display='block';$('actions').style.display='grid';$('reveal').style.display='none'};document.querySelectorAll('[data-grade]').forEach(b=>b.onclick=()=>{if(b.dataset.grade==='ok')ok++;else miss.push(queue[i]);i++;show()});show();
</script></body></html>