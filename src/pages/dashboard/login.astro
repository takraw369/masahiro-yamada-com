---
import {
  LEGACY_COOKIE_NAME,
  basePermissions,
  createSessionToken,
  loadAuthConfig,
  operatorPermissions,
  sessionCookieOptions,
  verifyPassword,
  verifySessionToken,
} from '../../lib/security/auth.mjs';
import { clientIp, isSameOriginRequest } from '../../lib/security/request.mjs';
import { consumeRateLimit } from '../../lib/security/rate-limit.mjs';

const env = (Astro.locals as unknown as { securityEnv?: Cloudflare.Env }).securityEnv as Record<string, unknown> | undefined;
const config = loadAuthConfig(env);

// The legacy boolean cookie is never accepted and is actively removed.
Astro.cookies.delete(LEGACY_COOKIE_NAME, { path: '/dashboard' });
Astro.cookies.delete(LEGACY_COOKIE_NAME, { path: '/' });

if (config) {
  const existingToken = Astro.cookies.get(config.cookieName)?.value;
  const existingSession = existingToken
    ? await verifySessionToken(existingToken, config)
    : null;
  if (existingSession) return Astro.redirect('/dashboard');
  if (existingToken) Astro.cookies.delete(config.cookieName, { path: '/' });
}

let error = '';

if (!['GET', 'POST'].includes(Astro.request.method)) {
  Astro.response.status = 405;
  Astro.response.headers.set('Allow', 'GET, POST');
  error = '許可されていないリクエストです';
} else if (Astro.request.method === 'POST') {
  if (!config) {
    Astro.response.status = 503;
    error = '認証設定を利用できません';
  } else {
    const limit = await consumeRateLimit(
      env?.AUTH_RATE_LIMITER,
      `login:${clientIp(Astro.request)}`,
      {
        limit: 5,
        windowMs: 60_000,
        retryAfterSeconds: 60,
        allowLocalFallback: config.mode !== 'production',
      },
    );

    if (limit.unavailable) {
      Astro.response.status = 503;
      error = '認証保護を利用できません';
    } else if (!limit.allowed) {
      Astro.response.status = 429;
      Astro.response.headers.set('Retry-After', String(limit.retryAfterSeconds));
      error = 'しばらく待ってから再試行してください';
    } else if (!isSameOriginRequest(Astro.request)) {
      Astro.response.status = 403;
      error = '認証リクエストを確認できません';
    } else {
      const formData = await Astro.request.formData();
      const rawPassword = formData.get('password');
      const password = typeof rawPassword === 'string' ? rawPassword : '';
      const [baseMatch, operatorMatch] = await Promise.all([
        verifyPassword(password, config.password),
        config.operatorPassword
          ? verifyPassword(password, config.operatorPassword)
          : Promise.resolve(false),
      ]);

      if (baseMatch || operatorMatch) {
        const permissions = operatorMatch ? operatorPermissions() : basePermissions();
        const maxAge = operatorMatch ? config.operatorTtlSeconds : config.sessionTtlSeconds;
        const token = await createSessionToken(config, {
          permissions,
          ttlSeconds: maxAge,
        });
        Astro.cookies.set(
          config.cookieName,
          token,
          sessionCookieOptions(config, maxAge),
        );
        return Astro.redirect('/dashboard');
      }

      Astro.response.status = 401;
      error = '認証に失敗しました';
    }
  }
}
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ACE Dashboard — Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0a1a;
      --surface: #12121f;
      --border: rgba(255,255,255,0.08);
      --accent: #F59E0B;
      --text: #e8e8f0;
      --text-dim: #7070a0;
    }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', 'Noto Sans JP', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 48px 40px;
      width: 100%;
      max-width: 380px;
      text-align: center;
    }
    .logo { font-size: 2.2rem; margin-bottom: 10px; }
    .title { font-size: 1.5rem; font-weight: 800; color: var(--accent); margin-bottom: 4px; }
    .subtitle { font-size: 0.82rem; color: var(--text-dim); margin-bottom: 36px; letter-spacing: 0.04em; }
    .form-group { margin-bottom: 20px; text-align: left; }
    label { display: block; font-size: 0.75rem; color: var(--text-dim); margin-bottom: 8px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
    input[type="password"] {
      width: 100%;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      color: var(--text);
      font-size: 1rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s;
    }
    input[type="password"]:focus { border-color: var(--accent); }
    .error {
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.3);
      color: #f87171;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.85rem;
      margin-bottom: 20px;
    }
    button[type="submit"] {
      width: 100%;
      background: var(--accent);
      color: #0a0a1a;
      border: none;
      border-radius: 10px;
      padding: 14px;
      font-size: 1rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }
    button[type="submit"]:hover { opacity: 0.9; }
    button[type="submit"]:active { transform: scale(0.98); }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">☀️</div>
    <div class="title">ACE Dashboard</div>
    <div class="subtitle">masahiro-yamada.com — MASA's private zone</div>
    {error && <div class="error">{error}</div>}
    <form method="POST">
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" autofocus />
      </div>
      <button type="submit">入室する</button>
    </form>
  </div>
</body>
</html>
