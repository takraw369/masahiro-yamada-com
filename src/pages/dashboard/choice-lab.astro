---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
const labs=[
  {href:'/dashboard/design-lab',status:'ACTIVE',name:'DESIGN',title:'見た目・操作感を選ぶ',desc:'UI / UX / Motion / Layout / Typographyなどを、実物を触って比較する。'},
  {status:'NEXT',name:'WORDS',title:'言葉を選ぶ',desc:'名前、見出し、CTA、説明文、ブランド語彙を比較する。'},
  {status:'NEXT',name:'PRIORITY',title:'優先順位を選ぶ',desc:'今やること、後回しにすること、捨てることを並べて選ぶ。'},
  {status:'NEXT',name:'OFFER',title:'商品・提案を選ぶ',desc:'価格、構成、特典、入口、導線の候補を比較する。'},
  {status:'NEXT',name:'BRAND',title:'ブランド表現を選ぶ',desc:'世界観、写真、色、言葉、服、見せ方を比較する。'},
  {status:'NEXT',name:'SYSTEM',title:'仕組みを選ぶ',desc:'運用方法、ツール、画面構成、自動化方針などを比較する。'},
];
---
<DashboardLayout title="Choice Lab" eyebrow="MASA OS">
  <div class="shell">
    <header><p>MASA CHOICE LAB · DECISION SURFACE v0.1</p><h1>考え続けるより、<br/><em>並べて、触って、選ぶ。</em></h1><span>選択が必要なものを「比較できる形」に変換する共通ラボ。Designは稼働中。ほかは必要になった時に同じ仕組みで足していく。</span></header>
    <section class="loop"><b>QUESTION</b><i>→</i><b>COMPARE</b><i>→</i><b>CHOOSE</b><i>→</i><b>USE</b><i>→</i><b>LEARN</b></section>
    <main>{labs.map(l=>l.href?<a class="lab active" href={l.href}><div><small>{l.status}</small><strong>{l.name}</strong></div><h2>{l.title}</h2><p>{l.desc}</p><span>開く →</span></a>:<article class="lab"><div><small>{l.status}</small><strong>{l.name}</strong></div><h2>{l.title}</h2><p>{l.desc}</p><span>必要になったら追加</span></article>)}</main>
    <aside><strong>原則</strong><p>選択肢を増やして迷わせるのではなく、比較軸を1つずつ切り出す。1回の選択は結論ではなくSignal。実際に使った結果まで戻して、繰り返し有効なものだけRuleへ昇格する。</p></aside>
  </div>
</DashboardLayout>
<style>
.shell{max-width:1180px;margin:0 auto;padding:14px 0 50px;color:#22282e}.shell header{padding:28px 0 34px;border-bottom:1px solid #d8d2ca}.shell header>p{color:#8b5b2c;font-size:.65rem;font-weight:700;letter-spacing:.14em}.shell h1{margin-top:8px;font-family:'Cormorant Garamond',serif;font-size:clamp(2.5rem,5.5vw,5.2rem);line-height:.9;letter-spacing:-.04em}.shell h1 em{font-style:normal;color:#8e8982}.shell header>span{display:block;max-width:720px;margin-top:20px;color:#707982;font-size:.8rem;line-height:1.8}.loop{display:flex;gap:11px;align-items:center;overflow:auto;padding:18px 0;color:#82796c;font-size:.62rem;letter-spacing:.08em;border-bottom:1px solid #e5e0d9}.loop b{color:#5d6268}.loop i{font-style:normal;color:#b5ada3}.shell main{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding-top:26px}.lab{min-height:205px;display:flex;flex-direction:column;padding:18px;border:1px solid #ddd7cf;background:#fbfaf8;color:inherit;text-decoration:none}.lab>div{display:flex;align-items:center;justify-content:space-between}.lab small{color:#999;font-size:.54rem;font-weight:700;letter-spacing:.1em}.lab strong{color:#8b5b2c;font-size:.62rem;letter-spacing:.12em}.lab h2{margin-top:25px;font-size:1rem}.lab p{margin-top:7px;color:#737c84;font-size:.66rem;line-height:1.65}.lab>span{margin-top:auto;padding-top:16px;color:#8f969c;font-size:.61rem}.lab.active{background:#fff;border-color:#bfa27e;transition:.16s}.lab.active small{color:#16835a}.lab.active>span{color:#7b4d16;font-weight:700}.lab.active:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(43,35,28,.07)}.shell aside{display:grid;grid-template-columns:90px 1fr;gap:16px;margin-top:28px;padding:17px;border:1px solid #ddd7cf;background:#f6f2eb}.shell aside strong{font-size:.68rem;color:#79501f}.shell aside p{color:#6f7880;font-size:.66rem;line-height:1.7}@media(max-width:800px){.shell main{grid-template-columns:1fr 1fr}}@media(max-width:560px){.shell main{grid-template-columns:1fr}.shell aside{grid-template-columns:1fr}.loop{gap:8px}}
</style>
