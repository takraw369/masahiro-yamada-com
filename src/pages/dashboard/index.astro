---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardCockpit from '../../components/dashboard/DashboardCockpit';
import RevenueMission from '../../components/dashboard/RevenueMission';
import '../../styles/dashboard-home-presets.css';
import { HomeFlowMap, HomeOutputDoors } from '../../components/dashboard/HomeFlowSurfaces';
import '../../styles/dashboard-home-content.css';
import { homeDesignPresets } from '../../data/homeDesignPresets';
import { parseHomeDesignPreview } from '../../data/homeDesignCombinations';
const previewConfig = parseHomeDesignPreview(Astro.url.searchParams.get('design-preview'));

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  month: 'long',
  day: 'numeric',
  weekday: 'short',
}).format(new Date());

const deepDoors = [
  { group:'EXECUTE', title:'Task Flow', detail:'Project・Task・WAITの詳細', href:'/dashboard/tasks' },
  { group:'SPRINT', title:'72H Flow Build', detail:'既存資産を72時間で現実へ流す', href:'/dashboard/sprint' },
  { group:'THINK', title:'Living Graph', detail:'知識・Project・関係を見る', href:'/dashboard/graph' },
  { group:'THINK', title:'Intelligence', detail:'外部情報を選別する', href:'/dashboard/intelligence' },
  { group:'RELATE', title:'Relationship OS', detail:'人・商談・次Action・購入後をつなぐ', href:'/dashboard/relationships' },
  { group:'LEARN', title:'Evidence Lab', detail:'結果を学習へ戻す', href:'/dashboard/evidence' },
  { group:'DECIDE', title:'Choice Lab', detail:'横断判断が必要な時だけ', href:'/dashboard/choice-lab' },
  { group:'SYSTEM', title:'Chat Sweep', detail:'Chatを診断してPROJECT / 資産化 / Archiveへ', href:'/dashboard/chat-sweep' },
  { group:'CREATE', title:'Publishing Flow', detail:'JourneyからResultまで1本で決める', href:'/dashboard/content-flow' },
  { group:'AI', title:'AI Commands', detail:'Driveの指示を目的から選ぶ', href:'/dashboard/ai-commands' },
  { group:'CREATE', title:'Visual Structures', detail:'20型から図解・スライド構造を選ぶ', href:'/dashboard/visual-structures' },
  { group:'CREATE', title:'FLOW FRAME', detail:'画像1つからSNS・note・App Store向け6サイズへ', href:'/dashboard/flow-frame' },
  { group:'CREATE', title:'Design Studio', detail:'スタイル・構成・パーツを組み合わせる', href:'/dashboard/design-templates' },
  { group:'CREATE', title:'X Post', detail:'決まった1本を編集・確認する', href:'/dashboard/post' },
  { group:'BUILD', title:'Quest', detail:'実践できる形へ変換', href:'/dashboard/quest' },
  { group:'AGENT', title:'Codex Agent', detail:'Task → Agent → Human Gate', href:'/dashboard/codex' },
  { group:'SYSTEM', title:'MASA OS', detail:'正本・統合の詳細へ', href:'/dashboard/os' },
];
---

<DashboardLayout title="今日" eyebrow="MASA OS · TODAY" previewMode={!!previewConfig}>
  <div class="dash-shell" id="dashboard-home-shell">
    <header class="dash-head">
      <div>
        <p class="kicker">MASA OS · TODAY</p>
        <h1>Flow Cockpit</h1>
        <p class="intro">左は全体の地図。ここには、今日触るものだけ置く。見る → 軽く動かす → 必要な時だけ詳細へ。</p>
      </div>
      <div class="date-chip"><span>TODAY</span><strong>{dateLabel}</strong></div>
    </header>

    <div class="home-design-indicator" id="home-design-indicator" hidden>
      <span id="home-design-label">表示スタイルを変更中</span>
      <a href="/dashboard/design-templates">デザインを変更・元に戻す ↗</a>
    </div>

    <nav class="home-quick-nav" id="home-quick-nav" aria-label="ホームのクイックナビ" hidden>
      <a href="/dashboard/tasks">Task Flow</a>
      <a href="/dashboard/line">LINE</a>
      <a href="/dashboard/ace-assets">ACE Assets</a>
      <a href="/mind?action=capture">Capture</a>
    </nav>

    <div class="home-layout-grid">
      <div class="home-unit home-unit--cockpit">
        <DashboardCockpit client:load readOnly={!!previewConfig} />
      </div>

      <div class="home-unit home-unit--revenue">
        <RevenueMission client:only="react" readOnly={!!previewConfig}>
          <p slot="fallback">First Product の共有進捗を読み込み中…</p>
        </RevenueMission>
      </div>

      <div class="home-unit home-unit--flow">
        <HomeFlowMap />
      </div>

      <div class="home-unit home-unit--output">
        <HomeOutputDoors />
      </div>
    </div>

    <section class="home-style-section" aria-labelledby="home-style-title">
      <div class="home-style-heading">
        <div><p class="kicker">STYLE GALLERY</p><h2 id="home-style-title">好きな画面を組み立てる。</h2></div>
        <a href="/dashboard/design-templates">スタイル・構成・部品を選ぶ →</a>
      </div>
      <div class="home-style-preview-rail">
        {homeDesignPresets.map(preset => (
          <a href={`/dashboard/design-templates?style=${preset.id}`} class="home-style-preview" aria-label={`${preset.name} のサンプルとプレビューを開く`}>
            <img src={`/assets/dashboard-style-presets/${preset.id}.svg`} alt="" width="720" height="440" loading="lazy" decoding="async" />
            <strong>{preset.name}</strong>
          </a>
        ))}
      </div>
      <p class="home-style-hint">画像をタップすると拡大プレビューへ。適用するまではホームの表示は変わらない。</p>
    </section>

    <details class="deep-section">
      <summary><span><b>MORE / DEEP WORK</b> 詳細に入りたい時だけ開く</span><em>＋</em></summary>
      <div class="deep-grid">
        {deepDoors.map(item => (
          <a href={item.href}><small>{item.group}</small><strong>{item.title}</strong><span>{item.detail}</span><b>↗</b></a>
        ))}
        <a href="https://opencut.app" target="_blank" rel="noreferrer" aria-label="OpenCutを新しいタブで開く">
          <small>CREATE</small><strong>OpenCut</strong><span>ブラウザで動画を編集する · Web Classic</span><b>↗</b>
        </a>
      </div>
    </details>

    <footer class="dash-foot"><p>Dashboard Cockpit v0.2 · contrast-first</p><span>Projectを見れば済むことは質問にしない。UI配置はoverlay、正本変更は既存Gateを維持。</span></footer>
  </div>
</DashboardLayout>

<script>
  import { loadHomeDesign, describeHomeDesign, parseHomeDesignPreview, homeRegionOrder } from '../../data/homeDesignCombinations';
  try {
    const preview = parseHomeDesignPreview(new URLSearchParams(location.search).get('design-preview'));
    const config = preview || loadHomeDesign(localStorage);
    if (config) {
      const shell = document.getElementById('dashboard-home-shell');
      const indicator = document.getElementById('home-design-indicator');
      const nav = document.getElementById('home-quick-nav');
      const label = document.getElementById('home-design-label');
      shell?.setAttribute('data-home-preset', config.style);
      shell?.setAttribute('data-home-layout', config.layout);
      shell?.setAttribute('data-home-buttons', config.buttons);
      shell?.setAttribute('data-home-cards', config.cards);
      shell?.setAttribute('data-home-navigation', config.navigation);
      shell?.setAttribute('data-home-cta', config.cta);
      if (indicator) indicator.hidden = false;
      if (nav) nav.hidden = false;
      if (label) label.textContent = `適用中：${describeHomeDesign(config)}`;
      if (preview && indicator) indicator.hidden = true;
      const grid = shell?.querySelector('.home-layout-grid');
      const arrange = () => {
        const narrow = (shell?.getBoundingClientRect().width ?? 0) < 860;
        for (const region of homeRegionOrder(config.layout,narrow)) {
          const unit = grid?.querySelector('.home-unit--'+region);
          if (unit) grid?.appendChild(unit);
        }
      };
      arrange();
      if (shell) new ResizeObserver(arrange).observe(shell);

    }
  } catch {
    // Invalid/unavailable storage never breaks the original home layout.
  }
</script>
