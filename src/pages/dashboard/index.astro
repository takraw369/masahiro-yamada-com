---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  month: 'long',
  day: 'numeric',
  weekday: 'short',
}).format(new Date());

const quickActions = [
  { label: 'CAPTURE', title: '残す', detail: '思いつき・メモを一瞬で置く', href: '/mind?action=capture' },
  { label: 'OUTPUT', title: '出す', detail: 'X・LINEなど外へ流す', href: '#output' },
  { label: 'REVIEW', title: '再会する', detail: '今もう一度触れる知識だけ見る', href: '/mind?view=review' },
];
---

<DashboardLayout title="今日" eyebrow="DAILY COMMAND CENTER">
  <div class="today-shell">
    <header class="today-head">
      <div>
        <p class="kicker">TODAY</p>
        <h1>迷わず、1つ動かす。</h1>
        <p class="intro">全部を見る場所ではなく、次の行動へ入るための操作面。必要な機能は必要な時だけ開く。</p>
      </div>
      <p class="date">{dateLabel}</p>
    </header>

    <section class="next-card" aria-labelledby="next-title">
      <div class="next-copy">
        <div class="status-line">
          <span class="kicker">NEXT MOVE · PROPOSAL</span>
          <span class="neutral-badge">CURRENT STATE 未連携</span>
        </div>
        <p class="context">Reality Loop</p>
        <h2 id="next-title">外へ1つ流して、反応を1つ戻す。</h2>
        <p class="body-copy">固定方針からの候補です。Task Board・期限・市場反応から自動判定した「今日の正解」ではありません。Current State接続までは提案として扱います。</p>
      </div>
      <div class="next-actions">
        <a class="primary" href="/dashboard/post">投稿を1本進める <span aria-hidden="true">→</span></a>
        <a class="secondary" href="/dashboard/intelligence#intel-list">素材を選び直す</a>
      </div>
    </section>

    <section class="quick-section" aria-labelledby="quick-title">
      <div class="section-head">
        <div><p class="kicker">START</p><h2 id="quick-title">3つだけ覚える</h2></div>
        <p>残す → 出す → 再会する。</p>
      </div>
      <div class="quick-grid">
        {quickActions.map(item => (
          <a class="quick-card" href={item.href}>
            <span>{item.label}</span>
            <strong>{item.title}</strong>
            <small>{item.detail}</small>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>

    <section class="output-section" id="output" aria-labelledby="output-title">
      <div class="section-head">
        <div><p class="kicker">OUTPUT</p><h2 id="output-title">どこへ流す？</h2></div>
        <p>媒体名より「何を動かすか」から入る。</p>
      </div>
      <div class="channel-grid">
        <a class="channel-card" href="/dashboard/post">
          <span class="channel-mark">X</span>
          <div><strong>X / Social</strong><small>仮説を市場へ出す</small></div>
          <span class="chevron" aria-hidden="true">→</span>
        </a>
        <a class="channel-card line-card" href="/dashboard/line">
          <span class="channel-mark line">L</span>
          <div><strong>LINE Flow</strong><small>教育・顧客導線を動かす</small></div>
          <span class="live-badge">LIVE</span>
          <span class="chevron" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="safety-note">公開・送信・有効化など影響の大きい操作はHuman Gateを残す。</p>
    </section>

    <details class="candidate-section">
      <summary>考える・調べる・育てる <span>THINK / REVIEW</span></summary>
      <div class="candidate-list">
        <article class="candidate-row">
          <div>
            <p class="candidate-name">FLOW MIND</p>
            <h3>読む・考える・再会する。</h3>
            <p>保存量を増やさず、Knowledgeを今の行動やProjectへ戻す。</p>
          </div>
          <a href="/mind">開く →</a>
        </article>
        <article class="candidate-row">
          <div>
            <p class="candidate-name">INTELLIGENCE</p>
            <h3>外から来た情報を選別する。</h3>
            <p>Discover → Trust → Reuse。Sourceを確認し、Evidence・Content・Asset候補へ昇格する。</p>
          </div>
          <a href="/dashboard/intelligence">確認する →</a>
        </article>
      </div>
    </details>

    <footer class="today-foot">
      <p>UI convergence · Warm Light Workbench</p>
      <span>詳しい機能は MORE TOOLS / Quick Jump から必要時だけ開く。</span>
    </footer>
  </div>
</DashboardLayout>

<style>
  .today-shell { max-width: 1180px; margin: 0 auto; padding-bottom: 40px; }
  .today-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 18px; }
  .kicker { color: var(--gold-muted); font-size: .7rem; letter-spacing: .12em; font-weight: 700; }
  .today-head h1 { margin-top: 4px; color: var(--text-primary); font-size: clamp(1.65rem, 3vw, 2.5rem); line-height: 1.25; font-weight: 700; }
  .intro { max-width: 650px; margin-top: 7px; color: var(--text-muted); font-size: .84rem; }
  .date { flex-shrink: 0; color: var(--text-muted); font-size: .82rem; }

  .next-card { display: grid; grid-template-columns: minmax(0,1.5fr) minmax(260px,.5fr); gap: 32px; align-items: end; padding: 30px 32px; background: var(--bg-surface); border: 1px solid #ccb891; box-shadow: 0 10px 34px rgba(55,45,32,.05); }
  .status-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
  .neutral-badge { padding: 4px 7px; border: 1px solid var(--border-default); color: var(--text-muted); background: #faf9f6; font-size: .66rem; letter-spacing: .04em; }
  .context { margin-top: 13px; color: var(--text-muted); font-size: .82rem; }
  .next-card h2 { margin-top: 6px; color: var(--text-primary); font-size: clamp(1.8rem, 4vw, 3.1rem); line-height: 1.28; font-weight: 700; letter-spacing: .01em; }
  .body-copy { max-width: 720px; margin-top: 13px; color: var(--text-muted); font-size: .85rem; line-height: 1.8; }
  .next-actions { display: grid; gap: 8px; }
  .primary, .secondary { min-height: 50px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 16px; text-decoration: none; font-size: .85rem; }
  .primary { color: #fff; background: var(--gold-pure); font-weight: 700; }
  .primary:hover { background: #7f511b; }
  .secondary { color: #5b626a; background: #fff; border: 1px solid var(--border-default); }
  .secondary:hover { border-color: var(--border-hover); color: var(--text-primary); }

  .quick-section, .output-section { margin-top: 30px; }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 12px; }
  .section-head h2 { margin-top: 3px; color: var(--text-primary); font-size: 1.05rem; font-weight: 700; }
  .section-head > p { color: var(--text-muted); font-size: .76rem; }
  .quick-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 9px; }
  .quick-card { position: relative; min-height: 118px; display: flex; flex-direction: column; padding: 16px; border: 1px solid var(--border-default); background: var(--bg-surface); text-decoration: none; }
  .quick-card:hover { border-color: #b58a53; background: #fbf8f3; }
  .quick-card > span { color: var(--gold-muted); font-size: .68rem; letter-spacing: .1em; font-weight: 700; }
  .quick-card strong { margin-top: 8px; font-size: 1rem; }
  .quick-card small { margin-top: 4px; padding-right: 18px; color: var(--text-muted); font-size: .76rem; }
  .quick-card b { position: absolute; right: 15px; bottom: 12px; color: var(--gold-pure); font-weight: 500; }

  .output-section { scroll-margin-top: 92px; }
  .channel-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
  .channel-card { min-height: 96px; display: grid; grid-template-columns: 48px minmax(0,1fr) auto auto; align-items: center; gap: 14px; padding: 16px 18px; border: 1px solid var(--border-default); background: #fff; text-decoration: none; }
  .channel-card:hover { border-color: #b58a53; box-shadow: 0 8px 24px rgba(55,45,32,.05); }
  .channel-mark { width: 44px; height: 44px; display: grid; place-items: center; color: #fff; background: #17191c; font-weight: 700; }
  .channel-mark.line { background: var(--state-green); }
  .channel-card strong { display: block; font-size: .93rem; }
  .channel-card small { display: block; margin-top: 3px; color: var(--text-muted); font-size: .73rem; }
  .live-badge { padding: 3px 7px; color: #0d6e43; background: #e8f5ee; border: 1px solid #b8dfca; font-size: .62rem; font-weight: 700; letter-spacing: .08em; }
  .chevron { color: var(--gold-pure); }
  .safety-note { margin-top: 8px; color: var(--text-dim); font-size: .69rem; }

  .candidate-section { margin-top: 24px; border: 1px solid var(--border-default); background: rgba(255,255,255,.55); padding: 0 16px; }
  .candidate-section > summary { min-height: 48px; display: flex; align-items: center; color: var(--text-primary); cursor: pointer; font-size: .82rem; font-weight: 500; }
  .candidate-section > summary span { margin-left: 10px; color: var(--text-muted); font-size: .66rem; letter-spacing: .08em; }
  .candidate-list { border-top: 1px solid var(--border-default); }
  .candidate-row { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 17px 0; border-bottom: 1px solid var(--border-default); }
  .candidate-row:last-child { border-bottom: 0; }
  .candidate-name { color: var(--gold-muted); font-size: .7rem; }
  .candidate-row h3 { margin-top: 4px; font-size: .91rem; font-weight: 700; }
  .candidate-row p:last-child { max-width: 720px; margin-top: 4px; color: var(--text-muted); font-size: .76rem; line-height: 1.65; }
  .candidate-row a { flex-shrink: 0; min-height: 42px; display: inline-flex; align-items: center; padding: 8px 12px; border: 1px solid var(--border-default); color: var(--gold-pure); background: #fff; text-decoration: none; font-size: .75rem; }
  .today-foot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 24px; padding-top: 15px; border-top: 1px solid var(--border-default); color: var(--text-dim); font-size: .68rem; }

  @media (max-width: 860px) { .next-card { grid-template-columns: 1fr; gap: 20px; } .next-actions { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 720px) { .quick-grid, .channel-grid { grid-template-columns: 1fr; } .quick-card { min-height: 96px; } }
  @media (max-width: 600px) { .today-head, .section-head { align-items: flex-start; flex-direction: column; } .next-card { padding: 22px 18px; } .next-actions { grid-template-columns: 1fr; } .channel-card { grid-template-columns: 44px minmax(0,1fr) auto; } .live-badge { display: none; } .candidate-row { align-items: stretch; flex-direction: column; gap: 11px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }
</style>
