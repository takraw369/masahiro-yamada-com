---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardCockpit from '../../components/dashboard/DashboardCockpit';

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  month: 'long',
  day: 'numeric',
  weekday: 'short',
}).format(new Date());

const designOpportunities = [
  {
    status: 'NEW',
    title: '画像を「ここだけ」直せる',
    principle: 'CHANGE → LOCK → VERIFY',
    detail: '完成画像を全作り直しせず、変える箇所・保持する箇所・差分確認を分けて修正する。',
    uses: ['SNS差し替え', '広告A/B', 'Character consistency', 'Storyboard', '教材図解'],
    command: 'この画像、ここだけ直して',
    href: '/dashboard/visual-prompt',
  },
];

const flowSteps = [
  { no:'01', label:'CAPTURE', title:'残す', detail:'思いつき・体験・違和感', href:'/mind?action=capture' },
  { no:'02', label:'THINK', title:'意味をつくる', detail:'FLOW MIND / Intelligence', href:'/mind' },
  { no:'03', label:'SHIP', title:'外へ流す', detail:'X / LINE / ACE', href:'#output' },
  { no:'04', label:'LEARN', title:'反応を戻す', detail:'Evidence / Review', href:'/dashboard/evidence' },
];

const deepDoors = [
  { group:'THINK', title:'Living Graph', detail:'知識・Project・関係を見る', href:'/dashboard/graph' },
  { group:'THINK', title:'Intelligence', detail:'外部情報を選別する', href:'/dashboard/intelligence' },
  { group:'LEARN', title:'Evidence Lab', detail:'結果を学習へ戻す', href:'/dashboard/evidence' },
  { group:'DECIDE', title:'Choice Lab', detail:'横断判断が必要な時だけ', href:'/dashboard/choice-lab' },
  { group:'CREATE', title:'X Post', detail:'投稿を編集・確認する', href:'/dashboard/post' },
  { group:'CREATE', title:'Visual Prompt', detail:'画像・映像の指示へ変換', href:'/dashboard/visual-prompt' },
  { group:'BUILD', title:'Quest', detail:'実践できる形へ変換', href:'/dashboard/quest' },
  { group:'SYSTEM', title:'MASA OS', detail:'Project / 正本の詳細へ', href:'/dashboard/os' },
];
---

<DashboardLayout title="今日" eyebrow="DAILY COMMAND CENTER">
  <div class="dash-shell">
    <header class="dash-head">
      <div>
        <p class="kicker">MASA OS · TODAY</p>
        <h1>Flow Cockpit</h1>
        <p class="intro">左は全体の地図。ここには、今日触るものだけ置く。見る → 軽く動かす → 必要な時だけ詳細へ。</p>
      </div>
      <div class="date-chip"><span>TODAY</span><strong>{dateLabel}</strong></div>
    </header>

    <DashboardCockpit client:load />

    <section class="radar-section" aria-labelledby="radar-title">
      <div class="section-head">
        <div><p class="kicker">DESIGN RADAR · NEW CAPABILITY</p><h2 id="radar-title">「今なら、これできる」が見える。</h2></div>
        <p>新技術を知識で終わらせず、MASAの使い道へ翻訳して最大5件だけ浮上。</p>
      </div>
      <div class="radar-grid">
        {designOpportunities.map(item => (
          <a class="radar-card" href={item.href}>
            <div class="radar-top"><span class="new-badge">{item.status}</span><small>{item.principle}</small></div>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
            <div class="use-tags" aria-label="使いどころ">
              {item.uses.map(use => <span>{use}</span>)}
            </div>
            <div class="command-row"><small>一言</small><strong>「{item.command}」</strong><b aria-hidden="true">→</b></div>
          </a>
        ))}
      </div>
      <p class="radar-rule">CAPABILITY → OPPORTUNITY → PROJECT → REAL USE → KEEP / PROMOTE / DROP</p>
    </section>

    <section class="flow-section" aria-labelledby="flow-title">
      <div class="section-head">
        <div><p class="kicker">FLOW</p><h2 id="flow-title">流れを見失った時だけ、ここへ戻る。</h2></div>
        <p>Dashboardを読むための説明ではなく、循環の地図。</p>
      </div>
      <div class="flow-track">
        {flowSteps.map((step, index) => (
          <a href={step.href} class="flow-step">
            <span class="no">{step.no}</span>
            <div><small>{step.label}</small><strong>{step.title}</strong><em>{step.detail}</em></div>
            {index < flowSteps.length - 1 && <b aria-hidden="true">→</b>}
          </a>
        ))}
      </div>
    </section>

    <section class="output-section" id="output" aria-labelledby="output-title">
      <div class="section-head">
        <div><p class="kicker">OUTPUT</p><h2 id="output-title">外へ流す。</h2></div>
        <p>細かい制作・公開は各ページへ。公開はHuman Gate。</p>
      </div>
      <div class="output-grid">
        <a class="output-card dark" href="/dashboard/post"><span>X</span><div><strong>X / Social</strong><small>仮説・体験・問いを出す</small></div><b>→</b></a>
        <a class="output-card green" href="/dashboard/line"><span>L</span><div><strong>LINE Flow</strong><small>教育・関係・顧客導線を動かす</small></div><b>→</b></a>
        <a class="output-card blue" href="/dashboard/ace-assets"><span>A</span><div><strong>ACE Assets</strong><small>学びを教材へ変換</small></div><b>→</b></a>
      </div>
    </section>

    <details class="deep-section">
      <summary><span><b>MORE / DEEP WORK</b> 詳細に入りたい時だけ開く</span><em>＋</em></summary>
      <div class="deep-grid">
        {deepDoors.map(item => (
          <a href={item.href}><small>{item.group}</small><strong>{item.title}</strong><span>{item.detail}</span><b>↗</b></a>
        ))}
      </div>
    </details>

    <footer class="dash-foot"><p>Dashboard Cockpit v0.1</p><span>Projectを見れば済むことは質問にしない。UI配置はoverlay、正本変更は既存Gateを維持。</span></footer>
  </div>
</DashboardLayout>

<style>
  .dash-shell{--panel:#fff;--muted:#68717b;--hairline:#e3e0db;max-width:1240px;margin:0 auto;padding-bottom:42px}
  .kicker{margin:0;color:var(--gold-muted);font-size:.72rem;letter-spacing:.12em;font-weight:800}
  .dash-head{display:flex;align-items:flex-end;justify-content:space-between;gap:26px;margin-bottom:6px}
  .dash-head h1{margin-top:3px;font-size:clamp(2rem,4vw,3.4rem);line-height:1;letter-spacing:-.035em}
  .intro{max-width:760px;margin-top:9px;color:var(--muted);font-size:.96rem;line-height:1.7}
  .date-chip{flex-shrink:0;min-width:170px;padding:13px 15px;border:1px solid var(--hairline);border-radius:16px;background:rgba(255,255,255,.74);box-shadow:0 8px 24px rgba(52,47,41,.035)}
  .date-chip span,.date-chip strong{display:block}.date-chip span{color:#959ca4;font-size:.7rem;letter-spacing:.12em;font-weight:800}.date-chip strong{margin-top:3px;font-size:.95rem}
  .radar-section,.flow-section,.output-section{margin-top:24px;padding:22px;border:1px solid var(--hairline);border-radius:20px;background:rgba(255,255,255,.72)}
  .radar-section{background:linear-gradient(145deg,rgba(255,255,255,.9),rgba(248,244,237,.82));border-color:#d8cdbd}
  .section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px}.section-head h2{margin-top:3px;font-size:1.05rem}.section-head>p{max-width:460px;color:#7c858e;font-size:.75rem;line-height:1.55;text-align:right}
  .radar-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px;margin-top:16px}.radar-card{display:block;padding:18px;border:1px solid #ddd2c2;border-radius:16px;background:#fff;color:inherit;text-decoration:none;box-shadow:0 10px 28px rgba(60,48,35,.045)}.radar-card:hover{border-color:#b99d77}.radar-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.new-badge{padding:4px 7px;border-radius:999px;background:#20242a;color:#fff;font-size:.64rem;font-weight:800;letter-spacing:.08em}.radar-top small{color:#8b5b2c;font-size:.66rem;font-weight:800;letter-spacing:.06em}.radar-card h3{margin-top:13px;font-size:1.08rem}.radar-card>p{margin-top:7px;color:#68717b;font-size:.78rem;line-height:1.7}.use-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:12px}.use-tags span{padding:4px 7px;border:1px solid #e2ddd5;border-radius:999px;background:#faf8f5;color:#6f7881;font-size:.63rem}.command-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid #ece7e0}.command-row small{color:#92999f;font-size:.64rem}.command-row strong{font-size:.76rem}.command-row b{color:#9a641f}.radar-rule{margin:11px 2px 0;color:#8a9199;font-size:.65rem;letter-spacing:.045em}
  .flow-track{display:grid;grid-template-columns:repeat(4,1fr);margin-top:16px;border:1px solid #e5e1db;border-radius:14px;overflow:hidden;background:#fff}
  .flow-step{position:relative;min-width:0;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding:14px;text-decoration:none;border-right:1px solid #e8e4de}.flow-step:last-child{border-right:0}
  .flow-step .no{color:#b5a58f;font-family:'Cormorant Garamond',serif;font-size:1.25rem}.flow-step small,.flow-step strong,.flow-step em{display:block}.flow-step small{color:#8b5b2c;font-size:.64rem;letter-spacing:.1em;font-weight:800}.flow-step strong{margin-top:2px;font-size:.82rem}.flow-step em{margin-top:2px;color:#7c858e;font-size:.67rem;font-style:normal;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.flow-step>b{color:#c5bdb3;font-weight:500}
  .output-section{scroll-margin-top:90px}.output-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:15px}.output-card{min-height:92px;display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:12px;padding:14px;border:1px solid #dedbd6;border-radius:14px;background:#fff;text-decoration:none}.output-card>span{width:40px;height:40px;display:grid;place-items:center;border-radius:11px;color:#fff;background:#20242a;font-weight:900}.output-card.green>span{background:#2b8f65}.output-card.blue>span{background:#507fb6}.output-card strong,.output-card small{display:block}.output-card strong{font-size:.86rem}.output-card small{margin-top:2px;color:#7c858e;font-size:.7rem}.output-card>b{color:#a56c22}
  .deep-section{margin-top:16px;border:1px solid var(--hairline);border-radius:16px;background:rgba(255,255,255,.52);overflow:hidden}.deep-section>summary{min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 16px;cursor:pointer;list-style:none;color:#606a74;font-size:.76rem}.deep-section>summary::-webkit-details-marker{display:none}.deep-section>summary b{margin-right:9px;color:#8b5b2c;font-size:.68rem;letter-spacing:.1em}.deep-section[open]>summary em{transform:rotate(45deg)}.deep-section>summary em{font-size:1rem;font-style:normal}.deep-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid #e5e1db}.deep-grid a{position:relative;min-height:108px;padding:14px;border-right:1px solid #e8e4de;border-bottom:1px solid #e8e4de;text-decoration:none}.deep-grid a:nth-child(4n){border-right:0}.deep-grid small,.deep-grid strong,.deep-grid span{display:block}.deep-grid small{color:#8b5b2c;font-size:.62rem;letter-spacing:.09em;font-weight:800}.deep-grid strong{margin-top:7px;font-size:.82rem}.deep-grid span{margin-top:3px;color:#7c858e;font-size:.68rem}.deep-grid a>b{position:absolute;right:13px;top:12px;color:#b79c75;font-weight:500}
  .dash-foot{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:20px;padding-top:14px;border-top:1px solid #dedad4;color:#8a9199;font-size:.68rem}
  @media(max-width:900px){.flow-track{grid-template-columns:repeat(2,1fr)}.flow-step:nth-child(2){border-right:0}.output-grid{grid-template-columns:1fr}.deep-grid{grid-template-columns:repeat(2,1fr)}.deep-grid a:nth-child(2n){border-right:0}}
  @media(max-width:620px){.dash-head,.section-head{align-items:flex-start;flex-direction:column}.date-chip{min-width:0;width:100%}.radar-section,.flow-section,.output-section{padding:16px}.section-head>p{max-width:100%;text-align:left}.flow-track,.deep-grid{grid-template-columns:1fr}.flow-step{border-right:0;border-bottom:1px solid #e8e4de}.flow-step:last-child{border-bottom:0}.deep-grid a{border-right:0}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
</style>
