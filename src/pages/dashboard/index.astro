---
const masaOsUrl = 'https://masa-os-dashboard.pages.dev/';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <meta http-equiv="refresh" content={`0;url=${masaOsUrl}`} />
    <title>MASA OSへ移動します</title>
  </head>
  <body>
    <main>
      <p>MASA OSへ統合しました。</p>
      <a href={masaOsUrl}>MASA OSを開く →</a>
    </main>
    <script is:inline define:vars={{ masaOsUrl }}>
      window.location.replace(masaOsUrl);
    </script>
  </body>
</html>

<style>
  :global(html) { background:#0f0d0b; color:#f2e8da; font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  body { margin:0; min-height:100vh; display:grid; place-items:center; }
  main { text-align:center; padding:32px; }
  p { color:#a89c90; }
  a { display:inline-block; margin-top:12px; color:#d3b88d; text-decoration:none; border:1px solid rgba(211,184,141,.25); border-radius:999px; padding:12px 18px; }
</style>
