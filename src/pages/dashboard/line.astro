---
import CopyOsReference from '../../components/dashboard/CopyOsReference.astro';
import LineFlowAssistant from '../../components/dashboard/LineFlowAssistant';
import LineFlowManagerV2 from '../../components/dashboard/LineFlowManagerV2';
import '../../styles/masa-readable.css';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#f3f1ed" />
    <title>LINE Flow — MASA OS</title>
  </head>
  <body>
    <nav class="flow-context" aria-label="LINE Control Plane context">
      <a class="flow-primary" href="/dashboard/lian">← PRIMARY / リアン</a>
      <span>FLOW BUILDER</span>
      <div>
        <a href="/dashboard/knowledge">Knowledge</a>
        <a href="/dashboard/graph">Graph</a>
      </div>
    </nav>
    <div class="copy-os-wrap"><CopyOsReference surface="LINE" /></div>
    <LineFlowAssistant client:load />
    <LineFlowManagerV2 client:load />
    <script is:inline src="/scripts/line-flow-asset-bridge.js"></script>
    <script is:inline src="/scripts/line-asset-library.js"></script>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    min-height: 100%;
    background: #f3f1ed;
    -webkit-text-size-adjust: 100%;
  }

  .flow-context {
    max-width: 1440px;
    margin: 0 auto;
    min-height: 44px;
    padding: 8px 22px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    align-items: center;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", "Noto Sans JP", system-ui, sans-serif;
    font-size: 13px;
    color: #625f59;
  }

  .flow-context > span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .1em;
    color: #8b5b2c;
  }

  .flow-context > div {
    justify-self: end;
    display: flex;
    gap: 6px;
  }

  .flow-context a {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    border: 1px solid #d8d2c9;
    border-radius: 8px;
    background: rgba(255,255,255,.78);
    color: #505b65;
    text-decoration: none;
  }

  .flow-context .flow-primary {
    justify-self: start;
    color: #744b18;
    font-weight: 700;
  }

  .copy-os-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 12px 22px 0;
  }

  body,
  .lf2 {
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "SF Pro Text",
      "Hiragino Sans",
      "Hiragino Kaku Gothic ProN",
      "Yu Gothic",
      "Noto Sans JP",
      system-ui,
      sans-serif !important;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "palt" 1;
  }

  .lf2 .metrics b,
  .lf2 .step-stat,
  .lf2 .badge,
  .lf2 input[type="number"],
  .lf2 input[type="time"] {
    font-variant-numeric: tabular-nums;
  }

  .lf2 button,
  .lf2 select,
  .lf2 input,
  .lf2 textarea {
    font: inherit;
  }

  .lf2 button,
  .lf2 select {
    touch-action: manipulation;
  }

  /* readability floor for dense builder chrome */
  .lf2 .step-copy > b { font-size: 14px !important; line-height: 1.62 !important; }
  .lf2 .step-copy > small,
  .lf2 .step-stat,
  .lf2 .badge,
  .lf2 .eyebrow,
  .lf2 .hint { font-size: 12px !important; line-height: 1.55 !important; }

  @media (max-width: 760px) {
    .flow-context {
      padding: 8px 14px 0;
      grid-template-columns: 1fr auto;
      font-size: 13px;
    }

    .flow-context > span { display: none; }
    .flow-context > div { gap: 4px; }
    .flow-context a { min-height: 40px; padding: 0 9px; }

    .copy-os-wrap {
      padding: 10px 14px 0;
    }

    .lf2 .top-actions button,
    .lf2 .top-actions select,
    .lf2 .inspect-actions button,
    .lf2 .save,
    .lf2 .mini-add {
      min-height: 44px;
    }

    .lf2 .step {
      grid-template-columns: 40px minmax(0, 1fr) 82px !important;
    }

    .lf2 .handle {
      min-width: 40px;
      min-height: 44px;
      touch-action: none;
    }

    .lf2 .step-copy > b {
      font-size: 14px !important;
      line-height: 1.62 !important;
    }

    .lf2 textarea,
    .lf2 input,
    .lf2 select {
      font-size: 16px !important;
    }
  }
</style>
