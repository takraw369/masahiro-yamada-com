---
import CopyOsReference from '../../components/dashboard/CopyOsReference.astro';
import LineFlowManagerV2 from '../../components/dashboard/LineFlowManagerV2';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>LINE Flow — MASA OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="copy-os-wrap"><CopyOsReference surface="LINE" /></div>
    <LineFlowManagerV2 client:load />
  </body>
</html>

<style is:global>
  html, body { margin: 0; min-height: 100%; background: #f3f1ed; }
  .copy-os-wrap { max-width: 1440px; margin: 0 auto; padding: 12px 22px 0; font-family: 'Zen Kaku Gothic New', sans-serif; }
</style>
