---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="ACE Evidence Lab">
  <div class="evidence-shell">
    <header class="hero">
      <div>
        <div class="eyebrow">THEORY → PRACTICE → EVIDENCE → THEORY 2.0</div>
        <h1>ACE Evidence Lab</h1>
        <p>現場の気づき、記事、研究、AIが拾った候補を一つの受け皿へ。生データはSupabase、意味が確定した知識だけDrive正本へ昇格させる。</p>
      </div>
      <div class="canonical">PRIMARY<br /><strong>MASA OS / Evidence</strong></div>
    </header>

    <div id="evidence-error" class="error" hidden></div>

    <section class="metrics" id="evidence-metrics">
      <div class="metric"><span>INBOX</span><strong>—</strong><small>未整理</small></div>
      <div class="metric"><span>FIELD</span><strong>—</strong><small>現場由来</small></div>
      <div class="metric"><span>SCOUT</span><strong>—</strong><small>AI / Web / Research</small></div>
      <div class="metric"><span>CANONICAL</span><strong>—</strong><small>Drive昇格</small></div>
    </section>

    <section class="panel intake-panel">
      <div class="panel-head">
        <div><div class="eyebrow">CAPTURE</div><h2>気づきを入れる</h2></div>
        <span>雑でOK。あとから整理する。</span>
      </div>
      <form id="evidence-form" class="intake-form">
        <label class="wide">タイトル<input name="title" required maxlength="400" placeholder="例：1v1で選択肢を増やすと判断が止まった" /></label>
        <label class="wide">本文<textarea name="body" required maxlength="12000" placeholder="何が起きた？ 何を変えた？ 選手はどう反応した？ 記事URLだけでもOK。"></textarea></label>
        <label>入口<select name="sourceKind"><option value="field">現場</option><option value="manual" selected>メモ</option><option value="voice">音声</option><option value="web">Web</option><option value="research">研究</option><option value="ai_scout">AI Scout</option></select></label>
        <label>種類<select name="evidenceType"><option value="observation">観察</option><option value="case">Case</option><option value="research">研究</option><option value="article">記事</option><option value="idea">仮説</option><option value="counterexample">反例</option></select></label>
        <label>Phase<select name="learningPhase"><option value="unclassified">未分類</option><option value="pattern">PATTERN</option><option value="perception">PERCEPTION</option><option value="choice">CHOICE</option><option value="adaptation">ADAPTATION</option><option value="creation">CREATION</option><option value="mixed">MIXED</option></select></label>
        <label>競技<input name="sport" placeholder="サッカー / セパタクロー" /></label>
        <label>年齢・層<input name="ageBand" placeholder="U12 / 高校 / Elite" /></label>
        <label class="wide">出典URL<input name="sourceUrl" type="url" placeholder="https://..." /></label>
        <label class="wide">ACEとの接続<input name="aceConnection" placeholder="Self-Compass / Adaptive Athlete Learning Loop など" /></label>
        <label class="wide">タグ<input name="tags" placeholder="decision-making, constraints, parent-coaching" /></label>
        <div class="submit-row wide"><span id="submit-state"></span><button type="submit">Evidenceへ追加</button></div>
      </form>
    </section>

    <section class="filters">
      <input id="evidence-query" type="search" placeholder="タイトル・本文・競技・ACE接続を検索" />
      <select id="evidence-source"><option value="all">全入口</option><option value="field">現場</option><option value="manual">メモ</option><option value="voice">音声</option><option value="web">Web</option><option value="research">研究</option><option value="ai_scout">AI Scout</option></select>
      <select id="evidence-phase"><option value="all">全Phase</option><option value="pattern">PATTERN</option><option value="perception">PERCEPTION</option><option value="choice">CHOICE</option><option value="adaptation">ADAPTATION</option><option value="creation">CREATION</option><option value="mixed">MIXED</option><option value="unclassified">未分類</option></select>
      <select id="evidence-status"><option value="all">全状態</option><option value="inbox">INBOX</option><option value="reviewing">検討中</option><option value="validated">検証済み</option><option value="canonical">正本化</option><option value="dismissed">見送り</option></select>
      <div id="evidence-count" class="count">—</div>
    </section>

    <div id="evidence-selection" class="selection-notice" role="status" hidden></div>
    <section id="evidence-list" class="evidence-list"><div class="empty">Evidenceを読み込み中…</div></section>
  </div>

  <style>
    .evidence-shell{max-width:1180px;margin:0 auto}.hero{display:flex;justify-content:space-between;align-items:flex-start;gap:28px;margin-bottom:24px}.eyebrow{font-size:.68rem;letter-spacing:.2em;color:var(--gold-pure);font-weight:500}.hero h1,.panel-head h2{font-family:'Cormorant Garamond',serif;font-weight:400}.hero h1{font-size:3rem;margin-top:4px}.hero p{max-width:740px;color:var(--text-muted);line-height:1.8;margin-top:8px}.canonical{border:1px solid var(--border-accent);background:var(--gold-glow);padding:12px 14px;font-size:.68rem;color:var(--text-muted);line-height:1.6;text-align:right}.canonical strong{color:var(--gold-pure);font-weight:400}.error{border:1px solid rgba(220,80,80,.35);background:rgba(180,50,50,.08);padding:12px 14px;margin-bottom:16px;color:#dba8a0;font-size:.82rem}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.metric,.panel,.evidence-card{border:1px solid var(--border-default);background:var(--bg-surface)}.metric{padding:18px}.metric span{display:block;font-size:.65rem;letter-spacing:.18em;color:var(--gold-muted)}.metric strong{display:block;font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:400;margin-top:4px}.metric small{color:var(--text-muted);font-size:.7rem}.panel{padding:20px;margin-bottom:14px}.panel-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:14px}.panel-head h2{font-size:1.55rem;margin-top:4px}.panel-head>span{font-size:.68rem;color:var(--text-dim)}.intake-form{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.intake-form label,.edit-grid label,.notes label{display:grid;gap:5px;font-size:.65rem;letter-spacing:.06em;color:var(--text-muted)}.wide{grid-column:1/-1}.intake-form input,.intake-form textarea,.intake-form select,.filters input,.filters select,.evidence-card input,.evidence-card select,.evidence-card textarea{background:var(--bg-elevated);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:10px 11px;outline:none}.intake-form textarea{min-height:105px;resize:vertical}.intake-form input:focus,.intake-form textarea:focus,.intake-form select:focus,.filters input:focus,.filters select:focus,.evidence-card input:focus,.evidence-card select:focus,.evidence-card textarea:focus{border-color:var(--border-hover)}.submit-row{display:flex;justify-content:flex-end;align-items:center;gap:10px}.submit-row span,.save-state{font-size:.68rem;color:var(--text-dim)}button{font:inherit}.submit-row button,.save{border:1px solid var(--border-accent);background:var(--gold-glow);color:var(--gold-pure);padding:10px 15px;cursor:pointer}.submit-row button:disabled,.save:disabled{opacity:.45;cursor:wait}.filters{display:grid;grid-template-columns:minmax(220px,1fr) auto auto auto auto;gap:8px;border:1px solid var(--border-default);background:var(--bg-surface);padding:12px;margin-bottom:12px}.count{display:flex;align-items:center;color:var(--text-dim);font-size:.72rem;padding:0 6px}.evidence-list{display:grid;gap:10px}.evidence-card{padding:18px}.card-top{display:flex;justify-content:space-between;gap:18px}.tags{display:flex;flex-wrap:wrap;gap:6px}.tag{border:1px solid var(--border-default);padding:4px 7px;font-size:.62rem;color:var(--text-muted)}.tag.phase{border-color:var(--border-accent);color:var(--gold-pure);background:var(--gold-glow)}.card-title{font-size:1.05rem;margin-top:12px;font-weight:500}.card-body{font-size:.88rem;line-height:1.75;color:var(--text-primary);margin-top:8px;white-space:pre-wrap}.meta{font-size:.68rem;color:var(--text-dim);margin-top:8px;line-height:1.6}.source-link{color:var(--gold-muted);text-decoration:none}.source-link:hover{color:var(--gold-pure)}.edit-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid var(--border-default)}.notes{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.notes textarea{min-height:68px;resize:vertical}.save-row{display:flex;justify-content:flex-end;align-items:center;gap:10px;margin-top:9px}.empty{padding:22px;border:1px dashed var(--border-default);color:var(--text-dim);font-size:.8rem;text-align:center}
    .selection-notice{border:1px solid var(--border-accent);padding:12px 14px;margin-bottom:12px;font-size:.8rem;color:var(--text-muted)}
    .evidence-card{scroll-margin-top:24px}.evidence-card.is-selected{border-color:var(--gold-pure)}.evidence-card:focus{outline:2px solid var(--gold-pure);outline-offset:3px}
    .receipt-links{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:10px;font-size:.7rem}.copy-link{border:1px solid var(--border-default);background:var(--bg-elevated);color:var(--text-primary);padding:5px 8px;cursor:pointer}.link-state{color:var(--text-muted)}
    @media(max-width:900px){.metrics{grid-template-columns:repeat(2,1fr)}.intake-form{grid-template-columns:1fr 1fr}.filters{grid-template-columns:1fr 1fr}.filters input{grid-column:1/-1}.count{grid-column:1/-1}.edit-grid{grid-template-columns:1fr 1fr}.notes{grid-template-columns:1fr}.hero{display:block}.canonical{display:none}}
    @media(max-width:560px){.metrics,.intake-form,.edit-grid{grid-template-columns:1fr}.wide{grid-column:auto}.card-top{display:block}.card-top time{display:block;margin-top:8px}.hero h1{font-size:2.35rem}}
  </style>

  <script>
    type EvidenceItem = {
      id: string;
      title: string;
      body: string;
      sourceKind: string;
      sourceUrl: string | null;
      sport: string | null;
      ageBand: string | null;
      learningPhase: string;
      evidenceType: string;
      evidenceQuality: string;
      status: string;
      aceConnection: string | null;
      reviewNote: string | null;
      canonicalDriveUrl: string | null;
      tags: string[];
      createdAt: string;
    };
    const requiredElement = <T extends HTMLElement>(selector: string): T => {
      const element = document.querySelector<T>(selector);
      if (!element) throw new Error(`Missing Evidence Lab element: ${selector}`);
      return element;
    };
    const SOURCE_LABELS: Record<string, string>={manual:'メモ',field:'現場',voice:'音声',web:'Web',research:'研究',ai_scout:'AI Scout'};
    const STATUS_LABELS: Record<string, string>={inbox:'INBOX',reviewing:'検討中',validated:'検証済み',canonical:'正本化',dismissed:'見送り'};
    const PHASE_LABELS: Record<string, string>={pattern:'PATTERN',perception:'PERCEPTION',choice:'CHOICE',adaptation:'ADAPTATION',creation:'CREATION',mixed:'MIXED',unclassified:'未分類'};
    const QUALITY_LABELS: Record<string, string>={raw:'RAW',weak:'WEAK',medium:'MEDIUM',strong:'STRONG',canonical:'CANONICAL'};
    let items: EvidenceItem[]=[];
    const form=requiredElement<HTMLFormElement>('#evidence-form');
    const list=requiredElement<HTMLElement>('#evidence-list');
    const q=requiredElement<HTMLInputElement>('#evidence-query');
    const sourceFilter=requiredElement<HTMLSelectElement>('#evidence-source');
    const phaseFilter=requiredElement<HTMLSelectElement>('#evidence-phase');
    const statusFilter=requiredElement<HTMLSelectElement>('#evidence-status');
    const countEl=requiredElement<HTMLElement>('#evidence-count');
    const errorEl=requiredElement<HTMLElement>('#evidence-error');
    const submitState=requiredElement<HTMLElement>('#submit-state');
    const selectionNotice=requiredElement<HTMLElement>('#evidence-selection');
    const HTML_ENTITIES: Record<string, string>={'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'};
    const esc=(value: unknown='')=>String(value).replace(/[&<>'"]/g,c=>HTML_ENTITIES[c]??c);
    const fmt=(value: string)=>{try{return new Date(value).toLocaleString('ja-JP',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'});}catch{return '';}};
    const showError=(text: string)=>{errorEl.textContent=text;errorEl.hidden=!text;};
    const option=(value: string,label: string,current: string)=>`<option value="${esc(value)}" ${value===current?'selected':''}>${esc(label)}</option>`;

    function updateMetrics(){
      const values=[items.filter(x=>x.status==='inbox').length,items.filter(x=>x.sourceKind==='field').length,items.filter(x=>['ai_scout','web','research'].includes(x.sourceKind)).length,items.filter(x=>x.status==='canonical'||x.evidenceQuality==='canonical').length];
      document.querySelectorAll('#evidence-metrics strong').forEach((el,i)=>el.textContent=String(values[i]??0));
    }

    function filtered(){
      const needle=(q.value||'').trim().toLowerCase();
      return items.filter(x=>sourceFilter.value==='all'||x.sourceKind===sourceFilter.value)
        .filter(x=>phaseFilter.value==='all'||x.learningPhase===phaseFilter.value)
        .filter(x=>statusFilter.value==='all'||x.status===statusFilter.value)
        .filter(x=>!needle||[x.title,x.body,x.sport||'',x.ageBand||'',x.aceConnection||'',...(x.tags||[])].join(' ').toLowerCase().includes(needle));
    }

    const permalink=(id: string)=>`/dashboard/evidence#${encodeURIComponent(id)}`;

    function card(item: EvidenceItem){
      const sourceLink=item.sourceUrl?`<a class="source-link" href="${esc(item.sourceUrl)}" target="_blank" rel="noopener noreferrer">出典 ↗</a>`:'';
      const tags=(item.tags||[]).slice(0,6).map(t=>`<span class="tag">${esc(t)}</span>`).join('');
      return `<article class="evidence-card" id="${esc(item.id)}" data-id="${esc(item.id)}" tabindex="-1">
        <div class="card-top"><div class="tags"><span class="tag phase">${esc(PHASE_LABELS[item.learningPhase]||item.learningPhase)}</span><span class="tag">${esc(SOURCE_LABELS[item.sourceKind]||item.sourceKind)}</span><span class="tag">${esc(STATUS_LABELS[item.status]||item.status)}</span><span class="tag">${esc(QUALITY_LABELS[item.evidenceQuality]||item.evidenceQuality)}</span>${tags}</div><time class="meta">${esc(fmt(item.createdAt))}</time></div>
        <div class="card-title">${esc(item.title)}</div>
        <div class="card-body">${esc(item.body)}</div>
        <div class="meta">${esc(item.evidenceType)}${item.sport?` · ${esc(item.sport)}`:''}${item.ageBand?` · ${esc(item.ageBand)}`:''} ${sourceLink}</div>
        ${item.aceConnection?`<div class="meta">ACE → ${esc(item.aceConnection)}</div>`:''}
        <div class="receipt-links"><a class="source-link" href="${esc(permalink(item.id))}">記録リンク</a><button class="copy-link" type="button">リンクをコピー</button><span class="link-state" role="status"></span></div>
        <div class="edit-grid">
          <label>STATUS<select data-field="status">${Object.entries(STATUS_LABELS).map(([v,l])=>option(v,l,item.status)).join('')}</select></label>
          <label>PHASE<select data-field="learningPhase">${Object.entries(PHASE_LABELS).map(([v,l])=>option(v,l,item.learningPhase)).join('')}</select></label>
          <label>QUALITY<select data-field="evidenceQuality">${Object.entries(QUALITY_LABELS).map(([v,l])=>option(v,l,item.evidenceQuality)).join('')}</select></label>
          <label>SPORT<input data-field="sport" value="${esc(item.sport||'')}" /></label>
          <label>AGE<input data-field="ageBand" value="${esc(item.ageBand||'')}" /></label>
        </div>
        <div class="notes"><label>ACE CONNECTION<textarea data-field="aceConnection">${esc(item.aceConnection||'')}</textarea></label><label>REVIEW NOTE<textarea data-field="reviewNote">${esc(item.reviewNote||'')}</textarea></label></div>
        <div class="notes"><label>CANONICAL DRIVE URL<input data-field="canonicalDriveUrl" value="${esc(item.canonicalDriveUrl||'')}" placeholder="Drive正本化したらURL" /></label><div></div></div>
        <div class="save-row"><span class="save-state"></span><button class="save" type="button">保存</button></div>
      </article>`;
    }

    function followSelection(moveFocus: boolean){
      let id='';
      try{id=decodeURIComponent(window.location.hash.slice(1));}catch{id=window.location.hash.slice(1);}
      const cards=Array.from(list.querySelectorAll<HTMLElement>('.evidence-card'));
      const selected=cards.find(el=>el.dataset.id===id);
      cards.forEach(el=>el.classList.toggle('is-selected',el===selected));
      selectionNotice.hidden=!id||Boolean(selected);
      selectionNotice.textContent=!id||selected?'':items.some(item=>item.id===id)
        ?'指定されたEvidenceは現在の検索条件で非表示です。検索・絞り込み条件を解除すると表示できます。'
        :'指定されたEvidenceは読み込んだ一覧（最新300件まで）に見つかりません。古い記録や削除済みの記録、アクセス権の違いが考えられます。';
      if(selected&&moveFocus){selected.focus({preventScroll:true});selected.scrollIntoView({block:'start'});}
    }

    async function copyLink(el: HTMLElement){
      const state=el.querySelector<HTMLElement>('.link-state');
      if(!state||!el.dataset.id)return;
      try{await navigator.clipboard.writeText(new URL(permalink(el.dataset.id),window.location.origin).href);state.textContent='リンクをコピーしました';}
      catch{state.textContent='コピーできませんでした。「記録リンク」を右クリックしてリンクをコピーしてください。';}
    }

    function render(moveFocus=false){
      const shown=filtered(); countEl.textContent=`${shown.length} / ${items.length} EVIDENCE`;
      list.innerHTML=shown.length?shown.map(card).join(''):'<div class="empty">条件に合うEvidenceはありません。</div>';
      list.querySelectorAll<HTMLElement>('.evidence-card').forEach(el=>{
        el.querySelector('.save')?.addEventListener('click',()=>saveCard(el));
        el.querySelector('.copy-link')?.addEventListener('click',()=>copyLink(el));
      });
      followSelection(moveFocus);
    }

    async function load(){
      try{showError('');const res=await fetch('/api/dashboard/evidence',{cache:'no-store'});const data=await res.json();if(!res.ok||!data.ok)throw new Error(data.error||'load_failed');items=data.items||[];updateMetrics();render(true);}
      catch(error){showError(`Evidenceの読み込みに失敗: ${String(error)}`);list.innerHTML='<div class="empty">読み込みに失敗しました。</div>';}
    }

    async function saveCard(el: HTMLElement){
      const button=el.querySelector<HTMLButtonElement>('.save'),state=el.querySelector<HTMLElement>('.save-state');if(!button||!state)return;button.disabled=true;state.textContent='保存中…';
      const value=(field: string)=>el.querySelector<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>(`[data-field="${field}"]`)?.value??'';
      const patch={status:value('status'),learningPhase:value('learningPhase'),evidenceQuality:value('evidenceQuality'),sport:value('sport'),ageBand:value('ageBand'),aceConnection:value('aceConnection'),reviewNote:value('reviewNote'),canonicalDriveUrl:value('canonicalDriveUrl')};
      try{const res=await fetch('/api/dashboard/evidence',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:el.dataset.id,patch})});const data=await res.json();if(!res.ok||!data.ok)throw new Error(data.error||'save_failed');const i=items.findIndex(x=>x.id===data.item.id);if(i>=0)items[i]=data.item;state.textContent='保存済み';updateMetrics();render();}
      catch(error){state.textContent='保存失敗';showError(`保存に失敗: ${String(error)}`);button.disabled=false;}
    }

    form?.addEventListener('submit',async event=>{
      event.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');if(!button)return;button.disabled=true;submitState.textContent='追加中…';showError('');
      const fd=new FormData(form);const payload={...Object.fromEntries(fd.entries()),tags:String(fd.get('tags')||'').split(',').map(x=>x.trim()).filter(Boolean)};
      try{const res=await fetch('/api/dashboard/evidence',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();if(!res.ok||!data.ok)throw new Error(data.error||'create_failed');items.unshift(data.item);form.reset();requiredElement<HTMLSelectElement>('#evidence-form [name="sourceKind"]').value='manual';submitState.textContent='追加済み';updateMetrics();render();}
      catch(error){submitState.textContent='追加失敗';showError(`追加に失敗: ${String(error)}`);}finally{button.disabled=false;}
    });

    [q,sourceFilter,phaseFilter,statusFilter].forEach(el=>el.addEventListener(el===q?'input':'change',()=>render()));
    window.addEventListener('hashchange',()=>followSelection(true));
    load();
  </script>
</DashboardLayout>
