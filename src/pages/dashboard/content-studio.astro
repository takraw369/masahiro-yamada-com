---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Knowledge Studio" eyebrow="KNOW → CREATE → SELL">
 <div class="studio-shell">
  <section class="studio-intro"><div><p class="studio-kicker">KNOWLEDGE SHELF / STUDIO</p><h1>知っていることを、<br/>誰かの一歩に変える。</h1><p>テーマから素材を選ぶ。届く形に整える。教材と発信に育てる。</p></div><div class="studio-intro-links"><a href="/library">販売する棚を見る ↗</a><a href="/dashboard/content-flow">発信の流れへ ↗</a></div></section>
  <div class="studio-status" id="studio-status" role="status">元資料を読み込んでいます。</div>
  <section aria-labelledby="map-title">
   <div class="studio-section-head"><div><span>01 / DISCOVER</span><h2 id="map-title">どの知識を、いま使う？</h2></div><button type="button" class="studio-secondary" id="refresh-sources">最新の情報へ更新</button></div>
   <div class="studio-toolbar"><label>テーマ・単語<input id="source-query" type="search" placeholder="自信、習慣、FLOW、身体、動けない…"/></label><label>入口テーマ<select id="source-theme"><option value="">すべて</option><option value="FLOW">FLOW・集中</option><option value="ATHLETE">競技・アスリート</option><option value="HEALTH">身体・健康・食</option><option value="EDUCATION">教育・学び</option><option value="RELATION">人間関係・子育て</option><option value="AI">AI・創作</option><option value="PHILOSOPHY">哲学・生き方</option><option value="BUSINESS">事業・意思決定</option></select></label></div>
   <p class="studio-count" id="source-count" aria-live="polite"></p><div class="studio-source-grid" id="source-grid"></div>
   <button type="button" class="studio-secondary" id="more-sources" hidden>さらに素材を見る</button>
   <details class="studio-concepts"><summary>関連する知識・概念を読む</summary><div id="concept-list"></div></details>
  </section>
  <section id="create" aria-labelledby="create-title">
   <div class="studio-section-head"><div><span>02 / SHAPE</span><h2 id="create-title">読者の変化から、教材を組み立てる。</h2></div></div>
   <div id="selected-source" class="studio-selected">まず上から素材を選んでください。</div>
   <div class="studio-video-handoff">
    <div><strong>VIDEO / 試作へ渡す</strong><p>選んだDrive素材を、台本 → 5〜10秒の縦型T1プレビューへ。まず制作指示をコピーしてCodexで実行します。動画生成・公開はこのボタンだけでは行いません。</p></div>
    <button type="button" class="studio-secondary" id="copy-video-prototype" disabled>動画試作の指示をコピー</button>
   </div>
   <div class="studio-editor-grid"><form id="product-form">
    <div class="studio-two"><label>教材のタイトル<input name="title" maxlength="200" required placeholder="何ができるようになる教材？"/></label><label>公開ページの名前<input name="slug" pattern="[a-z0-9-]{2,80}" maxlength="80" required placeholder="例：a3-decision-flow"/></label></div>
    <label>届けたい相手<input name="audience" maxlength="500" placeholder="いま、どんなことで止まっている人？"/></label>
    <label>持ち帰ってほしい変化<textarea name="summary" rows="2" maxlength="2000" required placeholder="読む前と後で、何を選べる・試せるようになる？"></textarea></label>
    <label>元資料から使う核<textarea name="core" rows="3" placeholder="元資料を読んで残したい考え方・本人の経験・問いを入れる"></textarea></label>
    <div class="studio-two"><label>読者が今日試す一手<input name="practice" maxlength="1000" placeholder="3分・1回・1つ、から始められる行動"/></label><label>予定価格（円）<input name="priceYen" type="number" min="0" max="1000000" step="1" value="0" required/></label></div>
    <div class="studio-editor-actions"><button class="studio-primary" id="make-outline" type="button">この核から構成を作る</button><button class="studio-secondary" id="copy-ai-brief" type="button">洗練用のAI指示をコピー</button></div>
    <label>教材の原稿<textarea id="product-body" name="body" rows="16" maxlength="100000" placeholder="見出し・説明・実践・振り返りを編集。構成を作るとここへ入ります。"></textarea></label>
    <div class="studio-editor-actions"><button class="studio-primary" type="submit">教材の下書きを保存</button><button class="studio-secondary" id="download-draft" type="button">原稿を書き出す</button><button class="studio-secondary" id="new-product" type="button">新しい教材を作る</button></div>
    <p class="studio-note">保存先は制作中の教材です。保存だけでは販売・公開されません。</p>
   </form><aside class="studio-reader"><div class="studio-reader-label">READING PREVIEW</div><h3 id="preview-title">読む人の画面</h3><div id="body-preview"><p>原稿を整えると、ここで読み心地を確認できます。</p></div></aside></div>
  </section>
  <section aria-labelledby="products-title"><div class="studio-section-head"><div><span>03 / RELEASE</span><h2 id="products-title">育てている教材</h2></div></div><div id="product-list">保存した教材がここに並びます。</div><div class="studio-release-flow"><span>下書きの確認</span><span>販売条件を決める</span><span>決済 → 鍵 → 教材</span><span>使われた結果で更新</span></div></section>
 </div>
</DashboardLayout>
<script>
 import { renderProtectedMarkdown } from '../../lib/knowledgeShelf';
 type Asset={id:string;title:string;genre:string;target:string;next:string;source_url:string|null;status:string;project:string;format:string;rights:string};
 type Concept={id:string;title:string;domain:string;summary:string;status:string;visibility:string;sources:{title:string;url:string}[]};
 type Product={slug:string;title:string;summary:string;body:string;source_asset_id:string|null;version:number;price_jpy:number;status:string};
 type Snapshot={assets:Asset[];knowledge:Concept[];products:Product[];captured_at:string};
 const byId=(id:string)=>document.getElementById(id),form=byId('product-form') as HTMLFormElement,bodyInput=byId('product-body') as HTMLTextAreaElement,queryInput=byId('source-query') as HTMLInputElement,themeInput=byId('source-theme') as HTMLSelectElement;
 let snapshot:Snapshot|null=null,selected:Asset|null=null,currentSlug='',currentVersion:number|null=null,visible=12,loading=false,dirty=false;
 const node=(tag:string,text?:string,cls?:string)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e;};
 const value=(name:string)=>String(new FormData(form).get(name)||'').trim();
 const setValue=(name:string,text:string)=>{const input=form.elements.namedItem(name);if(input instanceof HTMLInputElement||input instanceof HTMLTextAreaElement)input.value=text;};
 const safeUrl=(url:unknown)=>{try{return typeof url==='string'&&new URL(url).protocol==='https:';}catch{return false;}};
 const status=(text:string)=>{const e=byId('studio-status');if(e)e.textContent=text;};
 function choose(asset:Asset){
  if(bodyInput.value.trim()&&asset.id!==selected?.id){status('原稿と出典を保持しています。別の教材を作る場合は、保存・書き出しの後に「新しい教材を作る」を選んでください。');return;}
  selected=asset;drawSelected();
  if(!dirty&&!bodyInput.value){setValue('title',asset.title.replace(/^(?:C\d+｜|READY｜|EXAMPLE｜|SEED｜)/,'').replace(/\s*[0-9]{4}-[0-9]{2}-[0-9]{2}$/,''));setValue('audience',asset.target||'');setValue('slug','asset-'+asset.id.toLowerCase().replace(/_/g,'-'));}
  drawSources();
 }
 function drawSelected(){const video=byId('copy-video-prototype') as HTMLButtonElement|null;if(video)video.disabled=!selected;const panel=byId('selected-source');if(!panel)return;const asset=selected;if(!asset){panel.textContent='まず上から素材を選んでください。';return;}panel.replaceChildren(node('strong',asset.id+' / '+asset.title),node('p',asset.target||'読者はこれから選ぶ'));
  if(safeUrl(asset.source_url)){const link=node('a','元資料を開いて確認する ↗') as HTMLAnchorElement;link.href=asset.source_url!;link.target='_blank';link.rel='noopener noreferrer';panel.append(link);}if(asset.rights)panel.append(node('p',asset.rights,'studio-note'));
 }
 function searchable(a:Asset){return [a.id,a.title,a.genre,a.target,a.next,a.project,a.format].join(' ').normalize('NFKC').toLowerCase();}
 const themeWords:Record<string,string[]>={FLOW:['flow','集中','zone'],ATHLETE:['athlete','競技','sports'],HEALTH:['health','body','身体','食','睡眠'],EDUCATION:['education','教育','学習','学び'],RELATION:['relation','関係','parenting','子育て','親子'],AI:['ai_','ai ','ai｜','ai・','aiと','automation','創作'],PHILOSOPHY:['philosophy','哲学','思想'],BUSINESS:['business','事業','意思決定']};
 function drawSources(){
  if(!snapshot)return;const words=queryInput.value.normalize('NFKC').toLowerCase().split(/\s+/).filter(Boolean),theme=themeInput.value;
  const assets=snapshot.assets.filter(a=>{const text=searchable(a);return words.every(w=>text.includes(w))&&(!theme||(themeWords[theme]||[]).some(w=>text.includes(w)));});
  const grid=byId('source-grid');if(!grid)return;grid.replaceChildren();const count=byId('source-count');if(count)count.textContent=`${assets.length}件の素材 / 全${snapshot.assets.length}件 · ${snapshot.knowledge.length}件の知識`;
  for(const a of assets.slice(0,visible)){const button=node('button',undefined,'studio-source') as HTMLButtonElement;button.type='button';button.setAttribute('aria-pressed',String(a.id===selected?.id));button.append(node('span',a.id+' / '+(a.genre||'未分類'),'studio-source-meta'),node('strong',a.title),node('span',a.target||'届けたい相手を決める','studio-source-audience'));button.addEventListener('click',()=>choose(a));grid.append(button);}
  if(!assets.length)grid.append(node('p','この言葉ではまだ素材が見つかりません。テーマを広げるか、元資料の接続を見直します。','studio-note'));const more=byId('more-sources');if(more)more.hidden=assets.length<=visible;
  const concepts=byId('concept-list');if(concepts){concepts.replaceChildren();const matches=snapshot.knowledge.filter(k=>words.every(w=>[k.title,k.domain,k.summary].join(' ').toLowerCase().includes(w))).slice(0,20);
   for(const k of matches){const d=node('details');d.append(node('summary',k.title),node('p',k.summary),node('p',(k.visibility==='private'?'非公開の制作素材 / ':'')+k.status,'studio-note'));for(const s of k.sources){if(!safeUrl(s.url))continue;const p=node('p'),link=node('a',s.title+' ↗') as HTMLAnchorElement;link.href=s.url;link.target='_blank';link.rel='noopener noreferrer';p.append(link);d.append(p);}const use=node('button','この概念を核に使う','studio-secondary') as HTMLButtonElement;use.type='button';use.addEventListener('click',()=>{setValue('core',k.summary);dirty=true;status('核を原稿の設計欄へ入れました。元資料を確認して整えてください。');});d.append(use);concepts.append(d);}}
 }
 function preview(){const title=byId('preview-title'),container=byId('body-preview');if(title)title.textContent=value('title')||'読む人の画面';if(container)container.innerHTML=renderProtectedMarkdown(bodyInput.value)||'<p>原稿を整えると、ここで読み心地を確認できます。</p>';}
 function drawProducts(){const list=byId('product-list');if(!list||!snapshot)return;list.replaceChildren();if(!snapshot.products.length){list.append(node('p','まだ教材の下書きはありません。まず一つの核から組み立てます。','studio-note'));return;}
  for(const p of snapshot.products){const item=node('div',undefined,'studio-product');item.append(node('strong',p.title),node('span',`${p.status==='live'?'公開中':'下書き'} / v${p.version} / 予定${p.price_jpy.toLocaleString('ja-JP')}円`));const button=node('button','原稿を編集','studio-secondary') as HTMLButtonElement;button.type='button';button.addEventListener('click',()=>{if(dirty){status('編集中の内容を先に保存または書き出してください。原稿を上書きしていません。');return;}currentSlug=p.slug;currentVersion=p.version;selected=snapshot!.assets.find(a=>a.id===p.source_asset_id)||null;setValue('slug',p.slug);setValue('title',p.title);setValue('summary',p.summary);setValue('priceYen',String(p.price_jpy));bodyInput.value=p.body;setValue('audience',selected?.target||'');setValue('core','');setValue('practice','');drawSelected();drawSources();preview();status('保存済みの原稿を開きました。');});item.append(button);if(p.status==='live'){const link=node('a','販売ページへ ↗') as HTMLAnchorElement;link.href='/library/'+p.slug;item.append(link);}list.append(item);}
 }
 async function refresh(){if(loading)return;loading=true;const button=byId('refresh-sources') as HTMLButtonElement;button.disabled=true;try{const response=await fetch('/api/dashboard/content-studio',{credentials:'same-origin'});const data=await response.json();if(!response.ok||!data.ok)throw new Error('read_failed');snapshot=data.data;drawSources();drawProducts();status('元資料と教材を更新しました。編集中の原稿は保持しています。');}catch{status(snapshot?'更新に接続できません。最後に読み取った情報を表示しています。':'元資料へ接続できません。ログイン状態と接続を確認してください。');}finally{loading=false;button.disabled=false;}}
 queryInput.addEventListener('input',()=>{visible=12;drawSources();});themeInput.addEventListener('change',()=>{visible=12;drawSources();});byId('more-sources')?.addEventListener('click',()=>{visible+=12;drawSources();});byId('refresh-sources')?.addEventListener('click',refresh);
 byId('make-outline')?.addEventListener('click',()=>{if(bodyInput.value.trim()){status('原稿が入っています。構成を作り直す場合は、先に保存・書き出しして原稿欄を空にしてください。');return;}const core=value('core'),summary=value('summary');if(!core||!summary){status('読者に届ける変化と、元資料から使う核を先に入れてください。');return;}
  bodyInput.value=`# ${value('title')||'教材のタイトル'}\n\n## この教材で持ち帰ること\n${summary}\n\n## こんなときに使う\n${value('audience')||'読者の現在地を記入'}\n\n## 核となる考え方\n${core}\n\n## 自分の状況に当てはめる\nいま起きていることを、事実・解釈・選べることに分けて書き出します。\n\n## 今日の小さな実践\n${value('practice')||'今日、一つだけ試す行動を決めます。'}\n\n## 振り返り\n何を試したか。何が起きたか。次は何を変えるか。\n\n## 次の一歩\nこの教材で残った問いを一つ書き、次に試す場面を選びます。`;dirty=true;preview();status('入力した核から構成の下書きを作りました。説明・実例・出典を確認して洗練させてください。');
 });
 byId('copy-ai-brief')?.addEventListener('click',async()=>{const prompt=`次の元資料に基づいて教材を洗練してください。対象：${value('audience')}。持ち帰る変化：${value('summary')}。元資料：${selected?.source_url||'下記の核'}。核：${value('core')}。現稿：${bodyInput.value}。事実と提案を分け、未確認の本人経験・科学的効果・成果を創作せず、説明→具体例→実践→振り返りを整えてください。購入者用の本文だけを作り、内部編集メモは含めないでください。`;try{await navigator.clipboard.writeText(prompt);status('洗練用の指示をコピーしました。');}catch{status('コピーできません。ブラウザのクリップボード権限を確認してください。');}});
 byId('copy-video-prototype')?.addEventListener('click',async()=>{
  if(!selected){status('まず動画にする元資料を選んでください。');return;}
  const lines=[
    'MASA既存VIDEO EDUCATION OS / Gift Content Engine / FLOW_VIDEO_ENGINEを使い、以下の元資料を縦型30秒教育動画へ変換する。',
    '新規Video OS / Repo / Dashboardは作らない。まず5〜10秒のT1プレビューまで実際に実行し、結果を返す。',
    '## Selected Source',
    'Asset ID: '+selected.id,
    'Title: '+selected.title,
    'Source URL: '+(selected.source_url||'未設定。CONTENT_OSからIDで解決すること'),
    'Rights metadata: '+(selected.rights||'未確認。必ず確認してから素材化'),
    'Audience: '+(value('audience')||selected.target||'原典から定義'),
    'Desired transformation: '+(value('summary')||'原典を読んで1つに絞る'),
    'Core/notes: '+(value('core')||'原典から抽出。体験・科学的根拠を創作しない'),
    '## Gate and execution',
    '1. Source Gate: Drive正本を実際に取得し、出典・権利・事実と仮説・個人経験を分離。無断で外部へ共有しない。',
    '2. Script Gate: Hook → Question → Evidence/Experience → Reframe → Quest。1動画1変化。セリフより先に画面上の比較・動線を設計。',
    '3. Reference-to-Original: イラスト、人物、音声、台詞、固有ストーリーはコピーしない。字幕の階層、カット、テンポ、A/B比較、微動の考え方だけ抽象化。',
    '4. GiftContentSpec を保存し、既存 packer で scenes.json 等に変換。',
    "5. 初回 T1: python3 scripts/render_gift_video.py <pack> --aspect '9:16' --preview-seconds 8 --tts none。既存 scripts/gift_video_preview_selftest.py の検証も確認する。",
    '6. T1 MP4、台本、実行receipt、未解決事項、次の最小修正だけ報告。T2の本制作・公開は許可なく実行しない。',
    'Project: takraw369/masa-automation / GitHub PR #234（未統合ならfeature branchで検証）',
    'Human Gate: 事実、本人の意図、権利、字幕、ブランド、最終公開。公開・有料API・大量GPU処理は必ず明示承認。',
  ];
  try{await navigator.clipboard.writeText(lines.join('\n'));status('選択素材に紐づくT1動画試作指示をコピーしました。Codexへ貼って制作できます。動画そのものはまだ生成されていません。');}
  catch{status('指示をコピーできませんでした。ブラウザのクリップボード権限を確認してください。');}
 });
 byId('download-draft')?.addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([bodyInput.value],{type:'text/markdown;charset=utf-8'})),link=document.createElement('a');link.href=url;link.download=(value('slug')||'knowledge-draft')+'.md';link.click();URL.revokeObjectURL(url);});
 byId('new-product')?.addEventListener('click',()=>{if(dirty){status('いまの原稿を先に保存または書き出してください。原稿は保持しています。');return;}form.reset();selected=null;currentSlug='';currentVersion=null;drawSelected();preview();drawSources();status('新しい教材の制作を始められます。');});
 form.addEventListener('input',()=>{dirty=true;preview();});
 form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button[type="submit"]') as HTMLButtonElement;button.disabled=true;try{const slug=value('slug'),response=await fetch('/api/dashboard/content-studio',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({slug,title:value('title'),summary:value('summary'),body:bodyInput.value,priceYen:Number(value('priceYen')),sourceAssetId:selected?.id||null,expectedVersion:slug===currentSlug?currentVersion:null})});const result=await response.json();if(!response.ok||!result.ok){status(result.error==='version_conflict'?'別の更新があります。原稿を書き出してから最新の保存内容を確認してください。':result.error==='live_product_update_requires_release'?'公開中の教材は、この下書き保存では書き換えません。別の下書きとして整えてから更新します。':'保存に接続できません。原稿はこの画面に保持しています。');return;}currentSlug=slug;currentVersion=result.data.version;dirty=false;await refresh();status('教材の下書きを保存しました。販売や公開はまだ行っていません。');}catch{status('保存に接続できません。原稿を書き出して保管できます。');}finally{button.disabled=false;}});
 window.addEventListener('beforeunload',event=>{if(dirty)event.preventDefault();});refresh();
</script>
<style>
.studio-shell{max-width:1160px;margin:auto;display:grid;gap:40px}.studio-intro{display:flex;justify-content:space-between;gap:32px;align-items:end;padding:8px 0 16px}.studio-kicker,.studio-section-head span{color:var(--gold-muted);font-size:12px;letter-spacing:.08em}.studio-intro h1{font-size:clamp(28px,4vw,46px);font-weight:500;line-height:1.3;margin:12px 0 16px}.studio-intro p{max-width:650px;color:var(--text-muted);font-size:16px;line-height:1.8}.studio-intro-links{display:grid;gap:12px;white-space:nowrap}.studio-intro-links a{color:var(--gold-muted);font-size:14px;text-underline-offset:4px}.studio-status{padding:14px 18px;background:var(--gold-glow);border-left:2px solid var(--gold-muted);font-size:14px;line-height:1.7}.studio-section-head{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.studio-section-head h2{font-size:24px;font-weight:500;line-height:1.5;margin-top:8px}.studio-toolbar,.studio-two{display:grid;grid-template-columns:1fr 1fr;gap:16px}.studio-toolbar{grid-template-columns:minmax(0,1fr) minmax(200px,.4fr)}label{display:grid;gap:8px;font-size:14px;color:var(--text-muted);line-height:1.6}input,textarea,select{width:100%;min-width:0;padding:12px 14px;border:1px solid var(--border-default);background:var(--bg-surface);color:var(--text-primary);font:inherit;font-size:16px;line-height:1.6}textarea{resize:vertical}button{font:inherit;font-size:14px;cursor:pointer;min-height:46px}button:disabled{opacity:.55;cursor:default}.studio-primary{background:var(--gold-muted);color:#fff;border:1px solid var(--gold-muted);padding:12px 18px}.studio-secondary{background:var(--bg-surface);color:var(--text-primary);border:1px solid var(--border-default);padding:11px 16px}.studio-count,.studio-note{font-size:14px;color:var(--text-muted);line-height:1.8;margin:14px 0}.studio-source-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:16px}.studio-source{text-align:left;display:flex;flex-direction:c