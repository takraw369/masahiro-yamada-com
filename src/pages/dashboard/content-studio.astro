px;font-weight:500;line-height:1.6;margin-top:12px;overflow-wrap:anywhere}#body-preview{line-height:1.9;overflow-wrap:anywhere}#body-preview :global(h2),#body-preview :global(h3){font-size:20px;font-weight:500;margin:28px 0 10px}#body-preview :global(p){margin:14px 0;white-space:pre-wrap}#body-preview :global(pre){white-space:pre-wrap;font-size:14px}.studio-product{display:flex;align-items:center;gap:16px;padding:18px 0;border-bottom:1px solid var(--border-default);flex-wrap:wrap}.studio-product strong{flex:1;min-width:180px;font-weight:500;overflow-wrap:anywhere}.studio-product span{font-size:13px;color:var(--text-muted)}.studio-product a{color:var(--gold-muted);font-size:14px}.studio-release-flow{display:flex;flex-wrap:wrap;gap:14px;margin-top:24px;color:var(--text-muted);font-size:14px}.studio-release-flow span+span:before{content:'→';margin-right:14px;color:var(--gold-muted)}@media(max-width:1000px){.studio-source-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.studio-editor-grid{grid-template-columns:1fr}}@media(max-width:650px){.studio-intro{display:grid;gap:16px}.studio-section-head{align-items:start;flex-direction:column}.studio-toolbar,.studio-two,.studio-source-grid{grid-template-columns:1fr}.studio-shell{gap:30px}.studio-reader{padding:20px}.studio-editor-actions>*{width:100%}.studio-intro h1{font-size:30px}}
