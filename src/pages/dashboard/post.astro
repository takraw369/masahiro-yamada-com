---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import CopyOsReference from '../../components/dashboard/CopyOsReference.astro';
import SocialAccountPlaybook from '../../components/dashboard/SocialAccountPlaybook';
import PostDraftShelf from '../../components/dashboard/PostDraftShelf';
import XProfileLoopBuilder from '../../components/dashboard/XProfileLoopBuilder';
import XOperationsCenter from '../../components/dashboard/XOperationsCenter';
import '../../styles/masa-readable.css';
import '../../styles/dashboard-home-presets.css';
import '../../styles/x-composer.css';
---
<DashboardLayout title="X Post">
 <div class="x-workspace">
  <header class="x-page-head"><div><h1>一本を、自分の言葉に。</h1><p>本文を整えて、届ける前に確認する。</p></div><a href="/dashboard/content-flow">素材を選ぶ ↗</a></header>
  <details class="publishing-handoff" id="publishing-handoff" hidden>
    <summary>Flowの素材を本文へ<span aria-hidden="true">＋</span></summary>
    <div class="handoff-content">
    <div class="handoff-head">
      <div><span>Flowから受け取った素材</span><strong id="handoff-core">Core未選択</strong></div>
      <a href="/dashboard/content-flow">Flowへ戻る ↗</a>
    </div>
    <div class="handoff-actions">
      <button type="button" id="handoff-to-composer" disabled aria-describedby="handoff-status">素材を本文へ取り込む</button>
    </div>
    <p id="handoff-status" role="status"></p>
    <p id="handoff-provenance" hidden><a id="handoff-source" target="_blank" rel="noopener noreferrer" hidden>元資料を確認 ↗</a> <span id="handoff-rights"></span></p>
    <details><summary>素材の狙いを確認する<span aria-hidden="true">＋</span></summary>
      <p id="handoff-question"></p>
      <div class="handoff-grid">
        <div><span>相手の状態</span><strong id="handoff-phase">—</strong></div>
        <div><span>テーマ</span><strong id="handoff-theme">—</strong></div>
        <div><span>届けたい相手</span><strong id="handoff-audience">—</strong></div>
        <div><span>届ける先</span><strong id="handoff-channel">—</strong></div>
        <div><span>次にしてほしいこと</span><strong id="handoff-cta">—</strong></div>
      </div>
    </details>
    </div>
  </details>

  <XOperationsCenter client:only="react" />
  <section class="x-support" aria-label="素材と書き方の道具">
    <h2>必要なときに、手を借りる。</h2>
    <details><summary>素材から投稿案をつくる<span aria-hidden="true">＋</span></summary><div class="x-support-body"><PostDraftShelf client:load /></div></details>
    <details><summary>アカウントの視点を確かめる<span aria-hidden="true">＋</span></summary><div class="x-support-body"><SocialAccountPlaybook client:load /></div></details>
    <details><summary>次の投稿や資産へつなぐ<span aria-hidden="true">＋</span></summary><div class="x-support-body"><XProfileLoopBuilder client:load /></div></details>
    <CopyOsReference surface="X" />
  </section>
 </div>
</DashboardLayout>

<script>
  import { readPublishingHandoff, isPublishingHandoffFresh, publishingHandoffSeed } from '../../lib/publishingHandoff';

  type ComposeDetail = { username?: string; text?: string };

  function handoffToComposer(detail: ComposeDetail, remaining = 15) {
    const textarea = Array.from(document.querySelectorAll('textarea')).find((node) =>
      node.getAttribute('placeholder')?.includes('今日の気づき') && node.getClientRects().length > 0
    ) as HTMLTextAreaElement | undefined;

    if (!textarea) {
      if (remaining > 0) window.setTimeout(() => handoffToComposer(detail, remaining - 1), 120);
      return;
    }
    if (textarea.disabled) return;

    if (detail.text) {
      const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value')?.set;
      setter?.call(textarea, detail.text);
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // XCommandCenter resolves explicit destinations against live connections.
    // DOM option matching here used to retain the previous account on a miss.

    textarea.focus();
    textarea.scrollIntoView({ behavior: window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
  }

  function text(id: string, value?: string) {
    const node = document.getElementById(id);
    if (node) node.textContent = value?.trim() || '—';
  }

  function renderPublishingHandoff() {
    let raw: string | null = null;
    try { raw = localStorage.getItem('masa-publishing-handoff-v1'); } catch {}
    const handoff = readPublishingHandoff(raw);
    if (!handoff) return;

    const root = document.getElementById('publishing-handoff');
    if (!root) return;
    root.hidden = false;

    const core = [handoff.coreId, handoff.coreTitle].filter(Boolean).join(' · ') || handoff.question || 'Core未選択';
    text('handoff-core', core);
    text('handoff-phase', handoff.phase);
    text('handoff-theme', handoff.theme);
    text('handoff-audience', handoff.audience);
    text('handoff-channel', handoff.channel);
    text('handoff-cta', handoff.cta);
    text('handoff-question', handoff.question ? `今週の問い：${handoff.question}` : '');
    const provenance = document.getElementById('handoff-provenance');
    const sourceLink = document.getElementById('handoff-source') as HTMLAnchorElement | null;
    let sourceUrl: URL | null = null;
    try { if (handoff.sourceUrl) sourceUrl = new URL(handoff.sourceUrl); } catch {}
    if (sourceLink && sourceUrl?.protocol === 'https:') {
      sourceLink.href = sourceUrl.href;
      sourceLink.hidden = false;
    }
    text('handoff-rights', handoff.sourceRights);
    if (provenance) provenance.hidden = !handoff.sourceRights && sourceUrl?.protocol !== 'https:';


    const button = document.getElementById('handoff-to-composer') as HTMLButtonElement | null;
    const scaffold = publishingHandoffSeed(handoff);
    const updateAvailability = () => {
      const fresh = isPublishingHandoffFresh(handoff);
      if (button) button.disabled = !fresh || !scaffold;
      text('handoff-status', !fresh
        ? 'この骨格は作成から24時間以上経過したか、作成日時を確認できません。Flowへ戻り、内容を選び直してください。'
        : !scaffold ? '本文素材がありません。FlowでCoreの題名または問いを入力してください。'
        : 'Coreの題名と問いを本文へ取り込みます。公開前に文面を確認してください。');
      return fresh && Boolean(scaffold);
    };
    updateAvailability();
    button?.addEventListener('click', () => {
      // Recheck on click: this page may have remained open past the expiry.
      if (!updateAvailability()) return;
      const composer = Array.from(document.querySelectorAll('textarea')).find(node => node.getAttribute('placeholder')?.includes('今日の気づき'));
      if (composer?.value.trim() && composer.value !== scaffold) {
        text('handoff-status', '投稿欄に下書きがあります。先にコピーして残し、投稿欄を空にしてから取り込んでください。');
        return;
      }
      window.dispatchEvent(new CustomEvent('masa:x-compose', { detail: { text: scaffold } }));
    });
  }

  window.addEventListener('masa:x-compose', (event) => {
    handoffToComposer((event as CustomEvent<ComposeDetail>).detail ?? {});
  });
  renderPublishingHandoff();
</script>

<script>
  import { loadHomeDesign } from '../../data/homeDesignCombinations';
  const workspace = document.querySelector<HTMLElement>('.x-workspace');
  let selected = null;
  try { selected = loadHomeDesign(localStorage); } catch {}
  if (workspace && selected) {
    workspace.dataset.homePreset = selected.style;
    workspace.dataset.homeButtons = selected.buttons;
    workspace.dataset.homeCards = selected.cards;
    workspace.dataset.homeNavigation = selected.navigation;
    workspace.dataset.homeCta = selected.cta;
  }
</script>
