---
import DashboardShellV2 from '../../layouts/DashboardShellV2.astro';

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo', month: 'long', day: 'numeric', weekday: 'short',
}).format(new Date());

// These are existing destinations, not new capture or publishing contracts.
const quickActions = [
  { label: 'CAPTURE', title: 'メモ・URLを残す', detail: 'Intelligenceの入力欄へ', href: '/dashboard/intelligence#intel-form' },
  { label: 'THINK', title: '保存した情報を読む', detail: 'Intelligenceの一覧へ', href: '/dashboard/intelligence#intel-list' },
  { label: 'CREATE', title: '投稿文を作る', detail: 'X Postへ', href: '/dashboard/post' },
  { label: 'TIME', title: '投稿予定を見る', detail: '投稿スケジュールへ', href: '/dashboard/schedule' },
];

const workspaces = [
  { label: 'CREATE', purpose: '発信をつくる', links: [
    { label: '投稿文を作る', tool: 'X Post', href: '/dashboard/post' },
    { label: '画像の指示を組む', tool: 'Visual Prompt', href: '/dashboard/visual-prompt' },
    { label: '発信の導線を組む', tool: 'Trinity Funnel', href: '/dashboard/funnel' },
  ] },
  { label: 'THINK', purpose: '情報を読み解く', links: [
    { label: '保存した情報を読む', tool: 'Intelligence', href: '/dashboard/intelligence#intel-list' },
    { label: '根拠を確かめる', tool: 'Evidence Lab', href: '/dashboard/evidence' },
    { label: 'つながりを見る', tool: 'Graph', href: '/dashboard/graph' },
  ] },
  { label: 'BUILD', purpose: '学び・事業を育てる', links: [
    { label: '事業の流れを組む', tool: '0→9 Flow', href: '/dashboard/flow-09' },
    { label: '学習テーマを選ぶ', tool: 'Quest', href: '/dashboard/quest' },
    { label: 'リアンを開く', tool: 'リアン', href: '/dashboard/lian' },
  ] },
  { label: 'ASSETS', purpose: 'お金・保有を整える', links: [
    { label: 'お金の流れを見る', tool: 'Treasury', href: '/dashboard/treasury' },
    { label: '投資を確認する', tool: 'Investment', href: '/dashboard/investment' },
    { label: '欲しいものを整理する', tool: 'Wish List', href: '/dashboard/wishlist' },
  ] },
];
const quickHrefs = new Set(quickActions.map(item => item.href));
const otherDestinations = workspaces.flatMap(space => space.links).filter(link => !quickHrefs.has(link.href));
---

<DashboardShellV2 title="今日の一手" eyebrow="DAILY COMMAND CENTER">
  <header class="today-head">
    <h1>今日の一手</h1>
    <p class="date">{dateLabel}<span>V2 PREVIEW</span></p>
  </header>

  <section class="next-action" aria-labelledby="next-action-title">
    <div class="next-copy">
      <div class="action-summary">
        <p class="section-label">NEXT ACTION</p>
        <p class="action-context">Social Growth Sprint 30D</p>
        <h2 id="next-action-title">既存素材を1本、<br />投稿文にする。</h2>
        <p class="next-instruction">伝えたい要点を1つ選び、X Postで文章にする。</p>
      </div>
      <div class="action-entry">
        <a class="primary-cta" href="/dashboard/post">投稿画面を開く <span aria-hidden="true">→</span></a>
        <p class="source-note">現行Dashboardの方針をもとにした提案</p>
      </div>
    </div>
    <details class="action-background">
      <summary>この一手の理由・その先</summary>
      <div class="disclosed-copy">
        <p>目指すのは、適合する実在見込み客が生まれること。まずは既存素材を使って、市場へ出す1本を準備する。</p>
        <p>投稿後の流れ：反応をもとに3〜5会話 → 適合者1名へ勝ち筋OSを具体提案。</p>
        <p>現在の完了状況や優先順位は未連携。この提案は自動更新されません。</p>
      </div>
    </details>
  </section>

  <section class="quick-section" aria-labelledby="quick-title">
    <div class="section-heading">
      <h2 id="quick-title">別のことを始める</h2>
      <p class="section-label">QUICK START</p>
    </div>
    <div class="quick-grid">
      {quickActions.map(item => (
        <a class="quick-card" href={item.href}>
          <span class="quick-label">{item.label}</span>
          <strong>{item.title}</strong>
          <small>{item.detail}</small>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <details class="capture-help">
      <summary>Captureで残せるもの</summary>
      <div class="disclosed-copy">
        <p>思いつき・メモ・URLは、Intelligenceの既存入力欄からFeedへ追加。タイトルだけでも残せます。音声は、対応端末の音声入力で文字にして残せます。</p>
        <p>録音ファイルの受け付けや自動AI処理は未対応。残した情報は、あとから既存の「SNS / AI種」「Evidence化」などの操作へつなげられます。</p>
      </div>
    </details>
  </section>

  <section class="loop-section" aria-labelledby="loop-title">
    <div class="section-heading">
      <h2 id="loop-title">次に触る候補</h2>
      <p class="section-label">ACTIVE LOOPS</p>
    </div>
    <p class="section-note">現行Dashboardの方針から。進捗・期限による自動選定は未連携。</p>
    <article class="loop-row">
      <div class="loop-main">
        <p class="loop-name">Idea → Asset → Reuse</p>
        <h3>使える素材を1つ選ぶ</h3>
        <p>新しく作る前に、残した情報から再利用する。</p>
      </div>
      <a class="secondary-cta" href="/dashboard/intelligence#intel-list">保存した情報へ <span aria-hidden="true">→</span></a>
    </article>
    <details class="other-focus">
      <summary>もう1つの方針：ACE｜実利用 E2E</summary>
      <div class="disclosed-copy">
        <p>次の確認：Google Login → My ACE → Action / Quest → progress → next を1本だけ通す。</p>
        <p>実利用の確認先はこのプレビューに未接続です。DashboardのQuestは学習テーマの一覧です。</p>
        <a href="/dashboard">現行Dashboardで方針を確認する <span aria-hidden="true">→</span></a>
      </div>
    </details>
  </section>

  <details class="workspace-section">
    <summary>ほかの仕事を探す <span>CREATE / THINK / BUILD / ASSETS</span></summary>
    <div class="workspace-grid">
      {workspaces.map(space => (
        <section class="workspace-card" aria-label={`${space.label}：${space.purpose}`}>
          <h2>{space.label}</h2>
          <p>{space.purpose}</p>
          <div class="workspace-links">
            {space.links.map(link => (
              <a href={link.href}>{link.label}<small>{link.tool}</small></a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </details>

  <footer class="preview-foot">
    <p>V2 · 隔離プレビュー</p>
    <a href="/dashboard">現行Dashboardと比較する <span aria-hidden="true">→</span></a>
  </footer>

  <dialog class="command-dialog" id="command-dialog" aria-labelledby="command-title">
    <div class="command-head">
      <h2 id="command-title">行き先を選ぶ</h2>
      <form method="dialog"><button aria-label="行き先を閉じる" autofocus>×</button></form>
    </div>
    <nav class="command-links" aria-label="行き先一覧">
      {quickActions.map(item => <a href={item.href}>{item.title}<span>{item.label} · {item.detail}</span></a>)}
      {otherDestinations.map(link => <a href={link.href}>{link.label}<span>{link.tool}</span></a>)}
      <a href="/dashboard/voice">顧客の声を整理する<span>Voice Inbox</span></a>
    </nav>
  </dialog>
</DashboardShellV2>

<style>
  .today-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  h1 { font-size: 1.05rem; font-weight: 500; }
  .date { display: flex; align-items: center; gap: 14px; color: var(--muted); font-size: .8rem; }
  .date span { color: var(--gold-muted); font-size: .75rem; letter-spacing: .07em; }
  .section-label, .quick-label { color: var(--gold); font-size: .75rem; letter-spacing: .12em; font-weight: 500; }
  .next-action { border: 1px solid var(--gold-muted); background: var(--panel); }
  .next-copy { padding: 28px 32px 22px; }
  .action-context { margin-top: 12px; color: var(--muted); font-size: .85rem; }
  .next-copy h2 { margin-top: 10px; font-size: clamp(1.75rem, 3.2vw, 2.8rem); line-height: 1.4; font-weight: 500; letter-spacing: .025em; }
  .next-instruction { margin-top: 14px; color: var(--muted); font-size: .9rem; line-height: 1.75; }
  .primary-cta { display: flex; align-items: center; justify-content: space-between; gap: 30px; width: min(100%, 340px); min-height: 48px; margin-top: 22px; padding: 12px 18px; color: var(--bg); background: var(--gold); text-decoration: none; font-size: .95rem; font-weight: 500; }
  .primary-cta:hover { background: var(--text); }
  .source-note { margin-top: 12px; font-size: .75rem; line-height: 1.6; color: var(--muted); }
  summary { cursor: pointer; font-size: .85rem; min-height: 44px; padding: 12px 0; line-height: 1.6; color: var(--muted); }
  summary:hover { color: var(--text); }
  .action-background { border-top: 1px solid var(--line); padding: 0 32px; }
  .disclosed-copy { padding-bottom: 18px; color: var(--muted); font-size: .85rem; line-height: 1.85; }
  .disclosed-copy p + p { margin-top: 10px; }
  .disclosed-copy a { display: inline-flex; align-items: center; min-height: 44px; color: var(--gold); text-underline-offset: 4px; }
  .quick-section, .loop-section { margin-top: 28px; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .section-heading h2 { font-size: 1rem; font-weight: 500; }
  .quick-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 8px; }
  .quick-card { min-width: 0; display: flex; position: relative; flex-direction: column; padding: 14px; padding-bottom: 20px; border: 1px solid var(--line-strong); background: var(--panel); text-decoration: none; }
  .quick-card:hover { border-color: var(--gold); background: var(--panel-2); }
  .quick-card strong { margin-top: 10px; font-size: .9rem; font-weight: 500; line-height: 1.6; }
  .quick-card small { margin-top: 4px; padding-right: 12px; font-size: .75rem; line-height: 1.6; color: var(--muted); }
  .arrow { position: absolute; right: 12px; bottom: 12px; color: var(--gold); }
  .capture-help { margin-top: 6px; }
  .section-note { color: var(--muted); font-size: .8rem; line-height: 1.75; margin-bottom: 12px; }
  .loop-row { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 18px 0; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line); }
  .loop-name { color: var(--gold-muted); font-size: .8rem; }
  .loop-main h3 { font-size: 1rem; font-weight: 500; margin-top: 6px; }
  .loop-main > p:last-child { margin-top: 6px; color: var(--muted); font-size: .85rem; line-height: 1.7; }
  .secondary-cta { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 18px; min-height: 44px; padding: 10px 14px; border: 1px solid var(--line-strong); color: var(--gold); text-decoration: none; font-size: .85rem; }
  .secondary-cta:hover { border-color: var(--gold); }
  .other-focus { border-bottom: 1px solid var(--line); }
  .workspace-section { margin-top: 24px; border: 1px solid var(--line-strong); padding: 0 16px; }
  .workspace-section > summary { color: var(--text); }
  .workspace-section > summary span { margin-left: 12px; color: var(--muted); font-size: .75rem; }
  .workspace-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 20px; padding: 16px 0; border-top: 1px solid var(--line); }
  .workspace-card { min-width: 0; }
  .workspace-card h2 { color: var(--gold); font-family: 'Cormorant Garamond',serif; font-size: 1.3rem; font-weight: 400; }
  .workspace-card > p { color: var(--muted); font-size: .8rem; margin-top: 6px; }
  .workspace-links { margin-top: 12px; }
  .workspace-links a { display: flex; flex-direction: column; padding: 10px 0; font-size: .85rem; border-top: 1px solid var(--line); text-decoration: none; }
  .workspace-links a:hover { color: var(--gold); }
  .workspace-links small { color: var(--muted); font-size: .75rem; margin-top: 2px; }
  .preview-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 22px; color: var(--muted); font-size: .75rem; }
  .preview-foot a { display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: 4px; }
  .command-dialog { width: min(640px,calc(100% - 28px)); max-height: calc(100dvh - 32px); margin: auto; padding: 20px; border: 1px solid var(--gold-muted); color: var(--text); background: var(--panel); }
  .command-dialog::backdrop { background: rgb(0 0 0 / .8); }
  .command-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
  .command-head h2 { font-size: 1.2rem; font-weight: 500; }
  .command-head button { min-width: 44px; min-height: 44px; border: 1px solid var(--line-strong); background: var(--panel-2); color: var(--text); cursor: pointer; font-size: 1.25rem; }
  .command-links { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
  .command-links a { display: flex; flex-direction: column; padding: 12px; border: 1px solid var(--line-strong); text-decoration: none; font-size: .85rem; }
  .command-links a:hover { border-color: var(--gold); }
  .command-links span { margin-top: 4px; color: var(--muted); font-size: .75rem; }
  @media (min-width: 1200px) {
    .next-copy { display: grid; grid-template-columns: minmax(0,1fr) 340px; align-items: end; gap: 28px; }
    .primary-cta { margin-top: 0; }
  }
  @media (max-width: 1150px) { .quick-grid, .workspace-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 640px) {
    .today-head { align-items: flex-start; margin-bottom: 12px; }
    .date { flex-direction: column; align-items: flex-end; gap: 3px; font-size: .75rem; }
    .date span { font-size: .75rem; }
    .next-copy { padding: 20px 18px 16px; }
    .next-copy h2 { font-size: clamp(1.6rem,6.5vw,2.25rem); }
    .next-instruction { font-size: .85rem; margin-top: 10px; }
    .primary-cta { width: 100%; margin-top: 16px; }
    .action-background { padding: 0 18px; }
    .quick-card { padding: 12px; padding-bottom: 20px; }
    .quick-card strong { font-size: .85rem; }
    .section-heading { gap: 8px; }
    .section-heading .section-label { font-size: .75rem; letter-spacing: .06em; }
    .loop-row { align-items: stretch; flex-direction: column; gap: 12px; }
    .workspace-section > summary span { display: block; margin: 4px 0 0; }
    .workspace-grid, .command-links { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }
</style>

<script>
  const dialog = document.getElementById('command-dialog');
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-command-trigger]');
  let previousFocus: HTMLElement | null = null;
  let previousOverflow = '';

  function openCommand() {
    if (!(dialog instanceof HTMLDialogElement) || document.querySelector('dialog[open]')) return;
    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    previousOverflow = document.body.style.overflow;
    dialog.showModal();
    document.body.style.overflow = 'hidden';
    triggers.forEach(trigger => trigger.setAttribute('aria-expanded', 'true'));
  }

  triggers.forEach(trigger => {
    trigger.setAttribute('aria-controls', 'command-dialog');
    trigger.setAttribute('aria-haspopup', 'dialog');
    trigger.setAttribute('aria-expanded', 'false');
    trigger.addEventListener('click', openCommand);
  });
  dialog?.addEventListener('close', () => {
    document.body.style.overflow = previousOverflow;
    triggers.forEach(trigger => trigger.setAttribute('aria-expanded', 'false'));
    // A breakpoint can hide the invoking control; only restore to a visible target.
    if (previousFocus?.getClientRects().length) previousFocus.focus();
  });
  dialog?.addEventListener('click', event => {
    if (!(dialog instanceof HTMLDialogElement) || event.target !== dialog) return;
    const bounds = dialog.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
  });
  document.addEventListener('keydown', event => {
    if (event.isComposing || event.altKey || event.repeat || event.defaultPrevented) return;
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openCommand();
    }
  });
</script>
