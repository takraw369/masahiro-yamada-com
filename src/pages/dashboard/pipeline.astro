.pipeline-filters button{background:transparent;border:1px solid transparent;padding:8px 10px;border-radius:6px;color:#646a74;font-size:12px;white-space:nowrap;}
.pipeline-filters button[aria-pressed="true"]{background:#fff;color:#232a34;box-shadow:0 1px 4px #00000014;font-weight:700;}
.pipeline-search-label{flex:1;min-width:200px;max-width:365px;}
.pipeline-search-label input{width:100%;border:1px solid var(--pp-line);border-radius:8px;min-height:38px;background:#fff;padding:8px 12px;font-size:12px;color:#17191c;}
.pipeline-sync{font-size:11px;color:#7c838d;white-space:nowrap;}
.pipeline-move-state{font-size:11px;color:#21654d;flex-basis:100%;margin:0;line-height:1.5}
.pipeline-move-state.is-error{color:#a34535}
.pipeline-task[draggable="true"]{cursor:grab}
.pipeline-task.is-dragging{opacity:.55;cursor:grabbing}
.pipeline-lane.is-drop-target{outline:3px solid #d4af37;outline-offset:-4px;background:#faf3e3}
