@media(max-width:640px){.pipeline-head{display:block;}.pipeline-head-actions{margin-top:13px;}.pipeline-kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;}.pipeline-kpi{padding:12px;}.pipeline-alert{flex-wrap:wrap;}.pipeline-alert a{margin-left:49px;}.pipeline-toolbar{gap:9px;}.pipeline-search-label{min-width:100%;max-width:none;order:2;}.pipeline-sync{order:3;}.pipeline-board{margin-right:-10px;padding-right:10px;}.pipeline-lane{flex:0 0 min(80vw,275px);min-width:0;}.pipeline-subtitle{font-size:12px;}.pipeline-detail-row{grid-template-columns:105px minmax(0,1fr);}}
@media(prefers-reduced-motion:reduce){.pipeline-task{transition:none;}.pipeline-task:hover{transform:none;}.pipeline-board{scroll-behavior:auto;}}
