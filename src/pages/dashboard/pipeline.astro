.pipeline-move-controls [hidden]{display:none!important}
.pipeline-board{display:flex;gap:11px;align-items:stretch;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x proximity;padding:0 1px 14px;scrollbar-width:thin;min-height:340px;}
.pipeline-lane{background:#f0f0f0;border:1px solid #e5e5e4;border-radius:13px;padding:12px;flex:1 0 219px;min-width:219px;max-width:340px;scroll-snap-align:start;align-self:stretch;}
