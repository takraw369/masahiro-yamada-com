.pipeline-detail-project{font-size:12px;color:#717783;overflow-wrap:anywhere;margin-bottom:15px;}
.pipeline-detail-data{display:grid;border-top:1px solid #e5e4e1;}
.pipeline-detail-row{display:grid;grid-template-columns:132px minmax(0,1fr);gap:10px;padding:8px 0;border-bottom:1px solid #eee;font-size:12px;overflow-wrap:anywhere;}
.pipeline-detail-row dt{color:#767b82;}
.pipeline-detail-row dd{margin:0;font-weight:700;}
.pipeline-detail-action{background:#fbf8f2;border-left:3px solid #d4af37;margin:16px 0;padding:13px;overflow-wrap:anywhere;}
.pipeline-detail-action p{font-size:13px;line-height:1.7;margin-top:6px;}
.pipeline-dialog-bottom a{font-size:12px;color:#815823;font-weight:700;text-decoration:none;}
.tone-slate{--tone:#94979c}.tone-indigo{--tone:#576ab6}.tone-gold{--tone:#c2943a}.tone-violet{--tone:#9376aa}.tone-coral{--tone:#c96b57}.tone-green{--tone:#398b6c}
