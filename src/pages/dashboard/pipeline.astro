---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Task Pipeline" eyebrow="MASA OS · EXECUTION">
  <main class="pipeline-shell">
    <header class="pipeline-head">
      <div>
        <p class="pipeline-kicker">EXECUTION / FLOW INTELLIGENCE</p>
        <h1>Task Pipeline</h1>
        <p class="pipeline-subtitle">仕事の流れを、ひと目で。滞留を見つけ、次の一手へ。</p>
      </div>
      <div class="pipeline-head-actions">
        <span class="pipeline-source-pill">Google Sheets · TASK_BOARD正本</span>
        <button id="pipeline-reload" class="pipeline-refresh" type="button">↻ 更新</button>
      </div>
    </header>

    <section class="pipeline-alert" aria-label="優先して見ること">
      <div class="pipeline-alert-icon" aria-hidden="true">↗</div>
      <div>
        <strong id="pipeline-alert-title">現在地を確認しています</strong>
        <p id="pipeline-alert-body">タスクの状態を読み込み、対応が必要な項目を表示します。</p>
      </div>
      <a href="/dashboard/tasks">Task詳細を見る →</a>
    </section>

    <section id="pipeline-kpis" class="pipeline-kpis" aria-label="フェーズ別サマリー"></section>

    <div class="pipeline-toolbar">
      <div class="pipeline-filters" role="group" aria-label="表示対象">
        <button type="button" data-scope="actionable" aria-pressed="true">進行中</button>
        <button type="button" data-scope="all" aria-pressed="false">すべて</button>
        <button type="button" data-scope="gate" aria-pressed="false">MASA判断待ち</button>
      </div>
      <label class="pipeline-search-label">
        <span class="pipeline-visually-hidden">Taskを検索</span>
        <input id="pipeline-search" type="search" placeholder="⌕  Project・Task・次の行動で検索" autocomplete="off" />
      </label>
      <span id="pipeline-sync" class="pipeline-sync" role="status" aria-live="polite">読み込み中…</span>
      <p id="pipeline-move-state" class="pipeline-move-state" role="status" aria-live="polite">書き込み連携を確認しています…</p>
    </div>

    <div id="pipeline-board" class="pipeline-board" aria-label="タスクフェーズ別ボード" tabindex="0">
      <p class="pipeline-loading">TASK_BOARD read model を読み込んでいます…</p>
    </div>

    <footer class="pipeline-footer">
      <span>フェーズはTASK_BOARDの status から集計。件数・期限は実データのみ使用しています。</span>
      <span>カード移動はGoogle Sheets TASKSへの保存が確認された場合のみ確定。未連携・失敗時は状態を変更しません。</span>
    </footer>
  </main>

  <dialog id="pipeline-detail" class="pipeline-dialog" aria-labelledby="pipeline-detail-heading">
    <div class="pipeline-dialog-top">
      <span class="pipeline-kicker">TASK / DETAILS</span>
      <button type="button" id="pipeline-close" aria-label="詳細を閉じる">✕</button>
    </div>
    <h2 id="pipeline-detail-heading"></h2>
    <p id="pipeline-detail-project" class="pipeline-detail-project"></p>
    <div id="pipeline-detail-data" class="pipeline-detail-data"></div>
    <div class="pipeline-detail-action">
      <span class="pipeline-kicker">NEXT ACTION</span>
      <p id="pipeline-detail-next"></p>
    </div>
    <section class="pipeline-move-controls" aria-label="タスクを移動">
      <label for="pipeline-move-target">移動先</label>
      <select id="pipeline-move-target">
        <option value="NEXT">次に進める</option>
        <option value="NOW">実行中</option>
        <option value="REVIEW">検証・確認</option>
        <option value="WAIT">停止・待機</option>
        <option value="DONE">完了</option>
      </select>
      <label id="pipeline-receipt-label" for="pipeline-move-receipt" hidden>完了の証跡（成果物・検証結果など12文字以上）</label>
      <textarea id="pipeline-move-receipt" rows="3" maxlength="1200" hidden placeholder="成果物URLや検証結果を記録"></textarea>
      <button id="pipeline-move-submit" type="button" disabled>Google Sheetsへ保存</button>
      <p id="pipeline-detail-write-note">保存経路を確認中です。</p>
    </section>
    <div class="pipeline-dialog-bottom">
      <a href="/dashboard/tasks">Task Flowへ →</a>
      <button type="button" id="pipeline-dismiss">閉じる</button>
    </div>
  </dialog>
</DashboardLayout>

<script is:inline>
(() => {
  const phases = [
    { key:'INBOX', name:'未分類', short:'INBOX', tone:'slate', help:'状態の確認が必要' },
    { key:'NEXT', name:'次に進める', short:'NEXT', tone:'indigo', help:'着手を待つタスク' },
    { key:'NOW', name:'実行中', short:'IN FLOW', tone:'gold', help:'動かしているタスク' },
    { key:'REVIEW', name:'検証・確認', short:'REVIEW', tone:'violet', help:'成果と品質を確認' },
    { key:'WAIT', name:'停止・待機', short:'WAIT', tone:'coral', help:'判断・外部条件待ち' },
    { key:'DONE', name:'完了', short:'DONE', tone:'green', help:'完了したタスク' }
  ];
  const $ = id => document.getElementById(id);
  const board = $('pipeline-board');
  const kpis = $('pipeline-kpis');
  let tasks = [];
  let scope = 'actionable';
  let search = '';
  let loaded = false;
  let writeEnabled = false;
  let saving = false;
  let dragTaskId = null;
  let selectedTask = null;
  const safeText = value => String(value == null ? '' : value);
  const upper = value => safeText(value).trim().toUpperCase();
  const dateKey = value => {
    const result = /^(\d{4}-\d{2}-\d{2})/.exec(safeText(value));
    if (!result) return '';
    const date = new Date(result[1] + 'T00:00:00Z');
    return !Number.isNaN(date.getTime()) && date.toISOString().slice(0,10) === result[1] ? result[1] : '';
  };
  const todayKey = () => {
    const parts = new Intl.DateTimeFormat('en-CA', { timeZone:'Asia/Tokyo', year:'numeric', month:'2-digit', day:'2-digit' }).formatToParts(new Date());
    const part = Object.fromEntries(parts.map(row => [row.type, row.value]));
    return part.year + '-' + part.month + '-' + part.day;
  };
  const phaseFor = item => {
    const status = upper(item.status);
    if (['DONE','COMPLETE','COMPLETED','CLOSED'].includes(status)) return 'DONE';
    if (['WAIT','BLOCKED','PAUSED','ON_HOLD','HOLD'].includes(status)) return 'WAIT';
    if (['REVIEW','VALIDATE','IN_REVIEW','QA'].includes(status)) return 'REVIEW';
    if (['NOW','EXECUTE','DOING','IN_PROGRESS','ACTIVE'].includes(status)) return 'NOW';
    if (['NEXT','TODO','READY','PLANNED','BACKLOG'].includes(status)) return 'NEXT';
    return 'INBOX';
  };
  const el = (tag, className, label) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (label !== undefined) node.textContent = safeText(label);
    return node;
  };
  const overdue = item => {
    const due = dateKey(item.dueDate);
    return Boolean(due && due < todayKey() && phaseFor(item) !== 'DONE');
  };
  const dueToday = item => dateKey(item.dueDate) === todayKey() && phaseFor(item) !== 'DONE';
  const stats = () => {
    const overdueCount = tasks.filter(overdue).length;
    const gateCount = tasks.filter(x => upper(x.executionLane) === 'MASA_GATE' && phaseFor(x) !== 'DONE').length;
    const waitingCount = tasks.filter(x => phaseFor(x) === 'WAIT').length;
    return { overdueCount, gateCount, waitingCount };
  };
  const formatDue = item => {
    const key = dateKey(item.dueDate);
    if (!key) return '';
    const parts = key.split('-');
    return Number(parts[1]) + '/' + Number(parts[2]);
  };
  const isVisible = item => {
    if (scope === 'actionable' && phaseFor(item) === 'DONE') return false;
    if (scope === 'gate' && upper(item.executionLane) !== 'MASA_GATE') return false;
    if (!search) return true;
    return [item.taskId,item.task,item.project,item.status,item.nextAction,item.executionLane,item.priority]
      .map(safeText).join(' ').toLocaleLowerCase('ja-JP').includes(search);
  };
  const append = (node, tag, className, label) => {
    const child = el(tag, className, label);
    node.appendChild(child);
    return child;
  };
  function drawKpis() {
    kpis.replaceChildren();
    const total = tasks.length;
    phases.filter(phase => phase.key !== 'INBOX').forEach(phase => {
      const count = tasks.filter(item => phaseFor(item) === phase.key).length;
      const card = el('article', 'pipeline-kpi tone-' + phase.tone);
      append(card, 'span', 'pipeline-kpi-title', phase.short);
      append(card, 'strong', 'pipeline-kpi-number', count + ' 件');
      const track = append(card, 'span', 'pipeline-kpi-track');
      const fill = append(track, 'span', 'pipeline-kpi-fill');
      fill.style.width = (total ? Math.round(count / total * 100) : 0) + '%';
      append(card, 'span', 'pipeline-kpi-help', phase.help);
      kpis.appendChild(card);
    });
  }
  function drawAlert() {
    const s = stats();
    const title = $('pipeline-alert-title');
    const body = $('pipeline-alert-body');
    if (!loaded) return;
    if (!tasks.length) {
      title.textContent = '現在、表示できるタスクはありません';
      body.textContent = 'TASK_BOARDの同期状況をご確認ください。架空のデータは表示しません。';
    } else if (s.overdueCount || s.gateCount || s.waitingCount) {
      title.textContent = s.overdueCount + '件の期限超過 · ' + s.gateCount + '件のMASA判断待ち';
      body.textContent = 'WAIT中 ' + s.waitingCount + '件。次のActionと正本を確認できます。';
    } else {
      title.textContent = '期限超過・判断待ちは見つかりませんでした';
      body.textContent = '全 ' + tasks.length + ' 件のタスクをフェーズ別に確認できます。';
    }
  }
  function drawTask(item) {
    const phase = phaseFor(item);
    const button = el('button', 'pipeline-task' + (overdue(item) ? ' is-overdue' : '' ));
    button.type = 'button';
    button.draggable = writeEnabled && !saving && ['NEXT','NOW','REVIEW','WAIT','DONE'].includes(upper(item.status));
    if (button.draggable) {
      button.addEventListener('dragstart', event => {
        if (!event.dataTransfer || saving) { event.preventDefault(); return; }
        dragTaskId = item.taskId;
        event.dataTransfer.setData('text/plain', item.taskId);
        event.dataTransfer.effectAllowed = 'move';
        button.classList.add('is-dragging');
      });
      button.addEventListener('dragend', () => {
        dragTaskId = null;
        board.querySelectorAll('.pipeline-lane').forEach(node => node.classList.remove('is-drop-target'));
        button.classList.remove('is-dragging');
      });
      button.title = 'ドラッグして列を移動できます。スマホでは詳細から移動先を選択。';
    }
    button.setAttribute('aria-label', safeText(item.task || '名称未設定') + ' の詳細を開く');
    const head = append(button, 'span', 'pipeline-task-top');
    let label = overdue(item) ? '期限超過' : (dueToday(item) ? '本日期限' : (upper(item.executionLane) === 'MASA_GATE' ? 'MASA判断' : (item.priority || item.status || 'TASK')));
    append(head, 'span', 'pipeline-chip' + (overdue(item) ? ' urgent' : ''), label);
    append(head, 'span', 'pipeline-task-date', formatDue(item));
    append(button, 'span', 'pipeline-task-project', item.project || 'NO PROJECT');
    append(button, 'strong', 'pipeline-task-title', item.task || '名称未設定のタスク');
    const next = append(button, 'span', 'pipeline-task-next');
    append(next, 'b', '', 'NEXT ');
    append(next, 'span', '', item.nextAction || '次のAction未登録');
    const foot = append(button, 'span', 'pipeline-task-foot');
    append(foot, 'span', 'pipeline-owner', item.executionLane || '担当区分未設定');
    append(foot, 'span', 'pipeline-id', item.taskId || phase);
    button.addEventListener('click', () => openDetail(item));
    return button;
  }
  function renderBoard() {
    if (!loaded) return;
    drawKpis();
    drawAlert();
    board.replaceChildren();
    const selected = tasks.filter(isVisible);
    // DONE remains a valid drop target even when completed cards are filtered out.
    // Hide the first empty INBOX lane so a narrow viewport starts at useful work.
    const visiblePhases = phases.filter(phase => phase.key !== 'INBOX' || tasks.some(x => phaseFor(x) === 'INBOX'));
    for (const phase of visiblePhases) {
      const list = selected.filter(item => phaseFor(item) === phase.key)
        .sort((a,b) => {
          const ao = overdue(a) ? 0 : 1, bo = overdue(b) ? 0 : 1;
          if (ao !== bo) return ao - bo;
          return (dateKey(a.dueDate) || '9999-12-31').localeCompare(dateKey(b.dueDate) || '9999-12-31');
        });
      const lane = el('section', 'pipeline-lane tone-' + phase.tone);
      lane.dataset.phase = phase.key;
      if (writeEnabled && ['NEXT','NOW','REVIEW','WAIT','DONE'].includes(phase.key)) {
        lane.addEventListener('dragover', event => {
          if (!dragTaskId || saving) return;
          const dragged = tasks.find(x => x.taskId === dragTaskId);
          if (!dragged || upper(dragged.status) === phase.key) return;
          event.preventDefault();
          if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
          lane.classList.add('is-drop-target');
        });
        lane.addEventListener('dragleave', event => {
          if (!lane.contains(event.relatedTarget)) lane.classList.remove('is-drop-target');
        });
        lane.addEventListener('drop', event => {
          event.preventDefault();
          lane.classList.remove('is-drop-target');
          const id = dragTaskId || event.dataTransfer?.getData('text/plain');
          dragTaskId = null;
          const item = tasks.find(x => x.taskId === id);
          if (item) void moveTask(item, phase.key);
        });
      }
      lane.setAttribute('aria-label', phase.name + ' ' + list.length + '件');
      const laneHead = append(lane, 'header', 'pipeline-lane-head');
      const laneTitle = append(laneHead, 'div', 'pipeline-lane-heading');
      append(laneTitle, 'span', 'pipeline-status-dot');
      append(laneTitle, 'h2', '', phase.name);
      append(laneTitle, 'span', 'pipeline-lane-count', list.length);
      append(lane, 'p', 'pipeline-lane-description', phase.help);
      const cards = append(lane, 'div', 'pipeline-lane-cards');
      if (!list.length) append(cards, 'p', 'pipeline-empty', phase.key === 'DONE' && scope === 'actionable' ? 'ここへドロップすると完了（証跡必須）' : '該当するタスクはありません');
      else for (const item of list) cards.appendChild(drawTask(item));
      board.appendChild(lane);
    }
    $('pipeline-sync').textContent = selected.length + ' / ' + tasks.length + '件表示';
  }
  function openDetail(item) {
    selectedTask = item;
    $('pipeline-move-target').value = ['NEXT','NOW','REVIEW','WAIT','DONE'].includes(upper(item.status)) ? upper(item.status) : 'NEXT';
    $('pipeline-move-receipt').value = '';
    $('pipeline-move-target').disabled = !writeEnabled || saving;
    $('pipeline-move-submit').disabled = !writeEnabled || saving;
    $('pipeline-detail-write-note').textContent = writeEnabled
      ? '保存先：Google Sheets TASKS。ドラッグでも移動できます。'
      : '閲覧専用。書き込み連携の準備が必要です。';
    updateReceiptField();
    $('pipeline-detail-heading').textContent = item.task || '名称未設定のタスク';
    $('pipeline-detail-project').textContent = item.project || 'NO PROJECT';
    const container = $('pipeline-detail-data');
    container.replaceChildren();
    const entries = [
      ['ID',item.taskId],['状態',item.status],['フェーズ',item.phase],
      ['担当区分',item.executionLane],['実行分類',item.executionClass],
      ['優先度',item.priority],['期限',item.dueDate],
      ['正本Revision',item.sourceRevision],['最終同期元の編集者',item.sourceEditBy]
    ];
    for (const pair of entries) {
      const row = append(container, 'div', 'pipeline-detail-row');
      append(row, 'dt', '', pair[0]);
      append(row, 'dd', '', pair[1] == null || pair[1] === '' ? '—' : pair[1]);
    }
    $('pipeline-detail-next').textContent = item.nextAction || '次のActionはまだ登録されていません。';
    const dialog = $('pipeline-detail');
    if (!dialog.open) dialog.showModal();
  }

  function updateReceiptField() {
    const completed = $('pipeline-move-target').value === 'DONE';
    $('pipeline-receipt-label').hidden = !completed;
    $('pipeline-move-receipt').hidden = !completed;
  }
  function moveMessage(text, error = false) {
    const target = $('pipeline-move-state');
    target.textContent = text;
    target.classList.toggle('is-error', error);
  }
  async function refreshWriter() {
    writeEnabled = false;
    try {
      const response = await fetch('/api/dashboard/task-move', {credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}});
      const payload = await response.json();
      if (!response.ok || !payload.ok || !payload.writeEnabled || !payload.statuses) throw Error('writer not ready');
      const statuses = payload.statuses;
      // Source Sheet status + revision win over possibly stale Supabase read mirror.
      tasks.forEach(item => {
        const canonical = statuses[item.taskId];
        if (canonical && Number.isSafeInteger(canonical.revision)) {
          item.status = canonical.status;
          item.sourceRevision = canonical.revision;
        }
      });
      writeEnabled = true;
      moveMessage('移動OK · カードをドラッグ／タップで移動先を選択 · Google Sheetsに保存');
    } catch {
      moveMessage('現在は閲覧のみ：Google Sheets書き込み連携が未設定または利用できません', true);
    }
    if (loaded) renderBoard();
  }
  async function moveTask(item, toStatus, receipt = '') {
    const fromStatus = upper(item.status);
    if (!writeEnabled || saving || fromStatus === toStatus) return;
    if (!['NEXT','NOW','REVIEW','WAIT','DONE'].includes(toStatus) ||
        !['NEXT','NOW','REVIEW','WAIT','DONE'].includes(fromStatus)) {
      moveMessage('このタスクは状態を確認してから移動してください', true); return;
    }
    if (toStatus === 'DONE' && receipt.trim().length < 12) {
      openDetail(item);
      $('pipeline-move-target').value = 'DONE';
      updateReceiptField();
      $('pipeline-detail-write-note').textContent = 'DONEは完了証跡を入力してから保存します。';
      $('pipeline-move-receipt').focus();
      return;
    }
    saving = true;
    moveMessage('Google Sheets正本に保存中…');
    $('pipeline-move-submit').disabled = true;
    try {
      const response = await fetch('/api/dashboard/task-move', {
        method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},
        body:JSON.stringify({taskId:item.taskId,fromStatus,toStatus,expectedRevision:item.sourceRevision,receipt})
      });
      const data = await response.json();
      if (!response.ok || !data.ok || !data.verified) {
        if (response.status === 409) throw Error('別の編集がありました。更新して最新の状態を確認してください。');
        if (data.error === 'completion_evidence_required') throw Error('DONEには完了の証跡が必要です。');
        throw Error('保存できませんでした。Google Sheets連携をご確認ください。');
      }
      item.status = data.status;
      item.sourceRevision = data.sourceRevision;
      item.sourceUpdatedAt = data.sourceUpdatedAt;
      item.sourceEditBy = data.sourceEditBy;
      moveMessage('Google Sheetsへの保存・再読取を確認しました。Supabase同期は後から反映されます。');
      $('pipeline-detail').close();
    } catch(error) {
      moveMessage(error.message || '保存できませんでした。画面上の状態は変更していません。', true);
      if ($('pipeline-detail').open) $('pipeline-detail-write-note').textContent = error.message || '保存失敗';
    } finally {
      saving = false;
      if (loaded) renderBoard();
      $('pipeline-move-submit').disabled = !writeEnabled;
    }
  }

  async function load() {
    const button = $('pipeline-reload');
    button.disabled = true;
    $('pipeline-sync').textContent = '読み込み中…';
    try {
      const response = await fetch('/api/dashboard/task-execution?limit=300', {credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}});
      if (!response.ok) throw new Error('HTTP ' + response.status);
      const payload = await response.json();
      if (!payload.ok || !Array.isArray(payload.items)) throw new Error('read_model_unavailable');
      tasks = payload.items;
      loaded = true;
      renderBoard();
      await refreshWriter();
      const last = payload.summary && payload.summary.lastSourceSyncAt;
      if (last && !Number.isNaN(Date.parse(last))) {
        const date = new Intl.DateTimeFormat('ja-JP',{timeZone:'Asia/Tokyo',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}).format(new Date(last));
        $('pipeline-sync').textContent += ' · 最終同期 ' + date;
      }
    } catch(error) {
      loaded = false;
      tasks = [];
      kpis.replaceChildren();
      board.replaceChildren();
      const errorBox = append(board, 'div', 'pipeline-error');
      append(errorBox, 'strong', '', 'TASK_BOARDの情報を取得できませんでした');
      append(errorBox, 'p', '', 'ログイン・連携・同期状況をご確認ください。失敗時は架空の値を表示しません。');
      const source = append(errorBox, 'a', '', '既存Task Flowを開く →');
      source.href = '/dashboard/tasks';
      $('pipeline-sync').textContent = '取得失敗';
      $('pipeline-alert-title').textContent = '接続を確認してください';
      $('pipeline-alert-body').textContent = '表示は前回の値ではなく、取得状態を明示しています。';
    } finally {
      button.disabled = false;
    }
  }
  document.querySelectorAll('.pipeline-filters button').forEach(button => {
    button.addEventListener('click', () => {
      scope = button.dataset.scope || 'actionable';
      document.querySelectorAll('.pipeline-filters button').forEach(target => target.setAttribute('aria-pressed', String(target === button)));
      renderBoard();
    });
  });
  $('pipeline-search').addEventListener('input', event => {
    search = event.target.value.trim().toLocaleLowerCase('ja-JP');
    renderBoard();
  });
  $('pipeline-reload').addEventListener('click', load);
  $('pipeline-move-target').addEventListener('change', updateReceiptField);
  $('pipeline-move-submit').addEventListener('click', () => {
    if (selectedTask) void moveTask(selectedTask, $('pipeline-move-target').value, $('pipeline-move-receipt').value);
  });
  $('pipeline-close').addEventListener('click', () => $('pipeline-detail').close());
  $('pipeline-dismiss').addEventListener('click', () => $('pipeline-detail').close());
  $('pipeline-detail').addEventListener('click', event => {
    if (event.target === $('pipeline-detail')) $('pipeline-detail').close();
  });
  load();
})();
</script>

<style is:global>
.pipeline-shell { --pp-bg:#f5f4f1;--pp-line:#dddcd7;--pp-muted:#6a717d;--pp-ink:#1a202a;max-width:1560px;margin-inline:auto;color:var(--pp-ink);padding-bottom:44px; }
.pipeline-shell button {font:inherit;cursor:pointer;}
.pipeline-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:23px;}
.pipeline-kicker{font-size:11px;letter-spacing:.13em;font-weight:700;color:#916d39;}
