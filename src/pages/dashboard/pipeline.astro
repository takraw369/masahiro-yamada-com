.pipeline-task-date{font-size:10px;color:#888d94;white-space:nowrap;}
.pipeline-task-project{display:block;color:#8b8e95;font-size:10px;margin:10px 0 3px;overflow-wrap:anywhere;}
.pipeline-task-title{display:block;font-size:12px;line-height:1.6;font-weight:700;overflow-wrap:anywhere;}
.pipeline-task-next{display:block;font-size:11px;line-height:1.65;color:#69717d;margin:10px 0;padding:9px 0;border-top:1px solid #ececea;border-bottom:1px solid #ececea;overflow-wrap:anywhere;}
.pipeline-task-next b{color:#88662e;font-size:9px;letter-spacing:.06em;}
.pipeline-task-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;color:#797f89;font-size:10px;min-width:0;}
.pipeline-owner{display:inline-block;background:#f2f4f6;padding:4px 6px;border-radius:5px;overflow-wrap:anywhere;}
.pipeline-id{font-variant-numeric:tabular-nums;overflow-wrap:anywhere;text-align:right;font-size:9px;}
.pipeline-empty{font-size:11px;color:#95999e;text-align:center;padding:24px 5px;border:1px dashed #ddd;border-radius:8px;}
.pipeline-loading,.pipeline-error{width:100%;background:#fff;padding:22px;border:1px solid var(--pp-line);border-radius:12px;color:#69717d;font-size:13px;}
.pipeline-error strong{color:#914a3e;display:block;}
.pipeline-error p{margin:9px 0;}
.pipeline-error a{color:#7b5525;}
.pipeline-footer{display:grid;gap:5px;margin-top:12px;font-size:11px;color:#757b83;}
.pipeline-dialog{border:1px solid #e0dbd2;border-radius:16px;padding:22px;width:min(540px,calc(100% - 26px));max-height:min(80vh,780px);box-shadow:0 24px 70px #0004;}
.pipeline-dialog::backdrop{background:#111d2b99;}
