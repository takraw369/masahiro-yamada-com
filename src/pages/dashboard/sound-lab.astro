---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const sounds = [
  { id:'tap', label:'ピッ', name:'Tap', category:'UI', feel:'軽い / 速い', use:'選択・小さな操作' },
  { id:'pin', label:'ピン', name:'Confirm', category:'UI', feel:'明るい / 一点', use:'決定・確定' },
  { id:'pop', label:'ポン', name:'Pop', category:'EDIT', feel:'丸い / 楽しい', use:'カード・テロップ出現' },
  { id:'tick', label:'コッ', name:'Accent', category:'EDIT', feel:'短い / 硬い', use:'強調・注意' },
  { id:'sparkle', label:'キラッ', name:'Sparkle', category:'REWARD', feel:'軽快 / ご褒美', use:'正解・発見' },
  { id:'clear', label:'ティロン', name:'Quest Clear', category:'REWARD', feel:'余韻 / 達成', use:'Quest完了' },
  { id:'level', label:'ピロリン', name:'Level Up', category:'REWARD', feel:'上昇 / 特別', use:'成長・昇格' },
  { id:'streak', label:'ピッピッピン', name:'Streak', category:'REWARD', feel:'テンポ / 加速', use:'連続達成・コンボ' },
  { id:'whoosh', label:'シュン', name:'Whoosh', category:'MOTION', feel:'移動 / 速度', use:'遷移・解放' },
  { id:'bounce', label:'ポヨン', name:'Bounce', category:'MOTION', feel:'柔らかい / コミカル', use:'ズーム・リアクション' },
  { id:'stamp', label:'ドン', name:'Stamp', category:'EDIT', feel:'低い / 太い', use:'大見出し・決め' },
  { id:'moon', label:'コォン…', name:'Moon Resonance', category:'WORLD', feel:'静けさ / 深さ', use:'章・世界・月' },
  { id:'ting', label:'チンッ', name:'Caption Hit', category:'EDIT', feel:'鋭い / 瞬間', use:'音ハメ・字幕強調' },
  { id:'boing', label:'ボヨン', name:'Reaction', category:'MOTION', feel:'コミカル / 意外', use:'リアクション・オチ' },
];

const slots = [
  { id:'ui.tap', group:'UI', title:'タップ / 選択', detail:'カードやボタンを触った瞬間', defaultSound:'tap' },
  { id:'ui.confirm', group:'UI', title:'決定 / 確定', detail:'選択を決めた瞬間', defaultSound:'pin' },
  { id:'quest.correct', group:'QUEST', title:'正解 / 発見', detail:'答えが合った・気づいた瞬間', defaultSound:'sparkle' },
  { id:'quest.clear', group:'QUEST', title:'Quest完了', detail:'一区切りの達成', defaultSound:'clear' },
  { id:'quest.levelup', group:'QUEST', title:'Level Up', detail:'成長・昇格・新要素解放', defaultSound:'level' },
  { id:'quest.streak', group:'QUEST', title:'連続達成', detail:'3日・7日・コンボなど', defaultSound:'streak' },
  { id:'video.caption', group:'VIDEO', title:'テロップ出現', detail:'文字がパッと出る瞬間', defaultSound:'pop' },
  { id:'video.emphasis', group:'VIDEO', title:'強調ワード', detail:'重要語や決め台詞を刺す', defaultSound:'ting' },
  { id:'video.reaction', group:'VIDEO', title:'リアクション', detail:'驚き・ズーム・オチ', defaultSound:'boing' },
  { id:'video.transition', group:'VIDEO', title:'画面遷移', detail:'場面が切り替わる瞬間', defaultSound:'whoosh' },
  { id:'video.stamp', group:'VIDEO', title:'大見出し / ドン', detail:'章タイトル・強い一言', defaultSound:'stamp' },
  { id:'world.unlock', group:'WORLD', title:'世界 / 章の解放', detail:'ACE世界観の大きな節目', defaultSound:'moon' },
];
---

<DashboardLayout title="Sound Map" eyebrow="ACE EXPERIENCE DESIGN">
  <main class="sound-shell">
    <header class="hero">
      <div>
        <p class="kicker">ACE SOUND MAP · ACTION × SOUND</p>
        <h1>この瞬間には、この音。</h1>
        <p class="lead">音を探すだけで終わらせず、Quest・UI・動画の「瞬間」に音を割り当てる。ここで決めた組み合わせを、今後のコンテンツ生成ルールとして使う。</p>
      </div>
      <div class="hero-actions">
        <button id="preview-flow" class="primary">▶ FLOWを試す</button>
        <button id="copy-manifest">AI用ルールをコピー</button>
      </div>
    </header>

    <section class="map-section" aria-labelledby="map-title">
      <div class="section-head">
        <div><p class="kicker">01 · MAP</p><h2 id="map-title">使う場面と音を組み合わせる</h2></div>
        <span id="save-state">ブラウザに自動保存</span>
      </div>

      <div class="slot-grid">
        {slots.map(slot => (
          <article class="slot-card" data-slot-card={slot.id}>
            <div class="slot-copy">
              <small>{slot.group}</small>
              <strong>{slot.title}</strong>
              <span>{slot.detail}</span>
              <code>{slot.id}</code>
            </div>
            <div class="slot-control">
              <select class="sound-select" data-slot={slot.id} aria-label={`${slot.title}の効果音`}>
                <option value="none">— 音なし —</option>
                {sounds.map(sound => (
                  <option value={sound.id} selected={sound.id === slot.defaultSound}>{sound.label} · {sound.name}</option>
                ))}
              </select>
              <button class="slot-play" data-play-slot={slot.id} aria-label={`${slot.title}の割り当て音を再生`}>▶</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bank-section" aria-labelledby="bank-title">
      <div class="section-head">
        <div><p class="kicker">02 · SOUND BANK</p><h2 id="bank-title">音だけ聴き比べる</h2></div>
        <label class="volume">VOLUME <input id="volume" type="range" min="0.05" max="0.5" step="0.01" value="0.22" /></label>
      </div>
      <div class="sound-grid">
        {sounds.map(sound => (
          <article class="sound-card" data-sound-card={sound.id} data-category={sound.category}>
            <div class="sound-top"><small>{sound.category}</small><span>{sound.feel}</span></div>
            <button class="sound-play" data-sound={sound.id}>
              <b>{sound.label}</b>
              <em>▶</em>
            </button>
            <strong>{sound.name}</strong>
            <p>{sound.use}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="reference-section">
      <div>
        <p class="kicker">03 · REFERENCE</p>
        <h2>外部素材は「参考」として探す</h2>
        <p>効果音ラボなどで方向性を探す場合は原サイト上で試聴する。ACE側には外部音源を転載・直リンクせず、必要なら正式採用後に用途へ組み込む。</p>
      </div>
      <a href="https://soundeffect-lab.info/sound/button/" target="_blank" rel="noreferrer">効果音ラボ · ボタン音を開く ↗</a>
    </section>

    <section class="manifest-section">
      <div>
        <p class="kicker">04 · GENERATION RULE</p>
        <h2>このマップを今後の生成ルールへ</h2>
        <p>「AI用ルールをコピー」で、Quest・動画・UI制作時にそのまま渡せる機械可読JSON＋人間向け一覧を生成する。</p>
      </div>
      <div class="manifest-actions">
        <button id="copy-json">JSONだけコピー</button>
        <button id="reset-map">初期設定へ戻す</button>
      </div>
      <pre id="manifest-preview" aria-live="polite"></pre>
    </section>
  </main>
</DashboardLayout>

<script>
  let audioCtx;
  const getCtx = () => {
    audioCtx ??= new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  };

  const volumeEl = document.querySelector('#volume');
  const volume = () => Number(volumeEl?.value || 0.22);

  function tone(freq, start, duration, type = 'sine', gain = 1, endFreq = null) {
    const ctx = getCtx();
    const osc = ctx.createOscillator();
    const amp = ctx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, start);
    if (endFreq) osc.frequency.exponentialRampToValueAtTime(endFreq, start + duration);
    amp.gain.setValueAtTime(Math.max(0.0001, volume() * gain), start);
    amp.gain.exponentialRampToValueAtTime(0.0001, start + duration);
    osc.connect(amp).connect(ctx.destination);
    osc.start(start);
    osc.stop(start + duration + 0.02);
  }

  function noise(start, duration, gain = .45, highpass = 800) {
    const ctx = getCtx();
    const buffer = ctx.createBuffer(1, Math.floor(ctx.sampleRate * duration), ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    const filter = ctx.createBiquadFilter();
    const amp = ctx.createGain();
    src.buffer = buffer;
    filter.type = 'highpass';
    filter.frequency.value = highpass;
    amp.gain.setValueAtTime(volume() * gain, start);
    amp.gain.exponentialRampToValueAtTime(0.0001, start + duration);
    src.connect(filter).connect(amp).connect(ctx.destination);
    src.start(start);
  }

  function playSound(id) {
    if (!id || id === 'none') return;
    const ctx = getCtx();
    const t = ctx.currentTime + 0.015;
    switch (id) {
      case 'tap': tone(820,t,.055,'sine',.55,930); break;
      case 'pin': tone(1180,t,.14,'sine',.72,1480); tone(1760,t+.025,.11,'sine',.26,2100); break;
      case 'pop': tone(320,t,.11,'sine',.8,520); tone(650,t+.025,.07,'triangle',.22,760); break;
      case 'tick': tone(1450,t,.045,'square',.22,1050); noise(t,.035,.12,2200); break;
      case 'sparkle': [1260,1680,2240].forEach((f,i)=>tone(f,t+i*.045,.12,'sine',.42-i*.07,f*1.06)); break;
      case 'clear': [660,880,1100].forEach((f,i)=>tone(f,t+i*.085,.25,'sine',.42-i*.06,f*1.02)); break;
      case 'level': [620,830,1110,1480].forEach((f,i)=>tone(f,t+i*.06,.16,'triangle',.42-i*.05,f*1.08)); break;
      case 'streak': tone(760,t,.05,'sine',.45,860); tone(900,t+.085,.05,'sine',.48,1000); tone(1320,t+.17,.13,'sine',.64,1650); break;
      case 'whoosh': noise(t,.22,.5,900); tone(260,t,.2,'sine',.14,720); break;
      case 'bounce': tone(240,t,.16,'sine',.65,420); tone(370,t+.11,.13,'sine',.34,290); break;
      case 'stamp': tone(115,t,.16,'triangle',.72,72); noise(t,.08,.16,120); break;
      case 'moon': tone(196,t,.9,'sine',.36,185); tone(392,t+.05,.7,'sine',.18,370); tone(588,t+.12,.55,'sine',.08,560); break;
      case 'ting': tone(1520,t,.075,'sine',.62,1760); tone(3020,t+.012,.05,'sine',.18,3300); break;
      case 'boing': tone(180,t,.24,'sine',.7,420); tone(420,t+.13,.18,'sine',.38,230); break;
    }
  }

  const storageKey = 'ace-sound-map:v1';
  const selects = [...document.querySelectorAll('.sound-select')];
  const defaultMap = Object.fromEntries(selects.map(select => [select.dataset.slot, select.value]));

  function currentMap() {
    return Object.fromEntries(selects.map(select => [select.dataset.slot, select.value]));
  }

  function soundLabel(id) {
    for (const select of selects) {
      const option = [...select.options].find(o => o.value === id);
      if (option) return option.textContent.trim();
    }
    return id;
  }

  function saveMap() {
    localStorage.setItem(storageKey, JSON.stringify(currentMap()));
    const state = document.querySelector('#save-state');
    if (state) {
      state.textContent = '保存しました ✓';
      setTimeout(() => state.textContent = 'ブラウザに自動保存', 1000);
    }
    renderManifest();
  }

  function loadMap() {
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
      selects.forEach(select => {
        if (saved[select.dataset.slot] && [...select.options].some(o => o.value === saved[select.dataset.slot])) {
          select.value = saved[select.dataset.slot];
        }
      });
    } catch {}
    renderManifest();
  }

  function manifest() {
    return {
      schema: 'ace.sound-map.v1',
      purpose: 'Use this sound mapping consistently in ACE UI, Quest, video and generated content.',
      mapping: currentMap(),
    };
  }

  function renderManifest() {
    const pre = document.querySelector('#manifest-preview');
    if (pre) pre.textContent = JSON.stringify(manifest(), null, 2);
  }

  async function copyText(text, button) {
    await navigator.clipboard.writeText(text);
    if (!button) return;
    const before = button.textContent;
    button.textContent = 'コピー済み ✓';
    setTimeout(() => button.textContent = before, 1200);
  }

  document.querySelectorAll('[data-sound]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.sound;
      playSound(id);
      const card = btn.closest('.sound-card');
      card?.classList.remove('playing');
      requestAnimationFrame(() => card?.classList.add('playing'));
      setTimeout(() => card?.classList.remove('playing'), 420);
    });
  });

  document.querySelectorAll('[data-play-slot]').forEach(btn => {
    btn.addEventListener('click', () => {
      const slot = btn.dataset.playSlot;
      const select = document.querySelector(`[data-slot="${slot}"]`);
      playSound(select?.value);
      const card = btn.closest('.slot-card');
      card?.classList.remove('hit');
      requestAnimationFrame(() => card?.classList.add('hit'));
      setTimeout(() => card?.classList.remove('hit'), 520);
    });
  });

  selects.forEach(select => {
    select.addEventListener('change', () => {
      playSound(select.value);
      saveMap();
      const card = select.closest('.slot-card');
      card?.classList.remove('hit');
      requestAnimationFrame(() => card?.classList.add('hit'));
      setTimeout(() => card?.classList.remove('hit'), 520);
    });
  });

  document.querySelector('#preview-flow')?.addEventListener('click', async () => {
    const sequence = ['ui.tap','ui.confirm','quest.correct','video.caption','video.emphasis','quest.clear','world.unlock'];
    for (const slot of sequence) {
      const select = document.querySelector(`[data-slot="${slot}"]`);
      const card = document.querySelector(`[data-slot-card="${slot}"]`);
      card?.classList.add('hit');
      playSound(select?.value);
      await new Promise(resolve => setTimeout(resolve, slot === 'world.unlock' ? 900 : 420));
      card?.classList.remove('hit');
    }
  });

  document.querySelector('#copy-json')?.addEventListener('click', e => {
    copyText(JSON.stringify(manifest(), null, 2), e.currentTarget);
  });

  document.querySelector('#copy-manifest')?.addEventListener('click', e => {
    const map = currentMap();
    const lines = Object.entries(map).map(([slot, sound]) => `- ${slot} → ${soundLabel(sound)} [${sound}]`).join('\n');
    const text = `ACE SOUND MAP v1\n今後のACE UI / Quest / 動画 / コンテンツ生成では、以下の音ハメを基本ルールとして使う。\n${lines}\n\nJSON:\n${JSON.stringify(manifest(), null, 2)}`;
    copyText(text, e.currentTarget);
  });

  document.querySelector('#reset-map')?.addEventListener('click', () => {
    selects.forEach(select => select.value = defaultMap[select.dataset.slot]);
    localStorage.removeItem(storageKey);
    renderManifest();
  });

  loadMap();
</script>

<style>
  .sound-shell{--line:#e2ded7;--muted:#737b84;max-width:1180px;margin:0 auto;padding-bottom:52px}.kicker{margin:0;color:var(--gold-muted);font-size:.69rem;font-weight:900;letter-spacing:.13em}.hero{display:grid;grid-template-columns:1fr auto;gap:28px;align-items:end}.hero h1{margin:5px 0 0;font-size:clamp(2.15rem,5vw,4rem);letter-spacing:-.045em;line-height:1}.lead{max-width:760px;margin:14px 0 0;color:var(--muted);line-height:1.85;font-size:.94rem}.hero-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.hero-actions button,.manifest-actions button{padding:11px 14px;border:1px solid var(--line);border-radius:11px;background:#fff;color:#30363d;font-size:.72rem;font-weight:800;cursor:pointer}.hero-actions .primary{background:#20242a;color:#fff;border-color:#20242a}
  .map-section,.bank-section,.reference-section,.manifest-section{margin-top:22px;padding:22px;border:1px solid var(--line);border-radius:20px;background:rgba(255,255,255,.76)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:18px}.section-head h2,.reference-section h2,.manifest-section h2{margin:4px 0 0;font-size:1.08rem}.section-head>span{color:#8b939b;font-size:.69rem}.slot-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:16px}.slot-card{display:grid;grid-template-columns:1fr minmax(220px,.8fr);align-items:center;gap:16px;padding:14px;border:1px solid #e6e2dc;border-radius:14px;background:#fff;transition:.18s transform,.18s border-color,.18s box-shadow}.slot-card.hit{transform:scale(1.012);border-color:#b89970;box-shadow:0 10px 28px rgba(94,70,40,.12)}.slot-copy small,.slot-copy strong,.slot-copy span,.slot-copy code{display:block}.slot-copy small{color:#9a6a32;font-size:.61rem;letter-spacing:.1em;font-weight:900}.slot-copy strong{margin-top:4px;font-size:.86rem}.slot-copy span{margin-top:2px;color:var(--muted);font-size:.69rem}.slot-copy code{margin-top:7px;color:#a2a8ae;font-size:.58rem}.slot-control{display:grid;grid-template-columns:1fr 38px;gap:7px}.sound-select{min-width:0;width:100%;padding:9px 10px;border:1px solid #dedad4;border-radius:10px;background:#faf9f7;color:#333;font-size:.72rem}.slot-play{border:1px solid #dedad4;border-radius:10px;background:#fff;color:#6f5434;cursor:pointer;font-size:.72rem}
  .volume{display:flex;align-items:center;gap:9px;color:#8b939b;font-size:.64rem;font-weight:800;letter-spacing:.08em}.volume input{width:120px}.sound-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:16px}.sound-card{padding:12px;border:1px solid #e7e3dd;border-radius:14px;background:#fff;transition:.16s transform,.16s border-color}.sound-card.playing{transform:translateY(-3px);border-color:#b89970}.sound-top{display:flex;justify-content:space-between;gap:8px;color:#9299a0;font-size:.58rem}.sound-top small{color:#9a6a32;font-weight:900}.sound-play{width:100%;min-height:68px;margin-top:8px;display:flex;align-items:center;justify-content:space-between;padding:0 13px;border:0;border-radius:12px;background:#f7f5f1;cursor:pointer}.sound-play b{font-size:1.15rem}.sound-play em{font-style:normal;color:#9a6a32}.sound-card>strong{display:block;margin-top:9px;font-size:.77rem}.sound-card>p{margin:2px 0 0;color:var(--muted);font-size:.65rem}
  .reference-section,.manifest-section{display:grid;grid-template-columns:1fr auto;align-items:center;gap:22px}.reference-section p,.manifest-section p{max-width:760px;margin:7px 0 0;color:var(--muted);font-size:.74rem;line-height:1.65}.reference-section>a{padding:12px 14px;border:1px solid #d8d3cb;border-radius:11px;background:#fff;text-decoration:none;font-size:.72rem;font-weight:800;white-space:nowrap}.manifest-section{grid-template-columns:1fr auto}.manifest-actions{display:flex;gap:8px}.manifest-section pre{grid-column:1/-1;max-height:280px;overflow:auto;margin:14px 0 0;padding:14px;border-radius:12px;background:#20242a;color:#dfe6ed;font-size:.66rem;line-height:1.55}
  @media(max-width:900px){.hero{grid-template-columns:1fr}.hero-actions{justify-content:flex-start}.slot-grid{grid-template-columns:1fr}.sound-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.reference-section,.manifest-section{grid-template-columns:1fr}.manifest-actions{justify-content:flex-start}}
  @media(max-width:620px){.map-section,.bank-section,.reference-section,.manifest-section{padding:16px}.slot-card{grid-template-columns:1fr}.sound-grid{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}.hero h1{font-size:2.45rem}.volume{width:100%;justify-content:space-between}.hero-actions,.manifest-actions{width:100%}.hero-actions button,.manifest-actions button{flex:1}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
</style>
