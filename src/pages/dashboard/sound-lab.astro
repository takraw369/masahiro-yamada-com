---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const sounds = [
  { id:'none', label:'—', name:'音なし' },
  { id:'tap', label:'ピッ', name:'Tap' },
  { id:'pin', label:'ピン', name:'Confirm' },
  { id:'pop', label:'ポン', name:'Pop' },
  { id:'tick', label:'コッ', name:'Accent' },
  { id:'sparkle', label:'キラッ', name:'Sparkle' },
  { id:'clear', label:'ティロン', name:'Quest Clear' },
  { id:'level', label:'ピロリン', name:'Level Up' },
  { id:'streak', label:'ピッピッピン', name:'Streak' },
  { id:'whoosh', label:'シュン', name:'Whoosh' },
  { id:'bounce', label:'ポヨン', name:'Bounce' },
  { id:'stamp', label:'ドン', name:'Stamp' },
  { id:'moon', label:'コォン…', name:'Moon Resonance' },
  { id:'ting', label:'チンッ', name:'Caption Hit' },
  { id:'boing', label:'ボヨン', name:'Reaction' },
];

const motions = [
  { id:'none', label:'動きなし' },
  { id:'pop', label:'POP · 0.18s' },
  { id:'punch', label:'PUNCH · 0.22s' },
  { id:'bounce', label:'BOUNCE · 0.38s' },
  { id:'slide', label:'SLIDE · 0.28s' },
  { id:'zoom', label:'ZOOM · 0.24s' },
  { id:'shake', label:'SHAKE · 0.30s' },
  { id:'float', label:'FLOAT · 0.55s' },
  { id:'reveal', label:'REVEAL · 0.42s' },
];

const captions = [
  { id:'none', label:'文字なし' },
  { id:'clean', label:'CLEAN · 普通' },
  { id:'bold', label:'BOLD · 強調' },
  { id:'boxed', label:'BOX · 囲み' },
  { id:'stamp', label:'STAMP · 決め' },
  { id:'spark', label:'SPARK · 発見' },
  { id:'comic', label:'COMIC · リアクション' },
  { id:'world', label:'WORLD · 世界観' },
];

const slots = [
  { id:'ui.tap', group:'UI', title:'タップ / 選択', detail:'カードやボタンを触った瞬間', text:'SELECT', sound:'tap', motion:'pop', caption:'clean' },
  { id:'ui.confirm', group:'UI', title:'決定 / 確定', detail:'選択を決めた瞬間', text:'DECIDED', sound:'pin', motion:'punch', caption:'boxed' },
  { id:'quest.correct', group:'QUEST', title:'正解 / 発見', detail:'答えが合った・気づいた瞬間', text:'NICE!', sound:'sparkle', motion:'pop', caption:'spark' },
  { id:'quest.clear', group:'QUEST', title:'Quest完了', detail:'一区切りの達成', text:'QUEST CLEAR', sound:'clear', motion:'zoom', caption:'bold' },
  { id:'quest.levelup', group:'QUEST', title:'Level Up', detail:'成長・昇格・新要素解放', text:'LEVEL UP', sound:'level', motion:'bounce', caption:'spark' },
  { id:'quest.streak', group:'QUEST', title:'連続達成', detail:'3日・7日・コンボなど', text:'7 DAY STREAK', sound:'streak', motion:'punch', caption:'bold' },
  { id:'video.caption', group:'VIDEO', title:'テロップ出現', detail:'文字がパッと出る瞬間', text:'ここ、大事。', sound:'pop', motion:'pop', caption:'boxed' },
  { id:'video.emphasis', group:'VIDEO', title:'強調ワード', detail:'重要語や決め台詞を刺す', text:'本質', sound:'ting', motion:'punch', caption:'bold' },
  { id:'video.reaction', group:'VIDEO', title:'リアクション', detail:'驚き・ズーム・オチ', text:'えっ!?', sound:'boing', motion:'bounce', caption:'comic' },
  { id:'video.transition', group:'VIDEO', title:'画面遷移', detail:'場面が切り替わる瞬間', text:'NEXT', sound:'whoosh', motion:'slide', caption:'clean' },
  { id:'video.stamp', group:'VIDEO', title:'大見出し / ドン', detail:'章タイトル・強い一言', text:'結論', sound:'stamp', motion:'zoom', caption:'stamp' },
  { id:'world.unlock', group:'WORLD', title:'世界 / 章の解放', detail:'ACE世界観の大きな節目', text:'NEW WORLD', sound:'moon', motion:'reveal', caption:'world' },
];
---

<DashboardLayout title="Cue Lab" eyebrow="ACE EXPERIENCE DESIGN">
  <main class="cue-shell">
    <header class="hero">
      <div>
        <p class="kicker">ACE CUE LAB · MOTION × SOUND × CAPTION</p>
        <h1>演出を、一度決めて使い回す。</h1>
        <p class="lead">Quest・Dashboard・動画で毎回ゼロから考えない。場面ごとに「動き・音・テロップ」を組み合わせ、そのままACEの生成ルールとして保存する。</p>
      </div>
      <div class="hero-actions">
        <button id="preview-flow" class="primary">▶ FLOWを試す</button>
        <button id="copy-manifest">AI用ルールをコピー</button>
      </div>
    </header>

    <section class="stage-section" aria-labelledby="stage-title">
      <div class="section-head">
        <div><p class="kicker">LIVE PREVIEW</p><h2 id="stage-title">音ハメをその場で確認</h2></div>
        <label class="volume">VOLUME <input id="volume" type="range" min="0.05" max="0.5" step="0.01" value="0.22" /></label>
      </div>
      <div class="stage" id="stage">
        <div class="stage-orbit"></div>
        <div id="stage-caption" class="stage-caption caption-clean">SELECT</div>
        <p id="stage-meta">ui.tap · POP + ピッ + CLEAN</p>
      </div>
    </section>

    <section class="map-section" aria-labelledby="map-title">
      <div class="section-head">
        <div><p class="kicker">01 · CUE MAP</p><h2 id="map-title">場面ごとに3つを組み合わせる</h2></div>
        <span id="save-state">ブラウザに自動保存</span>
      </div>

      <div class="slot-grid">
        {slots.map(slot => (
          <article class="slot-card" data-slot-card={slot.id}>
            <div class="slot-copy">
              <small>{slot.group}</small>
              <strong>{slot.title}</strong>
              <span>{slot.detail}</span>
              <code>{slot.id}</code>
            </div>
            <div class="cue-controls">
              <label>TEXT<input class="text-input" data-kind="text" data-slot={slot.id} value={slot.text} aria-label={`${slot.title}の表示テキスト`} /></label>
              <label>MOTION<select class="cue-select" data-kind="motion" data-slot={slot.id} aria-label={`${slot.title}の動き`}>
                {motions.map(item => <option value={item.id} selected={item.id === slot.motion}>{item.label}</option>)}
              </select></label>
              <label>SOUND<select class="cue-select" data-kind="sound" data-slot={slot.id} aria-label={`${slot.title}の効果音`}>
                {sounds.map(item => <option value={item.id} selected={item.id === slot.sound}>{item.label} · {item.name}</option>)}
              </select></label>
              <label>CAPTION<select class="cue-select" data-kind="caption" data-slot={slot.id} aria-label={`${slot.title}のテロップスタイル`}>
                {captions.map(item => <option value={item.id} selected={item.id === slot.caption}>{item.label}</option>)}
              </select></label>
              <button class="slot-preview" data-preview-slot={slot.id}>▶ この組み合わせ</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="preset-section">
      <div>
        <p class="kicker">02 · QUICK PRESETS</p>
        <h2>迷ったらテンポから選ぶ</h2>
        <p>全体の音・動きを一気に寄せる。個別調整はその後で。</p>
      </div>
      <div class="preset-grid">
        <button data-preset="minimal"><b>MINIMAL</b><span>静か / UI中心 / 音少なめ</span></button>
        <button data-preset="variety"><b>VARIETY</b><span>韓国TV的 / テンポ / 音ハメ多め</span></button>
        <button data-preset="quest"><b>QUEST</b><span>達成感 / 成長 / ご褒美重視</span></button>
        <button data-preset="world"><b>WORLD</b><span>幻想 / 余韻 / ACE世界観</span></button>
      </div>
    </section>

    <section class="reference-section">
      <div>
        <p class="kicker">03 · REFERENCE</p>
        <h2>外部素材は方向性探しに使う</h2>
        <p>参考サイト上で試聴し、ACE側ではオリジナル音と演出ルールを正本化する。</p>
      </div>
      <a href="https://soundeffect-lab.info/sound/button/" target="_blank" rel="noreferrer">効果音ラボ · ボタン音 ↗</a>
    </section>

    <section class="manifest-section">
      <div>
        <p class="kicker">04 · GENERATION RULE</p>
        <h2>動画・Quest・UI生成へ渡す</h2>
        <p>選んだ「場面 → 動き → 音 → テロップ」を機械可読JSONにする。今後の生成エージェントや動画編集指示の共通ルールにできる。</p>
      </div>
      <div class="manifest-actions">
        <button id="copy-json">JSONだけコピー</button>
        <button id="reset-map">初期設定へ戻す</button>
      </div>
      <pre id="manifest-preview" aria-live="polite"></pre>
    </section>
  </main>
</DashboardLayout>

<script>
  let audioCtx;
  const getCtx = () => {
    const AudioContextCtor = window.AudioContext || window['webkitAudioContext'];
    audioCtx ??= new AudioContextCtor();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  };

  const volumeEl = document.querySelector('#volume');
  const volume = () => Number(volumeEl?.value || 0.22);

  function tone(freq, start, duration, type = 'sine', gain = 1, endFreq = null) {
    const ctx = getCtx();
    const osc = ctx.createOscillator();
    const amp = ctx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, start);
    if (endFreq) osc.frequency.exponentialRampToValueAtTime(endFreq, start + duration);
    amp.gain.setValueAtTime(Math.max(0.0001, volume() * gain), start);
    amp.gain.exponentialRampToValueAtTime(0.0001, start + duration);
    osc.connect(amp).connect(ctx.destination);
    osc.start(start);
    osc.stop(start + duration + 0.02);
  }

  function noise(start, duration, gain = .45, highpass = 800) {
    const ctx = getCtx();
    const buffer = ctx.createBuffer(1, Math.floor(ctx.sampleRate * duration), ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    const filter = ctx.createBiquadFilter();
    const amp = ctx.createGain();
    src.buffer = buffer;
    filter.type = 'highpass';
    filter.frequency.value = highpass;
    amp.gain.setValueAtTime(volume() * gain, start);
    amp.gain.exponentialRampToValueAtTime(0.0001, start + duration);
    src.connect(filter).connect(amp).connect(ctx.destination);
    src.start(start);
  }

  function playSound(id) {
    if (!id || id === 'none') return;
    const ctx = getCtx();
    const t = ctx.currentTime + 0.015;
    switch (id) {
      case 'tap': tone(820,t,.055,'sine',.55,930); break;
      case 'pin': tone(1180,t,.14,'sine',.72,1480); tone(1760,t+.025,.11,'sine',.26,2100); break;
      case 'pop': tone(320,t,.11,'sine',.8,520); tone(650,t+.025,.07,'triangle',.22,760); break;
      case 'tick': tone(1450,t,.045,'square',.22,1050); noise(t,.035,.12,2200); break;
      case 'sparkle': [1260,1680,2240].forEach((f,i)=>tone(f,t+i*.045,.12,'sine',.42-i*.07,f*1.06)); break;
      case 'clear': [660,880,1100].forEach((f,i)=>tone(f,t+i*.085,.25,'sine',.42-i*.06,f*1.02)); break;
      case 'level': [620,830,1110,1480].forEach((f,i)=>tone(f,t+i*.06,.16,'triangle',.42-i*.05,f*1.08)); break;
      case 'streak': tone(760,t,.05,'sine',.45,860); tone(900,t+.085,.05,'sine',.48,1000); tone(1320,t+.17,.13,'sine',.64,1650); break;
      case 'whoosh': noise(t,.22,.5,900); tone(260,t,.2,'sine',.14,720); break;
      case 'bounce': tone(240,t,.16,'sine',.65,420); tone(370,t+.11,.13,'sine',.34,290); break;
      case 'stamp': tone(115,t,.16,'triangle',.72,72); noise(t,.08,.16,120); break;
      case 'moon': tone(196,t,.9,'sine',.36,185); tone(392,t+.05,.7,'sine',.18,370); tone(588,t+.12,.55,'sine',.08,560); break;
      case 'ting': tone(1520,t,.075,'sine',.62,1760); tone(3020,t+.012,.05,'sine',.18,3300); break;
      case 'boing': tone(180,t,.24,'sine',.7,420); tone(420,t+.13,.18,'sine',.38,230); break;
    }
  }

  const storageKey = 'ace-cue-map:v1';
  const controls = [...document.querySelectorAll('[data-slot][data-kind]')];
  const defaults = {};
  controls.forEach(control => {
    defaults[control.dataset.slot] ??= {};
    defaults[control.dataset.slot][control.dataset.kind] = control.value;
  });

  function currentMap() {
    const map = {};
    controls.forEach(control => {
      map[control.dataset.slot] ??= {};
      map[control.dataset.slot][control.dataset.kind] = control.value;
    });
    return map;
  }

  function controlFor(slot, kind) {
    return document.querySelector(`[data-slot="${slot}"][data-kind="${kind}"]`);
  }

  function cueFor(slot) {
    return {
      text: controlFor(slot, 'text')?.value || '',
      motion: controlFor(slot, 'motion')?.value || 'none',
      sound: controlFor(slot, 'sound')?.value || 'none',
      caption: controlFor(slot, 'caption')?.value || 'none',
    };
  }

  function previewCue(slot) {
    const cue = cueFor(slot);
    const caption = document.querySelector('#stage-caption');
    const meta = document.querySelector('#stage-meta');
    if (!caption || !meta) return;
    caption.className = `stage-caption caption-${cue.caption}`;
    caption.textContent = cue.text || ' '; 
    caption.classList.remove('motion-pop','motion-punch','motion-bounce','motion-slide','motion-zoom','motion-shake','motion-float','motion-reveal');
    void caption.offsetWidth;
    if (cue.motion !== 'none') caption.classList.add(`motion-${cue.motion}`);
    meta.textContent = `${slot} · ${cue.motion.toUpperCase()} + ${cue.sound} + ${cue.caption.toUpperCase()}`;
    playSound(cue.sound);
  }

  function manifest() {
    return {
      schema: 'ace.cue-map.v1',
      purpose: 'Reuse consistent motion, sound and caption cues across ACE UI, Quest, video and generated content.',
      timing: { sound_offset_ms: 20, motion_start_ms: 0, principle: 'Use cues only at meaningful moments; do not decorate every action.' },
      cues: currentMap(),
    };
  }

  function renderManifest() {
    const pre = document.querySelector('#manifest-preview');
    if (pre) pre.textContent = JSON.stringify(manifest(), null, 2);
  }

  function saveMap() {
    localStorage.setItem(storageKey, JSON.stringify(currentMap()));
    const state = document.querySelector('#save-state');
    if (state) {
      state.textContent = '保存しました ✓';
      setTimeout(() => state.textContent = 'ブラウザに自動保存', 900);
    }
    renderManifest();
  }

  function loadMap() {
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
      controls.forEach(control => {
        const value = saved?.[control.dataset.slot]?.[control.dataset.kind];
        if (value !== undefined) control.value = value;
      });
    } catch {}
    renderManifest();
  }

  async function copyText(text, button) {
    await navigator.clipboard.writeText(text);
    if (!button) return;
    const before = button.textContent;
    button.textContent = 'コピー済み ✓';
    setTimeout(() => button.textContent = before, 1200);
  }

  controls.forEach(control => {
    const eventName = control.tagName === 'INPUT' ? 'input' : 'change';
    control.addEventListener(eventName, () => {
      saveMap();
      if (control.dataset.kind !== 'text') previewCue(control.dataset.slot);
    });
  });

  document.querySelectorAll('[data-preview-slot]').forEach(button => {
    button.addEventListener('click', () => previewCue(button.dataset.previewSlot));
  });

  document.querySelector('#preview-flow')?.addEventListener('click', async () => {
    const sequence = ['ui.tap','ui.confirm','quest.correct','video.caption','video.emphasis','video.reaction','quest.clear','world.unlock'];
    for (const slot of sequence) {
      previewCue(slot);
      await new Promise(resolve => setTimeout(resolve, slot === 'world.unlock' ? 1000 : 520));
    }
  });

  const presets = {
    minimal: {
      'ui.tap': ['tap','pop','clean'], 'ui.confirm':['pin','pop','clean'], 'quest.correct':['sparkle','pop','clean'],
      'quest.clear':['clear','zoom','bold'], 'quest.levelup':['level','pop','bold'], 'quest.streak':['pin','pop','clean'],
      'video.caption':['none','none','clean'], 'video.emphasis':['ting','punch','bold'], 'video.reaction':['none','none','comic'],
      'video.transition':['whoosh','slide','none'], 'video.stamp':['stamp','zoom','stamp'], 'world.unlock':['moon','reveal','world']
    },
    variety: {
      'ui.tap':['tap','pop','clean'], 'ui.confirm':['pin','punch','boxed'], 'quest.correct':['sparkle','bounce','spark'],
      'quest.clear':['clear','zoom','bold'], 'quest.levelup':['level','bounce','spark'], 'quest.streak':['streak','punch','bold'],
      'video.caption':['pop','pop','boxed'], 'video.emphasis':['ting','punch','bold'], 'video.reaction':['boing','shake','comic'],
      'video.transition':['whoosh','slide','clean'], 'video.stamp':['stamp','zoom','stamp'], 'world.unlock':['moon','reveal','world']
    },
    quest: {
      'ui.tap':['tap','pop','clean'], 'ui.confirm':['pin','punch','boxed'], 'quest.correct':['sparkle','pop','spark'],
      'quest.clear':['clear','zoom','bold'], 'quest.levelup':['level','bounce','spark'], 'quest.streak':['streak','punch','bold'],
      'video.caption':['pop','pop','clean'], 'video.emphasis':['ting','punch','bold'], 'video.reaction':['bounce','bounce','comic'],
      'video.transition':['whoosh','slide','clean'], 'video.stamp':['stamp','zoom','stamp'], 'world.unlock':['moon','reveal','world']
    },
    world: {
      'ui.tap':['tap','pop','clean'], 'ui.confirm':['pin','float','boxed'], 'quest.correct':['sparkle','float','spark'],
      'quest.clear':['clear','reveal','bold'], 'quest.levelup':['level','reveal','spark'], 'quest.streak':['sparkle','float','clean'],
      'video.caption':['pop','reveal','clean'], 'video.emphasis':['ting','zoom','bold'], 'video.reaction':['bounce','float','comic'],
      'video.transition':['whoosh','reveal','none'], 'video.stamp':['stamp','zoom','stamp'], 'world.unlock':['moon','reveal','world']
    }
  };

  document.querySelectorAll('[data-preset]').forEach(button => {
    button.addEventListener('click', () => {
      const preset = presets[button.dataset.preset];
      Object.entries(preset).forEach(([slot, values]) => {
        controlFor(slot,'sound').value = values[0];
        controlFor(slot,'motion').value = values[1];
        controlFor(slot,'caption').value = values[2];
      });
      saveMap();
      previewCue('video.emphasis');
    });
  });

  document.querySelector('#copy-json')?.addEventListener('click', event => copyText(JSON.stringify(manifest(), null, 2), event.currentTarget));
  document.querySelector('#copy-manifest')?.addEventListener('click', event => {
    const lines = Object.entries(currentMap()).map(([slot, cue]) => `- ${slot}: motion=${cue.motion}, sound=${cue.sound}, caption=${cue.caption}, text="${cue.text}"`).join('\n');
    const text = `ACE CUE MAP v1\n今後のACE UI / Quest / 動画 / コンテンツ生成では以下を基本演出ルールとして使う。\n${lines}\n\nJSON:\n${JSON.stringify(manifest(), null, 2)}`;
    copyText(text, event.currentTarget);
  });

  document.querySelector('#reset-map')?.addEventListener('click', () => {
    controls.forEach(control => control.value = defaults[control.dataset.slot][control.dataset.kind]);
    localStorage.removeItem(storageKey);
    renderManifest();
    previewCue('ui.tap');
  });

  loadMap();
</script>

<style>
  .cue-shell{--line:#e2ded7;--muted:#737b84;max-width:1180px;margin:0 auto;padding-bottom:52px}.kicker{margin:0;color:var(--gold-muted);font-size:.69rem;font-weight:900;letter-spacing:.13em}.hero{display:grid;grid-template-columns:1fr auto;gap:28px;align-items:end}.hero h1{margin:5px 0 0;font-size:clamp(2.15rem,5vw,4rem);letter-spacing:-.045em;line-height:1}.lead{max-width:780px;margin:14px 0 0;color:var(--muted);line-height:1.85;font-size:.94rem}.hero-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.hero-actions button,.manifest-actions button{padding:11px 14px;border:1px solid var(--line);border-radius:11px;background:#fff;color:#30363d;font-size:.72rem;font-weight:800;cursor:pointer}.hero-actions .primary{background:#20242a;color:#fff;border-color:#20242a}
  .stage-section,.map-section,.preset-section,.reference-section,.manifest-section{margin-top:22px;padding:22px;border:1px solid var(--line);border-radius:20px;background:rgba(255,255,255,.76)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:18px}.section-head h2,.preset-section h2,.reference-section h2,.manifest-section h2{margin:4px 0 0;font-size:1.08rem}.section-head>span{color:#8b939b;font-size:.69rem}.volume{display:flex;align-items:center;gap:9px;color:#8b939b;font-size:.64rem;font-weight:800;letter-spacing:.08em}.volume input{width:120px}
  .stage{position:relative;min-height:250px;margin-top:16px;display:grid;place-items:center;overflow:hidden;border-radius:18px;background:radial-gradient(circle at 50% 40%,#333b47 0,#20242a 44%,#171a1f 100%);color:#fff}.stage-orbit{position:absolute;width:280px;height:280px;border:1px solid rgba(255,255,255,.09);border-radius:50%;box-shadow:0 0 90px rgba(200,170,120,.08)}.stage-caption{position:relative;z-index:2;padding:10px 16px;font-size:clamp(1.5rem,5vw,3.2rem);font-weight:900;letter-spacing:-.04em;text-align:center}.stage>p{position:absolute;left:16px;bottom:12px;margin:0;color:#8f99a5;font-size:.65rem;letter-spacing:.04em}
  .caption-none{visibility:hidden}.caption-clean{color:#fff}.caption-bold{color:#fff;text-shadow:0 3px 0 rgba(0,0,0,.35);font-weight:1000}.caption-boxed{border:2px solid rgba(255,255,255,.9);border-radius:8px;background:rgba(0,0,0,.28)}.caption-stamp{border:3px solid #fff;transform:rotate(-2deg);letter-spacing:.02em}.caption-spark{text-shadow:0 0 24px rgba(255,235,170,.65)}.caption-comic{border-radius:999px;background:#fff;color:#20242a;padding:10px 22px;transform:rotate(-2deg)}.caption-world{font-family:'Cormorant Garamond',serif;font-weight:600;letter-spacing:.14em;text-shadow:0 0 30px rgba(255,255,255,.25)}
