---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { visualStructureRecommendations, visualStructureTemplates } from '../../data/visualStructureTemplates';

const first = visualStructureTemplates[0];
---

<DashboardLayout title="Visual Structures" eyebrow="MASA VISUAL STRUCTURE LIBRARY">
  <div class="structure-shell">
    <header class="hero">
      <div>
        <p class="kicker">STRUCTURE BEFORE DECORATION</p>
        <h1>Visual Structure <span>Library</span></h1>
        <p class="lead">伝えたい内容に合わせて「見せ方の型」を先に選ぶ。20の構造テンプレを、スライド・SNS図解・教材・AI画像Promptへ横断利用する。</p>
      </div>
      <a class="lab-link" href="/dashboard/visual-prompt">VISUAL PROMPT LAB →</a>
    </header>

    <section class="flow" aria-label="利用フロー">
      <span>PURPOSE</span><i>→</i><span>STRUCTURE</span><i>→</i><span>CONTENT</span><i>→</i><span>PROMPT</span><i>→</i><span>SLIDE / IMAGE</span><i>→</i><span>REUSE</span>
    </section>

    <section class="use-section">
      <div class="section-head">
        <div><p class="kicker">01 · PURPOSE</p><h2>用途から選ぶ</h2></div>
        <p id="recommendation-note">用途を選ぶと、第一推奨だけに絞り込む。</p>
      </div>
      <div class="use-grid">
        <button class="use-button is-active" type="button" data-use-case="ALL" data-template-ids="">ALL <small>20 TYPES</small></button>
        {visualStructureRecommendations.map((item) => (
          <button class="use-button" type="button" data-use-case={item.useCase} data-template-ids={item.primary.join(',')} data-note={item.note}>
            {item.useCase}<small>{item.primary.join(' / ')}</small>
          </button>
        ))}
      </div>
    </section>

    <section class="template-section">
      <div class="section-head">
        <div><p class="kicker">02 · STRUCTURE</p><h2>20型から選ぶ</h2></div>
        <p><span id="visible-count">{visualStructureTemplates.length}</span> / {visualStructureTemplates.length} TYPES</p>
      </div>
      <div class="template-grid" id="template-grid">
        {visualStructureTemplates.map((template, index) => (
          <button
            class:list={['template-card', index === 0 && 'is-active']}
            type="button"
            data-template-id={template.id}
            data-name={template.name}
            data-image={template.image}
            data-best-for={template.bestFor.join(' / ')}
            data-copy={template.copy}
            data-structure={template.structure}
            data-prompt-hint={template.promptHint}
          >
            <span class="template-no">{template.id}</span>
            <strong>{template.name}</strong>
            <p>{template.image}</p>
            <small>{template.bestFor.slice(0,3).join(' · ')}</small>
          </button>
        ))}
      </div>
    </section>

    <section class="builder-section">
      <div class="section-head">
        <div><p class="kicker">03 · BUILD</p><h2>選んだ型を、今回の内容へ入れ替える</h2></div>
        <span id="selected-badge">{first.id}</span>
      </div>

      <div class="builder-grid">
        <div class="detail-panel">
          <div class="detail-title"><span id="detail-id">{first.id}</span><h3 id="detail-name">{first.name}</h3></div>
          <dl>
            <div><dt>イメージ</dt><dd id="detail-image">{first.image}</dd></div>
            <div><dt>向いている内容</dt><dd id="detail-best">{first.bestFor.join(' / ')}</dd></div>
            <div><dt>文言イメージ</dt><dd id="detail-copy">「{first.copy}」</dd></div>
            <div><dt>構造ルール</dt><dd id="detail-structure">{first.structure}</dd></div>
          </dl>
          <button id="copy-copy" class="secondary" type="button">文言イメージをコピー</button>
        </div>

        <div class="input-panel">
          <label><span>テーマ</span><input id="theme" type="text" placeholder="例：MASA OSの全体像" /></label>
          <label><span>タイトル</span><input id="title" type="text" placeholder="空欄なら文言イメージを使用" /></label>
          <label class="full"><span>要点 3〜7個</span><textarea id="points" rows="6" placeholder="1行に1つずつ入力\n例：発信\n教育\n商品\nコミュニティ\n社会実装"></textarea></label>
          <label><span>用途</span><select id="output-use"><option>講座スライド</option><option>SNS図解</option><option>note図解</option><option>教材</option><option>事業説明</option></select></label>
          <label><span>比率</span><select id="ratio"><option>16:9</option><option>1:1</option><option>9:16</option><option>A4縦</option></select></label>
        </div>

        <aside class="output-panel">
          <div class="output-head"><div><p class="kicker">04 · OUTPUT</p><h3>Structure Prompt</h3></div><span id="output-template-id">{first.id}</span></div>
          <p class="output-note">ChatGPT画像生成 / Gemini / Canva / Figma / スライド生成AIへ渡せる共通指示。</p>
          <div class="actions"><button id="generate" class="primary" type="button">Prompt生成</button><button id="copy-prompt" type="button">コピー</button><button id="reset" type="button">リセット</button></div>
          <textarea id="prompt-output" class="prompt-output" readonly></textarea>
          <p id="status" class="status" aria-live="polite"></p>
        </aside>
      </div>
    </section>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = 'masaVisualStructureLibraryV1';
  const cards = Array.from(document.querySelectorAll('.template-card'));
  const useButtons = Array.from(document.querySelectorAll('.use-button'));
  const byId = (id) => document.getElementById(id);
  let selectedId = cards[0]?.dataset.templateId || 'S01';

  function loadState() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); }
    catch { return {}; }
  }

  function saveState() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify({
      selectedId,
      theme: byId('theme').value,
      title: byId('title').value,
      points: byId('points').value,
      outputUse: byId('output-use').value,
      ratio: byId('ratio').value,
    }));
  }

  function selectedCard() {
    return cards.find((card) => card.dataset.templateId === selectedId) || cards[0];
  }

  function setSelected(id) {
    const card = cards.find((item) => item.dataset.templateId === id && !item.hidden) || cards.find((item) => !item.hidden) || cards[0];
    if (!card) return;
    selectedId = card.dataset.templateId;
    cards.forEach((item) => item.classList.toggle('is-active', item === card));
    byId('detail-id').textContent = card.dataset.templateId;
    byId('selected-badge').textContent = card.dataset.templateId;
    byId('output-template-id').textContent = card.dataset.templateId;
    byId('detail-name').textContent = card.dataset.name;
    byId('detail-image').textContent = card.dataset.image;
    byId('detail-best').textContent = card.dataset.bestFor;
    byId('detail-copy').textContent = `「${card.dataset.copy}」`;
    byId('detail-structure').textContent = card.dataset.structure;
    saveState();
    generatePrompt(false);
  }

  function filterByUseCase(button) {
    useButtons.forEach((item) => item.classList.toggle('is-active', item === button));
    const ids = (button.dataset.templateIds || '').split(',').filter(Boolean);
    cards.forEach((card) => { card.hidden = ids.length > 0 && !ids.includes(card.dataset.templateId); });
    byId('visible-count').textContent = String(cards.filter((card) => !card.hidden).length);
    byId('recommendation-note').textContent = button.dataset.note || '用途を選ぶと、第一推奨だけに絞り込む。';
    if (selectedCard()?.hidden) setSelected(ids[0]);
  }

  function pointLines() {
    return byId('points').value.split('\n').map((line) => line.trim()).filter(Boolean).map((line) => `・${line}`).join('\n') || '・[要点1]\n・[要点2]\n・[要点3]';
  }

  function buildPrompt() {
    const card = selectedCard();
    const theme = byId('theme').value.trim() || '[テーマ]';
    const title = byId('title').value.trim() || card.dataset.copy;
    const outputUse = byId('output-use').value;
    const ratio = byId('ratio').value;
    return `「${theme}」を、${card.dataset.name}の構造で${outputUse}として設計してください。\n\n【基本】\n・比率：${ratio}\n・タイトル：「${title}」\n・型：${card.dataset.templateId}｜${card.dataset.name}\n\n【構造】\n${card.dataset.structure}\n\n【ビジュアルイメージ】\n${card.dataset.image}\n\n【今回入れる要点】\n${pointLines()}\n\n【構図キーワード】\n${card.dataset.promptHint}\n\n【制作ルール】\n・構造が一目で分かることを優先し、装飾を増やしすぎない\n・日本語テキストは短く正確に、見出しと要点の階層を明確にする\n・3秒で主題、10秒で全体構造が理解できる情報量にする\n・各要素の関係性は位置、矢印、線、余白で表現する\n・必要に応じてACE / Sun Loves Flowの既存ブランド表現へ合わせる`;
  }

  function generatePrompt(showStatus = true) {
    byId('prompt-output').value = buildPrompt();
    saveState();
    if (showStatus) setStatus('Promptを生成しました。');
  }

  async function copyText(text, message) {
    try { await navigator.clipboard.writeText(text); setStatus(message); }
    catch {
      const output = byId('prompt-output');
      output.value = text; output.focus(); output.select(); document.execCommand('copy'); setStatus(message);
    }
  }

  function setStatus(message) { byId('status').textContent = message; }

  cards.forEach((card) => card.addEventListener('click', () => setSelected(card.dataset.templateId)));
  useButtons.forEach((button) => button.addEventListener('click', () => filterByUseCase(button)));
  ['theme','title','points','output-use','ratio'].forEach((id) => byId(id).addEventListener('input', () => { saveState(); generatePrompt(false); }));
  byId('generate').addEventListener('click', () => generatePrompt(true));
  byId('copy-prompt').addEventListener('click', () => copyText(byId('prompt-output').value || buildPrompt(), 'Promptをコピーしました。'));
  byId('copy-copy').addEventListener('click', () => copyText(selectedCard().dataset.copy, '文言イメージをコピーしました。'));
  byId('reset').addEventListener('click', () => {
    byId('theme').value = ''; byId('title').value = ''; byId('points').value = ''; byId('output-use').value = '講座スライド'; byId('ratio').value = '16:9';
    generatePrompt(false); saveState(); setStatus('入力をリセットしました。');
  });

  const saved = loadState();
  if (saved.theme) byId('theme').value = saved.theme;
  if (saved.title) byId('title').value = saved.title;
  if (saved.points) byId('points').value = saved.points;
  if (saved.outputUse && Array.from(byId('output-use').options).some((o) => o.value === saved.outputUse)) byId('output-use').value = saved.outputUse;
  if (saved.ratio && Array.from(byId('ratio').options).some((o) => o.value === saved.ratio)) byId('ratio').value = saved.ratio;
  setSelected(saved.selectedId || selectedId);
</script>

<style>
  .structure-shell{max-width:1320px;margin:0 auto;padding-bottom:64px}.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;padding:14px 0 32px;border-bottom:1px solid var(--border-default)}.kicker{margin:0;color:var(--gold-muted);font-size:.66rem;letter-spacing:.16em;font-weight:500}.hero h1{margin-top:8px;font-family:'Cormorant Garamond',serif;font-size:clamp(2.6rem,5vw,4.8rem);font-weight:300;line-height:.95}.hero h1 span{color:var(--gold-pure)}.lead{max-width:820px;margin-top:16px;color:var(--text-muted);font-size:.88rem;line-height:1.85}.lab-link{flex-shrink:0;color:var(--gold-pure);text-decoration:none;border:1px solid var(--border-accent);padding:11px 16px;font-size:.72rem;letter-spacing:.08em}.lab-link:hover{border-color:var(--border-hover)}
  .flow{margin-top:18px;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:9px;padding:15px;border:1px solid var(--border-default);background:var(--bg-surface)}.flow span{color:var(--text-muted);font-size:.62rem;letter-spacing:.1em;border:1px solid var(--border-default);padding:6px 9px}.flow i{color:var(--gold-dim);font-style:normal}
  .use-section,.template-section,.builder-section{margin-top:34px}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:16px}.section-head h2{margin-top:4px;font-family:'Cormorant Garamond',serif;font-size:1.9rem;font-weight:300}.section-head>p{max-width:580px;color:var(--text-dim);font-size:.72rem;text-align:right}.section-head>span{color:var(--gold-muted);font-size:.66rem;letter-spacing:.1em;border:1px solid var(--border-default);padding:6px 9px}
  .use-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--border-default);border-left:1px solid var(--border-default)}.use-button{min-height:68px;display:flex;align-items:flex-start;justify-content:space-between;gap:8px;padding:13px;border:0;border-right:1px solid var(--border-default);border-bottom:1px solid var(--border-default);background:var(--bg-surface);color:var(--text-muted);font-family:inherit;text-align:left;cursor:pointer}.use-button small{color:var(--text-dim);font-size:.58rem}.use-button:hover,.use-button.is-active{color:var(--gold-pure);background:var(--gold-glow)}
  .template-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.template-card{min-height:190px;display:flex;flex-direction:column;align-items:flex-start;text-align:left;padding:17px;border:1px solid var(--border-default);background:var(--bg-surface);color:inherit;cursor:pointer}.template-card[hidden]{display:none}.template-card:hover,.template-card.is-active{border-color:var(--border-hover);background:var(--bg-elevated)}.template-card.is-active{box-shadow:inset 3px 0 0 var(--gold-muted)}.template-no{color:var(--gold-muted);font-family:'JetBrains Mono',monospace;font-size:.62rem;letter-spacing:.08em}.template-card strong{margin-top:10px;color:var(--text-primary);font-size:.86rem;font-weight:500}.template-card p{margin-top:8px;color:var(--text-muted);font-size:.7rem;line-height:1.65}.template-card small{margin-top:auto;padding-top:12px;color:var(--text-dim);font-size:.62rem;line-height:1.5}
  .builder-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1fr) minmax(360px,1.1fr);gap:12px;align-items:start}.detail-panel,.input-panel,.output-panel{padding:19px;border:1px solid var(--border-default);background:var(--bg-surface)}.detail-title{display:flex;align-items:baseline;gap:10px;padding-bottom:13px;border-bottom:1px solid var(--border-default)}.detail-title span{color:var(--gold-muted);font-family:'JetBrains Mono',monospace;font-size:.65rem}.detail-title h3,.output-head h3{font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:300}.detail-panel dl{margin:0}.detail-panel dl div{padding:13px 0;border-bottom:1px solid var(--border-default)}.detail-panel dt{color:var(--gold-muted);font-size:.62rem;letter-spacing:.08em}.detail-panel dd{margin:5px 0 0;color:var(--text-muted);font-size:.73rem;line-height:1.7}.secondary{margin-top:13px}
  .input-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.input-panel label{display:grid;gap:6px}.input-panel label.full{grid-column:1/-1}.input-panel label span{color:var(--text-muted);font-size:.66rem}input,textarea,select{width:100%;border:1px solid var(--border-default);background:var(--bg-void);color:var(--text-primary);padding:11px 12px;font-family:inherit;font-size:.78rem;outline:none}input:focus,textarea:focus,select:focus{border-color:var(--gold-muted)}textarea{resize:vertical;line-height:1.6}
  .output-panel{position:sticky;top:18px}.output-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px}.output-head span{color:var(--gold-muted);font-family:'JetBrains Mono',monospace;font-size:.65rem}.output-note{margin-top:7px;color:var(--text-dim);font-size:.68rem;line-height:1.6}.actions{display:flex;gap:7px;flex-wrap:wrap;margin:13px 0 10px}button{border:1px solid var(--border-default);background:var(--bg-elevated);color:var(--text-muted);padding:10px 13px;font-family:inherit;font-size:.72rem;cursor:pointer}button:hover{color:var(--text-primary);border-color:var(--border-hover)}button.primary{background:var(--gold-pure);border-color:var(--gold-pure);color:var(--bg-void);font-weight:500}.prompt-output{min-height:480px;font-family:'JetBrains Mono',monospace;font-size:.69rem;line-height:1.65}.status{min-height:18px;margin-top:8px;color:var(--gold-pure);font-size:.66rem}
  @media(max-width:1120px){.use-grid,.template-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.builder-grid{grid-template-columns:1fr 1fr}.output-panel{grid-column:1/-1;position:static}.prompt-output{min-height:340px}}
  @media(max-width:760px){.hero,.section-head{align-items:flex-start;flex-direction:column}.lab-link{width:100%;text-align:center}.section-head>p{text-align:left}.use-grid,.template-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.builder-grid{grid-template-columns:1fr}.output-panel{grid-column:auto}.input-panel{grid-template-columns:1fr}.input-panel label.full{grid-column:auto}}
  @media(max-width:480px){.use-grid,.template-grid{grid-template-columns:1fr}.template-card{min-height:154px}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
</style>
