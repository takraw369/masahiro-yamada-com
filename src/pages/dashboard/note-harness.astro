t-size:.67rem;overflow-wrap:anywhere}.table-panel{overflow:hidden}.table-wrap{overflow:auto}table{width:100%;min-width:900px;border-collapse:collapse;font-size:.69rem}th{text-align:left;color:#8b929a;font-weight:500;padding:8px;border-bottom:1px solid #d8d4cd}td{padding:10px 8px;border-bottom:1px solid #ece8e1;vertical-align:top;color:#505964}td strong{display:block;color:#24282d}td small{display:block;color:#8b929a;margin-top:2px;font-size:.59rem}td a{display:inline-block;margin-top:3px;color:#8b5b2c;font-size:.61rem}.rule{color:#626b75;font-size:.72rem;line-height:1.75}.rule p{margin-top:6px}.rule strong{color:#754a16}.empty{color:#8b929a;font-size:.72rem}.error{border-color:#d8a79b;color:#7c4032}.error p{margin:6px 0}.error small{color:#8b929a}@media(max-width:1050px){.score-grid{grid-template-columns:repeat(3,1fr)}.two-col{grid-template-columns:1fr}.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.metrics-grid .wide{grid-column:span 2}}@media(max-width:620px){.hero{flex-direction:column}.score-grid{grid-template-columns:repeat(2,1fr)}.form-grid,.metrics-grid{grid-template-columns:1fr}.metrics-grid .wide{grid-column:span 1}}
</style>
