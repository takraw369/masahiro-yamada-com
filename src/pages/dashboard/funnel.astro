---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

interface Env {
  DB: D1Database;
}

type EventRow = {
  event_name: string;
  sessions: number;
};

type SourceRow = {
  source: string;
  views: number;
  completes: number;
  line_clicks: number;
  trial_clicks: number;
};

const env = Astro.locals.runtime?.env as Env | undefined;
let dbReady = false;
let eventRows: EventRow[] = [];
let sourceRows: SourceRow[] = [];

if (env?.DB) {
  try {
    const events = await env.DB.prepare(`
      SELECT event_name, COUNT(DISTINCT session_id) AS sessions
      FROM trinity_funnel_events
      WHERE datetime(created_at) >= datetime('now', '-30 days')
      GROUP BY event_name
    `).all<EventRow>();

    const sources = await env.DB.prepare(`
      SELECT
        COALESCE(NULLIF(source, ''), 'direct') AS source,
        COUNT(DISTINCT CASE WHEN event_name = 'trinity_view' THEN session_id END) AS views,
        COUNT(DISTINCT CASE WHEN event_name = 'trinity_complete' THEN session_id END) AS completes,
        COUNT(DISTINCT CASE WHEN event_name = 'trinity_line_click' THEN session_id END) AS line_clicks,
        COUNT(DISTINCT CASE WHEN event_name = 'trinity_trial_click' THEN session_id END) AS trial_clicks
      FROM trinity_funnel_events
      WHERE datetime(created_at) >= datetime('now', '-30 days')
      GROUP BY COALESCE(NULLIF(source, ''), 'direct')
      ORDER BY views DESC
      LIMIT 8
    `).all<SourceRow>();

    eventRows = events.results;
    sourceRows = sources.results;
    dbReady = true;
  } catch {
    dbReady = false;
  }
}

const metrics = Object.fromEntries(eventRows.map((row) => [row.event_name, Number(row.sessions)]));
const views = metrics.trinity_view || 0;
const starts = metrics.trinity_start || 0;
const completes = metrics.trinity_complete || 0;
const lineClicks = metrics.trinity_line_click || 0;
const trialClicks = metrics.trinity_trial_click || 0;

const pct = (n: number, d: number) => d > 0 ? `${((n / d) * 100).toFixed(1)}%` : '—';

const cards = [
  { label: '閲覧', value: views, sub: 'ユニークセッション' },
  { label: '診断開始', value: starts, sub: `閲覧→開始 ${pct(starts, views)}` },
  { label: '診断完了', value: completes, sub: `開始→完了 ${pct(completes, starts)}` },
  { label: 'LINEクリック', value: lineClicks, sub: `完了→LINE ${pct(lineClicks, completes)}` },
  { label: '体験相談クリック', value: trialClicks, sub: `LINE→体験 ${pct(trialClicks, lineClicks)}` },
];
---
<DashboardLayout title="Trinity Funnel">
  <main class="funnel-page">
    <div class="heading">
      <div>
        <span class="eyebrow">ACE GROWTH</span>
        <h1>Trinity Funnel</h1>
        <p>直近30日｜診断 → LINE → 体験セッションの最短導線</p>
      </div>
      <a href="/trinity" target="_blank" rel="noopener noreferrer">診断ページを見る ↗</a>
    </div>

    {!dbReady ? (
      <section class="notice">
        <strong>計測DBの準備待ち</strong>
        <p><code>migrations/004_trinity_funnel.sql</code> を本番D1へ適用すると、この画面に数値が入り始めます。</p>
      </section>
    ) : (
      <>
        <section class="cards">
          {cards.map((card) => (
            <article class="metric-card">
              <span>{card.label}</span>
              <strong>{card.value}</strong>
              <small>{card.sub}</small>
            </article>
          ))}
        </section>

        <section class="flow-card">
          <div class="flow-step"><strong>{views}</strong><span>閲覧</span></div>
          <b>→</b>
          <div class="flow-step"><strong>{starts}</strong><span>開始</span></div>
          <b>→</b>
          <div class="flow-step"><strong>{completes}</strong><span>完了</span></div>
          <b>→</b>
          <div class="flow-step"><strong>{lineClicks}</strong><span>LINE</span></div>
          <b>→</b>
          <div class="flow-step accent"><strong>{trialClicks}</strong><span>体験相談</span></div>
        </section>

        <section class="source-card">
          <div class="section-title">
            <h2>流入別</h2>
            <span>UTM source / referrer</span>
          </div>
          {sourceRows.length === 0 ? (
            <p class="empty">まだデータがありません。</p>
          ) : (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>Source</th><th>閲覧</th><th>完了</th><th>LINE</th><th>体験</th></tr>
                </thead>
                <tbody>
                  {sourceRows.map((row) => (
                    <tr>
                      <td>{row.source}</td>
                      <td>{row.views}</td>
                      <td>{row.completes}</td>
                      <td>{row.line_clicks}</td>
                      <td>{row.trial_clicks}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </>
    )}
  </main>

  <style>
    .funnel-page { padding: 34px; max-width: 1180px; margin: 0 auto; }
    .heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
    .eyebrow { color: var(--gold-muted); font-family: 'Cormorant Garamond', serif; font-size: 10px; letter-spacing: 5px; }
    h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(30px, 5vw, 46px); font-weight: 300; margin: 6px 0; }
    .heading p { color: var(--text-muted); font-size: 13px; }
    .heading a { color: var(--gold-pure); border: 1px solid var(--border-default); text-decoration: none; padding: 10px 14px; font-size: 12px; white-space: nowrap; }
    .cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 18px; }
    .metric-card, .flow-card, .source-card, .notice { background: var(--bg-surface); border: 1px solid var(--border-default); }
    .metric-card { padding: 20px; min-height: 132px; display: flex; flex-direction: column; }
    .metric-card span { color: var(--text-muted); font-size: 12px; }
    .metric-card strong { color: var(--gold-pure); font-family: 'Cormorant Garamond', serif; font-size: 38px; font-weight: 300; line-height: 1.2; margin: 8px 0 auto; }
    .metric-card small { color: var(--text-dim); font-size: 10px; }
    .flow-card { padding: 24px; display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 18px; overflow-x: auto; }
    .flow-card b { color: var(--gold-dim); font-weight: 300; }
    .flow-step { min-width: 90px; text-align: center; }
    .flow-step strong { display: block; color: var(--text-primary); font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 300; }
    .flow-step span { color: var(--text-muted); font-size: 11px; }
    .flow-step.accent strong { color: #06C755; }
    .source-card { padding: 24px; }
    .section-title { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 16px; }
    .section-title h2 { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 300; }
    .section-title span, .empty { color: var(--text-dim); font-size: 11px; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th, td { padding: 12px 10px; border-bottom: 1px solid var(--border-default); text-align: right; }
    th:first-child, td:first-child { text-align: left; }
    th { color: var(--text-dim); font-weight: 400; }
    td { color: var(--text-muted); }
    .notice { padding: 24px; border-color: rgba(201,169,110,0.25); }
    .notice strong { color: var(--gold-pure); }
    .notice p { color: var(--text-muted); font-size: 13px; margin-top: 8px; line-height: 1.8; }
    code { color: var(--text-primary); }
    @media (max-width: 980px) { .cards { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) {
      .funnel-page { padding: 22px 16px 40px; }
      .heading { flex-direction: column; }
      .cards { grid-template-columns: 1fr 1fr; }
      .metric-card { min-height: 120px; }
    }
  </style>
</DashboardLayout>
