---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import IntelligenceBoard from '../../components/dashboard/IntelligenceBoard';
import '../../styles/masa-readable.css';
import '../../styles/intelligence-board-fix.css';
---
<DashboardLayout title="情報Feed" eyebrow="見つける → 読む → 活かす">
  <div class="playground-entry">
    <div>
      <span>自分だけの試作スペース</span>
      <b>公開前に、まず遊ぶ。</b>
      <p>気になった記事を読み、使い道を考える。投稿素材は試作スペースで整えられます。</p>
    </div>
    <a href="/dashboard/playground">試作スペースを開く →</a>
  </div>
  <IntelligenceBoard client:load />
</DashboardLayout>

<style>
  .playground-entry{display:flex;justify-content:space-between;gap:20px;align-items:center;margin:0 0 18px;padding:15px 17px;border:1px solid #d8c29e;background:#fffaf2;color:#343a40}.playground-entry div{display:grid;gap:3px}.playground-entry span{font-size:.72rem;font-weight:900;letter-spacing:.09em;color:#8b5b2c}.playground-entry b{font-size:1rem}.playground-entry p{margin:0;color:#66707a;font-size:.84rem;line-height:1.6}.playground-entry a{flex:none;padding:10px 12px;border:1px solid #c7a46d;background:#fff;color:#744b18;text-decoration:none;font-size:.82rem;font-weight:900}@media(max-width:720px){.playground-entry{align-items:flex-start;flex-direction:column}.playground-entry a{width:100%;text-align:center}}
</style>
