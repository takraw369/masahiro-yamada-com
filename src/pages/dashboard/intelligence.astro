---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Intelligence" eyebrow="DISCOVER → TRUST → REUSE">
  <div class="intel-shell">
    <header class="hero">
      <div>
        <p class="eyebrow">INTELLIGENCE INBOX</p>
        <h1>世界から、使うものだけ残す。</h1>
        <p class="lead">収集は自動。ここでは選ぶ。Sourceを確かめ、今のMASAに必要なものだけをEvidence・Content・Assetへ進める。</p>
      </div>
      <div class="hero-actions">
        <a class="quiet-link" href="/mind">FLOW MIND →</a>
        <a class="quiet-link" href="/dashboard/evidence">Evidence →</a>
      </div>
    </header>

    <div id="intel-error" class="error" hidden></div>

    <section class="metrics" id="intel-metrics" aria-label="Intelligence summary">
      <div class="metric primary"><span>NEW</span><strong>—</strong><small>まだ見ていない</small></div>
      <div class="metric primary"><span>HIGH SIGNAL</span><strong>—</strong><small>優先して見る</small></div>
      <div class="metric secondary"><span>PEOPLE</span><strong>—</strong><small>人物候補</small></div>
      <div class="metric primary"><span>TRUSTED</span><strong>—</strong><small>確認済み</small></div>
      <div class="metric secondary"><span>OUTPUT</span><strong>—</strong><small>再利用候補</small></div>
    </section>

    <details class="capture-drawer" id="intake-drawer">
      <summary><span>＋ Sourceを手動で追加</span><small>URL・気づき・仮説</small></summary>
      <form id="intel-form" class="intake-form">
        <label class="wide">タイトル / 気づき<input name="title" required maxlength="500" placeholder="例：AI Agentが教育コンテンツ制作をどう変えるか" /></label>
        <label class="wide">URL<input name="url" type="url" placeholder="https://...（任意）" /></label>
        <label>領域<select name="topic">
          <option>Athlete / Education</option><option>AI / Build</option><option>Business / Revenue</option><option>Health / Human</option><option>Capital / Market</option><option>Society / Culture</option><option>Creativity / Media</option><option>Life / Place</option><option selected>General</option>
        </select></label>
        <label class="span-2">なぜ気になる？<input name="whyItMatters" maxlength="3000" placeholder="今のProject・人生・事業との接点" /></label>
        <label class="wide">自分の言葉で要点<textarea name="excerpt" maxlength="5000" placeholder="引用を貼るより、何が重要だと思ったかを残す"></textarea></label>
        <div class="submit-row wide"><span id="submit-state"></span><button type="submit">追加する</button></div>
      </form>
    </details>

    <section class="review-head" aria-labelledby="review-title">
      <div><p class="eyebrow">REVIEW</p><h2 id="review-title">次に見るもの</h2></div>
      <div id="intel-count" class="count">—</div>
    </section>

    <section class="filters" aria-label="Intelligence filters">
      <input id="intel-query" type="search" placeholder="検索：タイトル・人物・Why・Lens" />
      <select id="intel-topic"><option value="all">全領域</option></select>
      <select id="intel-status">
        <option value="all">全状態</option><option value="new">NEW</option><option value="saved">SAVE</option><option value="review">REVIEW</option><option value="verified">VERIFIED</option><option value="content_seed">SNS / AI種</option><option value="evidence">EVIDENCE</option><option value="asset">ASSET</option><option value="project">PROJECT</option><option value="archived">ARCHIVE</option>
      </select>
      <details class="advanced-filters">
        <summary>絞り込み</summary>
        <div class="advanced-grid">
          <label>種類<select id="intel-kind"><option value="all">すべて</option><option value="people">People</option><option value="intelligence">情報</option></select></label>
          <label>ACE影響<select id="intel-impact"><option value="all">すべて</option><option value="transformative">TRANSFORM</option><option value="direct">DIRECT</option><option value="adjacent">ADJACENT</option><option value="none">NONE</option></select></label>
        </div>
      </details>
    </section>

    <section id="intel-list" class="intel-list"><div class="empty">Intelligenceを読み込み中…</div></section>
  </div>

  <style>
    .intel-shell{max-width:1060px;margin:0 auto;padding-bottom:64px}.hero{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding:4px 0 22px}.eyebrow{font-size:.66rem;letter-spacing:.14em;color:var(--gold-muted);font-weight:700}.hero h1{margin-top:5px;font-size:clamp(1.8rem,4vw,3rem);line-height:1.18;color:var(--text-primary)}.lead{max-width:720px;color:var(--text-muted);line-height:1.8;margin-top:8px;font-size:.84rem}.hero-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.quiet-link{min-height:40px;display:inline-flex;align-items:center;padding:8px 11px;color:var(--text-muted);text-decoration:none;border:1px solid var(--border-default);background:var(--bg-surface);font-size:.72rem;white-space:nowrap}.quiet-link:hover{color:var(--text-primary);border-color:var(--border-hover)}.error{border:1px solid #ddbbb5;background:#fff5f3;padding:12px 14px;margin-bottom:12px;color:#8b4e45;font-size:.8rem}

    .metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin:4px 0 16px}.metric{min-height:82px;padding:12px 13px;background:var(--bg-surface);border:1px solid var(--border-default)}.metric span{display:block;color:var(--text-dim);font-size:.58rem;letter-spacing:.1em}.metric strong{display:block;font-size:1.6rem;line-height:1.15;margin-top:3px}.metric small{font-size:.63rem;color:var(--text-dim)}.metric.primary{border-color:#d3c2a5}.metric.primary span{color:var(--gold-muted)}.metric.secondary{background:rgba(255,255,255,.48)}

    .capture-drawer{margin-bottom:26px;border:1px solid var(--border-default);background:rgba(255,255,255,.55)}.capture-drawer>summary{min-height:48px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 14px;cursor:pointer;list-style:none;color:var(--text-primary);font-size:.78rem}.capture-drawer>summary::-webkit-details-marker{display:none}.capture-drawer>summary:after{content:'＋';color:var(--gold-muted)}.capture-drawer[open]>summary:after{content:'−'}.capture-drawer>summary small{margin-left:auto;color:var(--text-dim);font-size:.66rem}.intake-form{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px;padding:15px;border-top:1px solid var(--border-default);background:var(--bg-surface)}.intake-form label{display:grid;gap:5px;color:var(--text-muted);font-size:.64rem;letter-spacing:.03em}.wide{grid-column:1/-1}.span-2{grid-column:span 2}.intake-form input,.intake-form textarea,.intake-form select,.filters input,.filters select{min-height:42px;background:#fff;border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:9px 10px;outline:none}.intake-form textarea{min-height:76px;resize:vertical}.intake-form input:focus,.intake-form textarea:focus,.intake-form select:focus,.filters input:focus,.filters select:focus{border-color:#b58a53}.submit-row{display:flex;align-items:center;justify-content:flex-end;gap:10px}.submit-row span{font-size:.66rem;color:var(--text-dim)}button{font:inherit}.submit-row button,.action{cursor:pointer;border:1px solid var(--border-default);background:#fff;color:var(--text-muted);padding:8px 10px;font-size:.68rem}.submit-row button{border-color:#c8a97a;background:#f3eadc;color:#754a16;padding:10px 15px;font-weight:700}

    .review-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin:0 0 9px}.review-head h2{margin-top:2px;font-size:1.06rem}.count{color:var(--text-muted);font-size:.7rem}.filters{display:grid;grid-template-columns:minmax(260px,1fr) minmax(150px,.35fr) minmax(150px,.35fr) auto;gap:7px;align-items:start;margin-bottom:10px}.advanced-filters{position:relative}.advanced-filters>summary{min-height:42px;display:flex;align-items:center;padding:0 11px;border:1px solid var(--border-default);background:#fff;color:var(--text-muted);cursor:pointer;list-style:none;font-size:.7rem;white-space:nowrap}.advanced-filters>summary::-webkit-details-marker{display:none}.advanced-filters[open] .advanced-grid{display:grid}.advanced-grid{position:absolute;right:0;z-index:10;width:300px;display:none;grid-template-columns:1fr;gap:9px;margin-top:4px;padding:12px;background:#fff;border:1px solid var(--border-default);box-shadow:0 12px 30px rgba(35,29,22,.1)}.advanced-grid label{display:grid;gap:4px;color:var(--text-muted);font-size:.63rem}

    .intel-list{display:grid;gap:8px}.intel-card{padding:16px 17px;background:var(--bg-surface);border:1px solid var(--border-default)}.intel-card:hover{border-color:#c7b9a5}.intel-card.people-card{border-left:3px solid #b99760}.card-head{display:grid;grid-template-columns:minmax(0,1fr) 104px;gap:18px;align-items:start}.tag-row{display:flex;flex-wrap:wrap;gap:5px}.tag{font-size:.56rem;letter-spacing:.03em;padding:3px 6px;border:1px solid #ded9d1;color:var(--text-dim);background:#fff}.tag.topic{border-color:#d7c5aa;color:#7b511f;background:#fbf6ee}.tag.status{color:var(--text-primary);font-weight:600}.tag.discovery,.tag.recommend{color:#77552a}.tag.ace-direct,.tag.ace-transformative{color:#7d5e30}.title{font-size:1rem;font-weight:700;margin-top:9px;line-height:1.5;color:var(--text-primary)}.source{font-size:.64rem;color:var(--text-dim);margin-top:5px;line-height:1.6}.source a{color:var(--gold-muted);text-decoration:none}.source a:hover{text-decoration:underline}.score-box{text-align:right}.signal{font-size:1.8rem;font-weight:700;color:#80551d;line-height:1}.signal-label{font-size:.53rem;color:var(--text-dim);letter-spacing:.09em}.scores{display:flex;gap:5px;justify-content:flex-end;flex-wrap:wrap;margin-top:5px;font-size:.55rem;color:var(--text-dim)}.why{margin-top:11px;padding:9px 10px;border-left:2px solid #c7a46d;background:#fbf7f0;font-size:.75rem;line-height:1.65;color:var(--text-primary)}.why strong{font-size:.6rem;color:var(--gold-muted)}.excerpt{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;margin-top:8px;color:var(--text-muted);font-size:.74rem;line-height:1.7;white-space:pre-wrap}.feedback{margin-top:8px;padding:7px 9px;border:1px dashed var(--border-default);font-size:.65rem;color:var(--text-muted)}.feedback strong{color:#77552a}.outputs{display:none}.actions{display:flex;flex-wrap:wrap;gap:5px;margin-top:12px;padding-top:10px;border-top:1px solid #ebe7e1}.action{min-height:34px}.action:hover{border-color:var(--border-hover);color:var(--text-primary)}.action.primary{border-color:#c7a46d;color:#754a16;background:#fbf3e7;font-weight:600}.action:disabled{opacity:.45;cursor:wait}.seed{margin-top:8px;border-top:1px dashed var(--border-default);padding-top:9px}.seed summary{cursor:pointer;color:var(--gold-muted);font-size:.66rem}.seed pre{white-space:pre-wrap;word-break:break-word;color:var(--text-muted);font:inherit;font-size:.7rem;line-height:1.65;margin-top:8px}.empty{padding:26px;border:1px dashed var(--border-default);color:var(--text-dim);text-align:center;font-size:.78rem}.time{font-size:.59rem;color:var(--text-dim);margin-top:3px}

    @media(max-width:900px){.metrics{grid-template-columns:repeat(3,1fr)}.metric.secondary{display:none}.hero{align-items:flex-start;flex-direction:column}.hero-actions{justify-content:flex-start}.intake-form{grid-template-columns:1fr 1fr}.span-2{grid-column:auto}.filters{grid-template-columns:1fr 1fr}.filters input{grid-column:1/-1}.card-head{grid-template-columns:1fr}.score-box{text-align:left;display:flex;align-items:baseline;gap:7px}.scores{justify-content:flex-start}}
    @media(max-width:560px){.metrics{grid-template-columns:repeat(3,1fr)}.metric{min-height:72px;padding:10px}.metric strong{font-size:1.35rem}.intake-form,.filters{grid-template-columns:1fr}.wide,.span-2{grid-column:auto}.hero h1{font-size:1.9rem}.quiet-link{flex:1;justify-content:center}.hero-actions{width:100%}.intel-card{padding:14px}.advanced-grid{position:static;width:auto;box-shadow:none}.actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.action{width:100%}.capture-drawer>summary small{display:none}}
  </style>

  <script>
    type IntelligenceItem = {
      id:string; title:string; url:string; sourceKind:string; provenance:string; excerpt:string;
      topic:string; lenses:string[]; scores:Record<string,number>; factType:string; aceImpact:string;
      whyItMatters:string; suggestedOutputs:string[]; status:string; outputTargets:string[]; contentSeed:string;
      lastSeenAt:string|null; detectedAt:string|null;
    };
    type IntelligenceResponse = { ok:boolean; error?:string; item?:IntelligenceItem; items?:IntelligenceItem[] };
    type IntelligencePatch = { status?:string; topic?:string; lenses?:string[]; aceImpact?:string; whyItMatters?:string; outputTargets?:string[]; contentSeed?:string; driveUrl?:string };

    const TOPICS=['Athlete / Education','AI / Build','Business / Revenue','Health / Human','Capital / Market','Society / Culture','Creativity / Media','Life / Place','General'] as const;
    const STATUS_LABEL:Record<string,string>={new:'NEW',saved:'SAVE',review:'REVIEW',verified:'VERIFIED',content_seed:'SNS / AI種',evidence:'EVIDENCE',asset:'ASSET',project:'PROJECT',archived:'ARCHIVE'};
    const PEOPLE_ACTION_LABEL:Record<string,string>={WATCH:'WATCH',SKIP:'SKIP',DEEP_RESEARCH:'DEEP RESEARCH',COLLAB_CANDIDATE:'COLLAB候補',FOLLOWED:'FOLLOWED'};
    const RECOMMEND_LABEL:Record<string,string>={WATCH:'WATCH',FOLLOW_CANDIDATE:'FOLLOW候補',DEEP_RESEARCH:'DEEP RESEARCH',COLLAB_CANDIDATE:'COLLAB候補'};
    const ESCAPE:Record<string,string>={'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'};

    function requiredEl<T extends HTMLElement>(id:string):T{
      const el=document.getElementById(id);
      if(!el)throw new Error(`missing_element:${id}`);
      return el as T;
    }

    let items:IntelligenceItem[]=[];
    const list=requiredEl<HTMLElement>('intel-list');
    const q=requiredEl<HTMLInputElement>('intel-query');
    const kind=requiredEl<HTMLSelectElement>('intel-kind');
    const topic=requiredEl<HTMLSelectElement>('intel-topic');
    const status=requiredEl<HTMLSelectElement>('intel-status');
    const impact=requiredEl<HTMLSelectElement>('intel-impact');
    const count=requiredEl<HTMLElement>('intel-count');
    const errorEl=requiredEl<HTMLElement>('intel-error');
    const form=requiredEl<HTMLFormElement>('intel-form');
    const submitState=requiredEl<HTMLElement>('submit-state');
    const intakeDrawer=document.getElementById('intake-drawer');

    TOPICS.forEach(t=>topic.insertAdjacentHTML('beforeend',`<option value="${t}">${t}</option>`));
    const esc=(v:unknown='')=>String(v).replace(/[&<>'"]/g,c=>ESCAPE[c]??c);
    const score=(item:IntelligenceItem,key:string)=>Number(item.scores?.[key]??0);
    const fmt=(v:string|null|undefined)=>{if(!v)return '';const d=new Date(v);return Number.isNaN(d.getTime())?'':d.toLocaleString('ja-JP',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'});};
    const showError=(t:unknown)=>{const text=t?String(t):'';errorEl.textContent=text;errorEl.hidden=!text;};
    const isPerson=(item:IntelligenceItem)=>item.sourceKind==='person';
    const recommendation=(item:IntelligenceItem)=>{
      const raw=(item.suggestedOutputs||[]).find(x=>x.startsWith('recommend:'));
      return raw?raw.slice('recommend:'.length):'';
    };
    const peopleFeedback=(item:IntelligenceItem)=>{
      const raw=(item.outputTargets||[]).find(x=>x.startsWith('people:'));
      return raw?raw.slice('people:'.length):'';
    };
    const revealManualIntake=()=>{
      if(location.hash==='#intel-form' && intakeDrawer instanceof HTMLDetailsElement) intakeDrawer.open=true;
    };
    revealManualIntake();
    window.addEventListener('hashchange',revealManualIntake);

    function updateMetrics(){
      const values=[
        items.filter(x=>x.status==='new').length,
        items.filter(x=>score(x,'signal')>=4).length,
        items.filter(isPerson).length,
        items.filter(x=>['verified','evidence'].includes(x.status)).length,
        items.filter(x=>['content_seed','asset','project'].includes(x.status)).length,
      ];
      document.querySelectorAll<HTMLElement>('#intel-metrics strong').forEach((el,i)=>el.textContent=String(values[i]??0));
    }

    function filtered():IntelligenceItem[]{
      const needle=(q.value||'').trim().toLowerCase();
      return items.filter(x=>status.value==='archived'||x.status!=='archived')
        .filter(x=>kind.value==='all'||(kind.value==='people'?isPerson(x):!isPerson(x)))
        .filter(x=>topic.value==='all'||x.topic===topic.value)
        .filter(x=>status.value==='all'||x.status===status.value)
        .filter(x=>impact.value==='all'||x.aceImpact===impact.value)
        .filter(x=>!needle||[x.title,x.excerpt,x.whyItMatters,x.topic,x.provenance,...(x.lenses||[]),...(x.suggestedOutputs||[]),...(x.outputTargets||[])].join(' ').toLowerCase().includes(needle));
    }

    function personCard(item:IntelligenceItem):string{
      const fit=Math.round(score(item,'fit'));
      const rec=recommendation(item);
      const feedback=peopleFeedback(item);
      const discovery=(item.suggestedOutputs||[]).includes('discovery_pick');
      const source=item.url?`<a href="${esc(item.url)}" target="_blank" rel="noopener noreferrer">PROFILE ↗</a>`:'NO URL';
      const ace=item.aceImpact!=='none'?`<span class="tag ace-${esc(item.aceImpact)}">ACE ${esc(item.aceImpact.toUpperCase())}</span>`:'';
      return `<article class="intel-card people-card" data-id="${esc(item.id)}">
        <div class="card-head"><div><div class="tag-row"><span class="tag topic">${esc(item.topic)}</span><span class="tag status">${esc(STATUS_LABEL[item.status]||item.status)}</span><span class="tag">PEOPLE</span>${discovery?'<span class="tag discovery">発掘枠</span>':''}${rec?`<span class="tag recommend">推奨：${esc(RECOMMEND_LABEL[rec]||rec)}</span>`:''}${ace}</div><h3 class="title">${esc(item.title)}</h3><div class="source">${source}${item.provenance?` · ${esc(item.provenance)}`:''}</div><div class="time">${esc(fmt(item.lastSeenAt||item.detectedAt))}</div></div>
        <div class="score-box"><div class="signal">${fit}</div><div class="signal-label">MASA FIT / 100</div><div class="scores"><span>DEN ${Math.round(score(item,'density'))}</span><span>NOV ${Math.round(score(item,'novelty'))}</span><span>REL ${Math.round(score(item,'relationship'))}</span></div></div></div>
        ${item.whyItMatters?`<div class="why"><strong>WHY NOW</strong> — ${esc(item.whyItMatters)}</div>`:''}
        ${item.excerpt?`<div class="excerpt">${esc(item.excerpt.slice(0,1200))}${item.excerpt.length>1200?'…':''}</div>`:''}
        ${feedback?`<div class="feedback">現在の判断：<strong>${esc(PEOPLE_ACTION_LABEL[feedback]||feedback)}</strong></div>`:''}
        <div class="actions">
          <button class="action" data-people-action="WATCH">Watch</button>
          <button class="action" data-people-action="DEEP_RESEARCH">Deep Research</button>
          <button class="action primary" data-people-action="COLLAB_CANDIDATE">Collaboration候補</button>
          <button class="action" data-people-action="FOLLOWED">Followedを記録</button>
          <button class="action" data-people-action="SKIP">Skip</button>
        </div>
      </article>`;
    }

    function intelligenceCard(item:IntelligenceItem):string{
      const signal=score(item,'signal').toFixed(1);
      const outputs=(item.suggestedOutputs||[]).map(x=>`<span class="output">${esc(x)}</span>`).join('');
      const source=item.url?`<a href="${esc(item.url)}" target="_blank" rel="noopener noreferrer">SOURCE ↗</a>`:'NO URL';
      const ace=item.aceImpact!=='none'?`<span class="tag ace-${esc(item.aceImpact)}">ACE ${esc(item.aceImpact.toUpperCase())}</span>`:'';
      const seed=item.contentSeed?`<details class="seed"><summary>生成済みの加工種を見る</summary><pre>${esc(item.contentSeed)}</pre><button class="action" data-copy="seed">Copy seed</button></details>`:'';
      return `<article class="intel-card" data-id="${esc(item.id)}">
        <div class="card-head"><div><div class="tag-row"><span class="tag topic">${esc(item.topic)}</span><span class="tag status">${esc(STATUS_LABEL[item.status]||item.status)}</span><span class="tag">${esc(item.factType)}</span><span class="tag">${esc(item.sourceKind)}</span>${ace}</div><h3 class="title">${esc(item.title)}</h3><div class="source">${source}${item.provenance?` · ${esc(item.provenance)}`:''}</div><div class="time">${esc(fmt(item.lastSeenAt||item.detectedAt))}</div></div>
        <div class="score-box"><div class="signal">${signal}</div><div class="signal-label">SIGNAL / 5</div><div class="scores"><span>I ${score(item,'interest')}</span><span>S ${score(item,'strategic')}</span><span>T ${score(item,'trust')}</span><span>R ${score(item,'reuse')}</span></div></div></div>
        ${item.whyItMatters?`<div class="why"><strong>WHY</strong> — ${esc(item.whyItMatters)}</div>`:''}
        ${item.excerpt?`<div class="excerpt">${esc(item.excerpt.slice(0,1500))}${item.excerpt.length>1500?'…':''}</div>`:''}
        <div class="outputs">${outputs}</div>
        <div class="actions">
          <button class="action" data-status="saved">保存</button>
          <button class="action" data-status="verified">確認済み</button>
          <button class="action primary" data-action="promote_evidence">Evidence化</button>
          <button class="action primary" data-action="content_seed">SNS / AI種</button>
          <button class="action" data-status="asset">Asset候補</button>
          <button class="action" data-status="project">Project候補</button>
          <button class="action" data-status="archived">Archive</button>
        </div>${seed}
      </article>`;
    }

    function card(item:IntelligenceItem):string{return isPerson(item)?personCard(item):intelligenceCard(item);}

    function render(){
      const rows=filtered(); count.textContent=`${rows.length} / ${items.length}`;
      list.innerHTML=rows.length?rows.map(card).join(''):'<div class="empty">この条件の情報はありません。</div>';
    }

    async function readResponse(res:Response):Promise<IntelligenceResponse>{
      return await res.json() as IntelligenceResponse;
    }

    async function loadItems(){
      showError('');
      const res=await fetch('/api/dashboard/intelligence',{headers:{Accept:'application/json'}});
      const data=await readResponse(res);
      if(!res.ok||!data.ok)throw new Error(data.error||`HTTP ${res.status}`);
      items=data.items||[]; updateMetrics(); render();
    }

    async function patchItem(id:string,patch:IntelligencePatch){
      const res=await fetch('/api/dashboard/intelligence',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,patch})});
      const data=await readResponse(res); if(!res.ok||!data.ok||!data.item)throw new Error(data.error||`HTTP ${res.status}`);
      items=items.map(x=>x.id===id?data.item!:x); updateMetrics(); render();
    }

    async function actionItem(id:string,action:string){
      const res=await fetch('/api/dashboard/intelligence',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,action})});
      const data=await readResponse(res); if(!res.ok||!data.ok||!data.item)throw new Error(data.error||`HTTP ${res.status}`);
      items=items.map(x=>x.id===id?data.item!:x); updateMetrics(); render();
    }

    async function peopleAction(id:string,action:string){
      const item=items.find(x=>x.id===id); if(!item)return;
      const statusByAction:Record<string,string>={WATCH:'saved',SKIP:'archived',DEEP_RESEARCH:'review',COLLAB_CANDIDATE:'project',FOLLOWED:'saved'};
      const nextTargets=(item.outputTargets||[]).filter(x=>!x.startsWith('people:'));
      nextTargets.push(`people:${action}`);
      await patchItem(id,{status:statusByAction[action]||'review',outputTargets:nextTargets});
    }

    form.addEventListener('submit',async e=>{
      e.preventDefault(); showError(''); submitState.textContent='追加中…';
      const fd=new FormData(form); const selected=String(fd.get('topic')||'General');
      try{
        const res=await fetch('/api/dashboard/intelligence',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:String(fd.get('title')||''),url:String(fd.get('url')||''),excerpt:String(fd.get('excerpt')||''),topic:selected,lenses:selected==='General'?[]:[selected],whyItMatters:String(fd.get('whyItMatters')||'')})});
        const data=await readResponse(res); if(!res.ok||!data.ok||!data.item)throw new Error(data.error||`HTTP ${res.status}`);
        items=[data.item,...items]; form.reset(); submitState.textContent='追加しました'; updateMetrics(); render(); setTimeout(()=>submitState.textContent='',1800);
      }catch(err){submitState.textContent='';showError(err);}
    });

    list.addEventListener('click',async e=>{
      if(!(e.target instanceof Element))return;
      const button=e.target.closest<HTMLButtonElement>('button'); if(!button)return;
      const cardEl=button.closest<HTMLElement>('.intel-card'); if(!cardEl)return;
      const id=cardEl.dataset.id; if(!id)return;
      if(button.dataset.copy==='seed'){
        const item=items.find(x=>x.id===id); if(item?.contentSeed){await navigator.clipboard.writeText(item.contentSeed);button.textContent='Copied';setTimeout(()=>button.textContent='Copy seed',1000);} return;
      }
      button.disabled=true; showError('');
      try{
        if(button.dataset.peopleAction) await peopleAction(id,button.dataset.peopleAction);
        else if(button.dataset.status) await patchItem(id,{status:button.dataset.status});
        else if(button.dataset.action) await actionItem(id,button.dataset.action);
      }catch(err){showError(err);button.disabled=false;}
    });

    q.addEventListener('input',render);
    kind.addEventListener('change',render);
    topic.addEventListener('change',render);
    status.addEventListener('change',render);
    impact.addEventListener('change',render);
    loadItems().catch(err=>{showError(err);list.innerHTML='<div class="empty">読み込みに失敗しました。</div>';});
  </script>
</DashboardLayout>
