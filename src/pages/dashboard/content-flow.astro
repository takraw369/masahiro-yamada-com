---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/publishing-flow-base.css';
import '../../styles/dashboard-home-presets.css';
import '../../styles/publishing-flow-choice.css';

const phases = [
  ['TOUCH','01','触れる','ん？','まず止まってもらう','現象・意外性・日常','「これ、なんで？」を1つ置く','続きを見たくなる','現象を1つ切り出して投稿にする。','保存・返信・フォローなど小さい反応'],
  ['MIRROR','02','映す','俺も','自分事にしてもらう','体験・感情・失敗・あるある','「俺の場合はこうだった」から入る','自分の経験と重ね始める','自分の体験を1つ重ねる。','自分の経験を1つ返してもらう'],
  ['SHIFT','03','ずらす','待てよ？','前提を少し揺らす','問い・比較・逆転・別の見方','「本当に○○なん？」を投げる','今までの見方を疑い始める','前提を揺らす問いを1つ置く。','保存・返信・続きへの遷移'],
  ['MAP','04','つなぐ','なるほど','構造を見せる','因果・歴史・科学・哲学・図解','点ではなく「どうつながるか」を見せる','自分の言葉で説明できる','因果や背景を3点以内でつなぐ。','深掘り・note・図解・プロフィールへ'],
  ['QUEST','05','試す','やる','身体で確かめてもらう','観察・実験・ワーク・小さな挑戦','「今日これだけ試してみて」','実際に1回やってみる','今日できる小さな実験を1つ渡す。','Quest実行・結果報告'],
  ['PROOF','06','確かめる','変わった','変化を言語化する','結果・失敗・比較・振り返り・事例','「やったら何が起きた？」を回収する','変化の理由を振り返る','やった結果・失敗・感覚を回収する。','Case・Evidence・振り返り'],
  ['FLOW','07','渡す','伝えたい','循環へつなぐ','まとめ・教材・Quest・共創・参加導線','「次は誰に／どこへ渡す？」','誰かに共有・参加・共創する','学びをまとめ、次の問いか参加先へ渡す。','共有・参加・共創・次の問い'],
];

const themes = [
  ['body','身体・食','感覚 → 観察 → 実験'],
  ['education','教育・学習','違和感 → 好奇心 → 探究'],
  ['sport','スポーツ・FLOW','体験 → 構造 → 再現'],
  ['ai','AI','使い方 → 問い → 共創'],
  ['philosophy','哲学・歴史','日常 → 語源 → 構造'],
  ['society','社会・制度','現象 → 資料 → 複数視点'],
];

const week = [
  ['月','TOUCH','現象を置く'],['火','MIRROR','体験を出す'],['水','SHIFT','前提をずらす'],
  ['木','MAP','構造を見せる'],['金','QUEST','試してもらう'],['土','PROOF','結果を回収'],['日','FLOW','次へ渡す'],
];

const channels = [
  ['','未決定 / HOLD'],
  ['x-masa','X · @MASAHIRO_501'],
  ['x-kids','X · @kodomo_athlete'],
  ['ig-kids','Instagram · @kodomo_athlete'],
  ['ig-slf','Instagram · @sunlovesflow'],
  ['note-masa','note · masahiroyamada'],
  ['note-slf','note · sunlovesflow'],
  ['line','LINE · 関係深化 / 診断'],
  ['other','その他 / 後で決める'],
];

const drive = {
  content: 'https://docs.google.com/spreadsheets/d/1mB9ZodA700hd3IRnV2Ijp-4tQ3_Y1tg_ZwGKOq_DWA8/edit',
  distribution: 'https://docs.google.com/spreadsheets/d/1429YnqTU2-WOjX-EALGo6DSeNdHjqBGDsx8HgBVhsH4/edit',
  rules: 'https://docs.google.com/document/d/1to13Se2iFtj-YwVimZNG2kZFEo15O5kteg1u7bWad6k/edit',
};
---

<DashboardLayout title="Publishing Flow" eyebrow="PUBLISHING OS">
  <main class="flow-shell">
    <header class="hero">
      <div>
        <p class="kicker">MASA PUBLISHING FLOW OS</p>
        <h1>届ける一本を、決めよう。</h1>
        <p>素材を選ぶ。相手に合わせる。下書きにして、反応を戻す。</p>
      </div>
      <nav class="hero-actions">
        <a href={drive.content} target="_blank" rel="noreferrer">CONTENT_OS</a>
        <a href="/dashboard/design-templates">見た目を選ぶ ↗</a>
      </nav>
    </header>

    <section class="command panel" aria-label="いま届ける一本">
      <div>
        <p class="kicker">いま届ける一本</p>
        <h2 id="command-title">TOUCH · まず1つ止まってもらう</h2>
        <p id="command-sub">Core未選択 · 配信先未決定</p>
      </div>
      <div class="command-actions">
        <a href="/dashboard/content-schedule">時間へ置く</a>
        <a class="dark" href="/dashboard/post" data-handoff="post">この一本の下書きを開く →</a>
        <a href={drive.distribution} target="_blank" rel="noreferrer">結果正本を見る</a>
      </div>
      <div class="command-grid">
        <div><span>相手の状態</span><strong id="summary-phase">TOUCH</strong></div>
        <div><span>選んだ素材</span><strong id="summary-core">未選択</strong></div>
        <div><span>届ける先</span><strong id="summary-channel">HOLD</strong></div>
        <div><span>次にしてほしいこと</span><strong id="summary-cta">小さい反応</strong></div>
      </div>
    </section>

    <nav class="flow-shortcuts" aria-label="届けるまでの操作"><a href="#what">01 素材を選ぶ</a><a href="#journey">02 相手に合わせる</a><a href="#where">03 届ける先を決める</a><a href="#result">04 反応を戻す</a></nav>
    <section class="top-grid" id="what">
      <article class="panel">
        <label for="weekly-question">今週の問い</label>
        <input id="weekly-question" placeholder="例：水分補給って、本当に水を飲むこと？" />
        <small>1週間を「1テーマ」ではなく「1つの問い」でつなぐ。</small>
      </article>
      <article class="panel">
        <span class="label">入口テーマ</span>
        <div class="pills">
          {themes.map(([id,label,hint]) => <button type="button" data-theme={id} data-hint={hint}>{label}</button>)}
        </div>
        <small id="theme-hint">入口を1つ選ぶ。出口はFLOWで合流。</small>
      </article>
    </section>

    <section class="decision-grid">
      <article class="panel">
        <div class="section-head compact"><div><p class="kicker">WHAT</p><h2>届ける素材を一つ選ぶ</h2></div><a href={drive.content} target="_blank" rel="noreferrer">CONTENT_OS ↗</a></div>
        <div class="field-grid">
          <label>素材番号 / Core ID<input id="core-id" placeholder="C034" /></label>
          <label>素材の核 / Big Idea<input id="core-title" placeholder="技術があるのに本番で出せない理由" /></label>
          <label class="wide">届けたい相手<input id="audience" placeholder="例：直近1〜3ヶ月に試合がある成人アスリート" /></label>
        </div>
        <small>新規制作より既存Coreを優先。Coreが未決定なら公開へ進まない。</small>
      </article>

      <article class="panel" id="where">
        <div class="section-head compact"><div><p class="kicker">WHERE / CTA</p><h2>お願いの大きさを温度に合わせる</h2></div><a href={drive.rules} target="_blank" rel="noreferrer">配信ルール ↗</a></div>
        <div class="field-grid single">
          <label>届ける先<select id="channel" aria-label="届ける先">{channels.map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
          <label>CTA<input id="cta" placeholder="例：崩れ始めの最初のサインを1つ返信" /></label>
        </div>
        <div class="cta-hint"><span>このPhaseのCTA目安</span><strong id="cta-suggestion">保存・返信・フォローなど小さい反応</strong></div>
        <small>WHATがREADYでも、WHO / WHEREが未決定ならHOLD。公開はHuman Gate。</small>
      </article>
    </section>

    <section class="phase-block" id="journey">
      <div class="section-head">
        <div><p class="kicker">JOURNEY PHASE</p><h2>今、相手はどこにいる？</h2></div>
        <p>投稿のテーマではなく「次に起こしたい状態変化」で選ぶ。</p>
      </div>
      <div class="phase-rail">
        {phases.map(([id,no,title,cue,purpose,output,template,exit,next,cta], index) => (
          <button type="button" class="phase" data-phase={id} data-no={no} data-title={title} data-purpose={purpose} data-output={output} data-template={template} data-exit={exit} data-next={next} data-cta={cta}>
            <span>{no}</span><strong>{id}</strong><b>{title}</b><small>「{cue}」</small>{index < 6 && <i>→</i>}
          </button>
        ))}
      </div>
    </section>

    <details class="phase-guide"><summary>選んだ状態に合う、作り方のヒント <span>＋</span></summary>
    <section class="now-grid">
      <article class="now panel">
        <div class="now-head"><span id="now-id" class="tag">TOUCH</span><span id="now-no">01</span></div>
        <h2 id="now-title">触れる</h2>
        <p id="now-purpose">まず止まってもらう</p>
        <div class="guide-grid">
          <div><span>今出すもの</span><strong id="now-output">現象・意外性・日常</strong></div>
          <div><span>投稿の型</span><strong id="now-template">「これ、なんで？」を1つ置く</strong></div>
          <div><span>次へ進むサイン</span><strong id="now-exit">続きを見たくなる</strong></div>
        </div>
        <div class="next-box"><span>今やること</span><strong id="now-next">現象を1つ切り出して投稿にする。</strong><a href="/dashboard/post" data-handoff="post">このPhaseで1本作る →</a></div>
      </article>
      <aside class="panel rule">
        <p class="kicker">3 QUESTIONS</p><h3>迷ったらここへ戻る。</h3>
        <ol><li><b>誰が</b>見る？</li><li>今その人は<b>どの状態</b>？</li><li>見たあと<b>何が1つ変われば成功</b>？</li></ol>
        <p>情報量ではなく「状態変化」で決める。</p>
      </aside>
    </section>

    </details>
    <details class="week-guide"><summary>1週間の組み立てを考える <span>＋</span></summary>
    <section class="panel week-panel">
      <div class="section-head compact"><div><p class="kicker">WHEN / WEEK FLOW</p><h2>1週間の基本順</h2></div><a href="/dashboard/content-schedule">Content Schedule →</a></div>
      <div class="week-grid">
        {week.map(([day,phase,action], index) => <button type="button" data-day={index} data-jump={phase}><span>{day}</span><strong>{phase}</strong><small>{action}</small></button>)}
      </div>
      <small>曜日は固定ルールではない。反応が止まっているなら、そのPhaseをもう1回。Feedは螺旋、正本Journeyは順序を持つ。</small>
    </section>

    </details>
    <section class="panel inbox-panel">
      <div class="section-head compact"><div><p class="kicker">MATERIAL INBOX</p><h2>ネタを「テーマ × Phase」で置く</h2></div><p>完成させず、そのまま置いてOK。</p></div>
      <form id="material-form"><textarea id="material-text" aria-label="素材メモ" rows="3" placeholder="例：絶対音感＝正解を当てる能力、だけではないかもしれない"></textarea><button>今のPhaseに置く</button></form>
      <div id="material-list" class="materials"></div>
    </section>

    <section class="panel result-panel" id="result">
      <div class="section-head compact"><div><p class="kicker">RESULT → LEARNING</p><h2>出した後に、次のFlowを決める</h2></div><a href={drive.distribution} target="_blank" rel="noreferrer">DISTRIBUTION_OS ↗</a></div>
      <form id="result-form"><textarea id="result-text" aria-label="今回の学び" rows="3" placeholder="例：返信は少ないが保存が伸びた。次はMAPで構造図にする。"></textarea><button>今回の学びを残す</button></form>
      <div id="result-list" class="results"></div>
      <small>ここは判断overlay。正式な配信実績・KPIはDISTRIBUTION_OSへ戻す。</small>
    </section>

    <details class="flow-map"><summary>全体の流れと正本を確認する <span>＋</span></summary>
    <section class="one-flow panel" aria-label="Publishing Flow">
      <a href="#journey"><span>01</span><strong>JOURNEY</strong><small>相手はいまどこ？</small></a>
      <b>→</b>
      <a href="#what"><span>02</span><strong>WHAT</strong><small>何を出す？</small></a>
      <b>→</b>
      <a href="#where"><span>03</span><strong>WHERE / CTA</strong><small>誰に・どこへ？</small></a>
      <b>→</b>
      <a href="/dashboard/content-schedule"><span>04</span><strong>WHEN</strong><small>いつ出す？</small></a>
      <b>→</b>
      <a href="/dashboard/post" data-handoff="post"><span>05</span><strong>CREATE</strong><small>下書き・確認</small></a>
      <b>→</b>
      <a href="#result"><span>06</span><strong>RESULT</strong><small>何が起きた？</small></a>
    </section>

    </details>
    <footer><strong>Journey → What → Where / CTA → When → Create → Result → Learning → Next</strong><span>作るOSではなく、選ぶ → 流す → 学ぶOS。</span></footer>
  </main>
</DashboardLayout>

<script is:inline>
(() => {
  const key = 'masa-publishing-flow-v2';
  const oldKey = 'masa-content-flow-v1';
  const defaults = { phase:'TOUCH', theme:'body', question:'', coreId:'', coreTitle:'', audience:'', channel:'', cta:'', materials:[], results:[] };
  let state = { ...defaults };
  try {
    const saved = JSON.parse(localStorage.getItem(key) || 'null');
    if (saved) state = { ...defaults, ...saved };
    else {
      const old = JSON.parse(localStorage.getItem(oldKey) || 'null');
      if (old) state = { ...defaults, phase:old.phase || defaults.phase, theme:old.theme || defaults.theme, question:old.question || '', materials:Array.isArray(old.materials) ? old.materials : [] };
    }
  } catch {}

  // Browser storage is an overlay; corrupt or unavailable storage must not stop the UI.
  for (const field of ['phase','theme','question','coreId','coreTitle','audience','channel','cta']) {
    if (typeof state[field] !== 'string') state[field] = defaults[field];
  }
  for (const field of ['materials','results']) {
    state[field] = Array.isArray(state[field]) ? state[field].filter(item => item && typeof item === 'object' && typeof item.text === 'string').slice(0, field === 'materials' ? 30 : 20) : [];
  }
  function storageNotice() {
    const node = document.getElementById('flow-storage-status');
    if (node) { node.hidden = false; node.textContent = 'このブラウザでは保存できません。入力はこの画面を閉じると失われます。必要な内容をコピーして残してください。'; }
  }
  const save = () => { try { localStorage.setItem(key, JSON.stringify(state)); return true; } catch { storageNotice(); return false; } };
  const phases = [...document.querySelectorAll('[data-phase]')];
  const themes = [...document.querySelectorAll('[data-theme]')];
  const setText = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value || ''; };
  const esc = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const el = (id) => document.getElementById(id);

  function channelLabel() {
    const select = el('channel');
    return select?.selectedOptions?.[0]?.textContent?.trim() || 'HOLD';
  }

  function updateCommand() {
    const phase = phases.find(x => x.dataset.phase === state.phase) || phases[0];
    const core = [state.coreId, state.coreTitle].filter(Boolean).join(' · ') || state.question || '未選択';
    const where = state.channel ? channelLabel() : 'HOLD / 未決定';
    const cta = state.cta || phase?.dataset.cta || '小さい反応';
    setText('summary-phase', state.phase);
    setText('summary-core', core);
    setText('summary-channel', where);
    setText('summary-cta', cta);
    setText('command-title', `${state.phase} · ${phase?.dataset.purpose || '次の状態変化を決める'}`);
    setText('command-sub', `${core} · ${where}`);
  }

  function selectPhase(id) {
    const b = phases.find(x => x.dataset.phase === id) || phases[0]; if (!b) return;
    state.phase = b.dataset.phase || 'TOUCH'; save();
    phases.forEach(x => { x.classList.toggle('active', x === b); x.setAttribute?.('aria-pressed',String(x === b)); });
    ['no','title','purpose','output','template','exit','next'].forEach(k => setText('now-' + k, b.dataset[k]));
    setText('now-id', b.dataset.phase);
    setText('cta-suggestion', b.dataset.cta);
    updateCommand();
  }

  function selectTheme(id) {
    const b = themes.find(x => x.dataset.theme === id) || themes[0]; if (!b) return;
    state.theme = b.dataset.theme || 'body'; save(); themes.forEach(x => { x.classList.toggle('active', x === b); x.setAttribute?.('aria-pressed',String(x === b)); }); setText('theme-hint', b.dataset.hint); updateCommand();
  }

  function renderMaterials() {
    const root = el('material-list'); if (!root) return;
    if (!state.materials.length) { root.innerHTML = '<p class="empty">まだ素材なし。思いつきを完成させず、そのまま置いてOK。</p>'; return; }
    root.innerHTML = state.materials.map((m,i) => `<article><div><span>${esc(m.theme)}</span><b>${esc(m.phase)}</b></div><p>${esc(m.text)}</p><button type="button" data-remove-material="${i}" aria-label="素材を削除">×</button></article>`).join('');
    root.querySelectorAll('[data-remove-material]').forEach(b => b.onclick = () => { state.materials.splice(Number(b.dataset.removeMaterial),1); save(); renderMaterials(); });
  }

  function renderResults() {
    const root = el('result-list'); if (!root) return;
    if (!state.results.length) { root.innerHTML = '<p class="empty">まだ学びなし。公開後に「反応 / 非反応 / 理由 / 次」を1行で残す。</p>'; return; }
    root.innerHTML = state.results.map((r,i) => `<article><div><b>${esc(r.phase)}</b><span>${esc(r.at)}</span></div><p>${esc(r.text)}</p><button type="button" data-remove-result="${i}" aria-label="学びを削除">×</button></article>`).join('');
    root.querySelectorAll('[data-remove-result]').forEach(b => b.onclick = () => { state.results.splice(Number(b.dataset.removeResult),1); save(); renderResults(); });
  }

  function bindInput(id, field) {
    const node = el(id); if (!node) return;
    node.value = state[field] || '';
    node.addEventListener('input', () => { state[field] = node.value; save(); updateCommand(); });
    node.addEventListener('change', () => { state[field] = node.value; save(); updateCommand(); });
  }

  phases.forEach(b => b.onclick = () => selectPhase(b.dataset.phase));
  themes.forEach(b => b.onclick = () => selectTheme(b.dataset.theme));
  document.querySelectorAll('[data-jump]').forEach(b => b.onclick = () => { selectPhase(b.dataset.jump); document.getElementById('journey')?.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'}); });

  bindInput('weekly-question','question');
  bindInput('core-id','coreId');
  bindInput('core-title','coreTitle');
  bindInput('audience','audience');
  bindInput('channel','channel');
  bindInput('cta','cta');

  const materialForm = el('material-form'); const materialText = el('material-text');
  if (materialForm && materialText) materialForm.onsubmit = e => { e.preventDefault(); const value = materialText.value.trim(); if (!value) return; const theme = themes.find(x => x.dataset.theme === state.theme)?.textContent?.trim() || state.theme; state.materials.unshift({text:value,phase:state.phase,theme}); state.materials = state.materials.slice(0,30); materialText.value=''; save(); renderMaterials(); };

  const resultForm = el('result-form'); const resultText = el('result-text');
  if (resultForm && resultText) resultForm.onsubmit = e => { e.preventDefault(); const value = resultText.value.trim(); if (!value) return; state.results.unshift({text:value,phase:state.phase,at:new Intl.DateTimeFormat('ja-JP',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}).format(new Date())}); state.results = state.results.slice(0,20); resultText.value=''; save(); renderResults(); };

  document.querySelectorAll('[data-handoff="post"]').forEach(link => link.addEventListener('click', (event) => {
    try { localStorage.setItem('masa-publishing-handoff-v1', JSON.stringify({phase:state.phase,theme:state.theme,question:state.question,coreId:state.coreId,coreTitle:state.coreTitle,audience:state.audience,channel:channelLabel(),cta:state.cta,createdAt:Date.now()})); } catch { event.preventDefault(); storageNotice(); }
  }));

  const jsDay = new Date().getDay(); const today = jsDay === 0 ? 6 : jsDay - 1; document.querySelector(`[data-day="${today}"]`)?.classList.add('today');
  selectPhase(state.phase); selectTheme(state.theme); renderMaterials(); renderResults(); updateCommand();
})();
</script>

<script>
  import { loadHomeDesign } from '../../data/homeDesignCombinations';
  try {
    const config=loadHomeDesign(localStorage);
    const surface=document.querySelector<HTMLElement>('.flow-shell');
    if(config && surface){
      surface.dataset.homePreset=config.style;
      surface.dataset.homeButtons=config.buttons;
      surface.dataset.homeCards=config.cards;
      surface.dataset.homeNavigation=config.navigation;
      surface.dataset.homeCta=config.cta;
    }
  } catch { /* Unavailable preferences retain the standard readable view. */ }
</script>
