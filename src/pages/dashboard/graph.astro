  { id: 'N016', label: 'RETURN', fullLabel: '乱れても戻り、再選択できる', kind: 'PRINCIPLE', role: 'Performance Principle', status: 'MAPPED', note: '強さを「乱れない」ではなく「戻り、再選択できる能力」と捉える。' },
