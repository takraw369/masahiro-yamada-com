---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const nodes = [
  { id:'N025', label:'MASTER DASHBOARD', kind:'CONTROL', note:'MASA OS全体の現在地・優先順位・次Actionを俯瞰する操作面。' },
  { id:'N026', label:'DRIVE INDEX', kind:'CONTROL', note:'Drive全体を発見・分類し、正本と処理対象を見つける索引。' },
  { id:'N017', label:'KNOWLEDGE FACTORY', kind:'KNOWLEDGE', note:'SourceをNodeへ分解し、既存Canonと接続して再利用可能な知識へ変換する。' },
  { id:'N018', label:'HUMAN FLOW GRAPH', kind:'HUMAN', note:'人・状態・学び・縁・行動を意味付きEdgeで接続するHuman OS。' },
  { id:'N019', label:'ACE BRAIN', kind:'HUMAN', note:'過去の知識・状態・関係から、今の次の良い経験へ進める認知OS。' },
  { id:'N020', label:'CONTENT OS', kind:'OUTPUT', note:'KnowledgeをSNS・note・Quest・Productへ届く表現へ変換する。' },
  { id:'N021', label:'PRODUCT OS', kind:'BUSINESS', note:'Sellable資産をOffer・Naming・Priceへ変換する。' },
  { id:'N022', label:'QUEST MASTER', kind:'ACTION', note:'Knowledgeを問い・実践へ変換し、Evidenceを残す。' },
  { id:'N023', label:'DISTRIBUTION OS', kind:'OUTPUT', note:'Contentを市場へ出し、反応をEvidenceとして戻す。' },
  { id:'N024', label:'CRM OS', kind:'BUSINESS', note:'顧客・見込み客との接点、反応、CaseをKnowledgeとProductへ戻す。' },
  { id:'N027', label:'ASSET FLOW', kind:'OUTPUT', note:'RAW→SIGNAL→IP→CONTENT→OFFER→REVENUEへ価値変換する流れ。' },
  { id:'N028', label:'WANT TO', kind:'LIFE', note:'Want toとPurposeをProject・Taskへ接続し、実践Evidenceで更新する。' },
  { id:'N029', label:'CAPITAL OS', kind:'BUSINESS', note:'RevenueをRunway・自由・資本形成へ接続する。' },
  { id:'N030', label:'REVENUE IDEAS', kind:'BUSINESS', note:'収益候補を資産性・反復性・波及で比較する。' },
  { id:'N031', label:'SHEET HUB', kind:'CONTROL', note:'重要Spreadsheetへ迷わず到達する人間向け入口。' },
  { id:'N003', label:'PREDICTION GAP', kind:'PRINCIPLE', note:'予測→実測→誤差→更新。学習や市場検証へ横断転用できる。' },
  { id:'N013', label:'LIFE HIERARCHY', kind:'PRINCIPLE', note:'Source→Being→Purpose→Vision→Want to→Project→Task。' },
  { id:'N016', label:'RETURN', kind:'PRINCIPLE', note:'強さは乱れないことではなく、戻って再選択できること。' },
  { id:'N011', label:'EN FLOW', kind:'PRINCIPLE', note:'縁は状態・環境・接触・信頼・交換・タイミング・継続で育つFlow。' },
  { id:'N012', label:'EDUCATION → POSSIBILITY', kind:'PRINCIPLE', note:'Educationは答えを渡すだけでなく、次の可能性・人・場所・体験へ接続する。' },
];

const edges = [
  { source:'N026', target:'N017', relation:'feeds', state:'CONFIRMED', note:'Drive資産をKnowledge Factoryへ送る' },
  { source:'N017', target:'N020', relation:'produces', state:'CONFIRMED', note:'KnowledgeをContentへ変換' },
  { source:'N017', target:'N018', relation:'feeds', state:'CONFIRMED', note:'KnowledgeをHuman Flowへ供給' },
  { source:'N018', target:'N022', relation:'routes_to', state:'CONFIRMED', note:'状態からNext Questへ' },
  { source:'N022', target:'N018', relation:'evidence_for', state:'CONFIRMED', note:'Quest EvidenceがHuman Flowを更新' },
  { source:'N020', target:'N021', relation:'feeds', state:'CONFIRMED', note:'Sellable ContentをOfferへ' },
  { source:'N020', target:'N023', relation:'distributed_by', state:'CONFIRMED', note:'Contentを市場へ配信' },
  { source:'N023', target:'N017', relation:'evidence_for', state:'CONFIRMED', note:'市場反応をKnowledgeへ戻す' },
  { source:'N024', target:'N017', relation:'evidence_for', state:'CONFIRMED', note:'顧客反応をKnowledgeへ戻す' },
  { source:'N024', target:'N021', relation:'informs', state:'CONFIRMED', note:'顧客EvidenceがOffer改善へ' },
  { source:'N027', target:'N020', relation:'transforms', state:'CONFIRMED', note:'AssetをContentへ' },
  { source:'N027', target:'N021', relation:'transforms', state:'CONFIRMED', note:'AssetをOfferへ' },
  { source:'N028', target:'N018', relation:'informs', state:'CONFIRMED', note:'Want toをRoutingへ' },
  { source:'N018', target:'N019', relation:'informs', state:'CONFIRMED', note:'Human FlowをACE BRAINへ' },
  { source:'N017', target:'N019', relation:'feeds', state:'CONFIRMED', note:'KnowledgeをACE BRAINへ' },
  { source:'N025', target:'N017', relation:'surfaces', state:'CONFIRMED', note:'DashboardからKnowledge Factoryを参照' },
  { source:'N025', target:'N021', relation:'surfaces', state:'CONFIRMED', note:'DashboardからProduct OSを参照' },
  { source:'N031', target:'N025', relation:'surfaces', state:'CONFIRMED', note:'Sheet HubからDashboardへ' },
  { source:'N030', target:'N021', relation:'informs', state:'CONFIRMED', note:'Revenue候補をProduct化へ' },
  { source:'N021', target:'N029', relation:'feeds', state:'CONFIRMED', note:'商品収益をCapital判断へ' },
  { source:'N016', target:'N021', relation:'supports', state:'CONFIRMED', note:'RETURN原理がOfferの核を支える' },
  { source:'N011', target:'N018', relation:'supports', state:'CONFIRMED', note:'縁を動的Relationship Graphへ拡張' },
  { source:'N013', target:'N028', relation:'supports', state:'CONFIRMED', note:'Life hierarchyがWant toを支える' },
];

const suggestions = [
  { id:'E035', source:'N003', target:'N023', relation:'supports', title:'予測誤差 × 発信改善', reason:'予測→実測→誤差更新の学習原理は、投稿仮説→反応→改善にも同型で使える可能性がある。', confidence:'MEDIUM-HIGH' },
  { id:'E036', source:'N013', target:'N030', relation:'informs', title:'人生設計 × 収益ポートフォリオ', reason:'Want to階層とRevenue候補を重ねると、「稼げるが未来を削る案」を見つけやすくなる可能性がある。', confidence:'MEDIUM' },
  { id:'E037', source:'N012', target:'N024', relation:'supports', title:'Education × CRM', reason:'CRMを顧客管理だけでなく「次の良い縁・人・体験を返す層」へ拡張できる可能性がある。', confidence:'MEDIUM' },
];

const kindMeta: Record<string, { label: string; color: string }> = {
  CONTROL:{ label:'操作・入口', color:'#59636e' }, KNOWLEDGE:{ label:'知識', color:'#7c5ce1' },
  HUMAN:{ label:'人・状態', color:'#157a70' }, OUTPUT:{ label:'発信・出力', color:'#2f6fb7' },
  BUSINESS:{ label:'事業・収益', color:'#a85b19' }, ACTION:{ label:'行動・実践', color:'#b64444' },
  LIFE:{ label:'人生・Purpose', color:'#a64378' }, PRINCIPLE:{ label:'原理・思想', color:'#7352a8' },
};

const relationLabels: Record<string,string> = {
  feeds:'渡す', produces:'生み出す', routes_to:'次の行動へ', evidence_for:'結果を返す',
  distributed_by:'市場へ届ける', informs:'判断に使う', transforms:'形を変える', surfaces:'開く',
  supports:'支える', related_to:'つながる', contrasts:'比べる',
};

const relationGuide = [
  ['渡す','知識・価値・材料などが、次のNodeへ流れ込む。'],
  ['開く','そのNodeから別のNodeへアクセス・参照できる。'],
  ['結果を返す','行動や市場の結果を、学習・判断側へ戻す。'],
  ['判断に使う','一方の情報が、もう一方の意思決定に効く。'],
  ['形を変える','同じ資産をContentやOfferなど別の形へ変換する。'],
  ['支える','原理・思想・仕組みが別のNodeの土台になる。'],
];

const kindEntries = Object.entries(kindMeta).map(([kind, meta]) => ({ kind, ...meta, count:nodes.filter(node => node.kind === kind).length }));
---

<DashboardLayout title="MASA Brain Graph" fullHeight={true}>
  <div class="graph-app">
    <header class="graph-header">
      <div class="graph-title">
        <p class="eyebrow-local">MASA BRAIN · LIVING GRAPH v0.4</p>
        <div class="title-row"><h1>つながりから、次の一手を見つける。</h1><span class="status-badge">{nodes.length} nodes · {edges.length} edges</span></div>
        <div class="howto"><span><b>1</b>左で探す</span><span><b>2</b>中央で流れを見る</span><span><b>3</b>右で意味と次Action</span></div>
      </div>
      <div class="header-actions">
        <label class="global-search"><span>⌕</span><input id="search" placeholder="例：CONTENT / 人 / 収益" autocomplete="off" /><kbd>/</kbd></label>
        <button id="reset-view" class="ui-btn" type="button">全体表示</button>
        <button id="connect-mode" class="ui-btn" type="button">＋ 2点をつなぐ</button>
        <button id="gpt-next" class="ui-btn accent" type="button">✦ AIの接続候補</button>
      </div>
    </header>

    <div class="workspace">
      <aside class="explorer">
        <section class="explorer-section">
          <div class="section-head"><div><p class="section-kicker">EXPLORE</p><h2>何を見たい？</h2></div><button id="clear-filters" class="text-btn" type="button">リセット</button></div>
          <button class="filter-btn active" data-kind="ALL" type="button"><span class="filter-dot all"></span><span>すべて</span><small>{nodes.length}</small></button>
          {kindEntries.map(item => <button class="filter-btn" data-kind={item.kind} type="button"><span class="filter-dot" style={`--dot:${item.color}`}></span><span>{item.label}</span><small>{item.count}</small></button>)}
        </section>
        <section class="explorer-section node-browser">
          <div class="section-head compact"><div><p class="section-kicker">NODES</p><h2>一覧から選ぶ</h2></div><span id="result-count" class="result-count">{nodes.length}</span></div>
          <div id="node-list" class="node-list">
            {nodes.map(node => <button class="node-list-item" data-node={node.id} type="button"><span class="node-list-main"><i style={`--node:${kindMeta[node.kind].color}`}></i><span><strong>{node.label}</strong><small>{kindMeta[node.kind].label}</small></span></span><span>›</span></button>)}
          </div>
          <p id="empty-list" class="empty-list" hidden>該当するNodeがありません。</p>
        </section>
      </aside>

      <main class="canvas-panel">
        <div class="canvas-toolbar">
          <div id="selection-chip" class="selection-chip"><span class="selection-dot"></span><span id="selection-text">MASTER DASHBOARD を中心に表示</span></div>
          <div class="view-actions">
            <button id="motion-toggle" class="motion-toggle active" type="button" aria-pressed="true"><i></i><span>FLOW ON</span></button>
            <label class="switch-label"><input id="edge-label-toggle" type="checkbox" checked /><span>関係ラベル</span></label>
            <button id="zoom-out" class="icon-action" type="button" aria-label="縮小">−</button><button id="zoom-in" class="icon-action" type="button" aria-label="拡大">＋</button>
          </div>
        </div>
        <div class="canvas-wrap">
          <svg id="graph" viewBox="0 0 1600 1000" role="img" aria-label="MASA Brain living knowledge graph">
            <defs>
              <marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="3.5" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L7,3.5 L0,7 Z" class="arrow-head"></path></marker>
              <filter id="soft-shadow" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="5" stdDeviation="8" flood-opacity=".12" /></filter>
              <filter id="flow-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            </defs>
            <g id="edge-layer"></g><g id="candidate-layer"></g><g id="node-layer"></g>
          </svg>
          <div class="canvas-help" id="hint">FLOWは“呼吸する程度”の動きです。Nodeを選ぶと周辺の流れが見やすくなります。</div>
          <div class="legend"><span><i class="line confirmed"></i>確認済み</span><span><i class="line ai"></i>AI候補</span><span><i class="line masa"></i>MASA提案</span></div>
          <div class="minimap-wrap"><div class="minimap-head"><span>OVERVIEW</span><button id="mini-reset" type="button">全体</button></div><svg id="mini-map" viewBox="0 0 1600 1000" aria-hidden="true"><g id="mini-edge-layer"></g><g id="mini-node-layer"></g><rect id="mini-viewport" x="0" y="0" width="1600" height="1000" rx="10"></rect></svg></div>
        </div>
      </main>

      <aside class="inspector">
        <section class="inspector-card primary-card">
          <div class="inspector-card-head"><div><p class="section-kicker">SELECTED NODE</p><div class="kind-pill" id="node-kind">操作・入口</div></div><button id="clear-selection" class="icon-close" type="button">×</button></div>
          <h2 id="node-title">MASTER DASHBOARD</h2><p id="node-note" class="node-note">MASA OS全体の現在地・優先順位・次Actionを俯瞰する操作面。</p>
          <div class="insight-box"><span>見るポイント</span><p id="node-insight">矢印の向き＝何がどこへ流れるか。線の言葉はその“流れ方”です。</p></div>
          <div class="connections-head"><h3>直接つながるNode</h3><span id="connection-count">0</span></div><div id="node-links" class="connection-list"></div>
        </section>

        <details class="inspector-card relation-guide">
          <summary><span><span class="section-kicker">RELATION GUIDE</span><strong>線の言葉って何？</strong></span><span>＋</span></summary>
          <div class="guide-body"><p>矢印は「何が、どこへ、どう影響するか」。抽象語ではなく、なるべく動詞で読めるようにしています。</p>{relationGuide.map(([label, desc]) => <div class="guide-row"><b>{label}</b><span>{desc}</span></div>)}</div>
        </details>

        <details class="inspector-card composer" id="composer">
          <summary><span><span class="section-kicker">MASA → GRAPH</span><strong>自分で2点をつなぐ</strong></span><span>＋</span></summary>
          <div class="composer-body">
            <div class="pair"><span id="pair-a">1点目を選択</span><b>→</b><span id="pair-b">2点目を選択</span></div>
            <label>関係<select id="relation"><option value="supports">支える</option><option value="informs">判断に使う</option><option value="feeds">渡す</option><option value="routes_to">次の行動へ</option><option value="related_to">つながる</option><option value="contrasts">比べる</option></select></label>
            <label>なぜつながる？<textarea id="comment" rows="3" placeholder="例：同じ原理が商品設計にも使える"></textarea></label>
            <div class="composer-actions"><button id="composer-clear" class="ui-btn" type="button">選び直す</button><button id="save-proposal" class="ui-btn accent grow" type="button">接続案を保存</button></div><p id="save-status" class="save-status"></p>
          </div>
        </details>

        <section class="inspector-card ai-card">
          <div class="ai-card-head"><div><p class="section-kicker">AI DISCOVERY</p><h3 id="gpt-title">遠い点のつながり候補</h3></div><span id="gpt-confidence" class="confidence">未選択</span></div>
          <p id="gpt-reason" class="node-note">「AIの接続候補」を押すと、既存Knowledgeから候補を1件ずつ表示します。</p><div id="gpt-pair" class="pair compact"></div>
          <div class="decision-row"><button id="gpt-accept" class="ui-btn accent grow" disabled>採用候補</button><button id="gpt-hold" class="ui-btn grow" disabled>保留</button></div>
          <p class="micro">AI候補は仮説。MASAの判断を通して初めてGraphへ残します。</p>
        </section>
        <details class="inspector-card activity-card"><summary><span><span class="section-kicker">RECENT NOTES</span><strong>最近のGraphメモ</strong></span><span>＋</span></summary><div id="activity" class="activity"><p class="node-note">読み込み中…</p></div></details>
      </aside>
    </div>
  </div>
</DashboardLayout>

<style>
  .graph-app{--bg:#f4f2ee;--panel:#fff;--ink:#20262d;--muted:#66717c;--line:#d9d4cc;--accent:#9a641f;height:calc(100vh - 66px);min-height:680px;display:flex;flex-direction:column;background:var(--bg);color:var(--ink);overflow:hidden}
  .graph-header{flex:0 0 auto;min-height:126px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:18px 22px;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line)}
  .graph-title{min-width:0}.eyebrow-local,.section-kicker{color:#8b5b2c;font-size:.62rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.title-row{display:flex;align-items:center;gap:12px;margin-top:3px;flex-wrap:wrap}.title-row h1{font-size:1.22rem}.status-badge{padding:2px 8px;border:1px solid #ddd6cb;border-radius:999px;color:#727983;background:#fbfaf8;font-size:.62rem}.howto{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}.howto span{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:7px;background:#f7f4ef;color:#626b75;font-size:.66rem}.howto b{width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:#fff;border:1px solid #d7d0c7;color:#7a4c15;font-size:.58rem}
  .header-actions{display:flex;align-items:center;justify-content:flex-end;gap:7px;flex-wrap:wrap}.global-search{width:min(300px,30vw);min-width:230px;height:42px;display:flex;align-items:center;gap:8px;padding:0 10px;border:1px solid #cbc5bc;background:#fff;border-radius:9px}.global-search:focus-within{border-color:#b5874d;box-shadow:0 0 0 3px rgba(165,108,34,.09)}.global-search input{min-width:0;flex:1;border:0;outline:0;background:transparent;font:inherit;font-size:.73rem}.global-search kbd{padding:1px 5px;border:1px solid #ddd7cf;border-radius:4px;color:#8b929a;background:#f8f7f4;font-size:.58rem}
  .ui-btn{min-height:40px;display:inline-flex;align-items:center;justify-content:center;padding:7px 11px;border:1px solid #cbc5bc;border-radius:8px;background:#fff;color:#59636e;cursor:pointer;font:inherit;font-size:.7rem;font-weight:700}.ui-btn:hover,.ui-btn.active{border-color:#a97940;color:#754a16;background:#fbf5ec}.ui-btn.accent{border-color:#b98a4f;background:#9a641f;color:#fff}.ui-btn:disabled{opacity:.38;cursor:not-allowed}.grow{flex:1}
  .workspace{min-height:0;flex:1;display:grid;grid-template-columns:230px minmax(0,1fr) 330px}.explorer,.inspector{min-height:0;overflow:auto;background:#fff}.explorer{border-right:1px solid var(--line)}.inspector{border-left:1px solid var(--line);padding:10px;display:grid;align-content:start;gap:9px}.explorer-section{padding:14px 12px;border-bottom:1px solid #ece8e2}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px}.section-head.compact{align-items:center}.section-head h2{margin-top:2px;font-size:.82rem}.text-btn{border:0;background:transparent;color:#8a6c48;cursor:pointer;font:inherit;font-size:.62rem;text-decoration:underline}.result-count{min-width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;background:#f0ede8;color:#68717b;font-size:.61rem}
  .filter-btn{width:100%;min-height:38px;display:grid;grid-template-columns:14px 1fr auto;align-items:center;gap:7px;padding:6px 8px;border:1px solid transparent;border-radius:7px;background:transparent;color:#66717b;text-align:left;cursor:pointer;font:inherit;font-size:.68rem}.filter-btn:hover{background:#f7f4ef}.filter-btn.active{border-color:#decfb9;background:#f7efe3;color:#68410f;font-weight:700}.filter-btn small{color:#939aa2;font-size:.58rem}.filter-dot{width:8px;height:8px;border-radius:50%;background:var(--dot,#a5abb2)}.filter-dot.all{background:linear-gradient(135deg,#157a70 0 25%,#7c5ce1 25% 50%,#2f6fb7 50% 75%,#a85b19 75%)}
  .node-list{display:grid;gap:2px}.node-list-item{width:100%;min-height:48px;display:flex;align-items:center;justify-content:space-between;gap:7px;padding:7px;border:1px solid transparent;border-radius:7px;background:transparent;color:#58626d;text-align:left;cursor:pointer;font:inherit}.node-list-item:hover{background:#f8f6f2}.node-list-item.active{border-color:#d9c7aa;background:#faf2e7}.node-list-item[hidden]{display:none}.node-list-main{min-width:0;display:flex;align-items:center;gap:8px}.node-list-main i{width:8px;height:28px;flex:0 0 auto;border-radius:6px;background:var(--node)}.node-list-main span{min-width:0}.node-list-main strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#31383f;font-size:.64rem}.node-list-main small{display:block;margin-top:2px;color:#8a929b;font-size:.56rem}.empty-list{padding:12px 4px;color:#8b929a;font-size:.66rem}
