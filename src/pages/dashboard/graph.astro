<script define:vars={{ nodes, edges, suggestions, kindMeta, relationLabels }}>
  const NS='http://www.w3.org/2000/svg';
  const $=id=>document.getElementById(id);
  const svg=$('graph'),edgeLayer=$('edge-layer'),candidateLayer=$('candidate-layer'),nodeLayer=$('node-layer');
  const miniEdgeLayer=$('mini-edge-layer'),miniNodeLayer=$('mini-node-layer'),miniViewport=$('mini-viewport');
  const search=$('search'),resultCount=$('result-count'),emptyList=$('empty-list');
  const nodeListItems=[...document.querySelectorAll('.node-list-item')],filterButtons=[...document.querySelectorAll('.filter-btn')];
  const connectBtn=$('connect-mode'),hint=$('hint'),pairA=$('pair-a'),pairB=$('pair-b'),comment=$('comment'),relation=$('relation'),saveBtn=$('save-proposal'),saveStatus=$('save-status');
  const nodeTitle=$('node-title'),nodeKind=$('node-kind'),nodeNote=$('node-note'),nodeLinks=$('node-links'),nodeInsight=$('node-insight'),connectionCount=$('connection-count'),selectionText=$('selection-text'),selectionDot=document.querySelector('.selection-dot');
  const activity=$('activity'),gptNext=$('gpt-next'),gptTitle=$('gpt-title'),gptReason=$('gpt-reason'),gptPair=$('gpt-pair'),gptConfidence=$('gpt-confidence'),gptAccept=$('gpt-accept'),gptHold=$('gpt-hold');
  const edgeLabelToggle=$('edge-label-toggle'),motionToggle=$('motion-toggle');
  const byId=new Map(nodes.map(n=>[n.id,n])),humanEdges=[],positions=new Map(),motionSeeds=new Map();
  const kindCenters={CONTROL:[780,120],KNOWLEDGE:[770,350],HUMAN:[1110,405],OUTPUT:[510,520],BUSINESS:[1030,735],ACTION:[1350,575],LIFE:[420,785],PRINCIPLE:[265,315]};
  const buckets={};nodes.forEach(n=>((buckets[n.kind]??=[]).push(n)));
  Object.entries(buckets).forEach(([kind,list])=>{const c=kindCenters[kind]||[800,500],rx=Math.min(205,105+list.length*18),ry=Math.min(150,70+list.length*13);list.forEach((n,i)=>{const a=list.length===1?0:(Math.PI*2*i/list.length)-Math.PI/2;positions.set(n.id,{x:list.length===1?c[0]:c[0]+Math.cos(a)*rx,y:list.length===1?c[1]:c[1]+Math.sin(a)*ry});});});
  nodes.forEach((n,i)=>motionSeeds.set(n.id,{phase:(i*1.73)%6.28,phase2:(i*2.31+1.2)%6.28,amp:7+(i%5)*2,speed:.00016+(i%4)*.000025}));

  let selected='N025',activeKind='ALL',connectMode=false,pair=[],gptIndex=-1,gptSuggestion=null,view={x:0,y:0,w:1600,h:1000},panStart=null,hoveredId=null;
  let motionEnabled=!window.matchMedia?.('(prefers-reduced-motion: reduce)').matches,animationFrame=null;

  const labelFor=id=>byId.get(id)?.label||id;
  const kindLabel=kind=>kindMeta[kind]?.label||kind;
  const relationLabel=key=>relationLabels[key]||key;
  const allEdges=()=>[...edges,...humanEdges];
  const connectedEdges=id=>allEdges().filter(e=>e.source===id||e.target===id);
  const connectedIds=id=>{const s=new Set([id]);connectedEdges(id).forEach(e=>{s.add(e.source);s.add(e.target)});return s};
  const currentQuery=()=>(search.value||'').trim().toLowerCase();
  const makeSvg=(tag,attrs={})=>{const el=document.createElementNS(NS,tag);Object.entries(attrs).forEach(([k,v])=>el.setAttribute(k,String(v)));return el};
  const escapeHtml=v=>String(v).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));

  function pointFor(id,time=0){const p=positions.get(id);if(!p)return {x:0,y:0,scale:1};if(!motionEnabled)return {...p,scale:1};const s=motionSeeds.get(id),soft=(id===selected||id===hoveredId)?.24:1;const dx=Math.sin(time*s.speed+s.phase)*s.amp*soft+Math.sin(time*s.speed*.57+s.phase2)*s.amp*.28*soft;const dy=Math.cos(time*s.speed*.83+s.phase2)*s.amp*.72*soft;const depth=Math.sin(time*s.speed*.48+s.phase2);return {x:p.x+dx,y:p.y+dy,scale:1+depth*.018*soft};}
  function matchingIds(){const q=currentQuery(),direct=nodes.filter(n=>(activeKind==='ALL'||n.kind===activeKind)&&(!q||n.label.toLowerCase().includes(q)||n.note.toLowerCase().includes(q))).map(n=>n.id);if(activeKind==='ALL'&&!q)return new Set(nodes.map(n=>n.id));const s=new Set(direct);allEdges().forEach(e=>{if(s.has(e.source))s.add(e.target);if(s.has(e.target))s.add(e.source)});return s}
  function visibleInList(n){const q=currentQuery();return (activeKind==='ALL'||n.kind===activeKind)&&(!q||n.label.toLowerCase().includes(q)||n.note.toLowerCase().includes(q))}
  function updateExplorerList(){let count=0;nodeListItems.forEach(item=>{const n=byId.get(item.dataset.node),show=n&&visibleInList(n);item.hidden=!show;item.classList.toggle('active',item.dataset.node===selected);if(show)count++});resultCount.textContent=String(count);emptyList.hidden=count!==0}
  function nodeLines(text){if(text.length<=20)return [text];const words=text.split(' ');if(words.length<=1)return [text.slice(0,18),text.slice(18,34)];const a=[],b=[];words.forEach(w=>(a.join(' ').length<15?a:b).push(w));return [a.join(' '),b.join(' ')].filter(Boolean)}

  function drawEdge(edge,className,layer=edgeLayer,withLabel=true){const a=pointFor(edge.source),b=pointFor(edge.target),g=makeSvg('g');const line=makeSvg('line',{x1:a.x,y1:a.y,x2:b.x,y2:b.y,class:className});line.dataset.source=edge.source;line.dataset.target=edge.target;line.classList.add('edge-live');g.appendChild(line);const title=makeSvg('title');title.textContent=`${labelFor(edge.source)} → ${labelFor(edge.target)}｜${edge.note||relationLabel(edge.relation)}`;g.appendChild(title);if(withLabel&&edgeLabelToggle.checked){const t=makeSvg('text',{x:(a.x+b.x)/2,y:(a.y+b.y)/2-7,class:'kg-edge-label edge-label-live'});t.dataset.source=edge.source;t.dataset.target=edge.target;t.textContent=relationLabel(edge.relation);g.appendChild(t)}layer.appendChild(g)}
  function renderNode(node,contextIds){const p=pointFor(node.id),g=makeSvg('g',{transform:`translate(${p.x} ${p.y}) scale(${p.scale})`,class:'kg-node',role:'button',tabindex:'0','aria-label':`${node.label}、${kindLabel(node.kind)}`});g.dataset.id=node.id;if(!contextIds.has(node.id))g.classList.add('context-dim');if(selected===node.id)g.classList.add('selected');if(pair.includes(node.id))g.classList.add('pair-selected');if(gptSuggestion&&(gptSuggestion.source===node.id||gptSuggestion.target===node.id))g.classList.add('gpt-selected');const w=node.kind==='PRINCIPLE'?164:176,h=64;g.append(makeSvg('rect',{x:-w/2,y:-h/2,width:w,height:h,rx:13,class:'node-card-svg'}),makeSvg('rect',{x:-w/2,y:-h/2,width:7,height:h,rx:4,fill:kindMeta[node.kind]?.color||'#59636e',class:'node-accent'}));nodeLines(node.label).forEach((line,i)=>{const t=makeSvg('text',{x:-w/2+18,y:nodeLines(node.label).length===1?-3:-10+i*16,class:'node-label','text-anchor':'start'});t.textContent=line;g.appendChild(t)});const k=makeSvg('text',{x:-w/2+18,y:22,class:'node-kind','text-anchor':'start'});k.textContent=kindLabel(node.kind);g.appendChild(k);g.addEventListener('mouseenter',()=>hoveredId=node.id);g.addEventListener('mouseleave',()=>hoveredId=null);g.addEventListener('click',e=>{e.stopPropagation();handleNodeClick(node.id)});g.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();handleNodeClick(node.id)}});nodeLayer.appendChild(g)}
  function renderMiniMap(){miniEdgeLayer.innerHTML='';miniNodeLayer.innerHTML='';allEdges().forEach(e=>{const a=positions.get(e.source),b=positions.get(e.target);if(a&&b){const l=makeSvg('line',{x1:a.x,y1:a.y,x2:b.x,y2:b.y,class:'mini-edge'});miniEdgeLayer.appendChild(l)}});nodes.forEach(n=>{const p=positions.get(n.id),c=makeSvg('circle',{cx:p.x,cy:p.y,r:selected===n.id?18:11,fill:kindMeta[n.kind]?.color||'#59636e',class:'mini-node'});miniNodeLayer.appendChild(c)});updateMiniViewport()}
  function render(){edgeLayer.innerHTML='';candidateLayer.innerHTML='';nodeLayer.innerHTML='';const context=matchingIds(),focus=selected?connectedIds(selected):null;edges.forEach(e=>drawEdge(e,`kg-edge${selected&&(e.source===selected||e.target===selected)?' focus':''}${context.has(e.source)&&context.has(e.target)?'':' context-dim'}`));humanEdges.forEach(e=>drawEdge(e,'kg-human',candidateLayer,false));if(gptSuggestion)drawEdge(gptSuggestion,'kg-candidate',candidateLayer,false);nodes.forEach(n=>{renderNode(n,context);if(selected&&focus&&!focus.has(n.id))nodeLayer.querySelector(`[data-id="${n.id}"]`)?.classList.add('context-dim')});updateExplorerList();renderMiniMap()}

  function animate(time){if(!motionEnabled){animationFrame=null;return}nodeLayer.querySelectorAll('.kg-node').forEach(g=>{const p=pointFor(g.dataset.id,time);g.setAttribute('transform',`translate(${p.x} ${p.y}) scale(${p.scale})`)});document.querySelectorAll('.edge-live').forEach(l=>{const a=pointFor(l.dataset.source,time),b=pointFor(l.dataset.target,time);l.setAttribute('x1',a.x);l.setAttribute('y1',a.y);l.setAttribute('x2',b.x);l.setAttribute('y2',b.y)});document.querySelectorAll('.edge-label-live').forEach(t=>{const a=pointFor(t.dataset.source,time),b=pointFor(t.dataset.target,time);t.setAttribute('x',(a.x+b.x)/2);t.setAttribute('y',(a.y+b.y)/2-7)});animationFrame=requestAnimationFrame(animate)}
  function syncMotionUi(){motionToggle.classList.toggle('active',motionEnabled);motionToggle.setAttribute('aria-pressed',String(motionEnabled));motionToggle.querySelector('span').textContent=motionEnabled?'FLOW ON':'STATIC';hint.textContent=motionEnabled?'FLOWは“呼吸する程度”の動き。選択中のNodeは落ち着き、周囲との関係が見やすくなります。':'動きを止めています。FLOW ONで時間軸を戻せます。';if(motionEnabled&&!animationFrame)animationFrame=requestAnimationFrame(animate)}

  function showNode(id,{center=false}={}){const n=byId.get(id);if(!n)return;selected=id;nodeTitle.textContent=n.label;nodeKind.textContent=kindLabel(n.kind);nodeKind.style.background=`${kindMeta[n.kind]?.color||'#59636e'}14`;nodeKind.style.color=kindMeta[n.kind]?.color||'#59636e';nodeNote.textContent=n.note;selectionText.textContent=`${n.label} を中心に表示`;selectionDot.style.background=kindMeta[n.kind]?.color||'#59636e';const links=connectedEdges(id);connectionCount.textContent=String(links.length);nodeLinks.innerHTML='';if(!links.length)nodeLinks.innerHTML='<p class="node-note">まだ直接の接続はありません。</p>';else links.slice(0,10).forEach(e=>{const otherId=e.source===id?e.target:e.source,other=byId.get(otherId),button=document.createElement('button');button.type='button';button.className='connection-item';button.innerHTML=`<span><strong>${escapeHtml(other?.label||otherId)}</strong><small>${escapeHtml(e.note||'')}</small></span><em>${escapeHtml(relationLabel(e.relation))}</em>`;button.addEventListener('click',()=>showNode(otherId,{center:true}));nodeLinks.appendChild(button)});nodeInsight.textContent=links.length>=4?`接続が${links.length}本あるハブ。矢印の「入る／出る」を分けると、循環とボトルネックが見えます。`:links.length?`直接の接続は${links.length}本。矢印の向きと線の動詞を読むと、このNodeの役割が掴みやすくなります。`:'孤立Node。既存資産との接点を探す候補です。';if(center)centerOnNode(id);render()}
  function clearSelection(){selected=null;nodeTitle.textContent='Nodeを選択';nodeKind.textContent='未選択';nodeNote.textContent='中央または左からNodeを選ぶと、意味・直接の接続・見るポイントが表示されます。';nodeInsight.textContent='矢印＝流れの向き。線の言葉＝流れ方です。';connectionCount.textContent='0';nodeLinks.innerHTML='';selectionText.textContent='全体を表示中';selectionDot.style.background='#8d949b';render()}
  function handleNodeClick(id){if(connectMode){if(pair.includes(id))pair=pair.filter(x=>x!==id);else if(pair.length<2)pair.push(id);else pair=[pair[1],id];updatePair();render();return}showNode(id)}
  function updatePair(){pairA.textContent=pair[0]?labelFor(pair[0]):'1点目を選択';pairB.textContent=pair[1]?labelFor(pair[1]):'2点目を選択';if(connectMode)hint.textContent=pair.length<2?'接続したいNodeを2つクリックしてください。':'右側で関係と理由を書いて保存できます。'}
  function clearPair(){pair=[];comment.value='';saveStatus.textContent='';updatePair();render()}
  function setActiveKind(kind){activeKind=kind;filterButtons.forEach(b=>b.classList.toggle('active',b.dataset.kind===kind));render()}
  function setView(){svg.setAttribute('viewBox',`${view.x} ${view.y} ${view.w} ${view.h}`);updateMiniViewport()}
  function fitAll(){view={x:0,y:0,w:1600,h:1000};setView()}
  function centerOnNode(id){const p=positions.get(id);if(!p)return;const w=Math.min(view.w,960),h=w*.625;view={x:p.x-w/2,y:p.y-h/2,w,h};setView()}
  function zoom(f){const cx=view.x+view.w/2,cy=view.y+view.h/2,w=Math.max(420,Math.min(2400,view.w*f)),h=w*.625;view={x:cx-w/2,y:cy-h/2,w,h};setView()}
  function updateMiniViewport(){if(!miniViewport)return;miniViewport.setAttribute('x',String(view.x));miniViewport.setAttribute('y',String(view.y));miniViewport.setAttribute('width',String(view.w));miniViewport.setAttribute('height',String(view.h))}

  async function postFeedback(message,context){const r=await fetch('/api/dashboard/feedback',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({page:'/dashboard/graph',message,context:JSON.stringify(context)})});if(!r.ok)throw new Error('save_failed');return r.json()}
  async function loadActivity(){try{const r=await fetch('/api/dashboard/feedback'),data=await r.json(),items=(data.items||[]).filter(x=>x.page==='/dashboard/graph').slice(0,6);activity.innerHTML='';if(!items.length){activity.innerHTML='<p class="node-note">まだGraphメモはありません。</p>';return}items.forEach(x=>{const d=document.createElement('div');d.className='activity-item';d.innerHTML=`<strong>${escapeHtml(x.message)}</strong><time>${new Date(x.created_at).toLocaleString('ja-JP')}</time>`;activity.appendChild(d)})}catch{activity.innerHTML='<p class="node-note">履歴を読み込めませんでした。</p>'}}
  function showSuggestion(s){gptSuggestion=s;gptTitle.textContent=s.title;gptReason.textContent=s.reason;gptConfidence.textContent=s.confidence;gptPair.innerHTML=`<span>${escapeHtml(labelFor(s.source))}</span><b>↔</b><span>${escapeHtml(labelFor(s.target))}</span>`;gptAccept.disabled=false;gptHold.disabled=false;selected=null;selectionText.textContent=`AI候補：${s.title}`;selectionDot.style.background='#7c5ce1';render()}
  async function decideSuggestion(decision){if(!gptSuggestion)return;const s=gptSuggestion;gptAccept.disabled=gptHold.disabled=true;try{await postFeedback(`AI ${decision==='accept'?'ACCEPT':'HOLD'}｜${s.title}`,{type:'gpt_edge_decision',decision,suggestion_id:s.id,source:s.source,target:s.target,relation:s.relation,reason:s.reason});if(decision==='accept')humanEdges.push({source:s.source,target:s.target,relation:s.relation,note:`AI候補を採用候補：${s.reason}`,state:'MASA_PROPOSAL'});await loadActivity();render()}catch{gptReason.textContent='保存に失敗しました。もう一度試してください。'}finally{gptAccept.disabled=gptHold.disabled=false}}

  filterButtons.forEach(b=>b.addEventListener('click',()=>setActiveKind(b.dataset.kind)));nodeListItems.forEach(item=>item.addEventListener('click',()=>connectMode?handleNodeClick(item.dataset.node):showNode(item.dataset.node,{center:true})));
  search.addEventListener('input',render);search.addEventListener('keydown',e=>{if(e.key==='Enter'){const first=nodes.find(n=>visibleInList(n));if(first)showNode(first.id,{center:true})}if(e.key==='Escape'){search.value='';render()}});
  window.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement!==search&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)){e.preventDefault();search.focus()}});
  $('clear-filters').addEventListener('click',()=>{search.value='';setActiveKind('ALL')});$('clear-selection').addEventListener('click',clearSelection);$('reset-view').addEventListener('click',fitAll);$('mini-reset').addEventListener('click',fitAll);$('zoom-in').addEventListener('click',()=>zoom(.82));$('zoom-out').addEventListener('click',()=>zoom(1.22));edgeLabelToggle.addEventListener('change',render);
  motionToggle.addEventListener('click',()=>{motionEnabled=!motionEnabled;if(!motionEnabled&&animationFrame){cancelAnimationFrame(animationFrame);animationFrame=null;render()}syncMotionUi()});
  document.addEventListener('visibilitychange',()=>{if(document.hidden&&animationFrame){cancelAnimationFrame(animationFrame);animationFrame=null}else if(!document.hidden)syncMotionUi()});
  connectBtn.addEventListener('click',()=>{connectMode=!connectMode;connectBtn.classList.toggle('active',connectMode);connectBtn.textContent=connectMode?'接続モード中 ✓':'＋ 2点をつなぐ';if(connectMode){$('composer').open=true;updatePair()}else clearPair()});$('composer-clear').addEventListener('click',clearPair);
  saveBtn.addEventListener('click',async()=>{if(pair.length!==2){saveStatus.textContent='Nodeを2つ選んでください。';return}const rel=relation.value,text=comment.value.trim()||'この2点はつながると思う';saveBtn.disabled=true;saveStatus.textContent='保存中…';try{await postFeedback(`CONNECT ${labelFor(pair[0])} → ${labelFor(pair[1])}｜${text}`,{type:'graph_edge_proposal',source:pair[0],target:pair[1],relation:rel,note:text});humanEdges.push({source:pair[0],target:pair[1],relation:rel,note:text,state:'MASA_PROPOSAL'});saveStatus.textContent='保存しました。Graphにも仮Edgeを表示しています。';render();await loadActivity()}catch{saveStatus.textContent='保存に失敗しました。'}finally{saveBtn.disabled=false}});
  gptNext.addEventListener('click',()=>{gptIndex=(gptIndex+1)%suggestions.length;showSuggestion(suggestions[gptIndex])});gptAccept.addEventListener('click',()=>decideSuggestion('accept'));gptHold.addEventListener('click',()=>decideSuggestion('hold'));
  svg.addEventListener('wheel',e=>{e.preventDefault();const f=e.deltaY>0?1.1:.9,r=svg.getBoundingClientRect(),px=view.x+(e.clientX-r.left)/r.width*view.w,py=view.y+(e.clientY-r.top)/r.height*view.h,w=Math.max(420,Math.min(2400,view.w*f)),h=w*.625,af=w/view.w;view={x:px-(px-view.x)*af,y:py-(py-view.y)*af,w,h};setView()},{passive:false});
  svg.addEventListener('pointerdown',e=>{if(e.target.closest?.('.kg-node'))return;panStart={cx:e.clientX,cy:e.clientY,x:view.x,y:view.y};svg.classList.add('panning');svg.setPointerCapture?.(e.pointerId)});svg.addEventListener('pointermove',e=>{if(!panStart)return;const r=svg.getBoundingClientRect();view.x=panStart.x-(e.clientX-panStart.cx)/r.width*view.w;view.y=panStart.y-(e.clientY-panStart.cy)/r.height*view.h;setView()});['pointerup','pointercancel'].forEach(type=>svg.addEventListener(type,()=>{panStart=null;svg.classList.remove('panning')}));

  setView();updatePair();showNode('N025');syncMotionUi();loadActivity();
</script>
