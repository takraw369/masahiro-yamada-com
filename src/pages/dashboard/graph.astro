</style>

<script define:vars={{ nodes, edges, suggestions, kindMeta, relationLabels }}>
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.getElementById('graph');
  const edgeLayer = document.getElementById('edge-layer');
  const candidateLayer = document.getElementById('candidate-layer');
  const nodeLayer = document.getElementById('node-layer');
  const miniEdgeLayer = document.getElementById('mini-edge-layer');
  const miniNodeLayer = document.getElementById('mini-node-layer');
  const miniViewport = document.getElementById('mini-viewport');

  const search = document.getElementById('search');
  const resultCount = document.getElementById('result-count');
  const emptyList = document.getElementById('empty-list');
  const nodeListItems = [...document.querySelectorAll('.node-list-item')];
  const filterButtons = [...document.querySelectorAll('.filter-btn')];

  const connectBtn = document.getElementById('connect-mode');
  const hint = document.getElementById('hint');
  const pairA = document.getElementById('pair-a');
  const pairB = document.getElementById('pair-b');
  const comment = document.getElementById('comment');
  const relation = document.getElementById('relation');
  const saveBtn = document.getElementById('save-proposal');
  const saveStatus = document.getElementById('save-status');
  const nodeTitle = document.getElementById('node-title');
  const nodeKind = document.getElementById('node-kind');
  const nodeNote = document.getElementById('node-note');
  const nodeLinks = document.getElementById('node-links');
  const nodeInsight = document.getElementById('node-insight');
  const connectionCount = document.getElementById('connection-count');
  const selectionText = document.getElementById('selection-text');
  const selectionDot = document.querySelector('.selection-dot');
  const activity = document.getElementById('activity');

  const gptNext = document.getElementById('gpt-next');
  const gptTitle = document.getElementById('gpt-title');
  const gptReason = document.getElementById('gpt-reason');
  const gptPair = document.getElementById('gpt-pair');
  const gptConfidence = document.getElementById('gpt-confidence');
  const gptAccept = document.getElementById('gpt-accept');
  const gptHold = document.getElementById('gpt-hold');
  const edgeLabelToggle = document.getElementById('edge-label-toggle');

  const byId = new Map(nodes.map(node => [node.id, node]));
  const humanEdges = [];
  const positions = new Map();

  const kindCenters = {
    CONTROL:[780,120],
    KNOWLEDGE:[770,350],
    HUMAN:[1110,405],
    OUTPUT:[510,520],
    BUSINESS:[1030,735],
    ACTION:[1350,575],
    LIFE:[420,785],
    PRINCIPLE:[265,315],
  };

  const buckets = {};
  nodes.forEach(node => ((buckets[node.kind] ??= []).push(node)));
  Object.entries(buckets).forEach(([kind, list]) => {
    const center = kindCenters[kind] || [800,500];
    const radiusX = Math.min(205, 105 + list.length * 18);
    const radiusY = Math.min(150, 70 + list.length * 13);
    list.forEach((node, index) => {
      if (list.length === 1) {
        positions.set(node.id, { x:center[0], y:center[1] });
        return;
      }
      const angle = (Math.PI * 2 * index / list.length) - Math.PI / 2;
      positions.set(node.id, {
        x:center[0] + Math.cos(angle) * radiusX,
        y:center[1] + Math.sin(angle) * radiusY,
      });
    });
  });

  let selected = 'N025';
  let activeKind = 'ALL';
  let connectMode = false;
  let pair = [];
  let gptIndex = -1;
  let gptSuggestion = null;
  let view = { x:0, y:0, w:1600, h:1000 };
  let panStart = null;

  function labelFor(id) {
    return byId.get(id)?.label || id;
  }

  function kindLabel(kind) {
    return kindMeta[kind]?.label || kind;
  }

  function relationLabel(key) {
    return relationLabels[key] || key;
  }

  function allEdges() {
    return [...edges, ...humanEdges];
  }

  function connectedEdges(id) {
    return allEdges().filter(edge => edge.source === id || edge.target === id);
  }

  function connectedIds(id) {
    const set = new Set([id]);
    connectedEdges(id).forEach(edge => {
      set.add(edge.source);
      set.add(edge.target);
    });
    return set;
  }

  function currentQuery() {
    return (search.value || '').trim().toLowerCase();
  }

  function matchingIds() {
    const query = currentQuery();
    const direct = nodes.filter(node => {
      const matchesKind = activeKind === 'ALL' || node.kind === activeKind;
      const matchesText = !query || node.label.toLowerCase().includes(query) || node.note.toLowerCase().includes(query);
      return matchesKind && matchesText;
    }).map(node => node.id);

    if (activeKind === 'ALL' && !query) return new Set(nodes.map(node => node.id));

    const contextual = new Set(direct);
    allEdges().forEach(edge => {
      if (contextual.has(edge.source)) contextual.add(edge.target);
      if (contextual.has(edge.target)) contextual.add(edge.source);
    });
    return contextual;
  }

  function visibleInList(node) {
    const query = currentQuery();
    const matchesKind = activeKind === 'ALL' || node.kind === activeKind;
    const matchesText = !query || node.label.toLowerCase().includes(query) || node.note.toLowerCase().includes(query);
    return matchesKind && matchesText;
  }

  function updateExplorerList() {
    let count = 0;
    nodeListItems.forEach(item => {
      const node = byId.get(item.dataset.node);
      const visible = node && visibleInList(node);
      item.hidden = !visible;
      item.classList.toggle('active', item.dataset.node === selected);
      if (visible) count += 1;
    });
    resultCount.textContent = String(count);
    emptyList.hidden = count !== 0;
  }

  function makeSvg(tag, attrs = {}) {
    const element = document.createElementNS(NS, tag);
    Object.entries(attrs).forEach(([key, value]) => element.setAttribute(key, String(value)));
    return element;
  }

  function drawEdge(edge, className, withLabel = true) {
    const a = positions.get(edge.source);
    const b = positions.get(edge.target);
    if (!a || !b) return;

    const group = makeSvg('g');
    const line = makeSvg('line', {
      x1:a.x, y1:a.y, x2:b.x, y2:b.y,
      class:className,
    });
    group.appendChild(line);

    if (withLabel && edgeLabelToggle.checked) {
      const mx = (a.x + b.x) / 2;
      const my = (a.y + b.y) / 2;
      const label = makeSvg('text', { x:mx, y:my - 7, class:'kg-edge-label' });
      label.textContent = relationLabel(edge.relation);
      group.appendChild(label);
    }
    edgeLayer.appendChild(group);
  }

  function nodeLines(text) {
    if (text.length <= 20) return [text];
    const words = text.split(' ');
    if (words.length <= 1) return [text.slice(0,18), text.slice(18,34)];
    const first = [];
    const second = [];
    words.forEach(word => {
      const target = first.join(' ').length < 15 ? first : second;
      target.push(word);
    });
    return [first.join(' '), second.join(' ')].filter(Boolean);
  }

  function renderNode(node, contextIds) {
    const point = positions.get(node.id);
    const group = makeSvg('g', {
      transform:`translate(${point.x} ${point.y})`,
      class:'kg-node',
      role:'button',
      tabindex:'0',
      'aria-label':`${node.label}、${kindLabel(node.kind)}`,
    });
    group.dataset.id = node.id;

    if (!contextIds.has(node.id)) group.classList.add('context-dim');
    if (selected === node.id) group.classList.add('selected');
    if (pair.includes(node.id)) group.classList.add('pair-selected');
    if (gptSuggestion && (gptSuggestion.source === node.id || gptSuggestion.target === node.id)) group.classList.add('gpt-selected');

    const width = node.kind === 'PRINCIPLE' ? 164 : 176;
    const height = 64;
    const card = makeSvg('rect', {
      x:-width/2, y:-height/2, width, height, rx:13,
      class:'node-card-svg',
    });
    const accent = makeSvg('rect', {
      x:-width/2, y:-height/2, width:7, height, rx:4,
      fill:kindMeta[node.kind]?.color || '#59636e',
      class:'node-accent',
    });
    group.append(card, accent);

    const lines = nodeLines(node.label);
    lines.forEach((line, index) => {
      const text = makeSvg('text', {
        x:-width/2 + 18,
        y: lines.length === 1 ? -3 : -10 + index * 16,
        class:'node-label',
        'text-anchor':'start',
      });
      text.textContent = line;
      group.appendChild(text);
    });

    const kindText = makeSvg('text', {
      x:-width/2 + 18,
      y:22,
      class:'node-kind',
      'text-anchor':'start',
    });
    kindText.textContent = kindLabel(node.kind);
    group.appendChild(kindText);

    group.addEventListener('click', event => {
      event.stopPropagation();
      handleNodeClick(node.id);
    });
    group.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        handleNodeClick(node.id);
      }
    });
    nodeLayer.appendChild(group);
  }

  function renderMiniMap() {
    miniEdgeLayer.innerHTML = '';
    miniNodeLayer.innerHTML = '';

    allEdges().forEach(edge => {
      const a = positions.get(edge.source);
      const b = positions.get(edge.target);
      if (!a || !b) return;
      const line = makeSvg('line', { x1:a.x, y1:a.y, x2:b.x, y2:b.y, class:'mini-edge' });
      miniEdgeLayer.appendChild(line);
    });

    nodes.forEach(node => {
      const point = positions.get(node.id);
      const circle = makeSvg('circle', {
        cx:point.x, cy:point.y, r:selected === node.id ? 18 : 11,
        fill:kindMeta[node.kind]?.color || '#59636e',
        class:'mini-node',
      });
      miniNodeLayer.appendChild(circle);
    });
    updateMiniViewport();
  }

  function render() {
    edgeLayer.innerHTML = '';
    candidateLayer.innerHTML = '';
    nodeLayer.innerHTML = '';

    const contextIds = matchingIds();
    const focusIds = selected ? connectedIds(selected) : null;

    edges.forEach(edge => {
      const isFocus = selected && (edge.source === selected || edge.target === selected);
      const isContext = contextIds.has(edge.source) && contextIds.has(edge.target);
      drawEdge(edge, `kg-edge${isFocus ? ' focus' : ''}${isContext ? '' : ' context-dim'}`, true);
    });

    humanEdges.forEach(edge => {
      const a = positions.get(edge.source);
      const b = positions.get(edge.target);
      if (!a || !b) return;
      const line = makeSvg('line', { x1:a.x, y1:a.y, x2:b.x, y2:b.y, class:'kg-human' });
      candidateLayer.appendChild(line);
    });

    if (gptSuggestion) {
      const a = positions.get(gptSuggestion.source);
      const b = positions.get(gptSuggestion.target);
      if (a && b) {
        const line = makeSvg('line', { x1:a.x, y1:a.y, x2:b.x, y2:b.y, class:'kg-candidate' });
        candidateLayer.appendChild(line);
      }
    }

    nodes.forEach(node => {
      renderNode(node, contextIds);
      if (selected && focusIds && !focusIds.has(node.id)) {
        const el = nodeLayer.querySelector(`[data-id="${node.id}"]`);
        el?.classList.add('context-dim');
      }
    });

    updateExplorerList();
    renderMiniMap();
  }

  function showNode(id, options = {}) {
    const node = byId.get(id);
    if (!node) return;
    selected = id;

    nodeTitle.textContent = node.label;
    nodeKind.textContent = kindLabel(node.kind);
    nodeKind.style.background = `${kindMeta[node.kind]?.color || '#59636e'}14`;
    nodeKind.style.color = kindMeta[node.kind]?.color || '#59636e';
    nodeNote.textContent = node.note;
    selectionText.textContent = `${node.label} を中心に表示`;
    selectionDot.style.background = kindMeta[node.kind]?.color || '#59636e';

    const links = connectedEdges(id);
    connectionCount.textContent = String(links.length);
    nodeLinks.innerHTML = '';

    if (!links.length) {
      nodeLinks.innerHTML = '<p class="node-note">まだ直接の接続はありません。</p>';
    } else {
      links.slice(0,10).forEach(edge => {
        const otherId = edge.source === id ? edge.target : edge.source;
        const other = byId.get(otherId);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'connection-item';
        button.innerHTML = `<span><strong>${escapeHtml(other?.label || otherId)}</strong><small>${escapeHtml(edge.note || '')}</small></span><em>${escapeHtml(relationLabel(edge.relation))}</em>`;
        button.addEventListener('click', () => showNode(otherId, { center:true }));
        nodeLinks.appendChild(button);
      });
    }

    nodeInsight.textContent = links.length >= 4
      ? `接続が${links.length}本あるハブです。上流と下流を分けて見ると、ボトルネックや再利用先を見つけやすいNodeです。`
      : links.length
        ? `直接の接続は${links.length}本。各Edgeの「何を渡しているか」を見ると、このNodeの役割が掴みやすくなります。`
        : '孤立Nodeです。既存資産との接点を探す候補になります。';

    if (options.center) centerOnNode(id);
    render();
  }

  function clearSelection() {
    selected = null;
    nodeTitle.textContent = 'Nodeを選択';
    nodeKind.textContent = '未選択';
    nodeKind.style.background = '#f1eee8';
    nodeKind.style.color = '#656e77';
    nodeNote.textContent = '中央または左の一覧からNodeを選ぶと、意味・直接の接続・見るポイントが表示されます。';
    nodeInsight.textContent = 'まずは左でテーマを絞るか、中央の気になるNodeをクリックしてください。';
    connectionCount.textContent = '0';
    nodeLinks.innerHTML = '';
    selectionText.textContent = '全体を表示中';
    selectionDot.style.background = '#8d949b';
    render();
  }

  function handleNodeClick(id) {
    if (connectMode) {
      if (pair.includes(id)) {
        pair = pair.filter(value => value !== id);
      } else if (pair.length < 2) {
        pair.push(id);
      } else {
        pair = [pair[1], id];
      }
      updatePair();
      render();
      return;
    }
    showNode(id);
  }

  function updatePair() {
    pairA.textContent = pair[0] ? labelFor(pair[0]) : '1点目を選択';
    pairB.textContent = pair[1] ? labelFor(pair[1]) : '2点目を選択';
    hint.textContent = connectMode
      ? (pair.length < 2 ? '接続したいNodeを2つクリックしてください。' : '右側の「自分で2点をつなぐ」で関係と理由を書いて保存できます。')
      : 'Nodeをクリックすると、その周辺だけが強調されます。空白ドラッグで移動、ホイールで拡大縮小。';
  }

  function clearPair() {
    pair = [];
    comment.value = '';
    saveStatus.textContent = '';
    updatePair();
    render();
  }

  function setActiveKind(kind) {
    activeKind = kind;
    filterButtons.forEach(button => button.classList.toggle('active', button.dataset.kind === kind));
    render();
  }

  function setView() {
    svg.setAttribute('viewBox', `${view.x} ${view.y} ${view.w} ${view.h}`);
    updateMiniViewport();
  }

  function fitAll() {
    view = { x:0, y:0, w:1600, h:1000 };
    setView();
  }

  function centerOnNode(id) {
    const point = positions.get(id);
    if (!point) return;
    const targetW = Math.min(view.w, 960);
    const targetH = targetW * 0.625;
    view = {
      x:point.x - targetW / 2,
      y:point.y - targetH / 2,
      w:targetW,
      h:targetH,
    };
    setView();
  }

  function zoom(factor) {
    const cx = view.x + view.w / 2;
    const cy = view.y + view.h / 2;
    const nextW = Math.max(420, Math.min(2400, view.w * factor));
    const nextH = nextW * 0.625;
    view = { x:cx-nextW/2, y:cy-nextH/2, w:nextW, h:nextH };
    setView();
  }

  function updateMiniViewport() {
    if (!miniViewport) return;
    miniViewport.setAttribute('x', String(view.x));
    miniViewport.setAttribute('y', String(view.y));
    miniViewport.setAttribute('width', String(view.w));
    miniViewport.setAttribute('height', String(view.h));
  }

  async function postFeedback(messageText, contextObj) {
    const response = await fetch('/api/dashboard/feedback', {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body:JSON.stringify({
        page:'/dashboard/graph',
        message:messageText,
        context:JSON.stringify(contextObj),
      }),
    });
    if (!response.ok) throw new Error('save_failed');
    return response.json();
  }

  async function loadActivity() {
    try {
      const response = await fetch('/api/dashboard/feedback');
      const data = await response.json();
      const items = (data.items || []).filter(item => item.page === '/dashboard/graph').slice(0,6);
      activity.innerHTML = '';
      if (!items.length) {
        activity.innerHTML = '<p class="node-note">まだGraphメモはありません。</p>';
        return;
      }
      items.forEach(item => {
        const div = document.createElement('div');
        div.className = 'activity-item';
        div.innerHTML = `<strong>${escapeHtml(item.message)}</strong><time>${new Date(item.created_at).toLocaleString('ja-JP')}</time>`;
        activity.appendChild(div);
      });
    } catch {
      activity.innerHTML = '<p class="node-note">履歴を読み込めませんでした。</p>';
    }
  }

  function showSuggestion(suggestion) {
    gptSuggestion = suggestion;
    gptTitle.textContent = suggestion.title;
    gptReason.textContent = suggestion.reason;
    gptConfidence.textContent = suggestion.confidence;
    gptPair.innerHTML = `<span>${escapeHtml(labelFor(suggestion.source))}</span><b>↔</b><span>${escapeHtml(labelFor(suggestion.target))}</span>`;
    gptAccept.disabled = false;
    gptHold.disabled = false;
    selected = null;
    selectionText.textContent = `AI候補：${suggestion.title}`;
    selectionDot.style.background = '#7c5ce1';
    render();
  }

  async function decideSuggestion(decision) {
    if (!gptSuggestion) return;
    const suggestion = gptSuggestion;
    gptAccept.disabled = true;
    gptHold.disabled = true;
    try {
      await postFeedback(
        `AI ${decision === 'accept' ? 'ACCEPT' : 'HOLD'}｜${suggestion.title}`,
        {
          type:'gpt_edge_decision',
          decision,
          suggestion_id:suggestion.id,
          source:suggestion.source,
          target:suggestion.target,
          relation:suggestion.relation,
          reason:suggestion.reason,
        },
      );
      if (decision === 'accept') {
        humanEdges.push({
          source:suggestion.source,
          target:suggestion.target,
          relation:suggestion.relation,
          note:`AI候補を採用候補：${suggestion.reason}`,
          state:'MASA_PROPOSAL',
        });
      }
      await loadActivity();
      render();
    } catch {
      gptReason.textContent = '保存に失敗しました。もう一度試してください。';
    } finally {
      gptAccept.disabled = false;
      gptHold.disabled = false;
    }
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>'"]/g, char => ({
      '&':'&amp;',
      '<':'&lt;',
      '>':'&gt;',
      "'":'&#39;',
      '"':'&quot;',
    }[char]));
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => setActiveKind(button.dataset.kind));
  });

  nodeListItems.forEach(item => {
    item.addEventListener('click', () => {
      if (connectMode) handleNodeClick(item.dataset.node);
      else showNode(item.dataset.node, { center:true });
    });
  });

  search.addEventListener('input', render);
  search.addEventListener('keydown', event => {
    if (event.key === 'Enter') {
      const first = nodes.find(node => visibleInList(node));
      if (first) showNode(first.id, { center:true });
    }
    if (event.key === 'Escape') {
      search.value = '';
      render();
    }
  });

  window.addEventListener('keydown', event => {
    if (event.key === '/' && document.activeElement !== search && !['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)) {
      event.preventDefault();
      search.focus();
    }
  });

  document.getElementById('clear-filters').addEventListener('click', () => {
    search.value = '';
    setActiveKind('ALL');
  });

  document.getElementById('clear-selection').addEventListener('click', clearSelection);
  document.getElementById('reset-view').addEventListener('click', fitAll);
  document.getElementById('mini-reset').addEventListener('click', fitAll);
  document.getElementById('zoom-in').addEventListener('click', () => zoom(.82));
  document.getElementById('zoom-out').addEventListener('click', () => zoom(1.22));
  edgeLabelToggle.addEventListener('change', render);

  connectBtn.addEventListener('click', () => {
    connectMode = !connectMode;
    connectBtn.classList.toggle('active', connectMode);
    connectBtn.textContent = connectMode ? '接続モード中 ✓' : '＋ 2点をつなぐ';
    if (connectMode) {
      document.getElementById('composer').open = true;
      updatePair();
    } else {
      clearPair();
    }
  });

  document.getElementById('composer-clear').addEventListener('click', clearPair);

  saveBtn.addEventListener('click', async () => {
    if (pair.length !== 2) {
      saveStatus.textContent = 'Nodeを2つ選んでください。';
      return;
    }
    const rel = relation.value;
    const text = comment.value.trim() || 'この2点はつながると思う';
    saveBtn.disabled = true;
    saveStatus.textContent = '保存中…';

    try {
      await postFeedback(
        `CONNECT ${labelFor(pair[0])} → ${labelFor(pair[1])}｜${text}`,
        {
          type:'graph_edge_proposal',
          source:pair[0],
          target:pair[1],
          relation:rel,
          note:text,
        },
      );
      humanEdges.push({
        source:pair[0],
        target:pair[1],
        relation:rel,
        note:text,
        state:'MASA_PROPOSAL',
      });
      saveStatus.textContent = '保存しました。Graphにも仮Edgeを表示しています。';
      render();
      await loadActivity();
    } catch {
      saveStatus.textContent = '保存に失敗しました。もう一度試してください。';
    } finally {
      saveBtn.disabled = false;
    }
  });

  gptNext.addEventListener('click', () => {
    gptIndex = (gptIndex + 1) % suggestions.length;
    showSuggestion(suggestions[gptIndex]);
  });
  gptAccept.addEventListener('click', () => decideSuggestion('accept'));
  gptHold.addEventListener('click', () => decideSuggestion('hold'));

  svg.addEventListener('wheel', event => {
    event.preventDefault();
    const factor = event.deltaY > 0 ? 1.1 : .9;
    const rect = svg.getBoundingClientRect();
    const px = view.x + (event.clientX - rect.left) / rect.width * view.w;
    const py = view.y + (event.clientY - rect.top) / rect.height * view.h;
    const nextW = Math.max(420, Math.min(2400, view.w * factor));
    const nextH = nextW * 0.625;
    const actualFactor = nextW / view.w;
    view = {
      x:px - (px - view.x) * actualFactor,
      y:py - (py - view.y) * actualFactor,
      w:nextW,
      h:nextH,
    };
    setView();
  }, { passive:false });

  svg.addEventListener('pointerdown', event => {
    if (event.target.closest?.('.kg-node')) return;
    panStart = {
      cx:event.clientX,
      cy:event.clientY,
      x:view.x,
      y:view.y,
    };
    svg.classList.add('panning');
    svg.setPointerCapture?.(event.pointerId);
  });

  svg.addEventListener('pointermove', event => {
    if (!panStart) return;
    const rect = svg.getBoundingClientRect();
    view.x = panStart.x - (event.clientX - panStart.cx) / rect.width * view.w;
    view.y = panStart.y - (event.clientY - panStart.cy) / rect.height * view.h;
    setView();
  });

  svg.addEventListener('pointerup', () => {
    panStart = null;
    svg.classList.remove('panning');
  });
  svg.addEventListener('pointercancel', () => {
    panStart = null;
    svg.classList.remove('panning');
  });

  setView();
  updatePair();
  showNode('N025');
  loadActivity();
</script>
