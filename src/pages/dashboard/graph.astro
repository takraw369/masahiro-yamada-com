---

<DashboardLayout title="MASA Brain Graph" fullHeight={true}>
  <div class="graph-app" id="graph-app">
    <header class="graph-toolbar">
      <div class="brand-block">
        <p>MASA BRAIN · GRAPH v0.1</p>
        <h1>知識の地図を、<span>触って考える。</span></h1>
      </div>
      <div class="toolbar-actions">
        <label class="search-box">
          <span>⌕</span>
          <input id="graph-search" type="search" placeholder="Nodeを検索…" autocomplete="off" />
        </label>
        <button class="tool-button" id="fit-button" type="button">全体表示</button>
        <button class="tool-button discovery" id="discovery-button" type="button">✦ AI Discovery</button>
      </div>
    </header>

    <div class="graph-body">
      <aside class="graph-filters" aria-label="Graph filters">
        <p class="mini-label">VIEW</p>
        <button class="filter active" data-kind="ALL" type="button"><span class="filter-dot all"></span>ALL</button>
        <button class="filter" data-kind="CONTROL" type="button"><span class="filter-dot control"></span>Control</button>
        <button class="filter" data-kind="KNOWLEDGE" type="button"><span class="filter-dot knowledge"></span>Knowledge</button>
        <button class="filter" data-kind="HUMAN" type="button"><span class="filter-dot human"></span>Human</button>
        <button class="filter" data-kind="OUTPUT" type="button"><span class="filter-dot output"></span>Output</button>
        <button class="filter" data-kind="BUSINESS" type="button"><span class="filter-dot business"></span>Business</button>
        <button class="filter" data-kind="ACTION" type="button"><span class="filter-dot action"></span>Action</button>
        <button class="filter" data-kind="LIFE" type="button"><span class="filter-dot life"></span>Life</button>
        <button class="filter" data-kind="PRINCIPLE" type="button"><span class="filter-dot principle"></span>Principle</button>
        <div class="filter-divider"></div>
        <label class="candidate-toggle">
          <input id="candidate-toggle" type="checkbox" checked />
          <span class="fake-check"></span>
          <span>AI候補線</span>
        </label>
        <div class="legend">
          <div><span class="line solid"></span>確認済み</div>
          <div><span class="line dashed"></span>AI候補</div>
        </div>
      </aside>

      <section class="graph-stage" id="graph-stage" aria-label="Interactive knowledge graph">
        <svg id="graph-svg" role="img" aria-label="MASA OS knowledge graph">
          <defs>
            <filter id="node-glow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="6" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
            <marker id="arrow-confirmed" markerWidth="8" markerHeight="8" refX="10" refY="4" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L0,8 L8,4 z" fill="rgba(201,169,110,.44)" />
            </marker>
            <marker id="arrow-candidate" markerWidth="8" markerHeight="8" refX="10" refY="4" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L0,8 L8,4 z" fill="rgba(217,193,255,.6)" />
            </marker>
          </defs>
          <g id="viewport">
            <g id="edge-layer"></g>
            <g id="node-layer"></g>
          </g>
        </svg>

        <div class="stage-hint" id="stage-hint">
          <span>drag</span> Nodeを動かす　·　<span>wheel</span> zoom　·　<span>click</span> 周辺を見る
        </div>

        <div class="discovery-toast" id="discovery-toast" aria-live="polite">
          <p class="mini-label">AI DISCOVERY</p>
          <strong id="discovery-title">意外な接続を探す</strong>
          <p id="discovery-copy">点線はGPTが見つけた未確定の関連候補。クリックして前後のNodeを見られます。</p>
        </div>
      </section>

      <aside class="node-panel" id="node-panel">
        <div class="panel-empty" id="panel-empty">
          <div class="empty-orbit"><span></span></div>
          <p class="mini-label">SELECT A NODE</p>
          <h2>点を選ぶと、<br />関係が見える。</h2>
          <p>Nodeをクリックすると、そのNodeの意味・接続先・Edgeの理由だけにFocusします。</p>
        </div>
        <div class="panel-content" id="panel-content" hidden>
          <div class="panel-topline">
            <span class="kind-badge" id="panel-kind">TYPE</span>
            <button class="panel-close" id="panel-close" type="button" aria-label="選択を解除">×</button>
          </div>
          <p class="node-id" id="panel-id"></p>
          <h2 id="panel-title"></h2>
          <p class="panel-role" id="panel-role"></p>
          <p class="panel-note" id="panel-note"></p>

          <div class="panel-connections">
            <p class="mini-label">CONNECTIONS</p>
            <div id="panel-edges"></div>
          </div>

          <a class="open-source" id="panel-link" href="#" target="_blank" rel="noopener noreferrer">正本を開く ↗</a>
        </div>
      </aside>
    </div>

    <script type="application/json" id="graph-nodes" set:html={JSON.stringify(nodes)}></script>
    <script type="application/json" id="graph-edges" set:html={JSON.stringify(edges)}></script>
  </div>
</DashboardLayout>

<script is:inline>
(() => {
  const NS = 'http://www.w3.org/2000/svg';
  const nodeData = JSON.parse(document.getElementById('graph-nodes')?.textContent || '[]');
  const edgeData = JSON.parse(document.getElementById('graph-edges')?.textContent || '[]');
  const svg = document.getElementById('graph-svg');
  const viewport = document.getElementById('viewport');
  const edgeLayer = document.getElementById('edge-layer');
  const nodeLayer = document.getElementById('node-layer');
  const stage = document.getElementById('graph-stage');
  const search = document.getElementById('graph-search');
  const candidateToggle = document.getElementById('candidate-toggle');
  const fitButton = document.getElementById('fit-button');
  const discoveryButton = document.getElementById('discovery-button');
  const discoveryToast = document.getElementById('discovery-toast');
  const discoveryTitle = document.getElementById('discovery-title');
  const discoveryCopy = document.getElementById('discovery-copy');
  const panelEmpty = document.getElementById('panel-empty');
  const panelContent = document.getElementById('panel-content');
  const panelClose = document.getElementById('panel-close');
  const panelKind = document.getElementById('panel-kind');
  const panelId = document.getElementById('panel-id');
  const panelTitle = document.getElementById('panel-title');
  const panelRole = document.getElementById('panel-role');
  const panelNote = document.getElementById('panel-note');
  const panelEdges = document.getElementById('panel-edges');
  const panelLink = document.getElementById('panel-link');

  if (!svg || !viewport || !edgeLayer || !nodeLayer || !stage) return;

  const kindClass = {
    CONTROL: 'control', KNOWLEDGE: 'knowledge', HUMAN: 'human', OUTPUT: 'output',
    BUSINESS: 'business', ACTION: 'action', LIFE: 'life', PRINCIPLE: 'principle'
  };

  const nodeById = new Map(nodeData.map((node) => [node.id, node]));
  const nodeState = new Map();
  let selectedId = null;
  let activeKind = 'ALL';
  let query = '';
  let showCandidates = true;
  let zoom = 1;
  let panX = 0;
  let panY = 0;
  let isPanning = false;
  let panStart = null;
  let dragged = null;
  let discoveryIndex = -1;
  let initialized = false;

  function layoutNodes() {
    const rect = stage.getBoundingClientRect();
    const w = Math.max(760, rect.width);
    const h = Math.max(560, rect.height);
    const cx = w * 0.5;
    const cy = h * 0.5;
    const systemNodes = nodeData.filter((n) => n.kind !== 'PRINCIPLE');
    const principles = nodeData.filter((n) => n.kind === 'PRINCIPLE');
    systemNodes.forEach((node, i) => {
      const angle = (Math.PI * 2 * i / systemNodes.length) - Math.PI / 2;
      const radiusX = Math.min(w * 0.34, 390) + ((i % 3) - 1) * 24;
      const radiusY = Math.min(h * 0.34, 300) + ((i % 2) * 24);
      let x = cx + Math.cos(angle) * radiusX;
      let y = cy + Math.sin(angle) * radiusY;
      if (node.id === 'N017') { x = cx - 40; y = cy - 40; }
      if (node.id === 'N025') { x = cx - 220; y = cy + 70; }
      if (node.id === 'N018') { x = cx + 185; y = cy + 20; }
      if (node.id === 'N021') { x = cx + 80; y = cy + 205; }
      nodeState.set(node.id, { x, y, vx: 0, vy: 0, fixed: false });
    });
    principles.forEach((node, i) => {
      const angle = -Math.PI * 0.85 + (Math.PI * 1.7 * i / Math.max(1, principles.length - 1));
      const x = cx + Math.cos(angle) * Math.min(w * .43, 500);
      const y = cy + Math.sin(angle) * Math.min(h * .43, 350);
      nodeState.set(node.id, { x, y, vx: 0, vy: 0, fixed: false });
    });
  }

  function createSvg(tag, attrs = {}) {
    const el = document.createElementNS(NS, tag);
    Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, String(value)));
    return el;
  }

  function truncateLabel(label) {
    return label.length > 20 ? `${label.slice(0, 19)}…` : label;
  }

  const edgeEls = new Map();
  edgeData.forEach((edge) => {
    const group = createSvg('g', { class: `graph-edge ${edge.state === 'CANDIDATE' ? 'candidate' : 'confirmed'}`, 'data-edge': edge.id });
    const hit = createSvg('line', { class: 'edge-hit' });
    const line = createSvg('line', { class: 'edge-line', 'marker-end': edge.state === 'CANDIDATE' ? 'url(#arrow-candidate)' : 'url(#arrow-confirmed)' });
    group.append(hit, line);
    group.addEventListener('click', (event) => {
      event.stopPropagation();
      const source = nodeById.get(edge.source);
      const target = nodeById.get(edge.target);
      discoveryToast?.classList.add('visible');
      if (discoveryTitle) discoveryTitle.textContent = `${source?.label || edge.source} → ${target?.label || edge.target}`;
      if (discoveryCopy) discoveryCopy.textContent = `${edge.relation}｜${edge.note}`;
      highlightEdge(edge.id);
    });
    edgeLayer.appendChild(group);
    edgeEls.set(edge.id, { group, hit, line });
  });

  const nodeEls = new Map();
  nodeData.forEach((node) => {
    const group = createSvg('g', { class: `graph-node ${kindClass[node.kind] || 'control'}`, tabindex: '0', role: 'button', 'aria-label': node.fullLabel, 'data-node': node.id });
    const halo = createSvg('circle', { class: 'node-halo', r: '29' });
    const circle = createSvg('circle', { class: 'node-circle', r: node.kind === 'PRINCIPLE' ? '10' : node.id === 'N017' ? '18' : '14' });
    const text = createSvg('text', { class: 'node-label', y: node.kind === 'PRINCIPLE' ? '28' : '31', 'text-anchor': 'middle' });
    text.textContent = truncateLabel(node.label);
    const sub = createSvg('text', { class: 'node-sub', y: node.kind === 'PRINCIPLE' ? '42' : '45', 'text-anchor': 'middle' });
    sub.textContent = node.kind;
    group.append(halo, circle, text, sub);

    const activate = (event) => {
      event.stopPropagation();
      selectNode(node.id);
    };
    group.addEventListener('click', activate);
    group.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') activate(event);
    });
    group.addEventListener('pointerdown', (event) => {
      event.stopPropagation();
      const state = nodeState.get(node.id);
      if (!state) return;
      dragged = { id: node.id, pointerId: event.pointerId };
      state.fixed = true;
      group.setPointerCapture?.(event.pointerId);
      group.classList.add('dragging');
    });
    group.addEventListener('pointermove', (event) => {
      if (!dragged || dragged.id !== node.id) return;
      const point = clientToGraph(event.clientX, event.clientY);
      const state = nodeState.get(node.id);
      if (state) { state.x = point.x; state.y = point.y; }
      renderPositions();
    });
    group.addEventListener('pointerup', (event) => {
      if (!dragged || dragged.id !== node.id) return;
      group.releasePointerCapture?.(event.pointerId);
      group.classList.remove('dragging');
      dragged = null;
    });
    nodeLayer.appendChild(group);
    nodeEls.set(node.id, group);
  });

  function connectedIds(id) {
    const ids = new Set([id]);
    edgeData.forEach((edge) => {
      if (!showCandidates && edge.state === 'CANDIDATE') return;
      if (edge.source === id) ids.add(edge.target);
      if (edge.target === id) ids.add(edge.source);
    });
    return ids;
  }

  function visibleByFilter(node) {
    if (activeKind !== 'ALL' && node.kind !== activeKind) return false;
    if (query && !(node.label + ' ' + node.fullLabel + ' ' + node.role + ' ' + node.note).toLowerCase().includes(query)) return false;
    return true;
  }

  function refreshVisibility() {
    const neighborhood = selectedId ? connectedIds(selectedId) : null;
    nodeData.forEach((node) => {
      const el = nodeEls.get(node.id);
      if (!el) return;
      const baseVisible = visibleByFilter(node);
      const inNeighborhood = !neighborhood || neighborhood.has(node.id);
      el.classList.toggle('hidden-node', !baseVisible);
      el.classList.toggle('dimmed', baseVisible && !inNeighborhood);
      el.classList.toggle('selected', node.id === selectedId);
    });
    edgeData.forEach((edge) => {
      const els = edgeEls.get(edge.id);
      if (!els) return;
      const sourceVisible = visibleByFilter(nodeById.get(edge.source));
      const targetVisible = visibleByFilter(nodeById.get(edge.target));
      const candidateHidden = edge.state === 'CANDIDATE' && !showCandidates;
      const touchesSelection = !selectedId || edge.source === selectedId || edge.target === selectedId;
      els.group.classList.toggle('hidden-edge', !sourceVisible || !targetVisible || candidateHidden);
      els.group.classList.toggle('dimmed', !!selectedId && !touchesSelection);
      els.group.classList.toggle('active-edge', !!selectedId && touchesSelection);
    });
  }

  function selectNode(id) {
    selectedId = id;
    const node = nodeById.get(id);
    if (!node) return;
    refreshVisibility();
    if (panelEmpty) panelEmpty.hidden = true;
    if (panelContent) panelContent.hidden = false;
    if (panelKind) panelKind.textContent = node.kind;
    if (panelId) panelId.textContent = `${node.id} · ${node.status}`;
    if (panelTitle) panelTitle.textContent = node.fullLabel;
    if (panelRole) panelRole.textContent = node.role;
    if (panelNote) panelNote.textContent = node.note;
    if (panelLink) {
      if (node.href) {
        panelLink.href = node.href;
        panelLink.hidden = false;
      } else {
        panelLink.hidden = true;
      }
    }
    if (panelEdges) {
      panelEdges.innerHTML = '';
      const linked = edgeData.filter((edge) => (edge.source === id || edge.target === id) && (showCandidates || edge.state !== 'CANDIDATE'));
      linked.forEach((edge) => {
        const outgoing = edge.source === id;
        const other = nodeById.get(outgoing ? edge.target : edge.source);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `connection-row ${edge.state === 'CANDIDATE' ? 'candidate' : ''}`;
        button.innerHTML = `<span class="edge-dir">${outgoing ? '→' : '←'}</span><span><strong>${edge.relation}</strong><small>${other?.label || ''}</small></span><em>${edge.state === 'CANDIDATE' ? 'AI?' : ''}</em>`;
        button.addEventListener('click', () => other && selectNode(other.id));
        panelEdges.appendChild(button);
      });
    }
  }

  function clearSelection() {
    selectedId = null;
    if (panelEmpty) panelEmpty.hidden = false;
    if (panelContent) panelContent.hidden = true;
    refreshVisibility();
  }

  function highlightEdge(edgeId) {
    edgeEls.forEach((els, id) => els.group.classList.toggle('edge-flash', id === edgeId));
    const edge = edgeData.find((item) => item.id === edgeId);
    if (!edge) return;
    selectedId = null;
    const relevant = new Set([edge.source, edge.target]);
    nodeEls.forEach((el, id) => {
      el.classList.toggle('dimmed', !relevant.has(id));
      el.classList.toggle('selected', relevant.has(id));
    });
    edgeEls.forEach((els, id) => els.group.classList.toggle('dimmed', id !== edgeId));
  }

  function renderPositions() {
    edgeData.forEach((edge) => {
      const a = nodeState.get(edge.source);
      const b = nodeState.get(edge.target);
      const els = edgeEls.get(edge.id);
      if (!a || !b || !els) return;
      ['hit', 'line'].forEach((key) => {
        els[key].setAttribute('x1', a.x);
        els[key].setAttribute('y1', a.y);
        els[key].setAttribute('x2', b.x);
        els[key].setAttribute('y2', b.y);
      });
    });
    nodeData.forEach((node) => {
      const state = nodeState.get(node.id);
      const el = nodeEls.get(node.id);
      if (state && el) el.setAttribute('transform', `translate(${state.x} ${state.y})`);
    });
    viewport.setAttribute('transform', `translate(${panX} ${panY}) scale(${zoom})`);
  }

  function settleLayout(iterations = 150) {
    const rect = stage.getBoundingClientRect();
    const cx = rect.width / 2;
    const cy = rect.height / 2;
    for (let step = 0; step < iterations; step++) {
      const states = [...nodeState.entries()];
      states.forEach(([idA, a], i) => {
        if (a.fixed) return;
        for (let j = i + 1; j < states.length; j++) {
          const [, b] = states[j];
          let dx = a.x - b.x;
          let dy = a.y - b.y;
          const d2 = Math.max(900, dx * dx + dy * dy);
          const force = 2600 / d2;
          const d = Math.sqrt(d2);
          dx /= d; dy /= d;
          a.vx += dx * force; a.vy += dy * force;
          b.vx -= dx * force; b.vy -= dy * force;
        }
        a.vx += (cx - a.x) * 0.00055;
        a.vy += (cy - a.y) * 0.00055;
      });
      edgeData.forEach((edge) => {
        const a = nodeState.get(edge.source);
        const b = nodeState.get(edge.target);
        if (!a || !b) return;
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dist = Math.max(1, Math.sqrt(dx * dx + dy * dy));
        const ideal = edge.state === 'CANDIDATE' ? 190 : 150;
        const spring = (dist - ideal) * 0.0018;
        const ux = dx / dist, uy = dy / dist;
        if (!a.fixed) { a.vx += ux * spring; a.vy += uy * spring; }
        if (!b.fixed) { b.vx -= ux * spring; b.vy -= uy * spring; }
      });
      nodeState.forEach((s) => {
        if (s.fixed) return;
        s.vx *= .82; s.vy *= .82;
        s.x += s.vx; s.y += s.vy;
        s.x = Math.max(70, Math.min(rect.width - 70, s.x));
        s.y = Math.max(70, Math.min(rect.height - 70, s.y));
      });
    }
  }

  function clientToGraph(clientX, clientY) {
    const rect = svg.getBoundingClientRect();
    return { x: (clientX - rect.left - panX) / zoom, y: (clientY - rect.top - panY) / zoom };
  }

  function fitGraph() {
    zoom = 1;
    panX = 0;
    panY = 0;
    renderPositions();
  }

  svg.addEventListener('pointerdown', (event) => {
    if (event.target !== svg && event.target !== viewport) return;
    isPanning = true;
    panStart = { x: event.clientX - panX, y: event.clientY - panY, pointerId: event.pointerId };
    svg.setPointerCapture?.(event.pointerId);
    clearSelection();
  });
  svg.addEventListener('pointermove', (event) => {
    if (!isPanning || !panStart) return;
    panX = event.clientX - panStart.x;
    panY = event.clientY - panStart.y;
    renderPositions();
  });
  svg.addEventListener('pointerup', (event) => {
    if (!isPanning) return;
    svg.releasePointerCapture?.(event.pointerId);
    isPanning = false;
    panStart = null;
  });
  svg.addEventListener('wheel', (event) => {
    event.preventDefault();
    const rect = svg.getBoundingClientRect();
    const before = { x: (event.clientX - rect.left - panX) / zoom, y: (event.clientY - rect.top - panY) / zoom };
    const factor = event.deltaY < 0 ? 1.1 : .9;
    zoom = Math.max(.45, Math.min(2.3, zoom * factor));
    panX = event.clientX - rect.left - before.x * zoom;
    panY = event.clientY - rect.top - before.y * zoom;
    renderPositions();
  }, { passive: false });

  document.querySelectorAll('.filter').forEach((button) => {
    button.addEventListener('click', () => {
      activeKind = button.dataset.kind || 'ALL';
      document.querySelectorAll('.filter').forEach((b) => b.classList.toggle('active', b === button));
      clearSelection();
    });
  });

  search?.addEventListener('input', () => {
    query = search.value.trim().toLowerCase();
    selectedId = null;
    refreshVisibility();
  });

  candidateToggle?.addEventListener('change', () => {
    showCandidates = candidateToggle.checked;
    refreshVisibility();
    if (selectedId) selectNode(selectedId);
  });

  fitButton?.addEventListener('click', fitGraph);
  panelClose?.addEventListener('click', clearSelection);

  const discoveries = edgeData.filter((edge) => edge.state === 'CANDIDATE');
  discoveryButton?.addEventListener('click', () => {
    if (!discoveries.length) return;
    showCandidates = true;
    if (candidateToggle) candidateToggle.checked = true;
    discoveryIndex = (discoveryIndex + 1) % discoveries.length;
    const edge = discoveries[discoveryIndex];
    const source = nodeById.get(edge.source);
    const target = nodeById.get(edge.target);
    if (discoveryTitle) discoveryTitle.textContent = `${source?.label} × ${target?.label}`;
    if (discoveryCopy) discoveryCopy.textContent = edge.note;
    discoveryToast?.classList.add('visible');
    highlightEdge(edge.id);
  });

  function init() {
    if (initialized) return;
    const rect = stage.getBoundingClientRect();
    if (rect.width < 10 || rect.height < 10) return;
    initialized = true;
    svg.setAttribute('viewBox', `0 0 ${rect.width} ${rect.height}`);
    layoutNodes();
    settleLayout();
    renderPositions();
    refreshVisibility();
  }

  const ro = new ResizeObserver(() => {
    const rect = stage.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${rect.width} ${rect.height}`);
    if (!initialized) init();
  });
  ro.observe(stage);
  requestAnimationFrame(init);
})();
</script>

