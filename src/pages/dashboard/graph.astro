  :global(.kg-node:hover rect.node-card-svg),:global(.kg-node:focus rect.node-card-svg),:global(.kg-node.selected rect.node-card-svg),:global(.kg-node.pair-selected rect.node-card-svg){stroke:#9a641f;stroke-width:2.8}
  :global(.kg-node.gpt-selected rect.node-card-svg){stroke:#7c5ce1;stroke-width:2.8}
