---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="FLOW Board" fullHeight={true}>
  <div class="board-app">
    <header class="board-bar">
      <div>
        <p class="eyebrow">FLOW VISUAL BRAIN · SHARED CANVAS</p>
        <div class="title-row">
          <h1>触って考える。AIとも同じ盤面を見る。</h1>
          <span id="sync-status" class="status">読み込み中…</span>
        </div>
      </div>
      <div class="actions">
        <button id="add-node" type="button">＋ ノード</button>
        <button id="connect" type="button">↗ つなぐ</button>
        <button id="edit-selected" type="button" disabled>編集</button>
        <button id="delete-selected" type="button" disabled>削除</button>
        <button id="zoom-out" type="button" aria-label="縮小">−</button>
        <button id="zoom-in" type="button" aria-label="拡大">＋</button>
        <button id="reset-view" type="button">全体</button>
        <button id="save" type="button" class="primary">保存</button>
      </div>
    </header>

    <div class="hint-bar">
      <span>ノードをタップして選択</span>
      <span>ドラッグで移動</span>
      <span>空白をドラッグで盤面移動</span>
      <span>「編集」でタイトル・メモ変更</span>
      <span id="mode-hint">通常モード</span>
    </div>

    <main id="canvas" class="canvas" aria-label="FLOW editable canvas">
      <div id="world" class="world">
        <svg id="edges" class="edges" width="4000" height="2600" viewBox="0 0 4000 2600" aria-hidden="true"></svg>
        <div id="nodes" class="nodes"></div>
      </div>
      <div class="corner-help">保存先: Supabase / scene: main</div>
    </main>
  </div>

  <script>
    type BoardNode = {
      id: string;
      label: string;
      note?: string;
      kind?: string;
      x: number;
      y: number;
      w?: number;
      h?: number;
      knowledgeId?: string | null;
      provenance?: string;
    };
    type BoardEdge = { id: string; source: string; target: string; relation: string; state?: string };
    type Snapshot = { nodes: BoardNode[]; edges: BoardEdge[]; viewport: { x: number; y: number; zoom: number } };

    const seed: Snapshot = {
      viewport: { x: 80, y: 60, zoom: .78 },
      nodes: [
        { id:'N025', label:'MASTER DASHBOARD', kind:'CONTROL', note:'MASA OS全体の現在地・優先順位・次Actionを俯瞰する操作面。', x:1450, y:150 },
        { id:'N026', label:'DRIVE INDEX', kind:'CONTROL', note:'Drive全体を発見・分類し、正本と処理対象を見つける索引。', x:880, y:120 },
        { id:'N017', label:'KNOWLEDGE FACTORY', kind:'KNOWLEDGE', note:'SourceをNodeへ分解し、既存Canonと接続して再利用可能な知識へ変換する。', x:1180, y:400 },
        { id:'N018', label:'HUMAN FLOW GRAPH', kind:'HUMAN', note:'人・状態・学び・縁・行動を意味付きEdgeで接続するHuman OS。', x:1650, y:470 },
        { id:'N019', label:'ACE BRAIN', kind:'HUMAN', note:'過去の知識・状態・関係から、今の次の良い経験へ進める認知OS。', x:1900, y:720 },
        { id:'N020', label:'CONTENT OS', kind:'OUTPUT', note:'KnowledgeをSNS・note・Quest・Productへ届く表現へ変換する。', x:980, y:760 },
        { id:'N021', label:'PRODUCT OS', kind:'BUSINESS', note:'Sellable資産をOffer・Naming・Priceへ変換する。', x:1140, y:1030 },
        { id:'N022', label:'QUEST MASTER', kind:'ACTION', note:'Knowledgeを問い・実践へ変換し、Evidenceを残す。', x:1700, y:1030 },
        { id:'N023', label:'DISTRIBUTION OS', kind:'OUTPUT', note:'Contentを市場へ出し、反応をEvidenceとして戻す。', x:700, y:1030 },
        { id:'N024', label:'CRM OS', kind:'BUSINESS', note:'顧客・見込み客との接点、反応、CaseをKnowledgeとProductへ戻す。', x:700, y:1370 },
        { id:'N027', label:'ASSET FLOW', kind:'OUTPUT', note:'RAW→SIGNAL→IP→CONTENT→OFFER→REVENUEへ価値変換する流れ。', x:420, y:650 },
        { id:'N028', label:'WANT TO', kind:'LIFE', note:'Want toとPurposeをProject・Taskへ接続し、実践Evidenceで更新する。', x:2100, y:320 },
        { id:'N029', label:'CAPITAL OS', kind:'BUSINESS', note:'RevenueをRunway・自由・資本形成へ接続する。', x:1250, y:1380 },
        { id:'N030', label:'REVENUE IDEAS', kind:'BUSINESS', note:'収益候補を資産性・反復性・波及で比較する。', x:1600, y:1380 },
      ],
      edges: [
        { id:'E1', source:'N026', target:'N017', relation:'feeds', state:'CONFIRMED' },
        { id:'E2', source:'N017', target:'N020', relation:'produces', state:'CONFIRMED' },
        { id:'E3', source:'N017', target:'N018', relation:'feeds', state:'CONFIRMED' },
        { id:'E4', source:'N018', target:'N022', relation:'routes_to', state:'CONFIRMED' },
        { id:'E5', source:'N020', target:'N021', relation:'feeds', state:'CONFIRMED' },
        { id:'E6', source:'N020', target:'N023', relation:'distributed_by', state:'CONFIRMED' },
        { id:'E7', source:'N024', target:'N021', relation:'informs', state:'CONFIRMED' },
        { id:'E8', source:'N021', target:'N029', relation:'feeds', state:'CONFIRMED' },
        { id:'E9', source:'N030', target:'N021', relation:'informs', state:'CONFIRMED' },
        { id:'E10', source:'N028', target:'N018', relation:'informs', state:'CONFIRMED' },
      ],
    };

    let snapshot: Snapshot = structuredClone(seed);
    let revision = 0;
    let selectedId: string | null = null;
    let connectSource: string | null = null;
    let dirty = false;
    let saveTimer: number | null = null;

    const canvas = document.querySelector<HTMLElement>('#canvas')!;
    const world = document.querySelector<HTMLElement>('#world')!;
    const nodesEl = document.querySelector<HTMLElement>('#nodes')!;
    const edgesEl = document.querySelector<SVGSVGElement>('#edges')!;
    const statusEl = document.querySelector<HTMLElement>('#sync-status')!;
    const modeHint = document.querySelector<HTMLElement>('#mode-hint')!;
    const editBtn = document.querySelector<HTMLButtonElement>('#edit-selected')!;
    const deleteBtn = document.querySelector<HTMLButtonElement>('#delete-selected')!;
    const connectBtn = document.querySelector<HTMLButtonElement>('#connect')!;

    const kindColor: Record<string,string> = {
      CONTROL:'#59636e', KNOWLEDGE:'#7c5ce1', HUMAN:'#157a70', OUTPUT:'#2f6fb7',
      BUSINESS:'#a85b19', ACTION:'#b64444', LIFE:'#a64378', PRINCIPLE:'#7352a8', NOTE:'#6c7480'
    };

    function uid(prefix: string) {
      return `${prefix}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,7)}`;
    }

    function setStatus(text: string, state = '') {
      statusEl.textContent = text;
      statusEl.dataset.state = state;
    }

    function applyViewport() {
      const v = snapshot.viewport;
      world.style.transform = `translate(${v.x}px, ${v.y}px) scale(${v.zoom})`;
    }

    function markDirty() {
      dirty = true;
      setStatus('未保存', 'dirty');
      if (saveTimer) window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => saveBoard(), 900);
    }

    function nodeCenter(node: BoardNode) {
      return { x: node.x + (node.w || 210)/2, y: node.y + (node.h || 100)/2 };
    }

    function renderEdges() {
      edgesEl.innerHTML = `
        <defs>
          <marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="3.5" orient="auto">
            <path d="M0,0 L7,3.5 L0,7 Z" fill="#8b929a"></path>
          </marker>
        </defs>`;
      for (const edge of snapshot.edges) {
        const a = snapshot.nodes.find(n => n.id === edge.source);
        const b = snapshot.nodes.find(n => n.id === edge.target);
        if (!a || !b) continue;
        const p1 = nodeCenter(a), p2 = nodeCenter(b);
        const midX = (p1.x + p2.x)/2;
        const path = document.createElementNS('http://www.w3.org/2000/svg','path');
        path.setAttribute('d', `M ${p1.x} ${p1.y} C ${midX} ${p1.y}, ${midX} ${p2.y}, ${p2.x} ${p2.y}`);
        path.setAttribute('class','edge-path');
        path.setAttribute('marker-end','url(#arrow)');
        edgesEl.appendChild(path);

        const label = document.createElementNS('http://www.w3.org/2000/svg','text');
        label.setAttribute('x', String(midX));
        label.setAttribute('y', String((p1.y+p2.y)/2 - 8));
        label.setAttribute('class','edge-label');
        label.textContent = edge.relation;
        edgesEl.appendChild(label);
      }
    }

    function renderNodes() {
      nodesEl.innerHTML = '';
      for (const node of snapshot.nodes) {
        const el = document.createElement('button');
        el.type = 'button';
        el.className = `node-card${selectedId === node.id ? ' selected' : ''}${connectSource === node.id ? ' connect-source' : ''}`;
        el.dataset.id = node.id;
        el.style.left = `${node.x}px`;
        el.style.top = `${node.y}px`;
        el.style.width = `${node.w || 210}px`;
        el.style.minHeight = `${node.h || 100}px`;
        el.style.setProperty('--node-color', kindColor[node.kind || 'NOTE'] || kindColor.NOTE);
        el.innerHTML = `<span class="node-kind">${escapeHtml(node.kind || 'NOTE')}</span><strong>${escapeHtml(node.label)}</strong><small>${escapeHtml(node.note || '')}</small>`;
        bindNodeEvents(el, node);
        nodesEl.appendChild(el);
      }
      editBtn.disabled = !selectedId;
      deleteBtn.disabled = !selectedId;
      renderEdges();
    }

    function escapeHtml(value: string) {
      return value.replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char] || char));
    }

    function selectNode(id: string | null) {
      selectedId = id;
      renderNodes();
    }

    function bindNodeEvents(el: HTMLButtonElement, node: BoardNode) {
      let dragging = false;
      let startX = 0, startY = 0, originX = 0, originY = 0;

      el.addEventListener('pointerdown', (event) => {
        event.stopPropagation();
        if (connectSource) return;
        selectNode(node.id);
        dragging = true;
        startX = event.clientX;
        startY = event.clientY;
        originX = node.x;
        originY = node.y;
        el.setPointerCapture(event.pointerId);
      });
      el.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        node.x = Math.round(originX + (event.clientX - startX)/snapshot.viewport.zoom);
        node.y = Math.round(originY + (event.clientY - startY)/snapshot.viewport.zoom);
        el.style.left = `${node.x}px`;
        el.style.top = `${node.y}px`;
        renderEdges();
      });
      el.addEventListener('pointerup', () => {
        if (!dragging) return;
        dragging = false;
        markDirty();
      });
      el.addEventListener('click', (event) => {
        event.stopPropagation();
        if (!connectBtn.classList.contains('active')) return;
        if (!connectSource) {
          connectSource = node.id;
          modeHint.textContent = `${node.label} → 接続先を選択`;
          renderNodes();
          return;
        }
        if (connectSource === node.id) return;
        const source = connectSource;
        const relation = window.prompt('関係名（例: supports / feeds / monetizes / next_step_of）', 'supports')?.trim();
        if (relation) {
          snapshot.edges.push({ id: uid('E'), source, target: node.id, relation, state:'HUMAN_CONFIRMED' });
          markDirty();
        }
        connectSource = null;
        connectBtn.classList.remove('active');
        modeHint.textContent = '通常モード';
        renderNodes();
      });
      el.addEventListener('dblclick', (event) => {
        event.stopPropagation();
        editNode(node);
      });
    }

    function editNode(node: BoardNode) {
      const label = window.prompt('タイトル', node.label);
      if (label === null) return;
      const note = window.prompt('メモ', node.note || '');
      if (note === null) return;
      const kind = window.prompt('種類', node.kind || 'NOTE');
      if (kind === null) return;
      node.label = label.trim() || node.label;
      node.note = note.trim();
      node.kind = kind.trim().toUpperCase() || 'NOTE';
      renderNodes();
      markDirty();
    }

    async function loadBoard() {
      setStatus('読み込み中…');
      try {
        const res = await fetch('/api/dashboard/board?scene=main', { headers: { Accept:'application/json' } });
        const payload = await res.json();
        if (!res.ok || !payload.ok) throw new Error(payload.error || 'read_failed');
        const data = payload.data || {};
        revision = Number(data.revision || 0);
        if (revision > 0 && data.snapshot?.nodes && data.snapshot?.edges) {
          snapshot = data.snapshot;
          snapshot.viewport ||= { x:80, y:60, zoom:.78 };
        } else {
          snapshot = structuredClone(seed);
        }
        dirty = false;
        selectedId = null;
        applyViewport();
        renderNodes();
        setStatus(revision ? `同期済 · r${revision}` : '初期ボード · 未保存', revision ? 'ok' : 'dirty');
      } catch (error) {
        console.error(error);
        snapshot = structuredClone(seed);
        applyViewport();
        renderNodes();
        setStatus('読み込み失敗', 'error');
      }
    }

    async function saveBoard() {
      if (!dirty && revision > 0) return;
      if (saveTimer) { window.clearTimeout(saveTimer); saveTimer = null; }
      setStatus('保存中…');
      try {
        const res = await fetch('/api/dashboard/board', {
          method:'POST',
          headers:{ 'Content-Type':'application/json', Accept:'application/json' },
          body: JSON.stringify({ sceneKey:'main', snapshot, expectedRevision: revision, actor:'human' }),
        });
        const payload = await res.json();
        if (res.status === 409) {
          setStatus('競合あり · 再読込', 'error');
          return;
        }
        if (!res.ok || !payload.ok) throw new Error(payload.error || 'save_failed');
        revision = Number(payload.data?.revision || revision + 1);
        dirty = false;
        setStatus(`同期済 · r${revision}`, 'ok');
      } catch (error) {
        console.error(error);
        setStatus('保存失敗', 'error');
      }
    }

    document.querySelector('#save')?.addEventListener('click', () => saveBoard());
    document.querySelector('#add-node')?.addEventListener('click', () => {
      const label = window.prompt('新しいノード名');
      if (!label?.trim()) return;
      const rect = canvas.getBoundingClientRect();
      const x = (rect.width/2 - snapshot.viewport.x)/snapshot.viewport.zoom - 105;
      const y = (rect.height/2 - snapshot.viewport.y)/snapshot.viewport.zoom - 50;
      const node: BoardNode = { id:uid('N'), label:label.trim(), note:'', kind:'NOTE', x:Math.round(x), y:Math.round(y), provenance:'human' };
      snapshot.nodes.push(node);
      selectedId = node.id;
      renderNodes();
      markDirty();
    });
    connectBtn.addEventListener('click', () => {
      connectSource = null;
      const active = connectBtn.classList.toggle('active');
      modeHint.textContent = active ? '接続元ノードを選択' : '通常モード';
      renderNodes();
    });
    editBtn.addEventListener('click', () => {
      if (!selectedId) return;
      const node = snapshot.nodes.find(n => n.id === selectedId);
      if (node) editNode(node);
    });
    deleteBtn.addEventListener('click', () => {
      if (!selectedId) return;
      const node = snapshot.nodes.find(n => n.id === selectedId);
      if (!node || !window.confirm(`「${node.label}」を削除しますか？`)) return;
      snapshot.nodes = snapshot.nodes.filter(n => n.id !== selectedId);
      snapshot.edges = snapshot.edges.filter(e => e.source !== selectedId && e.target !== selectedId);
      selectedId = null;
      renderNodes();
      markDirty();
    });

    function zoomBy(multiplier: number) {
      snapshot.viewport.zoom = Math.max(.25, Math.min(2.2, snapshot.viewport.zoom * multiplier));
      applyViewport();
      markDirty();
    }
    document.querySelector('#zoom-in')?.addEventListener('click', () => zoomBy(1.15));
    document.querySelector('#zoom-out')?.addEventListener('click', () => zoomBy(1/1.15));
    document.querySelector('#reset-view')?.addEventListener('click', () => {
      snapshot.viewport = { x:80, y:60, zoom:.78 };
      applyViewport();
      markDirty();
    });

    let panning = false, panX = 0, panY = 0, baseX = 0, baseY = 0;
    canvas.addEventListener('pointerdown', (event) => {
      if ((event.target as HTMLElement).closest('.node-card')) return;
      panning = true;
      panX = event.clientX; panY = event.clientY;
      baseX = snapshot.viewport.x; baseY = snapshot.viewport.y;
      canvas.setPointerCapture(event.pointerId);
      selectNode(null);
    });
    canvas.addEventListener('pointermove', (event) => {
      if (!panning) return;
      snapshot.viewport.x = baseX + event.clientX - panX;
      snapshot.viewport.y = baseY + event.clientY - panY;
      applyViewport();
    });
    canvas.addEventListener('pointerup', () => {
      if (!panning) return;
      panning = false;
      markDirty();
    });
    canvas.addEventListener('wheel', (event) => {
      event.preventDefault();
      zoomBy(event.deltaY < 0 ? 1.08 : 1/1.08);
    }, { passive:false });

    window.addEventListener('beforeunload', (event) => {
      if (!dirty) return;
      event.preventDefault();
    });

    loadBoard();
  </script>

  <style>
    .board-app { height: calc(100vh - 66px); min-height: 680px; display:grid; grid-template-rows:auto auto minmax(0,1fr); background:#f3f1ed; }
    .board-bar { display:flex; align-items:center; justify-content:space-between; gap:18px; padding:16px 20px; border-bottom:1px solid #d9d4cc; background:#fbfaf8; }
    .eyebrow { color:#8b5b2c; font-size:.66rem; font-weight:700; letter-spacing:.13em; }
    .title-row { margin-top:3px; display:flex; align-items:center; flex-wrap:wrap; gap:10px; }
    h1 { font-size:1.08rem; line-height:1.3; }
    .status { padding:4px 8px; border:1px solid #d2ccc3; background:#fff; color:#707782; font-size:.65rem; }
    .status[data-state="ok"] { color:#147450; border-color:#b7d8ca; background:#f0faf5; }
    .status[data-state="dirty"] { color:#9a6115; border-color:#e0c79f; background:#fff8eb; }
    .status[data-state="error"] { color:#9f3434; border-color:#e0b9b9; background:#fff2f2; }
    .actions { display:flex; align-items:center; gap:6px; flex-wrap:wrap; justify-content:flex-end; }
    .actions button { min-height:38px; padding:0 10px; border:1px solid #cbc5bc; background:#fff; color:#515b65; cursor:pointer; font-size:.7rem; border-radius:8px; }
    .actions button:hover, .actions button.active { border-color:#a56c22; color:#754a16; background:#faf2e6; }
    .actions button.primary { background:#81551f; color:#fff; border-color:#81551f; font-weight:700; }
    .actions button:disabled { opacity:.42; cursor:default; }
    .hint-bar { min-height:36px; display:flex; align-items:center; gap:14px; padding:5px 20px; overflow-x:auto; border-bottom:1px solid #ddd8d0; color:#7a818a; background:#fff; font-size:.64rem; white-space:nowrap; }
    #mode-hint { color:#81551f; font-weight:700; }
    .canvas { position:relative; overflow:hidden; min-height:0; touch-action:none; background-color:#f7f5f1; background-image:radial-gradient(#cfc9c0 1px, transparent 1px); background-size:24px 24px; cursor:grab; }
    .canvas:active { cursor:grabbing; }
    .world { position:absolute; inset:0 auto auto 0; width:4000px; height:2600px; transform-origin:0 0; will-change:transform; }
    .edges, .nodes { position:absolute; inset:0; width:4000px; height:2600px; }
    .edges { overflow:visible; pointer-events:none; }
    :global(.edge-path) { fill:none; stroke:#9ca2a8; stroke-width:2; opacity:.75; }
    :global(.edge-label) { fill:#777e86; font-size:12px; text-anchor:middle; paint-order:stroke; stroke:#f7f5f1; stroke-width:5px; stroke-linejoin:round; }
    .node-card { position:absolute; z-index:2; display:flex; flex-direction:column; align-items:flex-start; gap:7px; padding:14px 15px; border:1px solid #d7d1c8; border-left:5px solid var(--node-color); border-radius:14px; background:rgba(255,255,255,.96); color:#22272d; text-align:left; box-shadow:0 7px 20px rgba(46,39,31,.08); cursor:grab; touch-action:none; user-select:none; }
    .node-card:active { cursor:grabbing; }
    .node-card:hover { border-color:#bfb6aa; box-shadow:0 10px 28px rgba(46,39,31,.13); }
    .node-card.selected { outline:3px solid rgba(165,108,34,.25); border-color:#a56c22; }
    .node-card.connect-source { outline:3px solid rgba(47,111,183,.25); border-color:#2f6fb7; }
    .node-kind { color:var(--node-color); font-size:.57rem; font-weight:700; letter-spacing:.1em; }
    .node-card strong { font-size:.82rem; line-height:1.3; }
    .node-card small { color:#6d747c; font-size:.65rem; line-height:1.5; white-space:normal; }
    .corner-help { position:absolute; right:12px; bottom:12px; padding:7px 9px; border:1px solid #d8d2ca; border-radius:8px; background:rgba(255,255,255,.88); color:#81878e; font-size:.58rem; pointer-events:none; }
    @media (max-width: 860px) {
      .board-app { height:calc(100dvh - 66px); min-height:0; }
      .board-bar { align-items:flex-start; padding:10px 12px; }
      .board-bar h1 { font-size:.86rem; }
      .actions { max-width:55%; }
      .actions button { min-height:34px; padding:0 8px; font-size:.64rem; }
      .hint-bar { padding-inline:12px; }
    }
    @media (max-width: 620px) {
      .board-bar { display:block; }
      .actions { max-width:none; margin-top:9px; justify-content:flex-start; }
      .actions button { flex:0 0 auto; }
      .title-row { gap:6px; }
      .node-card { border-radius:12px; }
    }
  </style>
</DashboardLayout>
