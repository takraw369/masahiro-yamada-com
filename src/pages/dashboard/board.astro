---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="FLOW Board" fullHeight={true}>
  <div class="board-app">
    <header class="board-bar">
      <div class="board-heading">
        <p class="eyebrow">FLOW VISUAL BRAIN · FREEFORM × MIND MAP × AI</p>
        <div class="title-row">
          <h1>考える前に置く。必要になったら構造化する。</h1>
          <span id="sync-status" class="status">読み込み中…</span>
          <span id="selection-label" class="selection-label">未選択</span>
        </div>
      </div>

      <div class="toolbar" aria-label="Board tools">
        <div class="tool-group tool-create">
          <button id="add-node" type="button">＋ 付箋</button>
          <button id="add-text" type="button">T テキスト</button>
          <button id="add-frame" type="button">□ Frame</button>
        </div>
        <div class="tool-group">
          <button id="visual-connect" type="button" title="意味を持たない自由な線">／ 線</button>
          <button id="semantic-connect" type="button" title="AIも意味として読む関係線">↗ 意味線</button>
          <button id="mindmap-layout" type="button" disabled>枝を整列</button>
        </div>
        <div class="tool-group">
          <button id="edit-selected" type="button" disabled>編集</button>
          <button id="duplicate-selected" type="button" disabled>複製</button>
          <button id="delete-selected" type="button" disabled>削除</button>
        </div>
        <div class="tool-group">
          <button id="undo" type="button" disabled aria-label="元に戻す">↶</button>
          <button id="redo" type="button" disabled aria-label="やり直す">↷</button>
          <button id="zoom-out" type="button" aria-label="縮小">−</button>
          <button id="zoom-in" type="button" aria-label="拡大">＋</button>
          <button id="reset-view" type="button">全体</button>
        </div>
        <div class="tool-group">
          <a href="/dashboard/board?mission=revenue" title="Revenue MissionをBoard中央へ">Revenue</a>
          <a href="/dashboard#revenue-mission">商品準備</a>
          <button id="save" type="button" class="primary" disabled>保存</button>
        </div>
      </div>
    </header>

    <div class="hint-bar">
      <span><b>ダブルクリック</b> 空白→自由テキスト</span>
      <span><b>Tab</b> 子ノード</span>
      <span><b>Enter</b> 兄弟ノード</span>
      <span><b>Shift+クリック</b> 複数選択</span>
      <span><b>Shift+空白ドラッグ</b> 範囲選択</span>
      <span><b>⌘/Ctrl+D</b> 複製</span>
      <span><b>⌘/Ctrl+Z</b> Undo</span>
      <span id="mode-hint">通常モード</span>
    </div>

    <main id="canvas" class="canvas" aria-label="FLOW freeform editable canvas">
      <div id="world" class="world">
        <svg id="edges" class="edges" aria-hidden="true"></svg>
        <div id="nodes" class="nodes"></div>
      </div>
      <div id="marquee" class="marquee" hidden></div>
      <div class="corner-help">
        <span>空白ドラッグ＝移動</span>
        <span>ホイール＝ズーム</span>
        <span>右下ハンドル＝リサイズ</span>
        <strong>Supabase · scene: main</strong>
      </div>
    </main>
  </div>

  <script>
    import { initFlowBoardEditor } from '../../lib/flowBoardEditor';
    initFlowBoardEditor();
  </script>

  <style>
    .board-app {
      height: calc(100vh - 66px);
      min-height: 680px;
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr);
      background: #f3f1ed;
    }
    .board-bar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      padding: 13px 16px;
      border-bottom: 1px solid #d9d4cc;
      background: #fbfaf8;
    }
    .board-heading { min-width: 250px; padding-top: 2px; }
    .eyebrow { color:#8b5b2c; font-size:.62rem; font-weight:700; letter-spacing:.12em; }
    .title-row { margin-top:3px; display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
    h1 { font-size:1rem; line-height:1.3; }
    .status,.selection-label {
      padding:4px 8px;
      border:1px solid #d2ccc3;
      border-radius:999px;
      background:#fff;
      color:#707782;
      font-size:.61rem;
      white-space:nowrap;
    }
    .selection-label { color:#66584a; background:#f8f5ef; }
    .status[data-state="ok"] { color:#147450; border-color:#b7d8ca; background:#f0faf5; }
    .status[data-state="dirty"] { color:#9a6115; border-color:#e0c79f; background:#fff8eb; }
    .status[data-state="error"] { color:#9f3434; border-color:#e0b9b9; background:#fff2f2; }

    .toolbar {
      display:flex;
      align-items:center;
      justify-content:flex-end;
      flex-wrap:wrap;
      gap:7px;
      max-width: 940px;
    }
    .tool-group {
      display:flex;
      align-items:center;
      gap:4px;
      padding-right:7px;
      border-right:1px solid #e1ddd6;
    }
    .tool-group:last-child { border-right:0; padding-right:0; }
    .toolbar button,.toolbar a {
      min-height:34px;
      padding:0 9px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border:1px solid #cbc5bc;
      border-radius:8px;
      background:#fff;
      color:#515b65;
      cursor:pointer;
      font-size:.66rem;
      text-decoration:none;
      white-space:nowrap;
    }
    .toolbar button:hover,.toolbar button.active,.toolbar a:hover {
      border-color:#a56c22;
      color:#754a16;
      background:#faf2e6;
    }
    .toolbar button.primary { background:#81551f; color:#fff; border-color:#81551f; font-weight:700; }
    .toolbar button:disabled { opacity:.38; cursor:default; }

    .hint-bar {
      min-height:34px;
      display:flex;
      align-items:center;
      gap:14px;
      padding:5px 16px;
      overflow-x:auto;
      border-bottom:1px solid #ddd8d0;
      color:#7a818a;
      background:#fff;
      font-size:.61rem;
      white-space:nowrap;
      scrollbar-width:thin;
    }
    .hint-bar b { color:#5b626a; }
    #mode-hint { color:#81551f; font-weight:700; }

    .canvas {
      position:relative;
      overflow:hidden;
      min-height:0;
      touch-action:none;
      background-color:#f7f5f1;
      background-image:radial-gradient(#cec8bf 1px, transparent 1px);
      background-size:24px 24px;
      cursor:grab;
    }
    .canvas:active { cursor:grabbing; }
    .world {
      position:absolute;
      inset:0 auto auto 0;
      transform-origin:0 0;
      will-change:transform;
    }
    .edges,.nodes { position:absolute; inset:0; }
    .edges { z-index:1; overflow:visible; pointer-events:none; }
    .nodes { z-index:2; }

    :global(.edge-path) { fill:none; stroke-width:2; opacity:.78; }
    :global(.edge-semantic) { stroke:#9299a0; }
    :global(.edge-mindmap) { stroke:#a56c22; stroke-width:2.2; }
    :global(.edge-visual) { stroke:#a8adb2; stroke-width:2; stroke-dasharray:0; opacity:.62; }
    :global(.edge-label) {
      fill:#777e86;
      font-size:12px;
      text-anchor:middle;
      paint-order:stroke;
      stroke:#f7f5f1;
      stroke-width:5px;
      stroke-linejoin:round;
    }
    :global(.edge-label-mindmap) { fill:#8b5b2c; }

    .node-card {
      --node-font-size: .82rem;
      position:absolute;
      z-index:2;
      display:flex;
      flex-direction:column;
      align-items:flex-start;
      gap:7px;
      padding:14px 15px;
      overflow:hidden;
      border:1px solid #d7d1c8;
      border-left:5px solid var(--node-color);
      border-radius:14px;
      background:rgba(255,255,255,.96);
      color:#22272d;
      text-align:left;
      box-shadow:0 7px 20px rgba(46,39,31,.08);
      cursor:grab;
      touch-action:none;
      user-select:none;
    }
    .node-card:active { cursor:grabbing; }
    .node-card:hover { border-color:#bfb6aa; box-shadow:0 10px 28px rgba(46,39,31,.13); }
    .node-card.selected { outline:3px solid rgba(165,108,34,.28); border-color:#a56c22; }
    .node-card.connect-source { outline:3px solid rgba(47,111,183,.25); border-color:#2f6fb7; }
    .node-kind { color:var(--node-color); font-size:.55rem; font-weight:700; letter-spacing:.1em; }
    .node-card strong { font-size:var(--node-font-size); line-height:1.32; overflow-wrap:anywhere; }
    .node-card small { color:#6d747c; font-size:.63rem; line-height:1.45; white-space:normal; overflow-wrap:anywhere; }

    .node-card.shape-text {
      z-index:3;
      justify-content:center;
      padding:8px 10px;
      border:1px solid transparent;
      border-left:0;
      border-radius:8px;
      background:transparent;
      box-shadow:none;
      color:#2d3136;
    }
    .node-card.shape-text:hover,.node-card.shape-text.selected {
      border-color:#c9c1b7;
      background:rgba(255,255,255,.72);
      box-shadow:none;
    }
    .free-text { font-size:clamp(.82rem,var(--node-font-size),1.35rem) !important; font-weight:600; white-space:pre-wrap; }

    .node-card.shape-frame {
      z-index:0;
      padding:16px;
      border:2px solid #cfc6b9;
      border-left:2px solid #cfc6b9;
      border-radius:18px;
      background:rgba(245,240,232,.38);
      box-shadow:none;
      color:#655d54;
    }
    .node-card.shape-frame::after {
      content:'';
      position:absolute;
      inset:34px 0 0;
      border-top:1px dashed rgba(154,141,124,.42);
      pointer-events:none;
    }
    .node-card.shape-frame strong { font-size:.72rem; letter-spacing:.03em; }
    .node-card.shape-frame .node-kind { font-size:.5rem; }

    .resize-handle {
      position:absolute;
      right:3px;
      bottom:3px;
      width:18px;
      height:18px;
      cursor:nwse-resize;
      opacity:0;
      transition:opacity .12s ease;
    }
    .resize-handle::after {
      content:'';
      position:absolute;
      right:3px;
      bottom:3px;
      width:8px;
      height:8px;
      border-right:2px solid #9d9286;
      border-bottom:2px solid #9d9286;
    }
    .node-card:hover .resize-handle,.node-card.selected .resize-handle { opacity:1; }

    .marquee {
      position:absolute;
      z-index:20;
      border:1px solid rgba(68,107,149,.75);
      background:rgba(86,134,185,.12);
      pointer-events:none;
    }
    .corner-help {
      position:absolute;
      z-index:25;
      right:12px;
      bottom:12px;
      display:flex;
      align-items:center;
      gap:9px;
      padding:7px 9px;
      border:1px solid #d8d2ca;
      border-radius:9px;
      background:rgba(255,255,255,.9);
      color:#81878e;
      font-size:.56rem;
      pointer-events:none;
      box-shadow:0 4px 18px rgba(40,34,28,.05);
    }
    .corner-help strong { color:#6d5a42; font-weight:700; }

    @media (max-width: 1100px) {
      .board-bar { display:block; }
      .toolbar { margin-top:9px; justify-content:flex-start; max-width:none; }
    }
    @media (max-width: 860px) {
      .board-app { height:calc(100dvh - 66px); min-height:0; }
      .board-bar { padding:9px 10px; }
      .board-bar h1 { font-size:.84rem; }
      .toolbar { flex-wrap:nowrap; overflow-x:auto; padding-bottom:3px; scrollbar-width:thin; }
      .tool-group { flex:0 0 auto; }
      .toolbar button,.toolbar a { min-height:33px; padding:0 8px; font-size:.62rem; }
      .hint-bar { padding-inline:10px; }
      .corner-help span { display:none; }
    }
    @media (max-width: 620px) {
      .eyebrow { font-size:.55rem; }
      .title-row { gap:5px; }
      .status,.selection-label { font-size:.56rem; }
      .node-card { border-radius:12px; }
      .resize-handle { width:24px; height:24px; opacity:.78; }
      .corner-help { right:8px; bottom:8px; }
    }
  </style>
</DashboardLayout>
