---
const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo', month: 'long', day: 'numeric', weekday: 'short',
}).format(new Date());

const coreLinks = [
  { label: 'Today', purpose: '今やること', href: '/dashboard/ui-v2-2' },
  { label: 'Capture', purpose: '残す', href: '/dashboard/intelligence#intel-form' },
  { label: 'Output', purpose: '出す', href: '#output' },
  { label: 'Review', purpose: '見る', href: '/dashboard/intelligence#intel-list' },
];

const lineAreas = [
  { label: 'Overview', jp: '今日見るもの', detail: '友だち・未返信・稼働Flow・次回配信・CV' },
  { label: 'Send', jp: '今送る', detail: '一斉 / セグメント / 予約 / 配信履歴' },
  { label: 'Flow', jp: '自動で動かす', detail: 'Step / Automation / Auto reply / Reminder' },
  { label: 'Audience', jp: '誰に送るか', detail: 'Friends / Tags / Segments / Metadata / Score' },
  { label: 'Assets', jp: '何を使うか', detail: 'Template / Rich Menu / Form / Tracking / QR' },
  { label: 'Insights', jp: '何が効いたか', detail: '流入 / 到達 / Click / CV / 離脱' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>MASA OS V2.2 Preview</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="app">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-title">MASA OS</div>
          <div class="brand-sub">Daily Command Center · V2.2</div>
        </div>
        <nav class="nav" aria-label="Dashboard navigation">
          {coreLinks.map((item, i) => (
            <a class:list={['core-link', { active: i === 0 }]} href={item.href}>
              <strong>{item.label}</strong><small>{item.purpose}</small>
            </a>
          ))}
          <details class="more-tools">
            <summary>MORE TOOLS</summary>
            <div class="tool-links">
              <a href="/dashboard/evidence">Evidence Lab</a>
              <a href="/dashboard/graph">Graph</a>
              <a href="/dashboard/flow-09">0→9 Flow</a>
              <a href="/dashboard/treasury">Treasury</a>
              <a href="/dashboard/os">MASA OS / Wealth</a>
            </div>
          </details>
        </nav>
        <div class="side-foot">
          <a href="/dashboard/ui-v2">V2.1と比較</a>
          <a href="/dashboard">現行Dashboard</a>
        </div>
      </aside>

      <main class="main">
        <header class="topbar">
          <div>
            <p class="eyebrow">DAILY COMMAND CENTER</p>
            <p class="top-title">今日</p>
          </div>
          <div class="top-actions">
            <a class="subtle-button" href="/dashboard/intelligence#intel-form">＋ Capture</a>
            <span class="preview-badge">V2.2 PREVIEW</span>
          </div>
        </header>

        <div class="content">
          <header class="today-head">
            <div>
              <p class="kicker">TODAY</p>
              <h1>迷わず、1つ動かす。</h1>
              <p>ブランド色より先に、情報と操作が読めることを優先する。</p>
            </div>
            <p class="date">{dateLabel}</p>
          </header>

          <section class="next-card" aria-labelledby="next-title">
            <div>
              <div class="status-line">
                <span class="kicker">NEXT MOVE · PROPOSAL</span>
                <span class="neutral-badge">CURRENT STATE 未連携</span>
              </div>
              <p class="context">Social Growth Sprint 30D</p>
              <h2 id="next-title">既存素材を1本、投稿文にする。</h2>
              <p class="body-copy">固定方針からの候補。現在地・期限・反応データから自動判定した「今日の正解」ではありません。</p>
            </div>
            <div class="next-actions">
              <a class="primary" href="/dashboard/post">この一手を進める <span>→</span></a>
              <a class="secondary" href="/dashboard/intelligence#intel-list">素材から選び直す</a>
            </div>
          </section>

          <section class="quick-section">
            <div class="section-head">
              <div><p class="kicker">START</p><h2>3つの入口</h2></div>
              <p>残す → 出す → 見る</p>
            </div>
            <div class="quick-grid">
              <a class="quick-card" href="/dashboard/intelligence#intel-form"><span>CAPTURE</span><strong>残す</strong><small>思いつき・メモ・URL</small></a>
              <a class="quick-card" href="#output"><span>OUTPUT</span><strong>出す</strong><small>X・LINE・その他の発信</small></a>
              <a class="quick-card" href="/dashboard/intelligence#intel-list"><span>REVIEW</span><strong>見る</strong><small>保存した情報を読み返す</small></a>
            </div>
          </section>

          <section class="output-section" id="output">
            <div class="section-head">
              <div><p class="kicker">OUTPUT</p><h2>どこへ出す？</h2></div>
              <p>媒体ではなく、仕事から選ぶ。</p>
            </div>
            <div class="channel-grid">
              <a class="channel-card" href="/dashboard/post">
                <span class="channel-mark">X</span>
                <div><strong>X / Social</strong><small>投稿を作る・出す</small></div>
                <span class="chevron">→</span>
              </a>
              <a class="channel-card line-card" href="#line-center">
                <span class="channel-mark line">L</span>
                <div><strong>LINE</strong><small>配信・顧客Flow・分析</small></div>
                <span class="chevron">↓</span>
              </a>
            </div>
          </section>

          <section class="line-center" id="line-center" aria-labelledby="line-title">
            <header class="line-head">
              <div>
                <div class="status-line"><span class="kicker green">LINE CENTER</span><span class="neutral-badge">IA PREVIEW · API未接続</span></div>
                <h2 id="line-title">顧客が動く流れを、1か所で見る。</h2>
                <p>流入 → 登録 → 教育 → 行動 → 商品 → CV。機能名を覚えなくても、目的から辿れる構造。</p>
              </div>
              <button type="button" class="inbox-button" disabled>Inbox <span>—</span></button>
            </header>

            <div class="line-nav" aria-label="LINE Center IA preview">
              {lineAreas.map((area, i) => (
                <article class:list={['line-area', { featured: i === 2 }]}>
                  <span class="area-index">0{i + 1}</span>
                  <strong>{area.label}</strong>
                  <em>{area.jp}</em>
                  <small>{area.detail}</small>
                </article>
              ))}
            </div>

            <div class="flow-preview">
              <div class="flow-top">
                <div><p class="kicker green">FLOW · EXAMPLE</p><h3>新規登録 → 教育 → オファー</h3></div>
                <span class="active-pill">ACTIVE</span>
              </div>
              <div class="flow-body">
                <div class="timeline">
                  <div class="flow-node trigger"><span class="node-type">TRIGGER</span><strong>友だち追加</strong><small>friend_add</small></div>
                  <div class="connector">↓</div>
                  <div class="flow-node"><span class="node-type">NOW</span><strong>Welcome</strong><small>登録ありがとう + 次に読むもの</small></div>
                  <div class="connector">↓ 1日</div>
                  <div class="flow-node"><span class="node-type">SEND</span><strong>教育①</strong><small>悩み → 視点 → 小さな行動</small></div>
                  <div class="connector">↓</div>
                  <div class="branch-node"><span class="node-type">IF</span><strong>purchased タグあり？</strong><div class="branch-choices"><span>YES → 購入者フォロー</span><span>NO → オファー</span></div></div>
                  <div class="connector">↓ 3日</div>
                  <div class="flow-node"><span class="node-type">REMIND</span><strong>Reminder</strong><small>未購入者だけに再案内</small></div>
                </div>
                <aside class="inspector">
                  <p class="kicker">INSPECTOR</p>
                  <h3>教育①</h3>
                  <dl>
                    <div><dt>WHEN</dt><dd>購読開始から1日後</dd></div>
                    <div><dt>WHO</dt><dd>条件なし</dd></div>
                    <div><dt>DO</dt><dd>Text / Template</dd></div>
                    <div><dt>AFTER</dt><dd>tag: education_01</dd></div>
                    <div><dt>RESULT</dt><dd>API接続後に表示</dd></div>
                  </dl>
                  <button type="button" disabled>Stepを編集</button>
                </aside>
              </div>
            </div>
          </section>

          <section class="design-note">
            <div><p class="kicker">V2.2 COLOR RULE</p><h2>金は「読む色」ではなく「意味のあるアクセント」に。</h2></div>
            <div class="swatches" aria-label="V2.2 palette">
              <span style="--swatch:#f3f1ed">Work</span>
              <span style="--swatch:#ffffff">Panel</span>
              <span style="--swatch:#17191c">Ink</span>
              <span style="--swatch:#6b7280">Muted</span>
              <span style="--swatch:#a56c22">Gold</span>
              <span style="--swatch:#138a55">State</span>
            </div>
          </section>

          <footer class="foot">
            <p>V2.2 · readability + LINE IA · visual preview only</p>
            <a href="/dashboard/ui-v2">V2.1を見る →</a>
          </footer>
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: #f3f1ed; }
  body { margin: 0; color: #17191c; background: #f3f1ed; font-family: 'Zen Kaku Gothic New', sans-serif; line-height: 1.55; }
  a { color: inherit; }
  button, a { font: inherit; }
  :focus-visible { outline: 3px solid rgba(165,108,34,.38); outline-offset: 3px; }
  .app { min-height: 100vh; display: grid; grid-template-columns: 220px minmax(0,1fr); }
  .sidebar { position: fixed; inset: 0 auto 0 0; width: 220px; z-index: 20; display: flex; flex-direction: column; background: #fbfaf8; border-right: 1px solid #d8d4cd; }
  .brand { padding: 22px 18px 18px; border-bottom: 1px solid #e2ded7; }
  .brand-title { font-family: 'Cormorant Garamond', serif; font-size: 1.65rem; letter-spacing: .05em; color: #754a16; }
  .brand-sub { margin-top: 3px; color: #68707a; font-size: .68rem; }
  .nav { display: grid; gap: 5px; padding: 14px 12px; }
  .core-link { min-height: 50px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid transparent; text-decoration: none; color: #505964; }
  .core-link strong { font-size: .84rem; font-weight: 700; }
  .core-link small { color: #7b838c; font-size: .68rem; }
  .core-link:hover { background: #f2efe9; border-color: #d7d0c5; }
  .core-link.active { color: #67400f; background: #f3eadc; border-color: #dcc9aa; border-left: 3px solid #a56c22; }
  .more-tools { margin-top: 12px; padding-top: 8px; border-top: 1px solid #e2ded7; }
  .more-tools summary { min-height: 44px; display: flex; align-items: center; color: #745b39; font-size: .7rem; letter-spacing: .08em; cursor: pointer; }
  .tool-links { display: grid; padding-bottom: 8px; }
  .tool-links a { padding: 8px 4px; color: #65707b; font-size: .74rem; text-decoration: none; }
  .tool-links a:hover { color: #17191c; }
  .side-foot { margin-top: auto; display: grid; gap: 8px; padding: 15px 18px; border-top: 1px solid #e2ded7; }
  .side-foot a { color: #707782; font-size: .7rem; text-decoration: none; }
  .main { grid-column: 2; min-width: 0; }
  .topbar { position: sticky; top: 0; z-index: 10; min-height: 66px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 10px 28px; background: rgba(251,250,248,.94); backdrop-filter: blur(14px); border-bottom: 1px solid #ddd9d2; }
  .eyebrow, .kicker { margin: 0; color: #8b5b1e; font-size: .68rem; font-weight: 700; letter-spacing: .12em; }
  .kicker.green { color: #13774d; }
  .top-title { margin: 2px 0 0; color: #4f5660; font-size: .8rem; }
  .top-actions { display: flex; align-items: center; gap: 8px; }
  .subtle-button { min-height: 42px; display: inline-flex; align-items: center; padding: 0 13px; border: 1px solid #cfc8bd; background: white; color: #684613; text-decoration: none; font-size: .76rem; font-weight: 700; }
  .preview-badge, .neutral-badge { display: inline-flex; align-items: center; min-height: 28px; padding: 3px 8px; border: 1px solid #d6d2cb; background: #f8f7f4; color: #69717b; font-size: .65rem; font-weight: 700; letter-spacing: .04em; }
  .content { max-width: 1380px; margin: 0 auto; padding: 28px 30px 56px; }
  .today-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
  .today-head h1 { margin: 4px 0 0; font-size: clamp(1.65rem,2.5vw,2.35rem); line-height: 1.25; }
  .today-head > div > p:last-child { margin: 7px 0 0; color: #606973; font-size: .86rem; }
  .date { color: #6e7680; font-size: .8rem; }
  .next-card { display: grid; grid-template-columns: minmax(0,1fr) 330px; gap: 28px; padding: 30px 32px; background: white; border: 1px solid #cec8be; box-shadow: 0 8px 28px rgba(34,30,24,.05); }
  .status-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
  .context { margin: 16px 0 0; color: #69717b; font-size: .82rem; }
  .next-card h2 { margin: 7px 0 0; font-size: clamp(1.7rem,3vw,2.65rem); line-height: 1.32; }
  .body-copy { max-width: 760px; margin: 13px 0 0; color: #565f69; font-size: .86rem; line-height: 1.8; }
  .next-actions { display: grid; align-content: end; gap: 9px; }
  .primary, .secondary { min-height: 49px; display: flex; align-items: center; justify-content: space-between; padding: 11px 16px; text-decoration: none; font-size: .86rem; font-weight: 700; }
  .primary { background: #8d5b1d; color: white; border: 1px solid #8d5b1d; }
  .primary:hover { background: #704714; }
  .secondary { color: #424a53; background: #fbfaf8; border: 1px solid #cbc5bb; }
  .quick-section, .output-section, .line-center, .design-note { margin-top: 30px; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 12px; }
  .section-head h2 { margin: 3px 0 0; font-size: 1.06rem; }
  .section-head > p { margin: 0; color: #66707a; font-size: .76rem; }
  .quick-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; }
  .quick-card { min-height: 124px; display: flex; flex-direction: column; padding: 16px 17px; background: #fff; border: 1px solid #d4cfc7; text-decoration: none; transition: .15s ease; }
  .quick-card:hover { transform: translateY(-2px); border-color: #b88a50; box-shadow: 0 8px 20px rgba(34,30,24,.06); }
  .quick-card span { color: #8d5b1d; font-size: .67rem; font-weight: 700; letter-spacing: .12em; }
  .quick-card strong { margin-top: 10px; font-size: 1.05rem; }
  .quick-card small { margin-top: 5px; color: #65707b; font-size: .75rem; }
  .channel-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
  .channel-card { min-height: 90px; display: grid; grid-template-columns: 46px 1fr auto; align-items: center; gap: 14px; padding: 15px 17px; background: white; border: 1px solid #d4cfc7; text-decoration: none; }
  .channel-card:hover { border-color: #aa885d; }
  .channel-mark { width: 42px; height: 42px; display: grid; place-items: center; background: #17191c; color: white; font-weight: 700; }
  .channel-mark.line { background: #06c755; }
  .channel-card strong { display: block; font-size: .95rem; }
  .channel-card small { display: block; margin-top: 3px; color: #68717b; font-size: .74rem; }
  .chevron { color: #8d5b1d; }
  .line-center { padding: 28px; background: #f9faf9; border: 1px solid #cbd5cf; }
  .line-head { display: flex; align-items: start; justify-content: space-between; gap: 20px; }
  .line-head h2 { margin: 8px 0 0; font-size: clamp(1.4rem,2.2vw,2rem); }
  .line-head > div > p:last-child { max-width: 720px; margin: 8px 0 0; color: #5d6862; font-size: .82rem; }
  .inbox-button { min-height: 42px; padding: 0 13px; border: 1px solid #c8d2cc; background: white; color: #526058; }
  .line-nav { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8px; margin-top: 22px; }
  .line-area { position: relative; min-height: 132px; display: flex; flex-direction: column; padding: 15px; background: white; border: 1px solid #d1dad5; }
  .line-area.featured { border-color: #6faa8c; box-shadow: inset 3px 0 #138a55; }
  .area-index { color: #87938c; font-size: .64rem; }
  .line-area strong { margin-top: 9px; font-size: .95rem; }
  .line-area em { margin-top: 2px; color: #277a56; font-size: .74rem; font-style: normal; font-weight: 700; }
  .line-area small { margin-top: auto; padding-top: 8px; color: #66726c; font-size: .7rem; line-height: 1.55; }
  .flow-preview { margin-top: 18px; padding: 20px; background: white; border: 1px solid #d1dad5; }
  .flow-top { display: flex; justify-content: space-between; align-items: start; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid #e0e5e2; }
  .flow-top h3 { margin: 4px 0 0; font-size: 1rem; }
  .active-pill { padding: 5px 9px; background: #e5f6ed; color: #107347; border: 1px solid #b7dfca; font-size: .68rem; font-weight: 700; }
  .flow-body { display: grid; grid-template-columns: minmax(0,1.6fr) minmax(260px,.7fr); gap: 20px; margin-top: 18px; }
  .timeline { display: grid; justify-items: stretch; max-width: 720px; }
  .flow-node, .branch-node { padding: 14px 16px; border: 1px solid #cfd7d2; background: #fbfcfb; }
  .flow-node.trigger { border-left: 4px solid #138a55; }
  .node-type { display: block; color: #277a56; font-size: .63rem; font-weight: 700; letter-spacing: .1em; }
  .flow-node strong, .branch-node strong { display: block; margin-top: 4px; font-size: .9rem; }
  .flow-node small { display: block; margin-top: 3px; color: #67716c; font-size: .72rem; }
  .connector { min-height: 32px; display: grid; place-items: center; color: #7b8580; font-size: .7rem; }
  .branch-node { background: #f4f8f5; border-color: #adc9b9; }
  .branch-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
  .branch-choices span { padding: 8px 10px; background: white; border: 1px solid #cfdbd4; color: #4c5c53; font-size: .7rem; }
  .inspector { padding: 16px; background: #f7f6f3; border: 1px solid #d8d4cd; }
  .inspector h3 { margin: 4px 0 0; }
  .inspector dl { margin: 16px 0 0; }
  .inspector dl div { display: grid; grid-template-columns: 66px 1fr; gap: 10px; padding: 9px 0; border-top: 1px solid #dedad3; }
  .inspector dt { color: #8a6a3d; font-size: .64rem; font-weight: 700; }
  .inspector dd { margin: 0; color: #4f5861; font-size: .72rem; }
  .inspector button { width: 100%; min-height: 40px; margin-top: 12px; border: 1px solid #d0cbc3; background: white; color: #899099; }
  .design-note { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 30px; padding: 22px 24px; background: #fff; border: 1px solid #d4cfc7; }
  .design-note h2 { max-width: 720px; margin: 5px 0 0; font-size: 1.05rem; }
  .swatches { display: flex; gap: 5px; flex-wrap: wrap; justify-content: flex-end; }
  .swatches span { width: 56px; height: 56px; display: grid; place-items: end center; padding-bottom: 5px; background: var(--swatch); border: 1px solid #d4cfc7; color: #42464b; font-size: .58rem; }
  .swatches span:nth-child(3) { color: white; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 34px; padding-top: 18px; border-top: 1px solid #d6d1c9; color: #737b84; font-size: .7rem; }
  .foot a { color: #734a17; text-decoration: none; font-weight: 700; }
  @media (max-width: 980px) {
    .app { display: block; }
    .sidebar { position: static; width: auto; min-height: auto; border-right: 0; border-bottom: 1px solid #d8d4cd; }
    .brand { padding: 14px 16px 10px; }
    .nav { grid-template-columns: repeat(4,minmax(0,1fr)); padding: 8px 12px 12px; }
    .core-link { min-height: 44px; grid-template-columns: 1fr; gap: 0; }
    .core-link small { display: none; }
    .more-tools, .side-foot { display: none; }
    .main { grid-column: auto; }
    .next-card { grid-template-columns: 1fr; }
    .next-actions { grid-template-columns: 1fr 1fr; }
    .line-nav { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .flow-body { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .topbar { padding: 9px 14px; }
    .preview-badge { display: none; }
    .content { padding: 20px 14px 40px; }
    .today-head { align-items: start; flex-direction: column; }
    .next-card { padding: 21px 18px; }
    .next-actions, .quick-grid, .channel-grid, .line-nav { grid-template-columns: 1fr; }
    .section-head { align-items: start; flex-direction: column; }
    .line-center { padding: 18px 14px; }
    .line-head { flex-direction: column; }
    .branch-choices { grid-template-columns: 1fr; }
    .design-note { grid-template-columns: 1fr; }
    .swatches { justify-content: flex-start; }
    .foot { align-items: start; flex-direction: column; }
  }
</style>
