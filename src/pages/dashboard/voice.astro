---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Voice Inbox">
  <div class="voice-shell">
    <header class="hero">
      <div>
        <div class="eyebrow">VOICE LOOP · PRIMARY</div>
        <h1>Voice Inbox</h1>
        <p>顧客の声を「集める」で止めず、改善・Case・Content・商品へ流す。ここがMASAの唯一の管理面です。</p>
      </div>
      <div class="canonical">PRIMARY<br /><strong>masahiroyamada.com/dashboard</strong></div>
    </header>

    <div id="voice-error" class="error" hidden></div>

    <section class="metrics" id="voice-metrics">
      <div class="metric"><span>NEW</span><strong>—</strong><small>未確認</small></div>
      <div class="metric"><span>SIGNAL</span><strong>—</strong><small>困った / 欲しい</small></div>
      <div class="metric"><span>OUTCOME</span><strong>—</strong><small>成果 / 好反応</small></div>
      <div class="metric"><span>PUBLIC</span><strong>—</strong><small>掲載許諾あり</small></div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div><div class="eyebrow">REPEATED SIGNALS</div><h2>繰り返し出ている声</h2></div>
        <span>theme / target × type</span>
      </div>
      <div id="voice-clusters" class="clusters"><div class="empty">読み込み中…</div></div>
    </section>

    <section class="filters">
      <input id="voice-query" type="search" placeholder="本文・Quest・テーマを検索" />
      <select id="voice-type">
        <option value="all">全タイプ</option>
        <option value="friction">困った</option><option value="request">欲しい</option>
        <option value="outcome">変わった</option><option value="praise">よかった</option>
        <option value="edit">修正</option><option value="add">追加</option><option value="note">メモ</option>
      </select>
      <select id="voice-status">
        <option value="all">全ステータス</option><option value="pending">新着</option>
        <option value="reviewing">検討中</option><option value="applied">反映済み</option><option value="dismissed">見送り</option>
      </select>
      <select id="voice-bucket">
        <option value="all">全ルート</option><option value="inbox">INBOX</option>
        <option value="improvement">改善</option><option value="case">Case</option>
        <option value="content">Content</option><option value="product">商品</option><option value="research">調査</option>
      </select>
      <div id="voice-count" class="count">—</div>
    </section>

    <section id="voice-list" class="voice-list"><div class="empty">Voiceを読み込み中…</div></section>
  </div>

  <style>
    .voice-shell{max-width:1180px;margin:0 auto}.hero{display:flex;justify-content:space-between;align-items:flex-start;gap:28px;margin-bottom:24px}.eyebrow{font-size:.68rem;letter-spacing:.22em;color:var(--gold-pure);font-weight:500}.hero h1{font-family:'Cormorant Garamond',serif;font-size:3rem;font-weight:400;color:var(--text-primary);margin-top:4px}.hero p{max-width:700px;color:var(--text-muted);line-height:1.8;margin-top:8px}.canonical{border:1px solid var(--border-accent);background:var(--gold-glow);padding:12px 14px;font-size:.68rem;color:var(--text-muted);line-height:1.6;text-align:right}.canonical strong{color:var(--gold-pure);font-weight:400}.error{border:1px solid rgba(220,80,80,.35);background:rgba(180,50,50,.08);padding:12px 14px;margin-bottom:16px;color:#dba8a0;font-size:.82rem}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.metric{border:1px solid var(--border-default);background:var(--bg-surface);padding:18px}.metric span{display:block;font-size:.65rem;letter-spacing:.18em;color:var(--gold-muted)}.metric strong{display:block;font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:400;color:var(--text-primary);margin-top:4px}.metric small{color:var(--text-muted);font-size:.7rem}.panel{border:1px solid var(--border-default);background:var(--bg-surface);padding:20px;margin-bottom:14px}.panel-head{display:flex;justify-content:space-between;align-items:end;gap:20px}.panel-head h2{font-family:'Cormorant Garamond',serif;font-size:1.55rem;font-weight:400;margin-top:4px}.panel-head>span{font-size:.68rem;color:var(--text-dim)}.clusters{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:15px}.cluster{border:1px solid var(--border-default);background:var(--bg-elevated);padding:14px;cursor:pointer;color:inherit;text-align:left;font-family:inherit}.cluster:hover{border-color:var(--border-hover)}.cluster-top{display:flex;justify-content:space-between;gap:10px;font-size:.65rem;color:var(--gold-muted)}.cluster-title{margin-top:7px;font-size:.84rem;line-height:1.55;color:var(--text-primary)}.cluster-meta{margin-top:6px;font-size:.65rem;color:var(--text-dim)}.filters{display:grid;grid-template-columns:minmax(220px,1fr) auto auto auto auto;gap:8px;border:1px solid var(--border-default);background:var(--bg-surface);padding:12px;margin-bottom:12px}.filters input,.filters select,.voice-card select,.voice-card input,.voice-card textarea{background:var(--bg-elevated);border:1px solid var(--border-default);color:var(--text-primary);font-family:inherit;padding:10px 11px;outline:none}.filters input:focus,.filters select:focus,.voice-card select:focus,.voice-card input:focus,.voice-card textarea:focus{border-color:var(--border-hover)}.count{display:flex;align-items:center;color:var(--text-dim);font-size:.72rem;padding:0 6px}.voice-list{display:grid;gap:10px}.voice-card{border:1px solid var(--border-default);background:var(--bg-surface);padding:18px}.voice-top{display:flex;justify-content:space-between;gap:18px}.tags{display:flex;flex-wrap:wrap;gap:6px}.tag{border:1px solid var(--border-default);padding:4px 7px;font-size:.62rem;color:var(--text-muted)}.tag.hot{border-color:var(--border-accent);color:var(--gold-pure);background:var(--gold-glow)}.voice-body{font-size:.92rem;line-height:1.75;color:var(--text-primary);margin-top:12px;white-space:pre-wrap}.voice-meta{font-size:.68rem;color:var(--text-dim);margin-top:9px;line-height:1.6}.edit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid var(--border-default)}.edit-grid label,.notes label{display:grid;gap:5px;font-size:.63rem;letter-spacing:.08em;color:var(--text-muted)}.notes{display:grid;grid-template-columns:1fr 1.5fr;gap:8px;margin-top:8px}.voice-card textarea{min-height:70px;resize:vertical}.save-row{display:flex;justify-content:flex-end;align-items:center;gap:10px;margin-top:9px}.save-state{font-size:.68rem;color:var(--text-dim)}.save{border:1px solid var(--border-accent);background:var(--gold-glow);color:var(--gold-pure);padding:9px 14px;font-family:inherit;cursor:pointer}.save:hover{border-color:var(--gold-muted)}.save:disabled{opacity:.45;cursor:wait}.empty{padding:22px;border:1px dashed var(--border-default);color:var(--text-dim);font-size:.8rem;text-align:center}.consent{color:#89a88e}.priority-P0{color:#df8b7c}.priority-P1{color:#d7aa70}
    @media(max-width:900px){.metrics{grid-template-columns:repeat(2,1fr)}.clusters{grid-template-columns:1fr 1fr}.filters{grid-template-columns:1fr 1fr}.filters input{grid-column:1/-1}.count{grid-column:1/-1}.edit-grid{grid-template-columns:1fr}.notes{grid-template-columns:1fr}.hero{display:block}.canonical{display:none}}
    @media(max-width:560px){.clusters{grid-template-columns:1fr}.voice-top{display:block}.voice-top time{display:block;margin-top:8px}.hero h1{font-size:2.35rem}}
  </style>

  <script>
    const TYPE_LABELS = {praise:'よかった',outcome:'変わった',friction:'困った',request:'欲しい',edit:'修正',add:'追加',note:'メモ'};
    const STATUS_LABELS = {pending:'新着',reviewing:'検討中',applied:'反映済み',dismissed:'見送り'};
    const BUCKET_LABELS = {inbox:'INBOX',improvement:'改善',case:'Case',content:'Content',product:'商品',research:'調査'};
    const PRIORITY_ORDER = {P0:0,P1:1,P2:2,P3:3};
    let items = [];
    const q = document.getElementById('voice-query');
    const typeFilter = document.getElementById('voice-type');
    const statusFilter = document.getElementById('voice-status');
    const bucketFilter = document.getElementById('voice-bucket');
    const list = document.getElementById('voice-list');
    const clustersEl = document.getElementById('voice-clusters');
    const errorEl = document.getElementById('voice-error');
    const countEl = document.getElementById('voice-count');

    const esc = (value='') => String(value).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const formatDate = value => { try { return new Date(value).toLocaleString('ja-JP',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}); } catch { return ''; } };
    const clusterId = item => item.clusterKey || item.theme || `${item.targetType}:${item.targetKey}:${item.feedbackType}`;
    const isPublic = value => value === 'anonymous_public' || value === 'named_public';

    function showError(text){ errorEl.textContent=text; errorEl.hidden=!text; }

    function updateMetrics(){
      const values = [
        items.filter(x=>x.status==='pending').length,
        items.filter(x=>['friction','request'].includes(x.feedbackType)&&x.status!=='dismissed').length,
        items.filter(x=>['outcome','praise'].includes(x.feedbackType)).length,
        items.filter(x=>isPublic(x.publicConsent)).length,
      ];
      document.querySelectorAll('#voice-metrics strong').forEach((el,i)=>el.textContent=String(values[i]??0));
    }

    function renderClusters(){
      const grouped = new Map();
      for(const item of items){
        const key=clusterId(item), current=grouped.get(key), open=['pending','reviewing'].includes(item.status)?1:0;
        if(!current) grouped.set(key,{key,label:item.theme||item.targetKey,type:item.feedbackType,count:1,open,latestAt:item.createdAt});
        else { current.count++; current.open+=open; if(item.createdAt>current.latestAt) current.latestAt=item.createdAt; }
      }
      const clusters=[...grouped.values()].sort((a,b)=>b.count-a.count||b.open-a.open||b.latestAt.localeCompare(a.latestAt)).slice(0,6);
      if(!clusters.length){ clustersEl.innerHTML='<div class="empty">Voiceが入ると、繰り返しシグナルがここに現れます。</div>'; return; }
      clustersEl.innerHTML=clusters.map(c=>`<button class="cluster" data-label="${esc(c.label)}" data-type="${esc(c.type)}"><div class="cluster-top"><span>${esc(TYPE_LABELS[c.type]||c.type)}</span><span>×${c.count}</span></div><div class="cluster-title">${esc(c.label)}</div><div class="cluster-meta">open ${c.open} · latest ${esc(formatDate(c.latestAt))}</div></button>`).join('');
      clustersEl.querySelectorAll('.cluster').forEach(btn=>btn.addEventListener('click',()=>{q.value=btn.dataset.label||'';typeFilter.value=btn.dataset.type||'all';renderList();}));
    }

    function option(value,label,current){ return `<option value="${esc(value)}" ${value===current?'selected':''}>${esc(label)}</option>`; }
    function card(item){
      const publicTag=isPublic(item.publicConsent)?'<span class="tag consent">PUBLIC OK</span>':'';
      return `<article class="voice-card" data-id="${esc(item.id)}">
        <div class="voice-top"><div class="tags"><span class="tag hot">${esc(TYPE_LABELS[item.feedbackType]||item.feedbackType)}</span><span class="tag priority-${esc(item.priority)}">${esc(item.priority)}</span><span class="tag">${esc(STATUS_LABELS[item.status]||item.status)}</span><span class="tag">${esc(BUCKET_LABELS[item.workflowBucket]||item.workflowBucket)}</span>${publicTag}</div><time class="voice-meta">${esc(formatDate(item.createdAt))}</time></div>
        <div class="voice-body">${esc(item.body)}</div>
        <div class="voice-meta">${esc(item.targetType)} · ${esc(item.targetKey)} · source: ${esc(item.source)}${item.theme?` · theme: ${esc(item.theme)}`:''}</div>
        <div class="edit-grid">
          <label>PRIORITY<select data-field="priority">${['P0','P1','P2','P3'].map(v=>option(v,v,item.priority)).join('')}</select></label>
          <label>STATUS<select data-field="status">${Object.entries(STATUS_LABELS).map(([v,l])=>option(v,l,item.status)).join('')}</select></label>
          <label>ROUTE<select data-field="workflowBucket">${Object.entries(BUCKET_LABELS).map(([v,l])=>option(v,l,item.workflowBucket)).join('')}</select></label>
        </div>
        <div class="notes"><label>THEME<input data-field="theme" value="${esc(item.theme||'')}" placeholder="テーマ" /></label><label>REVIEW NOTE<textarea data-field="reviewNote" placeholder="判断・次の一手">${esc(item.reviewNote||'')}</textarea></label></div>
        <div class="save-row"><span class="save-state"></span><button class="save" type="button">保存</button></div>
      </article>`;
    }

    function filteredItems(){
      const needle=(q.value||'').trim().toLowerCase();
      return [...items].filter(x=>typeFilter.value==='all'||x.feedbackType===typeFilter.value)
        .filter(x=>statusFilter.value==='all'||x.status===statusFilter.value)
        .filter(x=>bucketFilter.value==='all'||x.workflowBucket===bucketFilter.value)
        .filter(x=>!needle||[x.body,x.targetKey,x.targetType,x.theme||'',x.source].join(' ').toLowerCase().includes(needle))
        .sort((a,b)=>(PRIORITY_ORDER[a.priority]??9)-(PRIORITY_ORDER[b.priority]??9)||b.createdAt.localeCompare(a.createdAt));
    }

    function renderList(){
      const shown=filteredItems(); countEl.textContent=`${shown.length} / ${items.length} VOICE`;
      list.innerHTML=shown.length?shown.map(card).join(''):'<div class="empty">条件に合うVoiceはありません。</div>';
      list.querySelectorAll('.voice-card').forEach(el=>{
        const button=el.querySelector('.save'), state=el.querySelector('.save-state');
        button.addEventListener('click',async()=>{
          const id=el.dataset.id; const patch={};
          el.querySelectorAll('[data-field]').forEach(input=>patch[input.dataset.field]=input.value||null);
          button.disabled=true; state.textContent='保存中…'; showError('');
          try{
            const response=await fetch('/api/dashboard/voice',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,patch})});
            const result=await response.json(); if(!response.ok||!result.ok) throw new Error(result.error||'save_failed');
            items=items.map(x=>x.id===result.item.id?result.item:x); state.textContent='保存済み'; updateMetrics(); renderClusters();
          }catch(err){ state.textContent=''; showError(`保存できませんでした: ${err instanceof Error?err.message:String(err)}`); }
          finally{button.disabled=false;}
        });
      });
    }

    [q,typeFilter,statusFilter,bucketFilter].forEach(el=>el.addEventListener(el===q?'input':'change',renderList));

    async function boot(){
      try{
        const response=await fetch('/api/dashboard/voice',{headers:{Accept:'application/json'}}); const result=await response.json();
        if(!response.ok||!result.ok) throw new Error(result.error||'load_failed');
        items=Array.isArray(result.items)?result.items:[]; updateMetrics(); renderClusters(); renderList();
      }catch(err){ clustersEl.innerHTML='<div class="empty">読み込めませんでした。</div>'; list.innerHTML=''; showError(`Voice Inboxを読み込めませんでした: ${err instanceof Error?err.message:String(err)}`); }
    }
    void boot();
  </script>
</DashboardLayout>
