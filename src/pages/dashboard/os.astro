---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const phases = [
  { phase: '0', target: '月10万円', note: '労働を事業へ置換' },
  { phase: '1', target: '月30万円', note: 'ACE＋診断＋発信安定' },
  { phase: '2', target: '月100万円', note: '継続課金・アフィリ・複数商品' },
  { phase: '3', target: '月300万円', note: 'B2B・SYSTEM・チーム化' },
  { phase: '4', target: '月833万円', note: '年商1億｜単一収益源30%以下' },
];

const revenueLayers = [
  { no: '01', name: 'EARN', detail: 'TIME · KNOWLEDGE · MEDIA' },
  { no: '02', name: 'COMPOUND', detail: 'COMMUNITY · IP · PRODUCT' },
  { no: '03', name: 'SCALE', detail: 'PLACE · SYSTEM · B2B' },
  { no: '04', name: 'CAPITAL', detail: '株・ETF・不動産等' },
];

const commands = [
  ['今日一番大事なのやって', 'RUN 司令塔'],
  ['朝会', 'RUN 司令塔'],
  ['今週レビューして', 'RUN 司令塔'],
  ['適任に任せて', 'RUN Specialist'],
  ['自律実行で', 'RUN Specialist'],
  ['SOURCE INBOXを全部処理して', 'RUN INBOX'],
  ['これ資産化して', 'ASK 資産化'],
  ['これ処理して', 'ASK 資産化'],
  ['これ検証して', 'ASK 調査'],
  ['これXにして', 'ASK 発信'],
  ['品質優先で', 'ASK Prompt Palette'],
  ['改善TOP3出して', 'ASK Prompt Palette'],
  ['SCHEDULE更新して', 'RUN Schedule'],
];

const canonicalMap = [
  { legacy: 'Project Map', canonical: 'Brain Graph', href: '/dashboard/graph', note: 'ProjectだけでなくKnowledge・Human・Product・Distributionまで接続して俯瞰する。' },
  { legacy: 'Work Map / Flow Board', canonical: 'Quest + Calendar', href: '/dashboard/quest', note: '実行はQuest、固定制約はCalendarへ分離する。' },
  { legacy: 'Recent Activity', canonical: 'Graph Notes / OS Metrics', href: '/dashboard/graph', note: '活動履歴を単独画面にせず、各正本側のEvidence・Notesへ戻す。' },
  { legacy: 'Command Center', canonical: 'Command Presets', href: '#command-presets', note: '旧13プリセットをこのページへ退避。UX改善時に司令塔へ統合する。' },
  { legacy: 'Want to Map', canonical: 'Want to 正本Sheet + Graph', href: '#source-sheets', note: '正本Sheetを維持し、GraphのWANT TOノードと接続する。' },
  { legacy: 'Asset Index', canonical: 'Drive / Knowledge / Asset Flow', href: '/dashboard/graph', note: '旧画面の同期待ち一覧ではなく、正本資産とAsset Flowへ接続する。' },
];
---

<DashboardLayout title="MASA OS Bridge">
  <div class="os-shell">
    <header class="hero">
      <div>
        <p class="eyebrow">MASA OS · CANONICAL BRIDGE</p>
        <h1>旧Dashboardの価値だけ、<span>正本へ。</span></h1>
        <p class="lead">masa-os-dashboard.pages.dev の独自UIは引き継がない。残す価値がある設計・導線・コマンドだけを masahiroyamada.com/dashboard 配下へ統合する。</p>
      </div>
      <a class="back" href="/dashboard">Dashboardへ戻る →</a>
    </header>

    <section class="section">
      <div class="section-head">
        <div><p class="kicker">MIGRATION MAP</p><h2>旧機能 → 現在の正本</h2></div>
        <p class="note">旧画面を残すためのページではなく、統合判断の橋渡し。</p>
      </div>
      <div class="map-grid">
        {canonicalMap.map(item => (
          <a class="map-card" href={item.href}>
            <span class="legacy">{item.legacy}</span>
            <span class="arrow">→</span>
            <strong>{item.canonical}</strong>
            <p>{item.note}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="source-sheets">
      <div class="section-head">
        <div><p class="kicker">SOURCE OF TRUTH</p><h2>旧Dashboardが参照していた正本Sheet</h2></div>
      </div>
      <div class="sheet-grid">
        <a class="sheet-card" href="https://docs.google.com/spreadsheets/d/1_Z_EmfRaIN5iW8mCBj5PF1Yn8D-zFFQbfw_ko45zVV0/edit" target="_blank" rel="noopener noreferrer">
          <span>WEALTH / ENGINE MAP</span><strong>正本Sheet ↗</strong>
        </a>
        <a class="sheet-card" href="https://docs.google.com/spreadsheets/d/1gkYpIk28ScWY5xlFfkjyyBVa0Cmx3pl_oQuJ5sC8ij4/edit" target="_blank" rel="noopener noreferrer">
          <span>WANT TO MAP</span><strong>正本Sheet ↗</strong>
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><p class="kicker">WEALTH ENGINE</p><h2>成長フェーズ</h2></div>
      </div>
      <div class="phase-grid">
        {phases.map(item => (
          <article class="phase-card"><span>{item.phase}</span><strong>{item.target}</strong><p>{item.note}</p></article>
        ))}
      </div>
      <div class="layer-grid">
        {revenueLayers.map(item => (
          <article class="layer-card"><span>{item.no}</span><strong>{item.name}</strong><p>{item.detail}</p></article>
        ))}
      </div>
    </section>

    <section class="section" id="command-presets">
      <div class="section-head">
        <div><p class="kicker">COMMAND CENTER</p><h2>旧13プリセットを救出</h2></div>
        <p class="note">押すと文言をコピー。UX改善時に常設Commandへ統合する。</p>
      </div>
      <div class="command-grid">
        {commands.map(([label, category]) => (
          <button class="command-card" type="button" data-command={label}>
            <span>{category}</span><strong>{label}</strong><em>コピー</em>
          </button>
        ))}
      </div>
      <p class="copy-status" id="copy-status" aria-live="polite"></p>
    </section>
  </div>

  <script>
    const status = document.getElementById('copy-status');
    document.querySelectorAll('[data-command]').forEach((button) => {
      button.addEventListener('click', async () => {
        const text = button.getAttribute('data-command') || '';
        try {
          await navigator.clipboard.writeText(text);
          if (status) status.textContent = `コピーしました：${text}`;
        } catch {
          if (status) status.textContent = `コピーできませんでした：${text}`;
        }
      });
    });
  </script>
</DashboardLayout>

<style>
  .os-shell{max-width:1320px;margin:0 auto;padding-bottom:64px}.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;padding:14px 0 38px;border-bottom:1px solid var(--border-default)}.eyebrow,.kicker{color:var(--gold-muted);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;font-weight:500}h1{margin-top:8px;font-family:'Cormorant Garamond',serif;font-weight:300;font-size:clamp(2.2rem,4vw,4rem);line-height:1;color:var(--text-primary)}h1 span{color:var(--gold-pure)}.lead{max-width:820px;margin-top:18px;color:var(--text-muted);font-size:.9rem;line-height:1.9}.back{flex-shrink:0;color:var(--gold-pure);text-decoration:none;border:1px solid var(--border-accent);padding:11px 16px;font-size:.78rem}.section{margin-top:46px}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}.section h2{margin-top:4px;font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:300}.note{color:var(--text-dim);font-size:.76rem}.map-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.map-card{display:grid;grid-template-columns:auto 22px 1fr;align-items:center;gap:8px;padding:18px;border:1px solid var(--border-default);background:var(--bg-surface);text-decoration:none;color:inherit}.map-card:hover{border-color:var(--border-hover);background:var(--bg-elevated)}.map-card .legacy{color:var(--text-muted);font-size:.75rem}.map-card .arrow{color:var(--gold-dim)}.map-card strong{color:var(--gold-pure);font-size:.85rem}.map-card p{grid-column:1/-1;color:var(--text-muted);font-size:.75rem;line-height:1.65;margin-top:8px}.sheet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.sheet-card{display:flex;justify-content:space-between;gap:16px;padding:20px;border:1px solid var(--border-accent);background:var(--gold-glow);text-decoration:none}.sheet-card span{color:var(--text-muted);font-size:.72rem;letter-spacing:.08em}.sheet-card strong{color:var(--gold-pure);font-size:.82rem}.phase-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.phase-card,.layer-card{padding:18px;border:1px solid var(--border-default);background:var(--bg-surface)}.phase-card span,.layer-card span{display:block;color:var(--gold-dim);font-family:'Cormorant Garamond',serif;font-size:1.2rem}.phase-card strong,.layer-card strong{display:block;margin-top:10px;color:var(--text-primary);font-size:.9rem}.phase-card p,.layer-card p{margin-top:7px;color:var(--text-muted);font-size:.72rem;line-height:1.6}.layer-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:10px}.command-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.command-card{display:flex;min-height:116px;flex-direction:column;align-items:flex-start;text-align:left;padding:16px;border:1px solid var(--border-default);background:var(--bg-surface);color:inherit;cursor:pointer;font:inherit}.command-card:hover{border-color:var(--border-hover);background:var(--bg-elevated)}.command-card span{color:var(--gold-muted);font-size:.62rem;letter-spacing:.08em}.command-card strong{margin-top:10px;color:var(--text-primary);font-size:.86rem;font-weight:500}.command-card em{margin-top:auto;color:var(--gold-pure);font-size:.66rem;font-style:normal}.copy-status{min-height:1.4em;margin-top:12px;color:var(--gold-muted);font-size:.72rem}@media(max-width:1000px){.map-grid,.command-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.phase-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.layer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.hero,.section-head{align-items:flex-start;flex-direction:column}.back{width:100%;text-align:center}.map-grid,.sheet-grid,.phase-grid,.layer-grid,.command-grid{grid-template-columns:1fr}}
</style>
