  .source-link:hover { border-color: var(--gold-muted); background: var(--gold-glow); }
  .flow-card { margin-top: 18px; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 9px; padding: 15px; border: 1px solid var(--border-default); background: var(--bg-surface); }
  .flow-card span { color: var(--text-muted); font-size: .65rem; letter-spacing: .1em; border: 1px solid var(--border-default); padding: 6px 9px; }
  .flow-card i { color: var(--gold-dim); font-style: normal; }
  .section-block { margin-top: 34px; }
  .section-head, .panel-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 16px; }
  .section-head h2, .panel h2 { margin-top: 4px; font-family: 'Cormorant Garamond', serif; font-size: 1.9rem; font-weight: 300; }
  .section-head > p { max-width: 520px; color: var(--text-dim); font-size: .74rem; text-align: right; }
  .type-grid { display: grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap: 10px; }
  .type-card { min-height: 132px; display: flex; flex-direction: column; gap: 7px; align-items: flex-start; text-align: left; padding: 16px; border: 1px solid var(--border-default); background: var(--bg-surface); color: inherit; cursor: pointer; transition: transform .18s, border-color .18s, background .18s; }
  .type-card:hover { transform: translateY(-2px); border-color: var(--border-hover); }
  .type-card.is-active { border-color: var(--gold-muted); background: var(--gold-glow); }
  .type-icon { color: var(--gold-pure); font-size: 1.4rem; }
  .type-card strong { color: var(--text-primary); font-size: .78rem; font-weight: 500; }
  .type-card small { color: var(--text-muted); font-size: .66rem; line-height: 1.55; }
  .workspace { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(380px,.85fr); gap: 14px; margin-top: 14px; align-items: start; }
  .input-stack { display: grid; gap: 14px; }
  .panel { padding: 20px; border: 1px solid var(--border-default); background: var(--bg-surface); }
  .output-panel { position: sticky; top: 18px; }
  .save-state, .type-badge { color: var(--gold-muted); font-size: .62rem; border: 1px solid var(--border-default); padding: 5px 8px; letter-spacing: .08em; }
  .preset-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
  select, input, textarea { width: 100%; border: 1px solid var(--border-default); background: var(--bg-void); color: var(--text-primary); padding: 11px 12px; font-family: inherit; font-size: .8rem; outline: none; }
  select:focus, input:focus, textarea:focus { border-color: var(--gold-muted); }
  button { border: 1px solid var(--border-default); background: var(--bg-elevated); color: var(--text-muted); padding: 10px 13px; cursor: pointer; font-family: inherit; font-size: .76rem; }
  button:hover { color: var(--text-primary); border-color: var(--border-hover); }
  button.primary { color: var(--bg-void); background: var(--gold-pure); border-color: var(--gold-pure); font-weight: 500; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; }
