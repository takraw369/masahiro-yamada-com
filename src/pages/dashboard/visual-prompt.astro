  @media (max-width: 1160px) { .type-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } .workspace { grid-template-columns: 1fr; } .output-panel { position: static; } .prompt-output { min-height: 390px; } }
  @media (max-width: 640px) { .prompt-hero { align-items: flex-start; flex-direction: column; } .source-link { width: 100%; text-align: center; } .section-head { align-items: flex-start; flex-direction: column; } .section-head > p { text-align: left; } .type-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } .form-grid { grid-template-columns: 1fr; } .field.full { grid-column: auto; } .preset-row { grid-template-columns: 1fr; } }
