---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import VisualStructureThumbnail from '../../components/dashboard/VisualStructureThumbnail.astro';
import { visualStructureTemplates } from '../../data/visualStructureTemplates';

const first = visualStructureTemplates[0];
---

<DashboardLayout title="Visual Builder" eyebrow="C109 · CONVERSATION → VISUAL">
  <div class="builder-shell">
    <header class="hero">
      <div>
        <p class="kicker">TEMPLATE IMAGE × NATURAL LANGUAGE</p>
        <h1>Visual <span>Builder</span></h1>
        <p class="lead">見本を選んで、普通に話すだけ。細かいPrompt入力はAI側へ寄せる。</p>
      </div>
      <div class="hero-links">
        <a href="https://docs.google.com/document/d/14YNs-i12AglPejN2aWNRzVUIPiQCYRR07cUrYHoH7Kk/edit" target="_blank" rel="noopener noreferrer">C109 正本 ↗</a>
        <a href="https://drive.google.com/file/d/1uFVr-CYpT2rTh8BKRdMmxOgwSJDwfmiA/view" target="_blank" rel="noopener noreferrer">Prompt Library ↗</a>
      </div>
    </header>

    <section class="flow" aria-label="制作フロー">
      <span>CHAT / IDEA</span><i>→</i><span>NATURAL LANGUAGE</span><i>→</i><span>STRUCTURE</span><i>→</i><span>PROMPT</span><i>→</i><span>VISUAL</span><i>→</i><span>ACE / SNS / NOTE</span>
    </section>

    <section class="request-panel">
      <div class="section-head">
        <div>
          <p class="kicker">01 · SAY IT</p>
          <h2>何を作りたい？</h2>
        </div>
        <span class="save-state">端末内に自動保存</span>
      </div>

      <textarea
        id="naturalRequest"
        rows="6"
        placeholder="例：この会話の『チャット→正本→資料→ACE本棚』の流れを、AIに詳しくない人でも一目で分かる1枚図解に。シャンパンタワーかFLOWっぽい見せ方で、難しい言葉は減らして。"
      ></textarea>

      <div class="quick-row">
        <label>
          <span>用途</span>
          <select id="purpose">
            <option value="SNS図解">SNS図解</option>
            <option value="note図解">note図解</option>
            <option value="ACE教材">ACE教材</option>
            <option value="講座スライド">講座スライド</option>
            <option value="YouTubeサムネ">YouTubeサムネ</option>
            <option value="自由">自由</option>
          </select>
        </label>
        <label>
          <span>比率</span>
          <select id="ratio">
            <option value="1:1">1:1</option>
            <option value="16:9">16:9</option>
            <option value="9:16">9:16</option>
            <option value="A4縦">A4縦</option>
          </select>
        </label>
        <button id="recommend" class="primary" type="button">AI向けに型を選ぶ</button>
      </div>
      <p id="recommendStatus" class="status" aria-live="polite"></p>
    </section>

    <section class="template-section">
      <div class="section-head">
        <div>
          <p class="kicker">02 · CHOOSE</p>
          <h2>見本画像から選ぶ</h2>
        </div>
        <p>おすすめが違えば、好きな型をクリックするだけ。</p>
      </div>

      <div class="template-grid" id="templateGrid">
        {visualStructureTemplates.map((template, index) => (
          <button
            class:list={['template-card', index === 0 && 'is-active']}
            type="button"
            data-template-id={template.id}
            data-name={template.name}
            data-image={template.image}
            data-best-for={template.bestFor.join(' / ')}
            data-structure={template.structure}
            data-prompt-hint={template.promptHint}
            data-tags={template.tags.join(' / ')}
          >
            <div class="thumb"><VisualStructureThumbnail id={template.id} /></div>
            <div class="card-copy">
              <span>{template.id}</span>
              <strong>{template.name}</strong>
              <small>{template.bestFor.slice(0, 3).join(' · ')}</small>
            </div>
          </button>
        ))}
      </div>
    </section>

    <section class="build-section">
      <div class="selected-panel">
        <div class="section-head compact">
          <div>
            <p class="kicker">03 · STRUCTURE</p>
            <h2 id="selectedName">{first.name}</h2>
          </div>
          <span id="selectedId" class="badge">{first.id}</span>
        </div>
        <p id="selectedImage" class="visual-image">{first.image}</p>
        <dl>
          <div><dt>向いている内容</dt><dd id="selectedBest">{first.bestFor.join(' / ')}</dd></div>
          <div><dt>構造ルール</dt><dd id="selectedStructure">{first.structure}</dd></div>
        </dl>
      </div>

      <div class="output-panel">
        <div class="section-head compact">
          <div>
            <p class="kicker">04 · BUILD</p>
            <h2>完成Prompt</h2>
          </div>
          <span class="engine-note">ChatGPT / Gemini / Canva / Figma</span>
        </div>
        <div class="actions">
          <button id="generate" class="primary" type="button">Prompt生成</button>
          <button id="copy" type="button">コピー</button>
          <button id="reset" type="button">リセット</button>
        </div>
        <textarea id="promptOutput" rows="18" readonly placeholder="自然言語で頼みたいことを書いて、型を選ぶだけ。"></textarea>
        <p id="outputStatus" class="status" aria-live="polite"></p>
      </div>
    </section>

    <section class="ace-note">
      <div>
        <p class="kicker">CONVERSATION → ACE</p>
        <h2>価値ある会話は、ここで終わらせない</h2>
      </div>
      <p>Chatで「資産化」「ACE化」「本棚へ」と指示 → 正本化 → CONTENT_OS → 教材Draft → Visual → Human Gate → ACE Shelf。C109がこの入口の正本。</p>
    </section>
  </div>
</DashboardLayout>

<script>
  const STORAGE_KEY = 'masaVisualBuilderV2';
  const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.template-card'));
  const requestEl = document.getElementById('naturalRequest') as HTMLTextAreaElement;
  const purposeEl = document.getElementById('purpose') as HTMLSelectElement;
  const ratioEl = document.getElementById('ratio') as HTMLSelectElement;
  const outputEl = document.getElementById('promptOutput') as HTMLTextAreaElement;
  const recommendStatus = document.getElementById('recommendStatus') as HTMLElement;
  const outputStatus = document.getElementById('outputStatus') as HTMLElement;
  let selectedId = cards[0]?.dataset.templateId || 'S01';

  type StoredState = {
    request?: string;
    purpose?: string;
    ratio?: string;
    selectedId?: string;
  };

  function currentCard() {
    return cards.find((card) => card.dataset.templateId === selectedId) || cards[0];
  }

  function saveState() {
    const state: StoredState = {
      request: requestEl.value,
      purpose: purposeEl.value,
      ratio: ratioEl.value,
      selectedId,
    };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function loadState(): StoredState {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') as StoredState; }
    catch { return {}; }
  }

  function setSelected(id: string, message = '') {
    const card = cards.find((item) => item.dataset.templateId === id) || cards[0];
    if (!card) return;
    selectedId = card.dataset.templateId || 'S01';
    cards.forEach((item) => item.classList.toggle('is-active', item === card));
    (document.getElementById('selectedId') as HTMLElement).textContent = selectedId;
    (document.getElementById('selectedName') as HTMLElement).textContent = card.dataset.name || '';
    (document.getElementById('selectedImage') as HTMLElement).textContent = card.dataset.image || '';
    (document.getElementById('selectedBest') as HTMLElement).textContent = card.dataset.bestFor || '';
    (document.getElementById('selectedStructure') as HTMLElement).textContent = card.dataset.structure || '';
    if (message) recommendStatus.textContent = message;
    saveState();
    buildPrompt(false);
  }

  function heuristicId(text: string) {
    const rules: Array<[RegExp, string]> = [
      [/シャンパン|自分.*家族|家族.*地域|人づくり|波及/, 'S03'],
      [/資産化|源流|流れ|flow|会話.*資料|チャット.*資産|本棚/, 'S16'],
      [/循環|フライホイール|複利|回す|ループ/, 'S06'],
      [/今.*次.*将来|ロードマップ|工程|手順|フェーズ|時間軸/, 'S04'],
      [/os|レイヤー|基盤|仕組み|システム層/, 'S09'],
      [/before|after|ビフォー|アフター|変化|変容|橋/, 'S11'],
      [/氷山|見える.*見えない|表面|水面|原因/, 'S08'],
      [/quest|rpg|冒険|ゲーム|ステージ/, 'S12'],
      [/根|ルーツ|系譜|歴史.*思想|原体験/, 'S13'],
      [/脳|神経|ネットワーク|知識.*接続/, 'S10'],
      [/商品.*階層|入口.*中核|ピラミッド|山/, 'S02'],
      [/複数.*project|路線|乗換|統合.*活動/, 'S05'],
      [/生態系|コミュニティ|森|相互.*支える/, 'S07'],
      [/全体像|俯瞰|基地|map|マップ/, 'S01'],
    ];
    for (const [pattern, id] of rules) if (pattern.test(text)) return id;
    return '';
  }

  function recommendTemplate() {
    const raw = requestEl.value.trim();
    if (!raw) {
      recommendStatus.textContent = 'まず普通の言葉で「何を作りたいか」を書いてください。';
      requestEl.focus();
      return;
    }

    const normalized = raw.toLowerCase();
    const direct = heuristicId(normalized);
    if (direct && cards.some((card) => card.dataset.templateId === direct)) {
      const name = cards.find((card) => card.dataset.templateId === direct)?.dataset.name || direct;
      setSelected(direct, `おすすめ：${direct}｜${name}。違えば好きな見本を選べます。`);
      return;
    }

    const tokens = normalized
      .split(/[\s、。,.!！?？「」『』（）()／/→・：:]+/)
      .map((token) => token.trim())
      .filter((token) => token.length >= 2);

    let best = cards[0];
    let bestScore = -1;
    cards.forEach((card) => {
      const haystack = [card.dataset.name, card.dataset.image, card.dataset.bestFor, card.dataset.structure, card.dataset.tags]
        .filter(Boolean).join(' ').toLowerCase();
      const score = tokens.reduce((sum, token) => sum + (haystack.includes(token) ? 2 : 0), 0);
      if (score > bestScore) { best = card; bestScore = score; }
    });

    const id = best?.dataset.templateId || 'S01';
    setSelected(id, `おすすめ：${id}｜${best?.dataset.name || ''}。見た目で別の型に変えてOKです。`);
  }

  function buildPrompt(showStatus = true) {
    const card = currentCard();
    if (!card) return;
    const request = requestEl.value.trim() || '[ここに作りたい内容を自然言語で書く]';
    const purpose = purposeEl.value;
    const ratio = ratioEl.value;

    outputEl.value = `以下の自然言語リクエストを理解し、内容を整理したうえで、1つの完成ビジュアルを作成してください。\n\n【ユーザーの依頼】\n${request}\n\n【用途】\n${purpose}\n\n【サイズ / 比率】\n${ratio}\n\n【採用する構造テンプレ】\n${card.dataset.templateId || ''}｜${card.dataset.name || ''}\n\n【構造ルール】\n${card.dataset.structure || ''}\n\n【見た目の方向】\n${card.dataset.image || ''}\n\n【構図キーワード】\n${card.dataset.promptHint || ''}\n\n【AI側で補完すること】\n・依頼文から主題を1つに絞る\n・日本語タイトルを短く提案する\n・要点を3〜7個に整理する\n・足りない細部は文脈から安全に補完する\n・事実として確認できない数値・固有情報は勝手に作らず、必要なら曖昧表現またはプレースホルダーにする\n・長文を画像内へ詰め込まず、短い見出し中心にする\n\n【制作ルール】\n・3秒で主題、10秒で全体構造が分かる\n・装飾より構造を優先する\n・日本語テキストは読みやすく、崩さない\n・矢印、位置、余白、サイズ差で関係性を見せる\n・スマホ表示でも主要文字が読める\n・ACE / Sun Loves Flow文脈では、落ち着いた知性と身体性が伝わる表現を優先する\n\nまず依頼内容を内部で整理してから、最終ビジュアルを生成してください。`;

    saveState();
    if (showStatus) outputStatus.textContent = '完成Promptを作りました。画像AIへそのまま渡せます。';
  }

  async function copyPrompt() {
    if (!outputEl.value) buildPrompt(false);
    try {
      await navigator.clipboard.writeText(outputEl.value);
      outputStatus.textContent = 'コピーしました。';
    } catch {
      outputEl.focus();
      outputEl.select();
      document.execCommand('copy');
      outputStatus.textContent = 'コピーしました。';
    }
  }

  function resetAll() {
    requestEl.value = '';
    purposeEl.value = 'SNS図解';
    ratioEl.value = '1:1';
    outputEl.value = '';
    recommendStatus.textContent = '';
    outputStatus.textContent = '';
    setSelected(cards[0]?.dataset.templateId || 'S01');
    localStorage.removeItem(STORAGE_KEY);
    requestEl.focus();
  }

  cards.forEach((card) => card.addEventListener('click', () => {
    setSelected(card.dataset.templateId || 'S01', `選択：${card.dataset.templateId}｜${card.dataset.name}`);
  }));
  requestEl.addEventListener('input', () => { saveState(); buildPrompt(false); });
  purposeEl.addEventListener('change', () => { saveState(); buildPrompt(false); });
  ratioEl.addEventListener('change', () => { saveState(); buildPrompt(false); });
  (document.getElementById('recommend') as HTMLButtonElement).addEventListener('click', recommendTemplate);
  (document.getElementById('generate') as HTMLButtonElement).addEventListener('click', () => buildPrompt(true));
  (document.getElementById('copy') as HTMLButtonElement).addEventListener('click', copyPrompt);
  (document.getElementById('reset') as HTMLButtonElement).addEventListener('click', resetAll);

  const stored = loadState();
  if (stored.request) requestEl.value = stored.request;
  if (stored.purpose && Array.from(purposeEl.options).some((option) => option.value === stored.purpose)) purposeEl.value = stored.purpose;
  if (stored.ratio && Array.from(ratioEl.options).some((option) => option.value === stored.ratio)) ratioEl.value = stored.ratio;
  setSelected(stored.selectedId || selectedId);
  if (requestEl.value) buildPrompt(false);
</script>

<style>
  .builder-shell { display: grid; gap: 26px; }
  .hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding-bottom: 22px; border-bottom: 1px solid #d8d4cd; }
  .kicker { color: #8b5b2c; font-size: .68rem; font-weight: 700; letter-spacing: .12em; }
  .hero h1 { margin-top: 6px; font-size: clamp(2rem, 5vw, 4rem); line-height: .98; letter-spacing: -.04em; }
  .hero h1 span { color: #a56c22; }
  .lead { max-width: 720px; margin-top: 12px; color: #626b75; font-size: 1rem; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .hero-links a { padding: 10px 12px; border: 1px solid #cfc8bd; background: #fff; color: #754a16; text-decoration: none; font-size: .75rem; }
  .flow { display: flex; align-items: center; gap: 8px; overflow-x: auto; padding: 12px 16px; border: 1px solid #ddd8d0; background: #fbfaf8; color: #68707a; font-size: .7rem; letter-spacing: .06em; white-space: nowrap; }
  .flow i { color: #b79c75; font-style: normal; }
  .request-panel, .selected-panel, .output-panel, .ace-note { padding: 22px; border: 1px solid #d8d4cd; background: #fff; }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 14px; }
  .section-head.compact { align-items: center; }
  .section-head h2 { margin-top: 3px; font-size: 1.18rem; }
  .section-head > p, .save-state, .engine-note { color: #7a8189; font-size: .72rem; }
  #naturalRequest, #promptOutput { width: 100%; resize: vertical; border: 1px solid #cfc8bd; background: #fbfaf8; color: #24282d; padding: 16px; font: inherit; line-height: 1.7; }
  #naturalRequest { min-height: 150px; font-size: 1rem; }
  #promptOutput { min-height: 390px; font-size: .82rem; }
  #naturalRequest:focus, #promptOutput:focus, select:focus { outline: 2px solid rgba(165,108,34,.28); border-color: #a56c22; }
  .quick-row { display: grid; grid-template-columns: minmax(130px, 180px) minmax(100px, 140px) minmax(160px, max-content); gap: 10px; align-items: end; margin-top: 12px; }
  label { display: grid; gap: 5px; color: #626b75; font-size: .7rem; }
  select { min-height: 44px; border: 1px solid #cfc8bd; background: #fff; padding: 0 10px; color: #343a40; }
  button { min-height: 44px; border: 1px solid #cfc8bd; background: #fff; color: #555f69; padding: 0 14px; cursor: pointer; }
  button:hover { border-color: #b58a53; color: #2f3439; }
  button.primary { border-color: #9b6727; background: #a56c22; color: #fff; font-weight: 700; }
  .status { min-height: 1.2em; margin-top: 8px; color: #7c5a2a; font-size: .76rem; }
  .template-section { display: grid; gap: 8px; }
  .template-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .template-card { display: grid; grid-template-rows: 130px auto; min-height: 220px; padding: 0; text-align: left; overflow: hidden; background: #fff; }
  .template-card.is-active { border: 2px solid #a56c22; box-shadow: 0 0 0 3px rgba(165,108,34,.08); }
  .thumb { display: grid; place-items: center; min-height: 130px; padding: 10px; overflow: hidden; background: #f4f1ec; border-bottom: 1px solid #e2ded7; }
  .thumb :global(svg) { width: 100%; height: 110px; }
  .card-copy { display: grid; gap: 4px; padding: 10px 11px 12px; }
  .card-copy span { color: #a56c22; font-size: .63rem; font-weight: 700; }
  .card-copy strong { color: #33383e; font-size: .82rem; }
  .card-copy small { color: #7c838b; font-size: .65rem; line-height: 1.45; }
  .build-section { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 16px; }
  .badge { padding: 5px 8px; border: 1px solid #dcc9aa; background: #f7efe3; color: #754a16; font-size: .68rem; font-weight: 700; }
  .visual-image { padding: 12px 14px; background: #f8f5f0; color: #535d67; font-size: .82rem; line-height: 1.7; }
  dl { display: grid; gap: 12px; margin-top: 16px; }
  dl div { display: grid; gap: 3px; padding-top: 10px; border-top: 1px solid #ece8e1; }
  dt { color: #8b5b2c; font-size: .67rem; font-weight: 700; }
  dd { color: #5f6872; font-size: .78rem; line-height: 1.65; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .ace-note { display: grid; grid-template-columns: minmax(230px, .7fr) minmax(0, 1.3fr); gap: 24px; align-items: center; border-color: #d7c7ad; background: #fbf6ee; }
  .ace-note h2 { margin-top: 4px; font-size: 1.08rem; }
  .ace-note > p { color: #675f55; font-size: .82rem; line-height: 1.75; }

  @media (max-width: 1050px) {
    .template-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .build-section { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero { align-items: flex-start; flex-direction: column; }
    .hero-links { justify-content: flex-start; }
    .quick-row { grid-template-columns: 1fr 1fr; }
    .quick-row .primary { grid-column: 1 / -1; }
    .template-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .template-card { grid-template-rows: 110px auto; min-height: 200px; }
    .thumb { min-height: 110px; }
    .thumb :global(svg) { height: 92px; }
    .ace-note { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) {
    .template-grid { grid-template-columns: 1fr; }
    .template-card { grid-template-columns: 132px 1fr; grid-template-rows: 1fr; min-height: 132px; }
    .thumb { min-height: 132px; border-bottom: 0; border-right: 1px solid #e2ded7; }
    .quick-row { grid-template-columns: 1fr; }
    .quick-row .primary { grid-column: auto; }
  }
</style>
