<script define:vars={{ questions, totalSets }}>
const KEY='masa-design-lab-v0.2';
let state={selections:{},activeSet:1,savedSets:[]};
try{state={...state,...JSON.parse(localStorage.getItem(KEY)||'{}')}}catch{}
const $=(s)=>document.querySelector(s); const $$=(s)=>[...document.querySelectorAll(s)];
const note=$('#taste-note'), save=$('#save-set'), status=$('#save-status');
function persist(){localStorage.setItem(KEY,JSON.stringify(state))}
function setQuestions(set){return questions.filter(q=>q.set===set)}
function answered(set){return setQuestions(set).filter(q=>state.selections[q.id]).length}
function render(){
  const set=Math.min(Math.max(Number(state.activeSet)||1,1),totalSets); state.activeSet=set; persist();
  $$('.experiment').forEach(el=>el.hidden=Number(el.dataset.set)!==set);
  $$('.set-nav button').forEach(b=>{const n=Number(b.dataset.setJump);b.classList.toggle('active',n===set);b.classList.toggle('complete',answered(n)===setQuestions(n).length)});
  const all=Object.keys(state.selections).length; $('#all-count').textContent=String(all); $('#all-bar').style.width=`${Math.round(all/questions.length*100)}%`; $('#resume-copy').textContent=`SET ${set} · ${answered(set)} / ${setQuestions(set).length}`; $('#set-number').textContent=String(set);
  const list=$('#summary-list'); list.innerHTML=''; setQuestions(set).forEach(q=>{const row=document.createElement('div');row.className='summary-row'+(state.selections[q.id]?' done':'');row.innerHTML=`<span>${q.label}</span><strong>${state.selections[q.id]?.name||'未選択'}</strong>`;list.appendChild(row)});
  $$('.choice').forEach(c=>{const v=state.selections[c.dataset.question];const on=v?.option===c.dataset.option;c.setAttribute('aria-pressed',on?'true':'false');const badge=c.querySelector('.choice-state');if(badge)badge.textContent=on?'選択中 ✓':'選ぶ'});
  const remain=setQuestions(set).length-answered(set); save.disabled=remain>0; save.textContent=remain?`あと${remain}つ選ぶ`:state.savedSets.includes(set)?'このSETは保存済み':'この5問を保存';
  $('#prev-set').disabled=set===1; $('#next-set').disabled=set===totalSets; $('#next-set').textContent=set===totalSets?'ここまで完了':`次の5問 →`;
}
$$('.choice').forEach(c=>c.addEventListener('click',()=>{const q=c.dataset.question;const question=questions.find(x=>x.id===q);state.selections[q]={option:c.dataset.option,name:c.dataset.name};state.savedSets=(state.savedSets||[]).filter(s=>s!==question.set);persist();status.textContent='この端末に保持しました。';render()}));
$$('[data-set-jump]').forEach(b=>b.addEventListener('click',()=>{state.activeSet=Number(b.dataset.setJump);persist();status.textContent='';render();window.scrollTo({top:0,behavior:'smooth'})}));
$('#prev-set').addEventListener('click',()=>{if(state.activeSet>1){state.activeSet--;persist();render();window.scrollTo({top:0,behavior:'smooth'})}});$('#next-set').addEventListener('click',()=>{if(state.activeSet<totalSets){state.activeSet++;persist();render();window.scrollTo({top:0,behavior:'smooth'})}});
async function saveSet(){const set=state.activeSet;if(answered(set)!==setQuestions(set).length)return;save.disabled=true;status.textContent='保存中…';const subset={};setQuestions(set).forEach(q=>subset[q.id]=state.selections[q.id]);const snapshot={type:'design_preference_set',version:'0.2',set,selections:subset,note:note.value.trim(),created_at:new Date().toISOString()};try{const r=await fetch('/api/dashboard/feedback',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({page:'/dashboard/design-lab',message:`DESIGN LAB SET ${set}｜${Object.values(subset).map(v=>v.name).join(' / ')}`,context:JSON.stringify(snapshot)})});if(!r.ok)throw 0;state.savedSets=[...new Set([...(state.savedSets||[]),set])];persist();status.textContent=set<totalSets?'保存しました。次の5問へ進めます。':'保存しました。現時点の25問まで完了できます。';await loadHistory();if(set<totalSets){setTimeout(()=>{state.activeSet=set+1;persist();render();window.scrollTo({top:0,behavior:'smooth'})},450)}}catch{status.textContent='保存に失敗。端末上の選択は残っています。'}finally{render()}}
save.addEventListener('click',saveSet);
async function loadHistory(){const box=$('#history-list');try{const r=await fetch('/api/dashboard/feedback');const d=await r.json();const items=(d.items||[]).filter(i=>i.page==='/dashboard/design-lab').slice(0,8);box.innerHTML='';if(!items.length){box.innerHTML='<p>まだSET保存はありません。</p>';return}items.forEach(i=>{const el=document.createElement('div');el.className='history-item';const s=document.createElement('strong');s.textContent=i.message||'DESIGN LAB';const t=document.createElement('time');t.textContent=new Date(i.created_at).toLocaleString('ja-JP');el.append(s,t);box.appendChild(el)})}catch{box.innerHTML='<p>履歴を読み込めませんでした。</p>'}}
render();loadHistory();
</script>
