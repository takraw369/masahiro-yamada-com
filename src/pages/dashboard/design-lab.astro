[data-demo="overlay"][data-style="dialog"] .mini main::after{content:'DETAIL';position:absolute;inset:20px 28px;display:grid;place-items:center;background:#fff;border:1px solid #ccc;box-shadow:0 8px 20px #0001;font-size:.45rem}[data-demo="overlay"][data-style="drawer"] .mini main::after{content:'DETAIL';position:absolute;right:0;top:0;bottom:0;width:45%;display:grid;place-items:center;background:#f2eee8;border-left:1px solid #ccc;font-size:.45rem}[data-demo="overlay"][data-style="inline"] .mini main>p{padding:5px;background:#f2eee8}
[data-demo="mobile"][data-style="bottom"] .mini main::after{content:'⌂   ◈   ＋';position:absolute;left:12px;right:12px;bottom:5px;text-align:center;padding:4px;background:#fff;border:1px solid #ddd;border-radius:99px}[data-demo="mobile"][data-style="sheet"] .mini main::after{content:'MENU';position:absolute;left:0;right:0;bottom:0;height:34px;display:grid;place-items:center;background:#fff;border-top:1px solid #ddd}[data-demo="mobile"][data-style="minimal"] .mini header span{display:none}
[data-demo="graph"][data-style="card"] .marks i{height:16px;border:1px solid #bbb;background:#fff}[data-demo="graph"][data-style="dot"] .marks i{width:10px;height:10px;border-radius:50%;background:#75634c}[data-demo="graph"][data-style="label"] .marks i{height:2px;width:36px}
