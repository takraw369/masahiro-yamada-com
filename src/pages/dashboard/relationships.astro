---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Relationship OS">
  <main class="crm-shell">
    <header class="crm-head">
      <div>
        <p class="eyebrow">RELATIONSHIP / REVENUE OS</p>
        <h1>人との関係から、次の一手を出す。</h1>
        <p class="intro">会社を管理するCRMではなく、Person → Relationship → Opportunity → Sale → Delivery → Outcome の入口。連絡先そのものは持たず、関係・商談・次Actionと正本参照だけを残す。</p>
      </div>
      <div class="head-actions">
        <span id="sync-status" class="sync-status">読み込み中…</span>
        <button id="new-contact" type="button" class="primary">＋ 人を追加</button>
      </div>
    </header>

    <section class="stats" aria-label="Relationship OS summary">
      <article><small>PEOPLE</small><strong id="stat-total">0</strong><span>登録された関係</span></article>
      <article><small>NEXT</small><strong id="stat-due">0</strong><span>今動くAction</span></article>
      <article><small>OPPORTUNITY</small><strong id="stat-opportunities">0</strong><span>会話・商談中</span></article>
      <article><small>PIPELINE</small><strong id="stat-pipeline">¥0</strong><span>金額仮説</span></article>
    </section>

    <section class="crm-grid">
      <div class="people-panel">
        <div class="toolbar">
          <label class="search-wrap">
            <span>検索</span>
            <input id="search" type="search" placeholder="名前・組織・次Action・タグ" autocomplete="off" />
          </label>
          <label>
            <span>段階</span>
            <select id="stage-filter">
              <option value="">すべて</option>
              <option value="DISCOVERED">DISCOVERED</option>
              <option value="WARM">WARM</option>
              <option value="CONVERSATION">CONVERSATION</option>
              <option value="OPPORTUNITY">OPPORTUNITY</option>
              <option value="CUSTOMER">CUSTOMER</option>
              <option value="DELIVERED">DELIVERED</option>
              <option value="ALUMNI">ALUMNI</option>
              <option value="PAUSED">PAUSED</option>
            </select>
          </label>
        </div>
        <div class="list-head">
          <div><b>People</b><span id="visible-count">0件</span></div>
          <small>期限が近い順 → 更新順</small>
        </div>
        <div id="people-list" class="people-list" aria-live="polite"></div>
        <div id="empty-state" class="empty-state" hidden>
          <strong>まだ関係がありません。</strong>
          <span>最初は「次に連絡したい人」を1人だけ追加。</span>
        </div>
      </div>

      <aside class="editor-panel" aria-labelledby="editor-title">
        <div class="editor-head">
          <div><p class="eyebrow">RELATIONSHIP</p><h2 id="editor-title">新しい人</h2></div>
          <span id="editor-stage" class="stage-chip">DISCOVERED</span>
        </div>

        <form id="contact-form">
          <input id="contact-id" type="hidden" />
          <div class="form-grid two">
            <label><span>名前 *</span><input id="name" maxlength="160" required placeholder="例: 山田 太郎" /></label>
            <label><span>関係</span><input id="relation" maxlength="160" placeholder="例: 見込み客 / 選手 / 保護者 / スポンサー" /></label>
          </div>
          <div class="form-grid two">
            <label><span>組織</span><input id="organization" maxlength="200" placeholder="会社・学校・チーム" /></label>
            <label><span>役割</span><input id="role" maxlength="160" placeholder="代表 / 選手 / 担当者" /></label>
          </div>
          <div class="form-grid two">
            <label><span>段階</span><select id="stage"></select></label>
            <label><span>金額仮説</span><input id="value-yen" type="number" inputmode="numeric" min="0" max="1000000000" step="1" placeholder="19800" /></label>
          </div>
          <label><span>Opportunity / Offer</span><input id="opportunity" maxlength="300" placeholder="例: 勝ち筋OS 90分セッション" /></label>
          <label class="important"><span>次に何をする？</span><textarea id="next-action" maxlength="600" rows="3" placeholder="例: 火曜にLINEで日程候補を3つ送る"></textarea></label>
          <div class="form-grid two">
            <label><span>次Action日</span><input id="next-at" type="date" /></label>
            <label><span>最終接点</span><input id="last-contact-at" type="date" /></label>
          </div>
          <div class="form-grid two">
            <label><span>きっかけ</span><input id="source" maxlength="200" placeholder="紹介 / X / LINE / イベント" /></label>
            <label><span>タグ</span><input id="tags" maxlength="420" placeholder="ACE, athlete, parent" /></label>
          </div>
          <label><span>正本・外部参照URL</span><input id="reference-url" type="url" maxlength="1500" placeholder="https://..." /></label>
          <label><span>メモ</span><textarea id="notes" maxlength="2400" rows="5" placeholder="必要最小限の背景。機微な会話本文や決済情報は置かない。"></textarea></label>

          <div class="form-actions">
            <button id="delete-contact" type="button" class="danger" hidden>削除</button>
            <span class="spacer"></span>
            <button id="cancel-edit" type="button" class="ghost">クリア</button>
            <button id="save-contact" type="submit" class="primary">保存</button>
          </div>
        </form>

        <div class="flow-links">
          <a href="/dashboard#revenue-mission"><small>SELL</small><strong>Revenue Mission</strong><span>商品準備・公開Gateへ →</span></a>
          <a href="/dashboard/evidence"><small>LEARN</small><strong>Evidence Lab</strong><span>販売・納品・成果へ →</span></a>
          <a href="/dashboard/board"><small>MAP</small><strong>FLOW Board</strong><span>CRM OSを全体構造で見る →</span></a>
        </div>
      </aside>
    </section>
  </main>

  <script>
    import {
      CRM_SCENE_KEY, CRM_STAGES, createCrmContact, createCrmSnapshot, getCrmContacts,
      getCrmStats, removeCrmContact, upsertCrmContact, validateCrmBoardSnapshot,
      type CrmContact, type CrmSnapshot,
    } from '../../lib/crm';

    let snapshot: CrmSnapshot = createCrmSnapshot();
    let revision = 0;
    let contacts: CrmContact[] = [];
    let loaded = false;
    let saving = false;
    let selectedId = '';

    const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const statusEl = byId<HTMLElement>('sync-status');
    const listEl = byId<HTMLElement>('people-list');
    const emptyEl = byId<HTMLElement>('empty-state');
    const form = byId<HTMLFormElement>('contact-form');
    const stageSelect = byId<HTMLSelectElement>('stage');
    const stageFilter = byId<HTMLSelectElement>('stage-filter');
    const searchInput = byId<HTMLInputElement>('search');
    const deleteButton = byId<HTMLButtonElement>('delete-contact');

    const stageLabels: Record<string,string> = {
      DISCOVERED: '発見', WARM: '温度あり', CONVERSATION: '会話中', OPPORTUNITY: '商談',
      CUSTOMER: '購入', DELIVERED: '提供済', ALUMNI: '継続関係', PAUSED: '保留',
    };

    for (const stage of CRM_STAGES) {
      const option = document.createElement('option');
      option.value = stage;
      option.textContent = `${stage} · ${stageLabels[stage]}`;
      stageSelect.appendChild(option);
    }

    function setStatus(text: string, state = '') {
      statusEl.textContent = text;
      statusEl.dataset.state = state;
    }

    function yen(value: number) {
      return new Intl.NumberFormat('ja-JP', { style: 'currency', currency: 'JPY', maximumFractionDigits: 0 }).format(value || 0);
    }

    function escapeHtml(value: string) {
      return value.replace(/[&<>'"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char] || char));
    }

    function today() {
      const parts = new Intl.DateTimeFormat('en-CA', { timeZone:'Asia/Tokyo', year:'numeric', month:'2-digit', day:'2-digit' }).formatToParts(new Date());
      const values = Object.fromEntries(parts.map(part => [part.type, part.value]));
      return `${values.year}-${values.month}-${values.day}`;
    }

    function dueRank(contact: CrmContact) {
      if (!contact.nextAction) return 3;
      if (!contact.nextAt || contact.nextAt <= today()) return 0;
      return 1;
    }

    function refreshContacts() {
      contacts = getCrmContacts(snapshot);
      const stats = getCrmStats(contacts, today());
      byId('stat-total').textContent = String(stats.total);
      byId('stat-due').textContent = String(stats.due);
      byId('stat-opportunities').textContent = String(stats.opportunities);
      byId('stat-pipeline').textContent = yen(stats.pipelineYen);
      renderList();
    }

    function filteredContacts() {
      const query = searchInput.value.trim().toLowerCase();
      const stage = stageFilter.value;
      return contacts
        .filter(contact => !stage || contact.stage === stage)
        .filter(contact => {
          if (!query) return true;
          return [contact.name, contact.organization, contact.role, contact.relation, contact.opportunity,
            contact.nextAction, contact.source, contact.notes, contact.tags.join(' ')].join(' ').toLowerCase().includes(query);
        })
        .sort((a, b) => {
          const due = dueRank(a) - dueRank(b);
          if (due) return due;
          if (a.nextAt !== b.nextAt) return (a.nextAt || '9999-99-99').localeCompare(b.nextAt || '9999-99-99');
          return b.updatedAt.localeCompare(a.updatedAt);
        });
    }

    function renderList() {
      const visible = filteredContacts();
      byId('visible-count').textContent = `${visible.length}件`;
      emptyEl.hidden = contacts.length > 0;
      listEl.innerHTML = '';
      for (const contact of visible) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `person-row${selectedId === contact.id ? ' selected' : ''}${dueRank(contact) === 0 ? ' due' : ''}`;
        const tags = contact.tags.slice(0, 3).map(tag => `<em>${escapeHtml(tag)}</em>`).join('');
        button.innerHTML = `
          <div class="person-main">
            <div><strong>${escapeHtml(contact.name)}</strong><span>${escapeHtml(contact.organization || contact.relation || '—')}</span></div>
            <small>${escapeHtml(stageLabels[contact.stage] || contact.stage)}</small>
          </div>
          <p>${escapeHtml(contact.nextAction || '次Action未設定')}</p>
          <div class="person-meta">
            <span>${contact.nextAt ? `NEXT ${escapeHtml(contact.nextAt)}` : 'NEXT —'}</span>
            <span>${contact.valueYen ? yen(contact.valueYen) : '¥—'}</span>
            <div>${tags}</div>
          </div>`;
        button.addEventListener('click', () => selectContact(contact.id));
        listEl.appendChild(button);
      }
    }

    function readInput(id: string) { return byId<HTMLInputElement>(id).value.trim(); }
    function writeInput(id: string, value: string) { byId<HTMLInputElement>(id).value = value; }
    function writeTextarea(id: string, value: string) { byId<HTMLTextAreaElement>(id).value = value; }

    function selectContact(id: string) {
      const contact = contacts.find(item => item.id === id);
      if (!contact) return;
      selectedId = id;
      writeInput('contact-id', contact.id);
      writeInput('name', contact.name);
      writeInput('relation', contact.relation);
      writeInput('organization', contact.organization);
      writeInput('role', contact.role);
      stageSelect.value = contact.stage;
      writeInput('value-yen', String(contact.valueYen || ''));
      writeInput('opportunity', contact.opportunity);
      writeTextarea('next-action', contact.nextAction);
      writeInput('next-at', contact.nextAt);
      writeInput('last-contact-at', contact.lastContactAt);
      writeInput('source', contact.source);
      writeInput('tags', contact.tags.join(', '));
      writeInput('reference-url', contact.referenceUrl);
      writeTextarea('notes', contact.notes);
      byId('editor-title').textContent = contact.name;
      byId('editor-stage').textContent = contact.stage;
      deleteButton.hidden = false;
      renderList();
    }

    function resetForm() {
      selectedId = '';
      form.reset();
      stageSelect.value = 'DISCOVERED';
      writeInput('contact-id', '');
      byId('editor-title').textContent = '新しい人';
      byId('editor-stage').textContent = 'DISCOVERED';
      deleteButton.hidden = true;
      renderList();
    }

    function makeId() {
      const raw = globalThis.crypto?.randomUUID?.() || `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
      return `crm:${raw}`;
    }

    function contactFromForm() {
      const id = readInput('contact-id') || makeId();
      const base = contacts.find(item => item.id === id) || createCrmContact(id);
      const tagValues = readInput('tags').split(',').map(tag => tag.trim()).filter(Boolean);
      const tags = [...new Set(tagValues)].slice(0, 10);
      return {
        ...base,
        name: readInput('name'),
        relation: readInput('relation'),
        organization: readInput('organization'),
        role: readInput('role'),
        stage: stageSelect.value,
        valueYen: Math.max(0, Number.parseInt(readInput('value-yen') || '0', 10) || 0),
        opportunity: readInput('opportunity'),
        nextAction: byId<HTMLTextAreaElement>('next-action').value.trim(),
        nextAt: readInput('next-at'),
        lastContactAt: readInput('last-contact-at'),
        source: readInput('source'),
        tags,
        referenceUrl: readInput('reference-url'),
        notes: byId<HTMLTextAreaElement>('notes').value.trim(),
        updatedAt: new Date().toISOString(),
      } as CrmContact;
    }

    async function persist(nextSnapshot: CrmSnapshot, successText: string) {
      if (!loaded || saving) return false;
      saving = true;
      setStatus('保存中…', 'saving');
      try {
        const res = await fetch('/api/dashboard/board', {
          method: 'POST',
          headers: { 'Content-Type':'application/json', Accept:'application/json' },
          body: JSON.stringify({ sceneKey: CRM_SCENE_KEY, snapshot: nextSnapshot, expectedRevision: revision, actor: 'human' }),
        });
        const payload = await res.json();
        if (res.status === 409) {
          setStatus('別更新あり · 再読み込み', 'error');
          await loadBoard();
          return false;
        }
        if (!res.ok || !payload.ok) throw new Error(payload.error || 'save_failed');
        snapshot = nextSnapshot;
        if (Number.isSafeInteger(payload.data?.revision)) revision = payload.data.revision;
        else revision += 1;
        refreshContacts();
        setStatus(successText, 'ok');
        return true;
      } catch (error) {
        console.error('crm_save_failed', error);
        setStatus('保存できません', 'error');
        return false;
      } finally {
        saving = false;
      }
    }

    async function loadBoard() {
      loaded = false;
      setStatus('読み込み中…');
      try {
        const res = await fetch(`/api/dashboard/board?scene=${CRM_SCENE_KEY}`, { headers: { Accept:'application/json' } });
        const payload = await res.json();
        if (!res.ok || !payload.ok) throw new Error(payload.error || 'read_failed');
        const data = payload.data || {};
        revision = Number.isSafeInteger(data.revision) && data.revision >= 0 ? data.revision : 0;
        const candidate = data.snapshot && typeof data.snapshot === 'object'
          ? { viewport:{ x:0, y:0, zoom:1 }, ...data.snapshot }
          : createCrmSnapshot();
        validateCrmBoardSnapshot(candidate);
        snapshot = candidate;
        loaded = true;
        refreshContacts();
        setStatus('Supabase同期', 'ok');
      } catch (error) {
        console.error('crm_load_failed', error);
        snapshot = createCrmSnapshot();
        revision = 0;
        contacts = [];
        refreshContacts();
        setStatus('読み込みできません', 'error');
      }
    }

    form.addEventListener('submit', async event => {
      event.preventDefault();
      try {
        const contact = contactFromForm();
        const next = upsertCrmContact(snapshot, contact);
        if (await persist(next, '保存しました')) selectContact(contact.id);
      } catch (error) {
        console.error('crm_validation_failed', error);
        setStatus(String(error).replace('Error: ', ''), 'error');
      }
    });

    deleteButton.addEventListener('click', async () => {
      if (!selectedId) return;
      const contact = contacts.find(item => item.id === selectedId);
      if (!contact || !window.confirm(`${contact.name} をRelationship OSから削除しますか？`)) return;
      try {
        const next = removeCrmContact(snapshot, selectedId);
        if (await persist(next, '削除しました')) resetForm();
      } catch (error) {
        setStatus(String(error).replace('Error: ', ''), 'error');
      }
    });

    byId('new-contact').addEventListener('click', () => { resetForm(); byId<HTMLInputElement>('name').focus(); });
    byId('cancel-edit').addEventListener('click', resetForm);
    searchInput.addEventListener('input', renderList);
    stageFilter.addEventListener('change', renderList);
    stageSelect.addEventListener('change', () => { byId('editor-stage').textContent = stageSelect.value; });

    resetForm();
    loadBoard();
  </script>
</DashboardLayout>

<style is:global>
  /* Scope styling to this page, including JavaScript-created descendants. */
  @scope (.crm-shell) {

  :scope{max-width:1280px;margin:0 auto;padding-bottom:48px;color:#26292d}
  .eyebrow{margin:0;color:var(--gold-muted);font-size:.68rem;letter-spacing:.13em;font-weight:900}
  .crm-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:18px}
  .crm-head h1{margin:4px 0 0;font-size:clamp(2rem,4.2vw,3.6rem);line-height:1;letter-spacing:-.045em}
  .intro{max-width:820px;margin:12px 0 0;color:#6b737c;font-size:.9rem;line-height:1.75}
  .head-actions{display:flex;align-items:center;gap:10px;flex-shrink:0}
  .sync-status{padding:8px 10px;border:1px solid #dedad4;border-radius:999px;color:#777f88;background:rgba(255,255,255,.74);font-size:.68rem;white-space:nowrap}.sync-status[data-state="ok"]{color:#267152}.sync-status[data-state="error"]{color:#a34747}.sync-status[data-state="saving"]{color:#8c6428}
  button,input,select,textarea{font:inherit}button{cursor:pointer}.primary,.ghost,.danger{min-height:38px;padding:0 14px;border-radius:10px;border:1px solid #d6d1ca;background:#fff;font-size:.76rem;font-weight:800}.primary{border-color:#25292d;background:#25292d;color:#fff}.danger{border-color:#e3c8c8;color:#a24444}.ghost{color:#626b74}
  .stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:12px}.stats article{padding:15px 16px;border:1px solid #e1ddd7;border-radius:16px;background:rgba(255,255,255,.74)}.stats small,.stats strong,.stats span{display:block}.stats small{color:#8d949a;font-size:.61rem;letter-spacing:.1em;font-weight:900}.stats strong{margin-top:4px;font-size:1.5rem}.stats span{margin-top:2px;color:#858b91;font-size:.66rem}
  .crm-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(360px,.88fr);gap:12px;align-items:start}.people-panel,.editor-panel{border:1px solid #e1ddd7;border-radius:20px;background:rgba(255,255,255,.78);box-shadow:0 10px 32px rgba(50,45,39,.035)}
  .people-panel{min-height:650px;overflow:hidden}.toolbar{display:grid;grid-template-columns:1fr 180px;gap:9px;padding:14px;border-bottom:1px solid #e8e4df}.toolbar label,.form-grid label,form>label{display:block}.toolbar label>span,form label>span{display:block;margin:0 0 5px;color:#777f87;font-size:.64rem;font-weight:800;letter-spacing:.035em}.toolbar input,.toolbar select,form input,form select,form textarea{width:100%;box-sizing:border-box;border:1px solid #dcd8d2;border-radius:10px;background:#fff;color:#25292d;outline:none}.toolbar input,.toolbar select,form input,form select{min-height:40px;padding:0 11px}.toolbar input:focus,.toolbar select:focus,form input:focus,form select:focus,form textarea:focus{border-color:#a88a62;box-shadow:0 0 0 3px rgba(168,138,98,.1)}form textarea{padding:10px 11px;resize:vertical;line-height:1.55}
  .list-head{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;border-bottom:1px solid #ece8e3}.list-head>div{display:flex;align-items:center;gap:8px}.list-head b{font-size:.78rem}.list-head span,.list-head small{color:#91979d;font-size:.65rem}
  .people-list{display:grid}.person-row{display:block;width:100%;padding:14px;border:0;border-bottom:1px solid #ece8e3;background:transparent;text-align:left;color:inherit}.person-row:hover,.person-row.selected{background:#faf8f4}.person-row.selected{box-shadow:inset 3px 0 #9a7040}.person-row.due:not(.selected){box-shadow:inset 3px 0 #c28a45}.person-main{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.person-main strong,.person-main span{display:block}.person-main strong{font-size:.87rem}.person-main span{margin-top:2px;color:#7d858d;font-size:.69rem}.person-main small{flex-shrink:0;padding:4px 7px;border-radius:999px;background:#f0ede8;color:#756b5f;font-size:.58rem;font-weight:800}.person-row p{margin:9px 0 0;color:#4d565f;font-size:.73rem;line-height:1.45}.person-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:9px;color:#90969b;font-size:.62rem}.person-meta>div{display:flex;gap:4px}.person-meta em{padding:2px 6px;border-radius:999px;background:#f2f0ed;color:#747b82;font-style:normal}
  .empty-state{padding:60px 20px;text-align:center;color:#80878f}.empty-state strong,.empty-state span{display:block}.empty-state strong{font-size:.9rem}.empty-state span{margin-top:5px;font-size:.72rem}
  .editor-panel{position:sticky;top:16px;padding:16px}.editor-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding-bottom:13px;border-bottom:1px solid #ece8e3}.editor-head h2{margin:3px 0 0;font-size:1.05rem}.stage-chip{padding:5px 8px;border-radius:999px;background:#272b2f;color:#fff;font-size:.58rem;font-weight:900}
  form{display:grid;gap:10px;margin-top:13px}.form-grid{display:grid;gap:9px}.form-grid.two{grid-template-columns:1fr 1fr}.important textarea{border-color:#d1c1aa;background:#fffdf8}.form-actions{display:flex;align-items:center;gap:8px;padding-top:4px}.spacer{flex:1}
  .flow-links{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:16px;padding-top:14px;border-top:1px solid #ece8e3}.flow-links a{padding:10px;border:1px solid #e3dfda;border-radius:12px;text-decoration:none;background:#fff}.flow-links small,.flow-links strong,.flow-links span{display:block}.flow-links small{color:#9a7040;font-size:.55rem;letter-spacing:.09em;font-weight:900}.flow-links strong{margin-top:4px;font-size:.69rem}.flow-links span{margin-top:3px;color:#8c9298;font-size:.58rem;line-height:1.35}
  @media(max-width:980px){.crm-grid{grid-template-columns:1fr}.editor-panel{position:static}.people-panel{min-height:0}.flow-links{grid-template-columns:1fr 1fr 1fr}}
  @media(max-width:700px){.crm-head{align-items:flex-start;flex-direction:column}.head-actions{width:100%;justify-content:space-between}.stats{grid-template-columns:1fr 1fr}.toolbar,.form-grid.two{grid-template-columns:1fr}.flow-links{grid-template-columns:1fr}:scope{padding-bottom:28px}}

  }
</style>
