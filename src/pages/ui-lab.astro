---
import { ObsidianArrowButton } from '../components/obsidian/ObsidianArrowButton.jsx';

const title = 'UI LAB — ACE METHOD × ObsidianUI';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <header class="lab-hero">
        <p class="eyebrow">EXPERIMENT 001</p>
        <h1>ACE METHOD × ObsidianUI</h1>
        <p class="lead">外部UIをそのまま貼らず、ACEの静けさ・黒・金・直線へ変換してから採用する。</p>
      </header>

      <section class="panel">
        <div class="panel-copy">
          <p class="eyebrow">OBSIDIAN PATTERN</p>
          <h2>Expanding fill interaction</h2>
          <p>
            ObsidianUIのArrow Fill Buttonのインタラクションを、ACE METHODのデザインルールに合わせて再構成。
            元の丸いボタン感は捨て、角を立て、既存のgold tokenへ寄せている。
          </p>
        </div>

        <div class="demo-stack">
          <ObsidianArrowButton href="/">Enter ACE Method</ObsidianArrowButton>
          <ObsidianArrowButton
            href="/learn"
            text="#D4C5A9"
            fill="#8B7355"
            fillText="#0D0B08"
          >
            Explore Learning
          </ObsidianArrowButton>
          <ObsidianArrowButton
            href="/gate"
            text="#7A6F5F"
            fill="#D4C5A9"
            fillText="#0D0B08"
          >
            Open the Gate
          </ObsidianArrowButton>
        </div>
      </section>

      <section class="rules">
        <div><span>01</span><p>ObsidianUIは「演出レイヤー」として使う。</p></div>
        <div><span>02</span><p>ACEの色・書体・角・余白を優先する。</p></div>
        <div><span>03</span><p>軽い部品から採用し、WebGL系は効果測定後。</p></div>
      </section>

      <footer>
        <a href="/">← Back to site</a>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    --bg-void: #0D0B08;
    --bg-surface: #1A1612;
    --gold-pure: #C9A96E;
    --gold-muted: #8B7355;
    --text-primary: #D4C5A9;
    --text-muted: #7A6F5F;
    --border-default: #2E2822;
  }

  * { box-sizing: border-box; }
  html { background: var(--bg-void); }
  body {
    margin: 0;
    background:
      radial-gradient(circle at 18% 8%, rgba(201,169,110,.07), transparent 32rem),
      var(--bg-void);
    color: var(--text-primary);
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-weight: 300;
    min-height: 100vh;
  }

  main {
    width: min(920px, calc(100% - 40px));
    margin: 0 auto;
    padding: 88px 0 64px;
  }

  .lab-hero { max-width: 720px; margin-bottom: 72px; }
  .eyebrow {
    margin: 0 0 14px;
    color: var(--gold-muted);
    font-family: 'Cormorant Garamond', serif;
    font-size: 11px;
    letter-spacing: .36em;
  }
  h1, h2 {
    margin: 0;
    color: var(--gold-pure);
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
  }
  h1 { font-size: clamp(38px, 7vw, 68px); line-height: .98; }
  h2 { font-size: clamp(25px, 4vw, 36px); }
  .lead, .panel-copy > p:last-child {
    max-width: 650px;
    color: var(--text-muted);
    line-height: 1.9;
  }
  .lead { margin-top: 28px; }

  .panel {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 48px;
    padding: 40px;
    border: 1px solid var(--border-default);
    background: rgba(26,22,18,.72);
  }
  .panel-copy > p:last-child { margin: 20px 0 0; font-size: 13px; }
  .demo-stack { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 16px; }

  .rules {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 1px;
    background: var(--border-default);
  }
  .rules > div { min-height: 150px; padding: 24px; background: var(--bg-void); }
  .rules span { color: var(--gold-muted); font-family: 'Cormorant Garamond', serif; font-size: 12px; letter-spacing: .2em; }
  .rules p { margin: 28px 0 0; color: var(--text-muted); font-size: 12px; line-height: 1.8; }

  footer { padding-top: 56px; }
  footer a { color: var(--text-muted); font-size: 12px; text-decoration: none; }
  footer a:hover { color: var(--gold-pure); }

  @media (max-width: 720px) {
    main { width: min(100% - 32px, 560px); padding-top: 56px; }
    .panel { grid-template-columns: 1fr; padding: 28px 22px; }
    .rules { grid-template-columns: 1fr; }
  }
</style>
