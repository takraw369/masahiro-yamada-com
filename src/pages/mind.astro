---
import KnowledgeCockpit from '../components/knowledge/KnowledgeCockpit.astro';
import '../styles/knowledge-os.css';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#171513" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="FLOW MIND" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>FLOW MIND — MASA OS</title>
    <link rel="manifest" href="/flow-mind.webmanifest" />
    <link rel="icon" href="/flow-mind-icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      html, body { margin: 0; min-height: 100%; background: #171513; overscroll-behavior: none; }
      body { min-height: 100dvh; }
      .knowledge-os { height: 100dvh; min-height: 100dvh; }
      @media (max-width: 760px) {
        .knowledge-os, .ko-main { min-height: 100dvh; }
        .ko-topbar { padding-top: env(safe-area-inset-top); height: calc(58px + env(safe-area-inset-top)); }
        .ko-canvas { padding-bottom: calc(90px + env(safe-area-inset-bottom)); }
        .ko-bottom { height: calc(62px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); }
        .ko-toast { bottom: calc(76px + env(safe-area-inset-bottom)); }
      }
    </style>
  </head>
  <body>
    <KnowledgeCockpit />
    <script is:inline src="/scripts/flow-mind-search.js"></script>
    <script is:inline src="/scripts/flow-mind-capture.js"></script>
    <script is:inline src="/scripts/flow-mind-today.js"></script>
    <script is:inline src="/scripts/flow-mind-highlight.js"></script>
    <script is:inline src="/scripts/flow-mind-journal.js"></script>
    <script is:inline src="/scripts/flow-mind-launch.js"></script>
  </body>
</html>
