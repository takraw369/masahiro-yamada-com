          <h1 class="active-copy__title" id="activeTitle">MIND — notice before you move.</h1>
        </div>
        <div class="gesture" aria-hidden="true">
          <span>Swipe to explore</span>
          <span class="gesture__line"></span>
        </div>
      </footer>
    </main>

    <script>
      const page = document.getElementById("page");
      const rail = document.getElementById("collectionRail");
      const looks = Array.from(rail.querySelectorAll(".look"));
      const currentIndex = document.getElementById("currentIndex");
      const activeKicker = document.getElementById("activeKicker");
      const activeTitle = document.getElementById("activeTitle");
      let frame = 0;
      let active = 0;

      function syncActive() {
        frame = 0;
        const railBox = rail.getBoundingClientRect();
        const center = railBox.left + railBox.width / 2;
        let best = active;
        let bestDistance = Infinity;

        looks.forEach((look, index) => {
          const box = look.getBoundingClientRect();
          const distance = Math.abs(box.left + box.width / 2 - center);
          if (distance < bestDistance) {
            bestDistance = distance;
            best = index;
          }
        });

        if (best === active && looks[best].classList.contains("is-active")) return;
        active = best;

        looks.forEach((look, index) => look.classList.toggle("is-active", index === active));
        const look = looks[active];

        currentIndex.textContent = look.dataset.index;
        activeKicker.textContent = look.dataset.kicker;
        activeTitle.textContent = look.dataset.title;
        page.style.setProperty("--accent", look.dataset.accent);
        page.style.setProperty("--accent-wash", look.dataset.wash);
      }

      rail.addEventListener("scroll", () => {
        if (frame) return;
        frame = requestAnimationFrame(syncActive);
      }, { passive: true });

      window.addEventListener("resize", syncActive, { passive: true });

      looks.forEach((look) => {
        look.addEventListener("focus", () => {
          look.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
        });
      });

      syncActive();
    </script>
  </body>
