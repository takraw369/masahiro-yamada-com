---
export const prerender = true;
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0D0B08" />
  <meta name="description" content="身体・心・未来をめぐる、3つの星の小さな旅。" />
  <meta property="og:title" content="FLOW LIFE｜星を旅する" />
  <meta property="og:description" content="身体・心・未来をめぐる、3つの星の小さな旅。" />
  <title>FLOW LIFE｜星を旅する</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="universe" id="universe">
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="nebula" aria-hidden="true"></div>

    <header class="masthead">
      <a class="brand" href="/flow-life/" aria-label="FLOW LIFE に戻る"><span class="brand-mark" aria-hidden="true">◈</span><span>ACE METHOD <i>/</i> FLOW LIFE</span></a>
      <div class="header-right"><span id="level" class="state-badge">LV. 01</span><a class="return-link" href="/flow-life/">FLOW LIFE <span aria-hidden="true">↗</span></a></div>
    </header>

    <main>
      <section class="map-view" id="map-view" aria-label="旅する星を選ぶ">
        <div class="heading">
          <p class="eyebrow">THE INNER UNIVERSE · 01—03</p>
          <h1>自分という宇宙を、<br /><em>旅しよう。</em></h1>
          <p class="lead">答えは、遠くではなく自分の中に。<br />3つの星で、今の自分と出会う。</p>
        </div>
        <div class="galaxy" id="galaxy" aria-label="星の地図">
          <div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div>
          <div class="orbit orbit-three" aria-hidden="true"></div><div class="map-sun" aria-hidden="true"></div>
          <button type="button" class="planet-node planet-body is-selected" data-planet="0" aria-pressed="true" aria-label="1つ目の星 身体の星">
            <span class="planet-orb"><span class="planet-shine"></span></span><span class="planet-number">01 / ROOT</span><span class="planet-label">身体の星</span><span class="node-check" aria-label="訪問済み">✓</span>
          </button>
          <button type="button" class="planet-node planet-mind" data-planet="1" aria-pressed="false" aria-label="2つ目の星 心の星">
            <span class="planet-orb"><span class="planet-shine"></span></span><span class="planet-number">02 / TIDE</span><span class="planet-label">心の星</span><span class="node-check" aria-label="訪問済み">✓</span>
          </button>
          <button type="button" class="planet-node planet-future" data-planet="2" aria-pressed="false" aria-label="3つ目の星 未来の星">
            <span class="planet-orb"><span class="planet-shine"></span></span><span class="planet-number">03 / LIGHT</span><span class="planet-label">未来の星</span><span class="node-check" aria-label="訪問済み">✓</span>
          </button>
        </div>
        <aside class="map-panel" aria-live="polite">
          <div class="panel-overline"><span id="map-counter">01 / 03</span><span id="visit-progress">0 STAR DISCOVERED</span></div>
          <h2 id="map-name">身体の星</h2>
          <p id="map-summary">思考をほどいて、身体が発する小さな声に気づく。</p>
          <div class="panel-actions"><button id="explore" class="action-primary" type="button">この星を探検する <span aria-hidden="true">↗</span></button></div>
          <p class="map-help">星を選ぶ · 左右キーで移動 · Enterで探検</p>
        </aside>
      </section>

      <section class="scene-view" id="scene-view" hidden aria-label="星での冒険">
        <div class="scene-top"><button type="button" id="back-to-map" class="back-button">← 星の地図へ</button><span id="scene-index">01 / ROOT</span></div>
        <div class="scene-content">
          <div class="scene-art" id="scene-art" aria-hidden="true">
            <span class="halo halo-a"></span><span class="halo halo-b"></span>
            <div class="landscape"><div class="landscape-cap"></div><div class="ridge ridge-back"></div><div class="ridge ridge-front"></div><div class="wanderer"><span></span></div><div class="landmark landmark-a"></div><div class="landmark landmark-b"></div></div>
            <span class="atmosphere"></span>
          </div>
          <div class="scene-story">
            <span id="scene-kicker" class="eyebrow">01 · THE ROOT</span>
            <h2 id="scene-name">身体の声を、聴く。</h2>
            <p id="scene-narrative" class="narrative"></p>
            <div class="story-line"><span class="story-line-mark" aria-hidden="true">“</span><p id="scene-question"></p></div>
            <fieldset class="choices" id="choices"><legend>今日は、どちらの一歩を選ぶ？</legend></fieldset>
            <div class="scene-actions"><button id="record-choice" type="button" class="action-primary" disabled>この気づきを記録する <span aria-hidden="true">→</span></button><span id="saved-state" role="status" aria-live="polite"></span></div>
          </div>
        </div>
      </section>

      <section class="ending" id="ending" hidden role="status" aria-live="polite">
        <span class="eyebrow">THREE STARS · ONE JOURNEY</span>
        <h2>旅の続きは、<em>今日の一歩へ。</em></h2>
        <p>3つの星から選んだ小さな行動を、現実の1日に持ち帰ろう。</p>
        <div class="ending-actions"><a class="action-primary" href="/flow-life/">FLOW LIFEでQuestを続ける <span aria-hidden="true">↗</span></a><button id="revisit" class="action-secondary" type="button">もう一度、星を見る</button></div>
      </section>
    </main>

    <footer class="footer"><span>FLOW LIFE / A QUIET JOURNEY WITHIN</span><div class="progress-dots" aria-label="星の発見状況"><span data-dot="0"></span><span data-dot="1"></span><span data-dot="2"></span></div><span id="quest-info">今日のQUEST · — / 3</span></footer>

    <div class="intro" id="intro" role="dialog" aria-modal="true" aria-labelledby="intro-title"><div class="intro-content"><span class="eyebrow">AN INTERACTIVE JOURNEY · FLOW LIFE</span><div class="intro-symbol" aria-hidden="true"><span></span></div><h2 id="intro-title">旅するほどに、<br /><em>自分が見えてくる。</em></h2><p>身体、心、未来。<br />小さな3つの星へ、出かけよう。</p><button id="begin" class="action-primary" type="button">旅を始める <span aria-hidden="true">↗</span></button><span class="intro-note">スマートフォンでも探検できます · 所要時間 約2分</span></div></div>
  </div>
  <script is:inline defer src="/flow-life/world/world.js"></script>
</body>
</html>
<style is:global>
  :root{--void:#0d0b08;--surface:#1a1612;--gold:#c9a96e;--muted:#8b7355;--ink:#d4c5a9;--dim:#7a6f5f}*{box-sizing:border-box}html{background:var(--void)}body{margin:0;color:var(--ink);font:300 14px/1.8 'Zen Kaku Gothic New',sans-serif}button,a{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.42}button:focus-visible,a:focus-visible{outline:2px solid #e3c88e;outline-offset:5px}a{color:inherit;text-decoration:none}em{font-weight:300;font-style:normal;color:var(--gold)}[hidden]{display:none!important}.universe{position:relative;overflow:hidden;min-height:100svh;background:#0d0b08}.universe::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 49% 43%,#201911 0%,transparent 59%);pointer-events:none}.nebula{position:absolute;inset:0;background:radial-gradient(ellipse at 17% 62%,rgba(96,90,58,.13),transparent 28%),radial-gradient(ellipse at 84% 21%,rgba(99,75,46,.12),transparent 31%);pointer-events:none}#stars{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.masthead,.footer{position:relative;z-index:8;display:flex;justify-content:space-between;align-items:center;padding:24px clamp(20px,4vw,70px)}.brand{display:flex;align-items:center;gap:13px;font:400 11px/1.2 'Cormorant Garamond',serif;letter-spacing:3px}.brand-mark{font:300 32px/1 'Cormorant Garamond',serif;color:var(--gold)}.brand i{font-style:normal;color:#504535;margin:0 6px}.header-right{display:flex;align-items:center;gap:24px}.state-badge{font:400 12px/1 'Cormorant Garamond',serif;color:var(--gold);letter-spacing:3px}.return-link{font:400 11px 'Cormorant Garamond',serif;letter-spacing:2px;color:#a28d6c;border-bottom:1px solid #544a37;padding-bottom:4px}.return-link span{margin-left:10px}.map-view{position:relative;z-index:2;min-height:calc(100svh - 144px);max-width:1500px;margin:0 auto}.heading{position:absolute;left:clamp(24px,7vw,110px);top:clamp(12px,5vh,75px);z-index:5;pointer-events:none}.eyebrow{font:400 11px/1.4 'Cormorant Garamond',serif;letter-spacing:4px;color:var(--muted)}h1,h2,p{margin-top:0}.heading h1{font:300 clamp(42px,5.7vw,88px)/1.17 'Cormorant Garamond',serif;letter-spacing:-1px;margin:16px 0 14px}.lead{color:#8f8372;font-size:13px;letter-spacing:.04em}.galaxy{position:absolute;inset:0;min-height:600px;isolation:isolate}.orbit{position:absolute;border:1px solid rgba(153,126,76,.13);border-radius:50%;left:55%;top:49%;transform:translate(-50%,-50%) rotate(-21deg);pointer-events:none}.orbit-one{width:48%;aspect-ratio:1.5}.orbit-two{width:75%;aspect-ratio:1.65}.orbit-three{width:108%;aspect-ratio:1.72;border-style:dotted;opacity:.55}.map-sun{position:absolute;left:55%;top:49%;height:5px;width:5px;border-radius:50%;background:#ffe9b5;box-shadow:0 0 14px 5px #d8ab5f49,0 0 80px 28px #80653224}.planet-node{position:absolute;z-index:3;display:grid;justify-items:center;gap:5px;min-width:150px;border:0;background:none;padding:9px;color:var(--ink);transform:translate(-50%,-50%)}.planet-node .planet-orb{position:relative;display:block;width:clamp(95px,12vw,165px);aspect-ratio:1;border-radius:50%;box-shadow:inset -25px -20px 35px #000b,0 15px 65px #0009;transition:filter .35s,border-color .35s;overflow:hidden}.planet-node .planet-orb::after{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 25% 18%,#fff8 0,transparent 15%),radial-gradient(circle at 75% 80%,#0009,transparent 38%)}.planet-orb .planet-shine{position:absolute;inset:15% 0;border-radius:50%;border-top:4px solid #ffffff20;transform:rotate(-20deg)}.planet-body{left:28%;top:57%}.planet-mind{left:64%;top:29%}.planet-future{left:78%;top:73%}.planet-body .planet-orb{background:radial-gradient(circle at 30% 24%,#ac9d70,#5e7154 39%,#28342b 73%,#111712)}.planet-mind .planet-orb{width:clamp(118px,15vw,204px);background:radial-gradient(circle at 29% 18%,#e3cfaf,#9c9f96 28%,#515d68 58%,#222b35 79%,#0d131a)}.planet-future .planet-orb{background:radial-gradient(circle at 27% 23%,#f4d99a,#be8965 35%,#704738 67%,#301d22)}.planet-orb::before{content:"";position:absolute;inset:24% -30%;border:13px solid #c6a67965;border-top-color:#ecd7a3a8;border-bottom-color:#48362965;border-radius:50%;transform:rotate(-23deg) scaleY(.46);z-index:1}.planet-node.is-selected .planet-orb{filter:drop-shadow(0 0 16px #d2b479a1)}.planet-node.is-selected::before{content:"";position:absolute;left:50%;top:52%;width:calc(clamp(95px,12vw,165px) + 29px);aspect-ratio:1;border:1px solid #c9a96e75;border-radius:50%;transform:translate(-50%,-50%)}.planet-mind.is-selected::before{width:calc(clamp(118px,15vw,204px) + 29px);top:50%}.planet-number{margin-top:9px;color:#9b8665;font:400 11px 'Cormorant Garamond',serif;letter-spacing:3px}.planet-label{font-size:13px;color:#d7c5a6;letter-spacing:.12em}.node-check{display:none;position:absolute;right:3px;top:0;color:#d8c494;font-size:15px}.planet-node.discovered .node-check{display:block}.map-panel{position:absolute;z-index:6;left:clamp(24px,7vw,110px);bottom:clamp(15px,5vh,60px);width:min(350px,calc(100% - 48px));background:linear-gradient(160deg,#1a1612f2,#0d0b08ec);border-left:1px solid #9e8255;padding:24px 27px 22px}.panel-overline{display:flex;justify-content:space-between;gap:10px;color:#877357;font:400 10px 'Cormorant Garamond',serif;letter-spacing:1.5px}.map-panel h2{font:300 36px 'Cormorant Garamond',serif;margin:10px 0 1px}.map-panel p{font-size:12px;color:#9e907b;line-height:1.85;margin:0}.panel-actions{margin-top:20px}.action-primary,.action-secondary{display:inline-flex;justify-content:space-between;align-items:center;gap:30px;padding:13px 24px;border:1px solid #97805a;background:linear-gradient(110deg,#c9a96e,#94754e);color:#120f0a;font:500 12px/1.5 'Zen Kaku Gothic New',sans-serif;letter-spacing:.06em;transition:background-color .25s,border-color .25s}.action-primary:hover:not(:disabled){background:#d2b780}.action-primary span{font-size:15px}.action-secondary{background:transparent;border-color:#65543c;color:#b7a486}.map-panel .map-help{margin-top:14px;color:#736555;font-size:10px}.footer{margin-top:auto;font:400 10px 'Cormorant Garamond',serif;letter-spacing:2px;color:#776951}.progress-dots{display:flex;gap:10px}.progress-dots span{height:5px;width:28px;background:#47392a}.progress-dots span.done{background:#c9a96e}.scene-view{position:relative;z-index:2;max-width:1350px;margin:auto;min-height:calc(100svh - 144px);padding:10px clamp(20px,5vw,78px) 30px}.scene-top{display:flex;justify-content:space-between;align-items:center;color:#827153;font:400 12px 'Cormorant Garamond',serif;letter-spacing:3px}.back-button{color:#b09a77;border:0;background:transparent;padding:12px 0;letter-spacing:1px;font:400 13px 'Zen Kaku Gothic New',sans-serif}.scene-content{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.8fr);align-items:center;gap:clamp(18px,5vw,88px);min-height:580px}.scene-art{position:relative;height:520px;display:grid;place-items:center;isolation:isolate}.halo{position:absolute;border:1px solid #ae946b31;border-radius:50%;transform:rotate(-15deg) scaleY(.65)}.halo-a{width:470px;height:470px}.halo-b{width:580px;height:580px;border-style:dashed;opacity:.7}.landscape{position:relative;width:min(390px,85%);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 25% 18%,var(--land-light,#a2ae86),var(--land-mid,#576e52) 38%,var(--land-dark,#243c34) 70%,#0c1716 95%);box-shadow:inset -48px -43px 54px #0009,0 35px 100px #0006,0 0 90px var(--land-glow,#8eae6a2b);overflow:hidden}.landscape-cap{position:absolute;inset:7% 17% 52%;border-radius:50%;border-top:1px solid #ffffff60}.ridge{position:absolute;bottom:19%;left:-10%;width:120%;height:37%;background:var(--ridge-back,#304e3c);clip-path:polygon(0 80%,18% 43%,28% 51%,48% 10%,64% 58%,82% 30%,100% 73%,100% 100%,0 100%);opacity:.87}.ridge-front{bottom:0;height:36%;background:var(--ridge-front,#1d352b);clip-path:polygon(0 62%,19% 35%,34% 64%,50% 33%,70% 58%,86% 32%,100% 63%,100% 100%,0 100%)}.wanderer{position:absolute;top:40%;left:51%;width:8px;height:22px;background:#e6d09c;box-shadow:0 0 14px #efd6a4aa;z-index:2;border-radius:4px 4px 0 0}.wanderer::before{content:"";position:absolute;left:-3px;top:-10px;width:14px;height:14px;border-radius:50%;background:#e5cca1}.wanderer span{position:absolute;top:18px;left:-6px;width:20px;border-bottom:12px solid #403727;border-left:6px solid transparent;border-right:6px solid transparent}.landmark{position:absolute;width:3px;height:90px;border-radius:40%;background:#5d4f36;top:25%;left:28%;transform:rotate(-15deg)}.landmark::before{content:"";position:absolute;width:45px;height:48px;left:-22px;top:-25px;border-radius:50%;background:#b8b393c9;box-shadow:0 0 16px #dac39557}.landmark-b{left:80%;top:31%;transform:scale(.65) rotate(23deg)}.atmosphere{position:absolute;width:75%;aspect-ratio:1;border:1px solid #d0b17c2a;border-radius:50%;z-index:-1}.scene-art[data-scene="1"]{--land-light:#b3bdc4;--land-mid:#616b81;--land-dark:#303b53;--land-glow:#8297bc29;--ridge-back:#52657a;--ridge-front:#26394e}.scene-art[data-scene="2"]{--land-light:#edd19d;--land-mid:#ae795d;--land-dark:#60394b;--land-glow:#e29b5c29;--ridge-back:#995b4e;--ridge-front:#57323c}.scene-story{padding:35px 0 50px}.scene-story h2{font:300 clamp(36px,4.2vw,62px)/1.35 'Cormorant Garamond',serif;letter-spacing:.04em;margin:22px 0}.narrative{font-size:14px;line-height:2.15;max-width:420px;color:#aa9b86}.story-line{position:relative;border-top:1px solid #4a3e2e;margin:32px 0 24px;padding:27px 10px 0 24px}.story-line-mark{position:absolute;left:-4px;top:16px;font:300 49px/1 'Cormorant Garamond',serif;color:#ab8a56}.story-line p{font-size:16px;line-height:1.8;color:#e0cba9}.choices{border:0;padding:0;margin:0;display:grid;gap:10px;max-width:420px}.choices legend{font-size:11px;letter-spacing:1px;color:#94826b;margin-bottom:11px}.choice{display:flex;gap:12px;align-items:center;padding:14px 16px;border:1px solid #453927;background:#17130f;color:#bda98b;text-align:left;font-size:12px}.choice:hover,.choice[aria-pressed="true"]{border-color:#b89865;color:#e2c89b;background:#211b15}.choice .choice-marker{font:400 12px 'Cormorant Garamond',serif;letter-spacing:2px;color:#9f835c}.scene-actions{display:flex;gap:13px;align-items:center;flex-wrap:wrap;margin-top:25px}.scene-actions #saved-state{font-size:11px;color:#c9a96e}.ending{position:relative;z-index:5;max-width:600px;margin:7vh auto 10vh;padding:65px 35px;text-align:center;border-top:1px solid #6f5733;border-bottom:1px solid #6f5733;background:radial-gradient(ellipse at 50% 0,#5b472019,transparent 70%)}.ending h2{font:300 clamp(34px,4vw,53px)/1.4 'Cormorant Garamond',serif;margin:25px 0}.ending p{color:#ad9f86}.ending-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:35px}.intro{position:fixed;z-index:30;inset:0;display:grid;place-items:center;background:radial-gradient(circle at 50% 41%,#282018e8,#0d0b08f8 70%);text-align:center;padding:25px;transition:opacity .7s ease,visibility .7s}.intro.is-leaving{opacity:0;visibility:hidden;pointer-events:none}.intro-content{max-width:550px}.intro-symbol{width:144px;height:144px;margin:25px auto;display:grid;place-items:center;border:1px solid #ac905d55;border-radius:50%;position:relative}.intro-symbol::before,.intro-symbol::after{content:"";position:absolute;border:1px solid #a88d5c4d;width:120%;height:120%;border-radius:50%;transform:rotate(45deg) scaleY(.48)}.intro-symbol::after{transform:rotate(-45deg) scaleY(.48)}.intro-symbol span{width:62px;height:62px;border-radius:50%;background:radial-gradient(circle at 29% 22%,#f6d5a0,#a37951 48%,#413024 90%);box-shadow:0 0 46px #c6a06c5c}.intro h2{font:300 clamp(36px,6vw,61px)/1.35 'Cormorant Garamond',serif;margin:22px 0}.intro p{color:#a5967e;margin-bottom:28px}.intro-note{display:block;margin-top:17px;font-size:10px;color:#766953}.return-link:hover,.back-button:hover,.brand:hover{color:#e6c78a}
  @media(max-width:1000px){.map-view{min-height:770px}.heading{top:20px}.galaxy{top:125px}.map-panel{left:auto;right:28px;bottom:22px}.planet-body{left:19%;top:52%}.planet-mind{left:65%;top:28%}.planet-future{left:74%;top:64%}.scene-content{grid-template-columns:1fr;gap:0}.scene-art{height:390px}.landscape{width:305px}.scene-story{max-width:620px;margin:auto;padding:0 0 30px}.halo-a{width:350px;height:350px}.halo-b{width:390px;height:390px}}
  @media(max-width:640px){.masthead{padding:18px 20px}.brand{letter-spacing:1.5px;font-size:10px;gap:7px}.brand-mark{font-size:25px}.header-right{gap:9px}.return-link{font-size:9px}.return-link span{display:none}.state-badge{font-size:10px}.map-view{min-height:calc(100svh - 95px);padding-bottom:285px}.heading{position:relative;left:auto;top:auto;padding:26px 24px 0}.heading h1{font-size:45px}.heading .lead{font-size:11px}.galaxy{inset:168px 0 200px;min-height:400px}.orbit{left:52%;top:50%}.orbit-one{width:90%;aspect-ratio:1.1}.orbit-two{width:135%;aspect-ratio:1.2}.orbit-three{width:190%;aspect-ratio:1.2}.map-sun{left:52%}.planet-node{min-width:112px}.planet-node .planet-orb{width:95px}.planet-mind .planet-orb{width:118px}.planet-node.is-selected::before{width:124px}.planet-mind.is-selected::before{width:147px}.planet-body{left:20%;top:62%}.planet-mind{left:66%;top:30%}.planet-future{left:77%;top:80%}.planet-number{font-size:9px;margin-top:3px}.planet-label{font-size:11px}.map-panel{position:absolute;left:20px;right:20px;bottom:0;width:auto;padding:18px 20px}.map-panel h2{font-size:30px}.map-panel .map-help{font-size:9px;margin-top:8px}.panel-actions{margin-top:12px}.action-primary,.action-secondary{font-size:11px;padding:12px 17px}.footer{padding:26px 20px;gap:12px;flex-wrap:wrap}.footer>span:first-child{display:none}.scene-top{font-size:10px}.scene-art{height:300px}.landscape{width:250px}.halo-a{width:280px;height:280px}.halo-b{width:310px;height:310px}.scene-story h2{font-size:38px}.scene-story{padding:0 0 50px}.scene-view{padding:0 20px}.intro-symbol{margin:15px auto;width:110px;height:110px}.intro h2{font-size:39px}.intro p{font-size:12px}}
  @media(max-height:680px) and (min-width:641px){.map-view{min-height:650px}.heading{top:10px}.map-panel{bottom:15px}.intro-symbol{width:95px;height:95px;margin:8px auto}.intro h2{margin:10px 0}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
</style>