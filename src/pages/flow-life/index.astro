---
import PublicPageLayout from '../../layouts/PublicPageLayout.astro';
---

<PublicPageLayout
  title="FLOW LIFE"
  description="今の状態を知り、今日のQuestを選び、気づきを自分のKnowledgeへ変えていくローカルファーストのセルフコーチングMVP。"
  eyebrow="FLOW CHECK × LIFE RPG × PERSONAL WIKI"
>
  <p slot="lead" class="public-lead">毎日の状態を30秒で見える化し、いま必要な一歩だけをQuestに変える。行動と気づきは、使うほど自分専用の取扱説明書として育っていきます。</p>

  <section class="public-section hero-grid">
    <article class="panel state-panel">
      <p class="kicker">TODAY</p>
      <h2>いまのFLOWを測る</h2>
      <div id="check-form" class="check-grid">
        <label>身体 <span id="body-v">3</span><input id="body" type="range" min="1" max="5" value="3" /></label>
        <label>エネルギー <span id="energy-v">3</span><input id="energy" type="range" min="1" max="5" value="3" /></label>
        <label>集中 <span id="focus-v">3</span><input id="focus" type="range" min="1" max="5" value="3" /></label>
        <label>感情 <span id="emotion-v">3</span><input id="emotion" type="range" min="1" max="5" value="3" /></label>
        <label>つながり <span id="relation-v">3</span><input id="relation" type="range" min="1" max="5" value="3" /></label>
        <label>意味・方向性 <span id="purpose-v">3</span><input id="purpose" type="range" min="1" max="5" value="3" /></label>
      </div>
      <button id="diagnose-btn" class="public-btn" type="button">今日のFLOWを出す</button>
    </article>

    <article class="panel result-panel">
      <p class="kicker">FLOW MODE</p>
      <div id="mode-badge" class="mode-badge">未チェック</div>
      <h2 id="mode-title">まず、今の自分を観る。</h2>
      <p id="mode-copy">良い・悪いではなく、今日はどんな流れにいるのかを確認します。</p>
      <div class="score-row"><span>FLOW SCORE</span><strong id="flow-score">--</strong></div>
      <p id="focus-note" class="focus-note">診断すると、今日いちばん整える価値がある領域を1つ出します。</p>
    </article>
  </section>

  <section class="public-section">
    <div class="section-head"><div><p class="kicker">QUEST</p><h2>今日の3つ</h2></div><strong id="xp-total">0 XP</strong></div>
    <div id="quest-list" class="quest-grid"></div>
  </section>

  <section class="public-section wiki-shell">
    <div class="section-head"><div><p class="kicker">PERSONAL WIKI</p><h2>気づきを資産にする</h2></div><span id="wiki-count">0 notes</span></div>
    <div class="wiki-compose">
      <textarea id="wiki-note" maxlength="800" placeholder="今日わかったこと、身体感覚、判断、繰り返したくないこと、うまくいったこと…"></textarea>
      <div class="wiki-actions"><input id="wiki-tags" maxlength="120" placeholder="タグ：例 仕事, 身体, 家族" /><button id="save-note" class="public-btn" type="button">Knowledgeに追加</button></div>
    </div>
    <div class="wiki-tools"><input id="wiki-search" type="search" placeholder="Knowledgeを検索" /><button id="export-btn" type="button">JSONで書き出す</button></div>
    <div id="wiki-list" class="wiki-list"></div>
  </section>

  <section class="public-section flow-map">
    <p class="kicker">HOW IT GROWS</p>
    <div class="flow-steps"><span>観る</span><i>→</i><span>選ぶ</span><i>→</i><span>動く</span><i>→</i><span>気づく</span><i>→</i><span>知識化</span></div>
    <p>このMVPではデータをブラウザ内に保存します。将来は本人が選んだものだけをSupabaseのFLOW / Quest / Knowledge Layerへ同期できる設計に広げます。</p>
  </section>
</PublicPageLayout>

<style>
  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}.panel{border:1px solid #2e2822;background:#17130f;padding:24px}.kicker{font-size:.62rem;letter-spacing:.18em;color:#8b7355;margin:0 0 5px}.panel h2,.public-section h2{font:300 1.65rem 'Cormorant Garamond',serif;color:#c9a96e;margin:0 0 18px}.check-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px}.check-grid label{display:grid;grid-template-columns:1fr auto;gap:8px;font-size:.78rem;color:#b9aa95}.check-grid label span{color:#c9a96e}.check-grid input{grid-column:1/-1;width:100%;accent-color:#c9a96e}.mode-badge{display:inline-block;border:1px solid rgba(201,169,110,.35);padding:6px 10px;font-size:.66rem;letter-spacing:.14em;color:#c9a96e;margin-bottom:16px}.result-panel>p:not(.kicker){font-size:.82rem;line-height:1.8;color:#968876}.score-row{display:flex;align-items:end;justify-content:space-between;border-top:1px solid #2e2822;border-bottom:1px solid #2e2822;padding:16px 0;margin:18px 0}.score-row span{font-size:.62rem;letter-spacing:.14em;color:#7b6c5b}.score-row strong{font:300 2.6rem 'Cormorant Garamond',serif;color:#d6bd8e}.focus-note{padding:12px;border-left:2px solid #c9a96e;background:rgba(201,169,110,.04)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:16px}.section-head h2{margin-bottom:0}.section-head>strong,.section-head>span{font-size:.75rem;color:#c9a96e}.quest-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.quest-card{border:1px solid #2e2822;background:#14110e;padding:18px;display:grid;gap:10px}.quest-card.done{opacity:.58}.quest-card .meta{display:flex;justify-content:space-between;color:#7e705f;font-size:.68rem}.quest-card h3{font-size:.92rem;font-weight:500;margin:0;color:#d8c9ad}.quest-card p{font-size:.77rem;line-height:1.65;color:#918574;margin:0}.quest-card button{border:1px solid #4b3f31;background:transparent;color:#c9a96e;padding:10px;cursor:pointer}.wiki-shell{border:1px solid rgba(201,169,110,.14);padding:24px}.wiki-compose textarea{width:100%;min-height:110px;background:#0f0d0a;border:1px solid #312a23;color:#d7c7aa;padding:13px;font:inherit;resize:vertical}.wiki-actions,.wiki-tools{display:flex;gap:10px;margin-top:10px}.wiki-actions input,.wiki-tools input{flex:1;background:#0f0d0a;border:1px solid #312a23;color:#d7c7aa;padding:0 12px;min-height:42px}.wiki-tools button{border:1px solid #312a23;background:#17130f;color:#9f8f79;padding:0 12px}.wiki-list{display:grid;gap:10px;margin-top:16px}.wiki-card{border-top:1px solid #2c261f;padding:15px 2px 4px}.wiki-card p{font-size:.82rem;line-height:1.75;color:#c4b49c;white-space:pre-wrap}.wiki-card .wiki-meta{display:flex;gap:10px;flex-wrap:wrap;color:#776a5a;font-size:.66rem}.wiki-card button{margin-left:auto;border:0;background:transparent;color:#715f50;cursor:pointer}.flow-map{text-align:center}.flow-steps{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin:18px 0}.flow-steps span{border:1px solid #3a3128;padding:8px 12px;color:#c7b79e;font-size:.76rem}.flow-steps i{font-style:normal;color:#665846}.flow-map>p:last-child{max-width:720px;margin:0 auto;color:#7f7262;font-size:.76rem;line-height:1.8}@media(max-width:760px){.hero-grid{grid-template-columns:1fr}.check-grid{grid-template-columns:1fr}.quest-grid{grid-template-columns:1fr}.wiki-actions,.wiki-tools{display:grid}.section-head{align-items:center}}
</style>

<script is:inline>
  const KEY='flow-life-v1';
  const defaultState={xp:0,assessment:null,quests:[],notes:[]};
  let state={...defaultState};
  try{state={...defaultState,...JSON.parse(localStorage.getItem(KEY)||'{}')}}catch{}
  const save=()=>localStorage.setItem(KEY,JSON.stringify(state));
  const ids=['body','energy','focus','emotion','relation','purpose'];
  const labels={body:'身体',energy:'エネルギー',focus:'集中',emotion:'感情',relation:'つながり',purpose:'意味・方向性'};
  ids.forEach(id=>{const el=document.getElementById(id);const out=document.getElementById(id+'-v');el.addEventListener('input',()=>out.textContent=el.value)});
  const questBank={
    body:[['水を一杯、ゆっくり飲む','身体感覚を確認しながら1杯。','3分',10],['5分だけ歩く','速度ではなく呼吸と足裏を観察。','5分',15]],
    energy:[['10分だけ休む','画面を閉じ、何もしない時間をつくる。','10分',20],['机の上を1か所だけ整える','環境からエネルギー漏れを減らす。','5分',10]],
    focus:[['次の1手だけ決める','今日いちばん重要な行動を1つ書く。','3分',15],['15分シングルタスク','通知を切り、1つだけ進める。','15分',25]],
    emotion:[['感情に名前をつける','正そうとせず、今の感情を3語で書く。','3分',15],['呼吸を5回観察する','変えようとせず、吐く息を最後まで感じる。','2分',10]],
    relation:[['1人に一言送る','感謝・労い・近況のどれかを伝える。','5分',20],['誰かの話を1つ聴く','結論を急がず、質問を1回する。','10分',25]],
    purpose:[['今日やらないことを決める','目的から外れるものを1つ減らす。','3分',15],['未来から逆算する','1年後から見て今日必要なことを1つ書く。','5分',20]]
  };
  const universal=[['外に出て空を見る','視野を広げ、30秒だけ遠くを見る。','2分',10],['今日の良かった1つを書く','小さな前進を記録する。','2分',10],['未完了を1つ閉じる','2〜10分で終わるものを1つだけ完了。','10分',20]];
  function buildQuests(lowKey){const source=[...(questBank[lowKey]||[]),...universal];return source.slice(0,3).map((q,i)=>({id:Date.now()+'-'+i,title:q[0],desc:q[1],time:q[2],xp:q[3],done:false,axis:lowKey}))}
  function diagnose(){const scores=Object.fromEntries(ids.map(id=>[id,Number(document.getElementById(id).value)]));const avg=ids.reduce((a,id)=>a+scores[id],0)/ids.length;const lowKey=ids.slice().sort((a,b)=>scores[a]-scores[b])[0];let mode,title,copy;if(avg<2.2){mode='RECOVER';title='今日は、回復を最優先。';copy='足すより減らす。まず回復できる余白をつくる日。'}else if(avg<3.1){mode='RESET';title='流れを整える日。';copy='全部を変えず、詰まりを1つだけほどく。'}else if(avg<4.1){mode='BUILD';title='積み上げられる状態。';copy='小さな行動を完了させるほどFLOWが太くなる。'}else{mode='FLOW';title='流れに乗れている。';copy='今ある勢いを、意味のある方向へ使う。'}
    state.assessment={at:new Date().toISOString(),scores,avg,mode,lowKey};state.quests=buildQuests(lowKey);save();render();
    document.getElementById('mode-badge').textContent=mode;document.getElementById('mode-title').textContent=title;document.getElementById('mode-copy').textContent=copy;document.getElementById('flow-score').textContent=Math.round(avg*20);document.getElementById('focus-note').textContent=`今日の焦点：${labels[lowKey]}。ここを1段整えるQuestから始める。`;
  }
  document.getElementById('diagnose-btn').addEventListener('click',diagnose);
  function render(){document.getElementById('xp-total').textContent=`${state.xp||0} XP`;const q=document.getElementById('quest-list');q.innerHTML=(state.quests||[]).length?state.quests.map((x,i)=>`<article class="quest-card ${x.done?'done':''}"><div class="meta"><span>${labels[x.axis]||'FLOW'}</span><span>+${x.xp} XP</span></div><h3>${x.title}</h3><p>${x.desc}</p><div class="meta"><span>${x.time}</span><span>${x.done?'COMPLETE':'READY'}</span></div><button data-q="${i}" ${x.done?'disabled':''}>${x.done?'完了済み':'Quest完了'}</button></article>`).join(''):'<p class="empty">FLOW診断すると、今日のQuestが3つ出ます。</p>';q.querySelectorAll('[data-q]').forEach(btn=>btn.addEventListener('click',()=>{const x=state.quests[Number(btn.dataset.q)];if(!x.done){x.done=true;state.xp=(state.xp||0)+x.xp;save();render()}}));renderNotes()}
  function renderNotes(){const term=(document.getElementById('wiki-search')?.value||'').toLowerCase();const notes=(state.notes||[]).filter(n=>(n.text+' '+n.tags.join(' ')).toLowerCase().includes(term));document.getElementById('wiki-count').textContent=`${state.notes.length} notes`;const box=document.getElementById('wiki-list');box.innerHTML=notes.length?notes.map(n=>`<article class="wiki-card"><p>${escapeHtml(n.text)}</p><div class="wiki-meta"><span>${new Date(n.at).toLocaleString('ja-JP')}</span>${n.tags.map(t=>`<span>#${escapeHtml(t)}</span>`).join('')}<button data-del="${n.id}">削除</button></div></article>`).join(''):'<p class="empty">まだKnowledgeはありません。</p>';box.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',()=>{state.notes=state.notes.filter(n=>n.id!==b.dataset.del);save();renderNotes()}))}
  function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
  document.getElementById('save-note').addEventListener('click',()=>{const t=document.getElementById('wiki-note');const g=document.getElementById('wiki-tags');const text=t.value.trim();if(!text)return;state.notes.unshift({id:crypto.randomUUID(),at:new Date().toISOString(),text,tags:g.value.split(',').map(x=>x.trim()).filter(Boolean).slice(0,8)});state.xp=(state.xp||0)+5;t.value='';g.value='';save();render()});
  document.getElementById('wiki-search').addEventListener('input',renderNotes);
  document.getElementById('export-btn').addEventListener('click',()=>{const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`flow-life-${new Date().toISOString().slice(0,10)}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)});
  if(state.assessment){const a=state.assessment;ids.forEach(id=>{document.getElementById(id).value=a.scores[id];document.getElementById(id+'-v').textContent=a.scores[id]});document.getElementById('mode-badge').textContent=a.mode;document.getElementById('flow-score').textContent=Math.round(a.avg*20);document.getElementById('focus-note').textContent=`前回の焦点：${labels[a.lowKey]}。必要なら今日の状態で測り直す。`}
  render();
</script>