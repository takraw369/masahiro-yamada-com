        equipment: '構造・機能・整備・規格等',
        practical: '鑑別等'
      };

      const STORAGE_KEY = 'otsu6-pass-sprint-v1';
      const EXAM_DATE = new Date('2026-09-27T00:00:00+09:00');

      const $ = (id) => document.getElementById(id);
      const views = {
        dashboard: $('dashboard'),
        quiz: $('quiz'),
        results: $('results')
      };

      let stats = loadStats();
      let session = null;
      let selectedChoice = null;
      let typedAnswer = '';
      let timerId = null;

      function emptyStats() {
        return {
          answered: 0,
          correct: 0,
          byQuestion: {},
          byTopic: {}
        };
      }

      function loadStats() {
        try {
          return { ...emptyStats(), ...JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') };
        } catch {
          return emptyStats();
        }
      }

      function saveStats() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(stats));
      }

      function ensureTopic(section, topic) {
        const key = `${section}:${topic}`;
        stats.byTopic[key] ||= { answered: 0, correct: 0 };
        return stats.byTopic[key];
      }

      function recordAnswer(q, correct) {
        stats.answered += 1;
        if (correct) stats.correct += 1;
        stats.byQuestion[q.id] ||= { answered: 0, correct: 0 };
        stats.byQuestion[q.id].answered += 1;
        if (correct) stats.byQuestion[q.id].correct += 1;
        const topic = ensureTopic(q.section, q.topic);
        topic.answered += 1;
        if (correct) topic.correct += 1;
        saveStats();
        renderDashboardStats();
      }

      function scoreQuestion(q) {
        const qStat = stats.byQuestion[q.id] || { answered: 0, correct: 0 };
        const tStat = stats.byTopic[`${q.section}:${q.topic}`] || { answered: 0, correct: 0 };
        const qRate = qStat.answered ? qStat.correct / qStat.answered : 0.5;
        const tRate = tStat.answered ? tStat.correct / tStat.answered : 0.5;
        let score = 1;
        if (!qStat.answered) score += 2.5;
        score += (1 - qRate) * 4;
        score += (1 - tRate) * 3;
        if (q.section === 'equipment') score += 1.6;
        if (q.section === 'practical') score += 1.35;
        return score + Math.random() * 0.7;
      }

      function weightedPick(pool, count, used = new Set()) {
        return [...pool]
          .filter((q) => !used.has(q.id))
          .map((q) => ({ q, score: scoreQuestion(q) }))
          .sort((a, b) => b.score - a.score)
          .slice(0, count)
          .map((item) => item.q);
      }

      function buildSprint() {
        const used = new Set();
        const first = weightedPick(BANK.filter((q) => q.section === 'equipment'), 1, used)[0];
        used.add(first.id);
        const secondPool = BANK.filter((q) => ['law', 'basic'].includes(q.section));
        const second = weightedPick(secondPool, 1, used)[0];
        used.add(second.id);
        const third = weightedPick(BANK.filter((q) => q.section === 'practical'), 1, used)[0];
        return [first, second, third];
      }

      function buildWeak(count = 10) {
        return weightedPick(BANK, count);
      }

      function pickSection(section, count, used) {
        const pool = BANK.filter((q) => q.section === section);
        const shuffled = pool
          .filter((q) => !used.has(q.id))
          .map((q) => ({ q, r: Math.random() }))
          .sort((a, b) => a.r - b.r)
          .slice(0, count)
          .map((x) => x.q);
        shuffled.forEach((q) => used.add(q.id));
        return shuffled;
      }

      function buildMock() {
        const used = new Set();
        return [
          ...pickSection('law', 10, used),
          ...pickSection('basic', 5, used),
          ...pickSection('equipment', 15, used),
          ...pickSection('practical', 5, used)
        ];
      }

      function buildPractical() {
        const used = new Set();
        return pickSection('practical', 5, used);
      }

      const MODE = {
        sprint: { label: '3問 集中', title: '3問 集中', immediate: true, build: buildSprint },
        weak: { label: '弱点10', title: '弱点10', immediate: true, build: () => buildWeak(10) },
        mock: { label: '本番モード', title: '本番モード 35問', immediate: false, build: buildMock },
        practical: { label: '鑑別・記述', title: '鑑別・記述5問', immediate: true, build: buildPractical }
      };

      function startSession(mode, queueOverride = null) {
        const config = MODE[mode] || MODE.sprint;
        session = {
          mode,
          title: config.title,
          immediate: config.immediate,
          queue: queueOverride || config.build(),
          index: 0,
          answers: [],
          startedAt: Date.now()
        };
        selectedChoice = null;
        typedAnswer = '';
        $('modeLabel').textContent = config.label;
        $('feedback').hidden = true;
        showView('quiz');
        renderQuestion();
        startTimer();
      }

      function showView(name) {
        Object.entries(views).forEach(([key, el]) => el.classList.toggle('active', key === name));
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function renderQuestion() {
        const q = session.queue[session.index];
        selectedChoice = null;
        typedAnswer = '';
        $('feedback').hidden = true;
        $('submitAnswer').disabled = true;
        $('submitAnswer').textContent = session.immediate ? '回答する' : '回答を記録';
        $('questionProgress').textContent = `${session.index + 1} / ${session.queue.length}`;
        $('questionNumber').textContent = `Q${session.index + 1}`;
        $('sectionBadge').textContent = session.mode === 'mock' ? '本問' : SECTION_LABEL[q.section];
        $('questionText').textContent = q.prompt;
        $('progressBar').style.width = `${(session.index / session.queue.length) * 100}%`;

        const visualWrap = $('visualWrap');
        if (q.visual) {
          visualWrap.hidden = false;
          visualWrap.innerHTML = renderVisual(q.visual);
        } else {
          visualWrap.hidden = true;
          visualWrap.innerHTML = '';
        }

        const choiceArea = $('choiceArea');
        const textArea = $('textArea');
        choiceArea.innerHTML = '';

        if (q.type === 'choice') {
          choiceArea.hidden = false;
          textArea.hidden = true;
          q.choices.forEach((choice, index) => {
            const button = document.createElement('button');
            button.className = 'choice-button';
            button.dataset.index = String(index);
            button.innerHTML = `<span>${index + 1}</span><b>${escapeHtml(choice)}</b>`;
            button.addEventListener('click', () => selectChoice(index, button));
            choiceArea.appendChild(button);
          });
        } else {
          choiceArea.hidden = true;
          textArea.hidden = false;
          $('textAnswer').value = '';
          setTimeout(() => $('textAnswer').focus(), 50);
        }
      }

      function selectChoice(index, button) {
        selectedChoice = index;
        document.querySelectorAll('.choice-button').forEach((el) => el.classList.toggle('selected', el === button));
        $('submitAnswer').disabled = false;
      }

      function renderVisual(kind) {
        const common = `viewBox="0 0 360 200" role="img" aria-label="鑑別用模式図"`;
        if (kind === 'gauge' || kind === 'gauge-low') {
          const angle = kind === 'gauge-low' ? -52 : 0;
          return `<svg ${common}><circle cx="180" cy="100" r="76" fill="#f3f7fb" stroke="#c8d5e4" stroke-width="7"/><path d="M118 126 A70 70 0 0 1 242 126" fill="none" stroke="#35c276" stroke-width="14" stroke-linecap="round"/><g transform="rotate(${angle} 180 100)"><line x1="180" y1="100" x2="180" y2="45" stroke="#102339" stroke-width="6" stroke-linecap="round"/></g><circle cx="180" cy="100" r="9" fill="#102339"/><text x="180" y="172" text-anchor="middle" fill="#102339" font-size="18">PRESSURE</text></svg>`;
        }
        if (kind === 'safety-pin') {
          return `<svg ${common}><rect x="112" y="82" width="136" height="72" rx="22" fill="#d94a3a"/><path d="M144 82 V52 H216 V82" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round"/><circle cx="180" cy="42" r="28" fill="none" stroke="#e5b64b" stroke-width="8"/><path d="M206 42 L280 30" stroke="#e5b64b" stroke-width="5"/><text x="286" y="34" fill="currentColor" font-size="18">輪状部品</text></svg>`;
        }
        if (kind === 'hose') {
          return `<svg ${common}><rect x="80" y="64" width="90" height="92" rx="18" fill="#d94a3a"/><path d="M160 80 C220 60 255 70 275 110 C290 140 315 132 326 118" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round"/><text x="240" y="46" text-anchor="middle" font-size="18">柔軟な管</text></svg>`;
        }
        if (kind === 'horn') {
          return `<svg ${common}><rect x="70" y="72" width="80" height="84" rx="18" fill="#d94a3a"/><path d="M146 82 C190 70 205 72 224 84" fill="none" stroke="currentColor" stroke-width="12"/><path d="M220 66 L310 40 L310 126 L220 100 Z" fill="none" stroke="currentColor" stroke-width="8"/><text x="265" y="154" text-anchor="middle" font-size="18">ラッパ状</text></svg>`;
        }
        if (kind === 'gas-cartridge') {
          return `<svg ${common}><rect x="88" y="48" width="108" height="112" rx="22" fill="#d94a3a"/><rect x="212" y="66" width="42" height="86" rx="12" fill="none" stroke="currentColor" stroke-width="7"/><path d="M196 86 L216 86" stroke="currentColor" stroke-width="7"/><text x="234" y="46" text-anchor="middle" font-size="17">小容器</text></svg>`;
        }
        if (kind === 'corrosion') {
          return `<svg ${common}><rect x="120" y="32" width="120" height="132" rx="28" fill="#d94a3a"/><circle cx="148" cy="94" r="18" fill="#6e3d2c"/><circle cx="202" cy="122" r="24" fill="#6e3d2c"/><circle cx="194" cy="60" r="12" fill="#6e3d2c"/><text x="282" y="96" font-size="18">赤茶色の劣化</text></svg>`;
        }
        if (kind === 'cap-hole') {
          return `<svg ${common}><rect x="125" y="84" width="110" height="64" rx="18" fill="#d94a3a"/><rect x="142" y="58" width="76" height="38" rx="8" fill="none" stroke="currentColor" stroke-width="7"/><circle cx="210" cy="76" r="6" fill="currentColor"/><path d="M216 76 L292 52" stroke="currentColor" stroke-width="4"/><text x="300" y="50" font-size="17">小さな孔</text></svg>`;
        }
        return `<svg ${common}><rect x="130" y="38" width="100" height="122" rx="22" fill="#d94a3a"/><text x="180" y="106" text-anchor="middle" fill="white" font-size="24">消火器</text></svg>`;
      }

      function normalizeText(value) {
        return String(value || '')
          .normalize('NFKC')
          .toLowerCase()
          .replace(/[　\s・･、。,.()（）「」『』\-ー]/g, '');
      }

      function evaluate(q, raw) {
        if (q.type === 'choice') return raw === q.answer;
        const input = normalizeText(raw);
        return q.accepted.some((answer) => {
          const target = normalizeText(answer);
          if (!input || input.length < 2) return false;
          return input === target || input.includes(target) || (target.length >= 3 && target.includes(input));
        });
      }

      function currentRawAnswer() {
        const q = session.queue[session.index];
        return q.type === 'choice' ? selectedChoice : typedAnswer.trim();
      }

      function submitCurrent() {
        const q = session.queue[session.index];
        const raw = currentRawAnswer();
        if ((q.type === 'choice' && raw === null) || (q.type === 'text' && !raw)) return;

        const correct = evaluate(q, raw);
        session.answers.push({
          id: q.id,
          section: q.section,
          topic: q.topic,
          correct,
          raw
        });

        if (session.immediate) {
          recordAnswer(q, correct);
          revealFeedback(q, correct);
        } else {
          moveNextOrFinish();
        }
      }

      function revealFeedback(q, correct) {
        const feedback = $('feedback');
        feedback.hidden = false;
        feedback.className = `feedback ${correct ? 'correct' : 'wrong'}`;
        $('feedbackMark').textContent = correct ? '○' : '×';
        $('feedbackTitle').textContent = correct ? '正解' : '不正解';
        $('feedbackExplanation').textContent = q.explanation;
        $('memoryHook').textContent = q.memory;
        $('nextQuestion').textContent = session.index === session.queue.length - 1 ? '結果を見る' : '次へ';
        document.querySelectorAll('.choice-button').forEach((button) => {
          button.disabled = true;
          if (q.type === 'choice') {
            const index = Number(button.dataset.index);
            button.classList.toggle('is-correct', index === q.answer);
            button.classList.toggle('is-wrong', selectedChoice === index && index !== q.answer);
          }
        });
        $('textAnswer').disabled = true;
        $('submitAnswer').disabled = true;
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function moveNextOrFinish() {
        if (session.index >= session.queue.length - 1) {
          finishSession();
          return;
        }
        session.index += 1;
        $('textAnswer').disabled = false;
        renderQuestion();
      }

      function nextFromFeedback() {
        moveNextOrFinish();
      }

      function finishSession() {
        clearInterval(timerId);
        if (!session.immediate) {
          session.answers.forEach((a) => {
            const q = BANK.find((item) => item.id === a.id);
            if (q) recordAnswer(q, a.correct);
          });
        }

        const total = session.answers.length;
        const correct = session.answers.filter((a) => a.correct).length;
        $('resultTitle').textContent = session.title;
        $('scoreMain').textContent = `${correct}/${total}`;
        const scorePercent = Math.round((correct / Math.max(total, 1)) * 100);
        $('scoreRate').textContent = `${scorePercent}%`;
        document.querySelector('.score-ring')?.style.setProperty('--score-pct', `${scorePercent}%`);

        renderSectionScores();
        renderPassJudge();
        renderResultWeakness();
        $('retryWrong').hidden = !session.answers.some((a) => !a.correct);
        showView('results');
      }

      function renderSectionScores() {
        const wrap = $('sectionScores');
        wrap.innerHTML = '';
        ['law', 'basic', 'equipment', 'practical'].forEach((section) => {
          const items = session.answers.filter((a) => a.section === section);
          if (!items.length) return;
          const correct = items.filter((a) => a.correct).length;
          const rate = Math.round((correct / items.length) * 100);
          const row = document.createElement('div');
          row.innerHTML = `<span>${SECTION_LABEL[section]}</span><b>${correct}/${items.length}</b><i>${rate}%</i>`;
          wrap.appendChild(row);
        });
      }

      function renderPassJudge() {
        const box = $('passJudge');
        box.className = 'pass-judge';

        if (session.mode !== 'mock' || session.answers.length < 35) {
          box.textContent = 'このセッションでは正答率70%以上を安定目標に。';
          return;
        }

        const group = (section) => {
          const items = session.answers.filter((a) => a.section === section);
          return {
            total: items.length,
            correct: items.filter((a) => a.correct).length
          };
        };
        const law = group('law');
        const basic = group('basic');
        const equipment = group('equipment');
        const practical = group('practical');
        const writtenCorrect = law.correct + basic.correct + equipment.correct;
        const writtenTotal = law.total + basic.total + equipment.total;

        const passed =
          law.correct / law.total >= 0.4 &&
          basic.correct / basic.total >= 0.4 &&
          equipment.correct / equipment.total >= 0.4 &&
          writtenCorrect / writtenTotal >= 0.6 &&
          practical.correct / practical.total >= 0.6;

        box.classList.add(passed ? 'passed' : 'failed');
        box.innerHTML = passed
          ? '<strong>合格ライン クリア</strong><span>次は70％超を安定させる。</span>'
          : '<strong>合格ライン 未達</strong><span>足切り or 総合点の弱点を下で確認。</span>';
      }

      function renderResultWeakness() {
        const misses = session.answers.filter((a) => !a.correct);
        const wrap = $('resultWeakness');
        if (!misses.length) {
          wrap.innerHTML = '<strong>弱点</strong><p>このセットは全問正解。次は難度を上げて継続。</p>';
          return;
        }
        const count = {};
        misses.forEach((a) => {
          const key = `${SECTION_LABEL[a.section]}・${a.topic}`;
          count[key] = (count[key] || 0) + 1;
        });
        const top = Object.entries(count).sort((a, b) => b[1] - a[1]).slice(0, 3);
        wrap.innerHTML = `<strong>最優先弱点</strong><ol>${top.map(([key, n]) => `<li>${escapeHtml(key)} <small>×${n}</small></li>`).join('')}</ol>`;
      }

      function retryWrong() {
        const wrongIds = session.answers.filter((a) => !a.correct).map((a) => a.id);
        const queue = wrongIds.map((id) => BANK.find((q) => q.id === id)).filter(Boolean);
        if (!queue.length) return;
        startSession('weak', queue);
      }

      function quitSession() {
        if (session && session.answers.length > 0) {
          const ok = confirm('このセッションを終了しますか？回答済みの学習記録は保存されています。');
          if (!ok) return;
        }
        clearInterval(timerId);
        session = null;
        showView('dashboard');
      }

      function renderDashboardStats() {
        $('answeredCount').textContent = String(stats.answered || 0);
        $('accuracyRate').textContent = stats.answered ? String(Math.round((stats.correct / stats.answered) * 100)) : '--';
        const entries = Object.entries(stats.byTopic || {}).filter(([, value]) => value.answered > 0);
        if (!entries.length) {
          $('weakestTopic').textContent = 'まだデータなし';
          $('weakestMeta').textContent = 'まず3問から開始';
          return;
        }
        const weakest = entries
          .map(([key, value]) => ({ key, value, rate: value.correct / value.answered }))
          .sort((a, b) => a.rate - b.rate || b.value.answered - a.value.answered)[0];
        const [section, topic] = weakest.key.split(':');
        $('weakestTopic').textContent = topic;
        $('weakestMeta').textContent = `${SECTION_LABEL[section]} / ${Math.round(weakest.rate * 100)}%`;
      }

      function startTimer() {
        clearInterval(timerId);
        const update = () => {
          const elapsed = Math.floor((Date.now() - session.startedAt) / 1000);
          const min = String(Math.floor(elapsed / 60)).padStart(2, '0');
          const sec = String(elapsed % 60).padStart(2, '0');
          $('timer').textContent = `${min}:${sec}`;
        };
        update();
        timerId = setInterval(update, 1000);
      }

      function escapeHtml(value) {
        return String(value)
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#039;');
      }

      function updateCountdown() {
        const now = new Date();
        const diff = EXAM_DATE - now;
        const days = Math.max(0, Math.ceil(diff / 86400000));
        $('daysLeft').textContent = String(days);
      }

      document.querySelectorAll('[data-mode]').forEach((button) => {
        button.addEventListener('click', () => startSession(button.dataset.mode));
      });

      $('submitAnswer').addEventListener('click', submitCurrent);
      $('nextQuestion').addEventListener('click', nextFromFeedback);
      $('quitQuiz').addEventListener('click', quitSession);
      $('backDashboard').addEventListener('click', () => {
        session = null;
        showView('dashboard');
      });
      $('retryWrong').addEventListener('click', retryWrong);
      $('textAnswer').addEventListener('input', (event) => {
        typedAnswer = event.target.value;
        $('submitAnswer').disabled = !typedAnswer.trim();
      });
      $('textAnswer').addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && !$('submitAnswer').disabled) submitCurrent();
      });
      document.addEventListener('keydown', (event) => {
        if (!views.quiz.classList.contains('active')) return;
        const q = session?.queue?.[session.index];
        if (!q || !$('feedback').hidden) {
          if (event.key === 'Enter' && !$('feedback').hidden) nextFromFeedback();
          return;
        }
        if (q.type === 'choice' && ['1', '2', '3', '4'].includes(event.key)) {
          const button = document.querySelector(`.choice-button[data-index="${Number(event.key) - 1}"]`);
          button?.click();
        } else if (event.key === 'Enter' && !$('submitAnswer').disabled) {
          submitCurrent();
        }
      });

      renderDashboardStats();
      updateCountdown();
    </script>

    <style>
      :root {
        color-scheme: dark;
        --bg: #07111f;
        --panel: #0d1a2b;
        --panel-2: #122238;
        --line: #203653;
        --text: #f2f6fb;
        --muted: #98abc1;
        --accent: #62d6a8;
        --accent-2: #7cc7ff;
        --warning: #f2bd5d;
        --danger: #ff7f75;
        --success: #5ad59a;
      }

      * { box-sizing: border-box; }

      html {
        background: var(--bg);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic UI", "Yu Gothic", sans-serif;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          radial-gradient(circle at 15% 0%, rgba(98, 214, 168, .10), transparent 28rem),
          radial-gradient(circle at 95% 14%, rgba(124, 199, 255, .09), transparent 30rem),
          var(--bg);
      }

      button, input { font: inherit; }
      button { color: inherit; }

      .app-shell {
        width: min(960px, calc(100% - 28px));
        margin: 0 auto;
        padding: 34px 0 42px;
      }

      .view { display: none; }
      .view.active { display: block; }

      .hero {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin: 20px 0 28px;
      }

      .eyebrow {
        margin: 0 0 8px;
        color: var(--accent);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      h1, h2, p { margin-top: 0; }

      h1 {
        margin-bottom: 10px;
        font-size: clamp(34px, 6vw, 58px);
        line-height: 1.05;
        letter-spacing: -.04em;
      }

      .hero-copy {
        max-width: 620px;
        margin-bottom: 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.8;
      }

      .countdown {
        flex: 0 0 auto;
        min-width: 112px;
        padding: 14px 18px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: rgba(13, 26, 43, .82);
        text-align: center;
      }

      .countdown span, .countdown small {
        display: block;
        color: var(--muted);
        font-size: 11px;
      }

      .countdown strong {
        display: inline-block;
        margin: 3px 4px;
        color: var(--warning);
        font-size: 38px;
        line-height: 1;
      }

      .status-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 2fr;
        gap: 12px;
        margin-bottom: 16px;
      }

      .status-card, .exam-card, .mode-card, .quick-note, .question-card, .feedback, .result-card {
        border: 1px solid var(--line);
        background: rgba(13, 26, 43, .9);
        box-shadow: 0 16px 50px rgba(0, 0, 0, .18);
      }

      .status-card {
        min-height: 105px;
        padding: 17px;
        border-radius: 16px;
      }

      .status-card span, .status-card small {
        display: block;
        color: var(--muted);
        font-size: 11px;
      }

      .status-card strong {
        display: inline-block;
        max-width: 100%;
        margin: 9px 4px 4px 0;
        overflow: hidden;
        color: var(--text);
        font-size: 26px;
        line-height: 1.1;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .status-card.wide strong { font-size: 20px; }

      .exam-card {
        padding: 22px;
        border-radius: 18px;
      }

      .exam-card h2 { margin-bottom: 18px; font-size: 22px; }

      .exam-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
      }

      .exam-grid div {
        padding: 14px 10px;
        border: 1px solid #1d304a;
        border-radius: 13px;
        background: #0a1727;
        text-align: center;
      }

      .exam-grid b, .exam-grid span, .exam-grid small { display: block; }
      .exam-grid b { font-size: 12px; }
      .exam-grid span { margin: 5px 0; font-size: 20px; font-weight: 800; }
      .exam-grid small { color: var(--muted); font-size: 10px; }

      .pass-note {
        margin: 16px 0 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.7;
      }

      .mode-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin: 16px 0;
      }

      .mode-card {
        min-height: 150px;
        padding: 20px;
        border-radius: 18px;
        cursor: pointer;
        text-align: left;
        transition: transform .16s ease, border-color .16s ease, background .16s ease;
      }

      .mode-card:hover {
        transform: translateY(-2px);
        border-color: #3c5c80;
        background: #11223a;
      }

      .mode-card.primary {
        border-color: rgba(98, 214, 168, .52);
        background: linear-gradient(145deg, rgba(31, 94, 78, .62), rgba(13, 26, 43, .98));
      }

      .mode-kicker {
        display: block;
        margin-bottom: 12px;
        color: var(--accent);
        font-size: 11px;
        font-weight: 800;
      }

      .mode-card strong { display: block; margin-bottom: 8px; font-size: 22px; }
      .mode-card small { color: var(--muted); line-height: 1.55; }

      .quick-note {
        padding: 18px 20px;
        border-radius: 16px;
      }

      .quick-note strong { font-size: 13px; }
      .quick-note p { margin: 6px 0 0; color: var(--muted); font-size: 12px; line-height: 1.7; }

      .quiz-header {
        display: grid;
        grid-template-columns: 48px 1fr 68px;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
      }

      .icon-button {
        width: 44px;
        height: 44px;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: var(--panel);
        cursor: pointer;
        font-size: 20px;
      }

      .quiz-meta span, .quiz-meta strong { display: block; }
      .quiz-meta span { color: var(--muted); font-size: 11px; }
      .quiz-meta strong { margin-top: 2px; }
      .timer { color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }

      .progress-track {
        width: 100%;
        height: 5px;
        margin-bottom: 18px;
        overflow: hidden;
        border-radius: 100px;
        background: #152840;
      }

      .progress-track i {
        display: block;
        width: 0;
        height: 100%;
        border-radius: inherit;
        background: var(--accent);
        transition: width .22s ease;
      }

      .question-card {
        padding: clamp(22px, 5vw, 42px);
        border-radius: 24px;
      }

      .question-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
      }

      .question-topline > span:first-child {
        color: var(--accent);
        font-weight: 900;
        font-size: 13px;
      }

      .section-badge {
        padding: 6px 9px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        font-size: 10px;
      }

      .question-card h2 {
        margin: 0 0 24px;
        font-size: clamp(20px, 3vw, 27px);
        line-height: 1.6;
        letter-spacing: -.01em;
      }

      .visual-wrap {
        margin: 0 0 22px;
        padding: 10px;
        border: 1px solid #213956;
        border-radius: 16px;
        background: #f7fafc;
        color: #17304a;
      }

      .visual-wrap svg { display: block; width: 100%; max-height: 220px; }

      .choice-area { display: grid; gap: 10px; }

      .choice-button {
        display: grid;
        grid-template-columns: 34px 1fr;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #263f5d;
        border-radius: 14px;
        background: #0a1727;
        cursor: pointer;
        text-align: left;
        transition: border-color .14s ease, background .14s ease, transform .14s ease;
      }

      .choice-button:hover { transform: translateY(-1px); border-color: #48709b; }

      .choice-button span {
        display: grid;
        width: 30px;
        height: 30px;
        place-items: center;
        border: 1px solid #314d6d;
        border-radius: 9px;
        color: var(--muted);
        font-weight: 800;
      }

      .choice-button b { font-size: 14px; font-weight: 650; line-height: 1.5; }
      .choice-button.selected { border-color: var(--accent-2); background: #102b42; }
      .choice-button.is-correct { border-color: var(--success); background: rgba(53, 194, 118, .11); }
      .choice-button.is-wrong { border-color: var(--danger); background: rgba(255, 127, 117, .10); }

      .text-area label { display: block; margin-bottom: 8px; color: var(--muted); font-size: 12px; }

      .text-area input {
        width: 100%;
        padding: 16px;
        border: 1px solid #304c6d;
        outline: none;
        border-radius: 14px;
        background: #081625;
        color: var(--text);
        font-size: 18px;
      }

      .text-area input:focus { border-color: var(--accent-2); box-shadow: 0 0 0 3px rgba(124, 199, 255, .1); }

      .submit-button, .next-button, .ghost-button {
        width: 100%;
        min-height: 50px;
        border-radius: 13px;
        cursor: pointer;
        font-weight: 850;
      }

      .submit-button {
        margin-top: 20px;
        border: 0;
        background: var(--accent);
        color: #062016;
      }

      .submit-button:disabled { cursor: not-allowed; opacity: .35; }

      .feedback {
        margin-top: 14px;
        padding: 20px;
        border-radius: 18px;
      }

      .feedback.correct { border-color: rgba(90, 213, 154, .45); }
      .feedback.wrong { border-color: rgba(255, 127, 117, .45); }

      .feedback-result { display: flex; align-items: center; gap: 10px; }
      .feedback-result strong { font-size: 30px; }
      .feedback.correct .feedback-result strong { color: var(--success); }
      .feedback.wrong .feedback-result strong { color: var(--danger); }
      .feedback-result span { font-size: 18px; font-weight: 900; }
      .feedback p { margin: 12px 0; color: #c4d1df; font-size: 13px; line-height: 1.75; }

      .memory-hook {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding: 10px 12px;
        border-radius: 11px;
        background: #081625;
      }

      .memory-hook span { color: var(--warning); font-size: 10px; font-weight: 850; }
      .memory-hook b { font-size: 13px; }

      .next-button { border: 0; background: #edf5fb; color: #07111f; }

      .result-card {
        padding: clamp(22px, 5vw, 42px);
        text-align: center;
        border-radius: 24px;
      }

      .result-card h2 { margin: 0 0 18px; }

      .score-ring {
        width: 160px;
        height: 160px;
        margin: 0 auto 20px;
        border-radius: 50%;
        display: grid;
        place-content: center;
        background:
          radial-gradient(circle at center, var(--panel) 56%, transparent 57%),
          conic-gradient(var(--accent) 0 var(--score-pct, 0%), #263a55 var(--score-pct, 0%) 100%);
        border: 1px solid var(--line);
      }

      .score-ring strong { display: block; font-size: 36px; }
      .score-ring span { color: var(--muted); font-size: 14px; }

      .section-scores {
        display: grid;
        gap: 8px;
        margin: 18px auto;
        max-width: 560px;
        text-align: left;
      }

      .section-scores div {
        display: grid;
        grid-template-columns: 1fr 64px 50px;
        align-items: center;
        gap: 8px;
        padding: 11px 13px;
        border: 1px solid #203653;
        border-radius: 11px;
        background: #091727;
      }

      .section-scores span { color: var(--muted); font-size: 12px; }
      .section-scores b, .section-scores i { text-align: right; font-size: 12px; font-style: normal; }

      .pass-judge, .result-weakness {
        max-width: 560px;
        margin: 12px auto;
        padding: 15px;
        border-radius: 13px;
        background: #091727;
        text-align: left;
      }

      .pass-judge { color: var(--muted); font-size: 12px; }
      .pass-judge strong, .pass-judge span { display: block; }
      .pass-judge strong { margin-bottom: 4px; color: var(--text); font-size: 16px; }
      .pass-judge.passed { border: 1px solid rgba(90, 213, 154, .45); }
      .pass-judge.failed { border: 1px solid rgba(255, 127, 117, .45); }

      .result-weakness strong { font-size: 12px; }
      .result-weakness p, .result-weakness ol { margin: 8px 0 0; color: var(--muted); font-size: 12px; line-height: 1.7; }
      .result-weakness ol { padding-left: 22px; }
      .result-weakness small { color: var(--danger); }

      .result-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        max-width: 560px;
        margin: 18px auto 0;
      }

      .result-actions .submit-button { margin-top: 0; }
      .ghost-button { border: 1px solid var(--line); background: transparent; }

      .app-footer {
        width: min(960px, calc(100% - 28px));
        margin: 0 auto;
        padding: 0 0 40px;
        color: #6f8298;
        font-size: 10px;
        line-height: 1.7;
      }

      .app-footer p { margin-bottom: 6px; }
      .app-footer a { color: #8ba7c4; }

      @media (max-width: 680px) {
        .app-shell { width: min(100% - 20px, 960px); padding-top: 16px; }
        .hero { gap: 14px; margin-top: 10px; }
        h1 { font-size: 35px; }
        .hero-copy { font-size: 13px; }
        .countdown { min-width: 88px; padding: 12px; }
        .countdown strong { font-size: 31px; }
        .status-grid { grid-template-columns: 1fr 1fr; }
        .status-card.wide { grid-column: 1 / -1; }
        .exam-grid { grid-template-columns: 1fr 1fr; }
        .mode-grid { grid-template-columns: 1fr; }
        .mode-card { min-height: 122px; }
        .question-card { padding: 18px 14px; border-radius: 17px; }
        .question-card h2 { font-size: 19px; }
        .choice-button { padding: 12px 11px; }
        .result-actions { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
