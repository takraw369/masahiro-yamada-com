---
import { ViewTransitions } from 'astro:transitions';

const title = "ACE METHOD — 脳が変われば、すべてが変わる";
const description = "元日本代表が脳科学で解き明かす、アスリートの認知変容メソッド";
const ogUrl = "https://masahiro-yamada.com";
const ogImage = "https://masahiro-yamada.com/og.png";
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- OGP -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap" rel="stylesheet" />

  <ViewTransitions />

  <style>
    :root {
      --bg-void:        #0D0B08;
      --bg-surface:     #1A1612;
      --bg-elevated:    #241F1A;
      --gold-pure:      #C9A96E;
      --gold-muted:     #8B7355;
      --gold-dim:       #5A4D3A;
      --gold-glow:      rgba(201, 169, 110, 0.08);
      --text-primary:   #D4C5A9;
      --text-muted:     #7A6F5F;
      --text-dim:       #4A4030;
      --border-default: #2E2822;
      --border-hover:   #8B7355;
      --border-accent:  rgba(201, 169, 110, 0.2);
      --accent-line:    #06C755;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg-void);
      color: var(--text-primary);
      font-family: 'Zen Kaku Gothic New', sans-serif;
      font-weight: 300;
      line-height: 1.7;
      overflow-x: hidden;
    }

    /* Ambient glow */
    .ambient {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: radial-gradient(
        ellipse at 30% 20%,
        rgba(139, 115, 85, 0.04) 0%,
        transparent 50%
      );
      pointer-events: none;
      z-index: 0;
    }

    /* Section label */
    .section-label {
      font-family: 'Cormorant Garamond', serif;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 6px;
      color: var(--gold-muted);
      text-transform: uppercase;
      display: block;
      margin-bottom: 40px;
    }

    /* Divider */
    .divider {
      width: 48px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold-muted), transparent);
      margin: 24px auto;
    }

    /* Buttons */
    .btn-primary {
      display: inline-block;
      background: linear-gradient(135deg, var(--gold-muted), var(--gold-dim));
      color: var(--bg-void);
      padding: 14px 48px;
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 3px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
    }
