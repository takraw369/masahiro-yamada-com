---
import Public from '../layouts/Public.astro';
---
<Public title="ホーム">
  <section style="padding: 6rem 0 4rem;">
    <h1 style="font-family: var(--font-display-en); font-size: 3rem; font-weight: 400; margin: 0 0 1rem;">
      Masahiro Yamada
    </h1>
    <div style="margin: 0 0 2rem;">
      <p style="font-family: var(--font-display-jp); font-size: 1.05rem; color: var(--pub-text); margin: 0 0 0.5rem;">
        セパタクロー元日本代表 ─ ACE Method 創始者
      </p>
      <p style="font-family: var(--font-display-en); font-style: italic; font-size: 0.95rem; color: var(--pub-muted); margin: 0;">
        身体感覚から無意識を書き換える
      </p>
    </div>
    <nav style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
      <a href="/about">About →</a>
      <a href="/thoughts">Thoughts →</a>
      <a href="/legacy">Legacy →</a>
      <a href="/contact">Contact →</a>
    </nav>
  </section>
</Public>
