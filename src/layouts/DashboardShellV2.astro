---
export interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = 'MASA OS' } = Astro.props;
const pathname = Astro.url.pathname;

const navGroups = [
  {
    label: 'NOW',
    items: [
      { href: '/dashboard/ui-v2', label: 'Today', mark: '01' },
      { href: '/dashboard/voice', label: 'Voice Inbox', mark: '02' },
      { href: '/dashboard/schedule', label: 'Calendar', mark: '03' },
    ],
  },
  {
    label: 'CREATE',
    items: [
      { href: '/dashboard/post', label: 'X Post', mark: '04' },
      { href: '/dashboard/visual-prompt', label: 'Visual Prompt', mark: '05' },
      { href: '/dashboard/funnel', label: 'Trinity Funnel', mark: '06' },
    ],
  },
  {
    label: 'THINK',
    items: [
      { href: '/dashboard/intelligence', label: 'Intelligence', mark: '07' },
      { href: '/dashboard/evidence', label: 'Evidence Lab', mark: '08' },
      { href: '/dashboard/graph', label: 'Graph', mark: '09' },
    ],
  },
  {
    label: 'BUILD',
    items: [
      { href: '/dashboard/flow-09', label: '0→9 Flow', mark: '10' },
      { href: '/dashboard/quest', label: 'Quest', mark: '11' },
      { href: '/dashboard/lian', label: 'リアン', mark: '12' },
    ],
  },
  {
    label: 'ASSETS',
    items: [
      { href: '/dashboard/treasury', label: 'Treasury', mark: '13' },
      { href: '/dashboard/investment', label: 'Investment', mark: '14' },
      { href: '/dashboard/wishlist', label: 'Wish List', mark: '15' },
    ],
  },
];

function isActive(href: string): boolean {
  if (href === '/dashboard/ui-v2') return pathname === href;
  return pathname.startsWith(href);
}
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} — MASA OS V2</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      * { margin: 0; }
      :root {
        --bg: #0d0b08;
        --panel: #15120f;
        --panel-2: #1b1713;
        --panel-3: #211b16;
        --gold: #c9a96e;
        --gold-muted: #8b7355;
        --gold-dim: #5a4d3a;
        --text: #e1d5bf;
        --muted: #9a8d7a;
        --dim: #665b4d;
        --line: #2d2822;
        --line-strong: #4a4034;
        --success: #7ea482;
        --warning: #c99a5c;
        --sidebar: 228px;
      }

      html { background: var(--bg); color-scheme: dark; }
      body {
        min-height: 100vh;
        background:
          radial-gradient(circle at 18% 0%, rgba(201,169,110,.05), transparent 34%),
          var(--bg);
        color: var(--text);
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-weight: 300;
        letter-spacing: .01em;
      }
      button, a { font: inherit; }
      a { color: inherit; }

      .app {
        display: grid;
        grid-template-columns: var(--sidebar) minmax(0, 1fr);
        min-height: 100vh;
      }

      .sidebar {
        position: fixed;
        inset: 0 auto 0 0;
        width: var(--sidebar);
        display: flex;
        flex-direction: column;
        background: rgba(21,18,15,.96);
        border-right: 1px solid var(--line);
        z-index: 50;
        overflow-y: auto;
      }

      .brand {
        padding: 26px 20px 20px;
        border-bottom: 1px solid var(--line);
      }
      .brand-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.72rem;
        font-weight: 300;
        color: var(--gold);
        letter-spacing: .06em;
      }
      .brand-sub {
        margin-top: 4px;
        color: var(--dim);
        font-size: .64rem;
        letter-spacing: .18em;
        text-transform: uppercase;
      }

      .nav { padding: 16px 12px 24px; }
      .nav-group + .nav-group { margin-top: 18px; }
      .nav-label {
        padding: 0 9px 7px;
        color: var(--dim);
        font-family: 'Cormorant Garamond', serif;
        font-size: .63rem;
        letter-spacing: .2em;
      }
      .nav-item {
        min-height: 40px;
        display: grid;
        grid-template-columns: 26px 1fr;
        align-items: center;
        gap: 8px;
        padding: 0 9px;
        border: 1px solid transparent;
        color: var(--muted);
        text-decoration: none;
        font-size: .78rem;
        transition: border-color .18s ease, background .18s ease, color .18s ease;
      }
      .nav-item:hover {
        color: var(--text);
        background: rgba(201,169,110,.045);
        border-color: var(--line);
      }
      .nav-item.active {
        color: var(--gold);
        background: rgba(201,169,110,.07);
        border-color: rgba(201,169,110,.22);
      }
      .nav-mark {
        color: var(--gold-dim);
        font-family: 'Cormorant Garamond', serif;
        font-size: .72rem;
      }

      .sidebar-foot {
        margin-top: auto;
        padding: 14px 20px 18px;
        border-top: 1px solid var(--line);
      }
      .legacy-link,
      .logout-link {
        display: block;
        padding: 8px 0;
        color: var(--dim);
        font-size: .7rem;
        text-decoration: none;
      }
      .legacy-link:hover,
      .logout-link:hover { color: var(--muted); }

      .main {
        grid-column: 2;
        min-width: 0;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 30;
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 0 28px;
        background: rgba(13,11,8,.9);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(12px);
      }
      .page-meta { min-width: 0; }
      .eyebrow {
        color: var(--gold-muted);
        font-family: 'Cormorant Garamond', serif;
        font-size: .63rem;
        letter-spacing: .2em;
        text-transform: uppercase;
      }
      .page-title {
        margin-top: 1px;
        color: var(--text);
        font-size: .88rem;
        font-weight: 400;
      }
      .top-actions { display: flex; align-items: center; gap: 8px; }
      .command-button,
      .menu-button {
        min-height: 36px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--muted);
        cursor: pointer;
      }
      .command-button { padding: 0 12px; font-size: .7rem; }
      .command-button:hover,
      .menu-button:hover { border-color: var(--gold-dim); color: var(--text); }
      .menu-button {
        display: none;
        width: 38px;
        place-items: center;
        font-size: 1rem;
      }

      .content { padding: 26px 28px 52px; }
      .content-inner { max-width: 1380px; margin: 0 auto; }

      .overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.58);
        z-index: 40;
      }
      .overlay.visible { display: block; }

      @media (max-width: 900px) {
        .app { display: block; }
        .sidebar {
          transform: translateX(-100%);
          transition: transform .22s ease;
        }
        .sidebar.open { transform: translateX(0); }
        .main { min-width: 0; }
        .menu-button { display: grid; }
        .topbar { padding: 0 16px; }
        .content { padding: 20px 14px 42px; }
        .command-button { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="overlay" id="dashboard-v2-overlay"></div>
    <div class="app">
      <aside class="sidebar" id="dashboard-v2-sidebar">
        <div class="brand">
          <div class="brand-title">MASA OS</div>
          <div class="brand-sub">Command Center · V2 Preview</div>
        </div>

        <nav class="nav" aria-label="Dashboard navigation">
          {navGroups.map(group => (
            <section class="nav-group">
              <p class="nav-label">{group.label}</p>
              {group.items.map(item => (
                <a href={item.href} class:list={['nav-item', { active: isActive(item.href) }]}>
                  <span class="nav-mark">{item.mark}</span>
                  <span>{item.label}</span>
                </a>
              ))}
            </section>
          ))}
        </nav>

        <div class="sidebar-foot">
          <a class="legacy-link" href="/dashboard">現行Dashboardへ</a>
          <a class="logout-link" href="/dashboard/logout">ログアウト</a>
        </div>
      </aside>

      <main class="main">
        <header class="topbar">
          <div class="page-meta">
            <p class="eyebrow">{eyebrow}</p>
            <p class="page-title">{title}</p>
          </div>
          <div class="top-actions">
            <button class="command-button" type="button" data-command-trigger>⌘ K · Quick Jump</button>
            <button class="menu-button" id="dashboard-v2-menu" type="button" aria-label="メニューを開く">≡</button>
          </div>
        </header>

        <div class="content">
          <div class="content-inner">
            <slot />
          </div>
        </div>
      </main>
    </div>

    <script>
      const sidebar = document.getElementById('dashboard-v2-sidebar');
      const overlay = document.getElementById('dashboard-v2-overlay');
      const menu = document.getElementById('dashboard-v2-menu');

      const open = () => {
        sidebar?.classList.add('open');
        overlay?.classList.add('visible');
      };
      const close = () => {
        sidebar?.classList.remove('open');
        overlay?.classList.remove('visible');
      };

      menu?.addEventListener('click', open);
      overlay?.addEventListener('click', close);
    </script>
  </body>
</html>
