---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const {
  title,
  description = '山田昌寛（MASA）公式サイト。元日本代表アスリートとしての身体知を、教育・コーチング・人の可能性を惹き出す仕組みへ変換する。',
  eyebrow = 'MASA / MASAHIRO YAMADA',
} = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <title>{title} | 山田昌寛 / MASA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --bg-void: #0d0b08;
        --bg-surface: #1a1612;
        --bg-elevated: #241f1a;
        --gold-pure: #c9a96e;
        --gold-muted: #8b7355;
        --gold-dim: #5a4d3a;
        --gold-glow: rgba(201, 169, 110, 0.08);
        --text-primary: #d4c5a9;
        --text-muted: #8f8372;
        --text-dim: #5f5447;
        --border-default: #2e2822;
        --border-accent: rgba(201, 169, 110, 0.22);
        --line: #06c755;
        --danger: #d18b7c;
        --success: #8fbd91;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg-void);
        color: var(--text-primary);
        font-family: 'Zen Kaku Gothic New', sans-serif;
        font-weight: 300;
        line-height: 1.8;
      }
      a { color: inherit; }
      button, input, select, textarea { font: inherit; }
      .public-shell { width: min(960px, calc(100% - 40px)); margin: 0 auto; }
      .public-wide { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }

      .public-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(13, 11, 8, 0.9);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border-default);
      }
      .public-header-inner {
        min-height: 66px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }
      .public-brand {
        text-decoration: none;
        font-family: 'Cormorant Garamond', serif;
        font-size: 18px;
        letter-spacing: .08em;
        color: var(--gold-pure);
      }
      .public-nav { display: flex; flex-wrap: wrap; gap: 18px; }
      .public-nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 12px;
        letter-spacing: .06em;
      }
      .public-nav a:hover { color: var(--gold-pure); }

      .public-main { min-height: calc(100vh - 180px); padding: 64px 0 88px; }
      .public-eyebrow {
        margin: 0 0 12px;
        color: var(--gold-muted);
        font-family: 'Cormorant Garamond', serif;
        font-size: 11px;
        letter-spacing: .22em;
        text-transform: uppercase;
      }
      .public-title {
        margin: 0;
        font-family: 'Cormorant Garamond', serif;
        font-weight: 300;
        font-size: clamp(2.4rem, 7vw, 4.7rem);
        line-height: 1;
        color: var(--text-primary);
      }
      .public-lead {
        max-width: 720px;
        margin: 22px 0 0;
        color: var(--text-muted);
        font-size: .95rem;
      }
      .public-hero { padding-bottom: 40px; border-bottom: 1px solid var(--border-default); }
      .public-section { margin-top: 44px; }
      .public-section h2 {
        margin: 0 0 16px;
        font-family: 'Cormorant Garamond', serif;
        font-weight: 300;
        font-size: 2rem;
        color: var(--gold-pure);
      }
      .public-section h3 { margin: 28px 0 10px; font-size: 1rem; color: var(--text-primary); }
      .public-section p, .public-section li { color: var(--text-muted); }
      .public-section ul, .public-section ol { padding-left: 1.35rem; }
      .public-section strong { color: var(--text-primary); font-weight: 500; }

      .public-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-default);
        padding: 24px;
      }
      .public-card + .public-card { margin-top: 12px; }
      .public-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }

      .public-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 12px 22px;
        border: 1px solid var(--border-accent);
        background: var(--gold-glow);
        color: var(--gold-pure);
        text-decoration: none;
        cursor: pointer;
        transition: border-color .2s, background .2s, transform .2s;
      }
      .public-btn:hover { border-color: var(--gold-muted); background: var(--bg-elevated); transform: translateY(-1px); }
      .public-btn-line { background: var(--line); border-color: var(--line); color: #fff; font-weight: 500; }
      .public-btn-line:hover { background: #05b94f; border-color: #05b94f; }

      .public-muted { color: var(--text-dim); font-size: .82rem; }
      .public-callout { border-left: 2px solid var(--gold-muted); padding: 10px 0 10px 18px; color: var(--text-muted); }
      .public-divider { height: 1px; background: var(--border-default); margin: 34px 0; }

      .public-footer { border-top: 1px solid var(--border-default); padding: 30px 0 38px; }
      .public-footer-links { display: flex; flex-wrap: wrap; gap: 14px 22px; margin-bottom: 18px; }
      .public-footer-links a { color: var(--text-dim); text-decoration: none; font-size: 12px; }
      .public-footer-links a:hover { color: var(--text-muted); }
      .public-copy { color: var(--text-dim); font-size: 11px; letter-spacing: .05em; }

      @media (max-width: 720px) {
        .public-shell, .public-wide { width: min(100% - 28px, 960px); }
        .public-header-inner { min-height: 60px; align-items: flex-start; flex-direction: column; padding: 13px 0; gap: 9px; }
        .public-nav { gap: 10px 14px; }
        .public-main { padding-top: 44px; }
        .public-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header class="public-header">
      <div class="public-wide public-header-inner">
        <a class="public-brand" href="/">MASA / 山田昌寛</a>
        <nav class="public-nav" aria-label="メインナビゲーション">
          <a href="/story">Story</a>
          <a href="/profile">Profile</a>
          <a href="/philosophy">Philosophy</a>
          <a href="/library">Library</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main class="public-main">
      <div class="public-shell">
        <header class="public-hero">
          <p class="public-eyebrow">{eyebrow}</p>
          <h1 class="public-title">{title}</h1>
          <slot name="lead" />
        </header>
        <slot />
      </div>
    </main>

    <footer class="public-footer">
      <div class="public-wide">
        <nav class="public-footer-links" aria-label="フッターナビゲーション">
          <a href="/">Home</a>
          <a href="/story">Story</a>
          <a href="/profile">Profile</a>
          <a href="/philosophy">Philosophy</a>
          <a href="/library">Library</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
          <a href="/legal/privacy">Privacy</a>
          <a href="/legal/terms">Terms</a>
          <a href="https://note.com/sunlovesflow" target="_blank" rel="noopener noreferrer">note</a>
        </nav>
        <div class="public-copy">© 2026 Masahiro Yamada / MASA</div>
      </div>
    </footer>
  </body>
</html>
