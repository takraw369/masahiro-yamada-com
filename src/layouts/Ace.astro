---
import '../styles/ace.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'ACE Method — 身体感覚から無意識を書き換える' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap');
    </style>
  </head>
  <body class="ace-body">
    <nav class="ace-nav">
      <a href="/" class="back-home">← MASA</a>
      <div class="ace-mark">ACE METHOD</div>
      <a href="/ace/coaching" class="nav-cta">Enter →</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="ace-footer">
      <div class="brand-mark">sun <em>loves</em> flow</div>
      <small>ACE Method by Masahiro Yamada</small>
    </footer>
  </body>
</html>
