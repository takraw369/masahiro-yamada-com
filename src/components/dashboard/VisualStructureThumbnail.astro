<style>
  .visual-thumb{width:100%;height:78px;display:grid;place-items:center;overflow:hidden;color:var(--gold-muted);opacity:.26;transition:opacity .2s ease,transform .2s ease}
  .visual-thumb svg{width:100%;height:100%;overflow:visible}
  .visual-thumb :global(svg > *:not(.line)){fill:currentColor;stroke:none}
  .visual-thumb :global(.line){fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .visual-thumb :global(.bold){stroke-width:3}
  :global(.template-card:hover) .visual-thumb,:global(.template-card.is-active) .visual-thumb{opacity:.68;transform:translateY(-1px)}
  @media(max-width:480px){.visual-thumb{height:66px}}
  @media(prefers-reduced-motion:reduce){.visual-thumb{transition:none}}
</style>
