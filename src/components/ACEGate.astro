---
interface Props {
  gateId?: string;
  destination?: string;
  label?: string;
  kicker?: string;
  hint?: string;
  phaseHint?: string;
  goalHint?: string;
}

const {
  gateId = 'default',
  destination = 'inline',
  label = 'ACE GATE',
  kicker = 'ACE METHOD',
  hint = '鍵を差し込む',
  phaseHint = '',
  goalHint = '',
} = Astro.props;
---

<section
  class="ace-gate"
  data-ace-gate
  data-gate-id={gateId}
  data-destination={destination}
  data-phase-hint={phaseHint}
  data-goal-hint={goalHint}
  aria-label={`${label}への入口`}
>
  <div class="ace-gate__cosmos" aria-hidden="true"></div>
  <div class="ace-gate__stars ace-gate__stars--a" aria-hidden="true"></div>
  <div class="ace-gate__stars ace-gate__stars--b" aria-hidden="true"></div>

  <div class="ace-gate__copy">
    <span class="ace-gate__kicker">{kicker}</span>
    <span class="ace-gate__label">{label}</span>
  </div>

  <div class="ace-gate__stage">
    <div class="ace-gate__lamp" aria-hidden="true">
      <span class="ace-gate__lamp-wire"></span>
      <span class="ace-gate__lamp-cap"></span>
      <span class="ace-gate__lamp-glow"></span>
    </div>

    <div class="ace-gate__doorway" aria-hidden="true">
      <div class="ace-gate__future-light"></div>
      <div class="ace-gate__frame">
        <div class="ace-gate__door">
          <span class="ace-gate__panel ace-gate__panel--top"></span>
          <span class="ace-gate__panel ace-gate__panel--bottom"></span>
          <span class="ace-gate__lock"></span>
          <span class="ace-gate__handle"></span>
        </div>
      </div>
      <div class="ace-gate__floor-light"></div>
    </div>

    <div class="ace-gate__mat" aria-hidden="true">
      <span>welcome</span>
    </div>

    <button class="ace-gate__key-button" type="button" aria-label={`${label}の扉を開く`}>
      <span class="ace-gate__key">
        <svg viewBox="0 0 170 72" role="img" aria-hidden="true">
          <defs>
            <linearGradient id={`key-gold-${gateId}`} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#fff2b9" />
              <stop offset="30%" stop-color="#d9b860" />
              <stop offset="70%" stop-color="#8f6a22" />
              <stop offset="100%" stop-color="#f2d781" />
            </linearGradient>
          </defs>
          <circle cx="31" cy="36" r="20" fill="none" stroke={`url(#key-gold-${gateId})`} stroke-width="9" />
          <circle cx="31" cy="36" r="7" fill="none" stroke={`url(#key-gold-${gateId})`} stroke-width="4" />
          <path d="M51 36 H133 L145 25 H159 V38 H150 V50 H137 V42 H120 V52 H107 V42 H51 Z"
            fill={`url(#key-gold-${gateId})`} />
          <path d="M66 31 H126" stroke="#fff5c8" stroke-width="2.5" stroke-linecap="round" opacity=".7" />
        </svg>
      </span>
      <span class="ace-gate__hint">{hint}</span>
    </button>
  </div>

  <div class="ace-gate__whiteout" aria-hidden="true"></div>
</section>

<style>
  .ace-gate {
    --navy-0: #030914;
    --navy-1: #071323;
    --navy-2: #0c1c34;
    --gold: #d8b65f;
    --gold-light: #f5dda0;
    --future: #fff6d8;
    position: fixed;
    inset: 0;
    z-index: 9999;
    min-height: 100svh;
    overflow: hidden;
    color: #f5ead9;
    background:
      radial-gradient(circle at 50% 54%, rgba(39, 73, 124, .24) 0, rgba(7, 19, 35, .07) 31%, transparent 52%),
      radial-gradient(circle at 50% -10%, rgba(48, 76, 124, .32), transparent 44%),
      linear-gradient(180deg, var(--navy-2) 0%, var(--navy-1) 47%, var(--navy-0) 100%);
    isolation: isolate;
    transition: opacity .35s ease, visibility .35s ease;
  }

  .ace-gate.is-finished {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .ace-gate__cosmos,
  .ace-gate__stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ace-gate__cosmos {
    background:
      radial-gradient(circle at 18% 27%, rgba(78, 119, 184, .12), transparent 18%),
      radial-gradient(circle at 78% 35%, rgba(92, 67, 152, .10), transparent 22%),
      radial-gradient(circle at 52% 80%, rgba(15, 45, 86, .22), transparent 35%);
    filter: blur(1px);
  }

  .ace-gate__stars {
    opacity: .65;
    background-image:
      radial-gradient(circle, rgba(255,255,255,.78) 0 1px, transparent 1.3px),
      radial-gradient(circle, rgba(185,211,255,.48) 0 1px, transparent 1.4px);
    background-size: 84px 84px, 137px 137px;
    background-position: 16px 12px, 64px 47px;
    mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.75) 52%, transparent 92%);
  }

  .ace-gate__stars--b {
    opacity: .24;
    transform: scale(1.2);
    background-size: 173px 173px, 229px 229px;
    animation: aceStars 18s ease-in-out infinite alternate;
  }

  .ace-gate__copy {
    position: absolute;
    top: max(26px, env(safe-area-inset-top));
    left: 50%;
    z-index: 4;
    display: grid;
    gap: 7px;
    transform: translateX(-50%);
    text-align: center;
    white-space: nowrap;
  }

  .ace-gate__kicker {
    color: rgba(232, 204, 142, .7);
    font-family: 'Cormorant Garamond', serif;
    font-size: 10px;
    letter-spacing: .58em;
  }

  .ace-gate__label {
    color: rgba(245, 234, 217, .58);
    font-family: 'Cormorant Garamond', serif;
    font-size: 12px;
    letter-spacing: .28em;
  }

  .ace-gate__stage {
    position: absolute;
    inset: 50% auto auto 50%;
    width: min(86vw, 430px);
    height: min(76svh, 650px);
    transform: translate(-50%, -48%);
    transform-origin: 50% 56%;
    transition: transform 1.05s cubic-bezier(.18,.73,.19,1);
    perspective: 1200px;
  }

  .ace-gate.is-opening .ace-gate__stage {
    transform: translate(-50%, -48%) scale(1.11);
  }

  .ace-gate.is-whiteout .ace-gate__stage {
    transform: translate(-50%, -48%) scale(1.44);
  }

  .ace-gate__lamp {
    position: absolute;
    top: 3%;
    left: 50%;
    z-index: 6;
    width: 116px;
    height: 92px;
    transform: translateX(-50%);
  }

  .ace-gate__lamp-wire {
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 30px;
    transform: translateX(-50%);
    background: linear-gradient(#3c352e, #96815d);
  }

  .ace-gate__lamp-cap {
    position: absolute;
    top: 27px;
    left: 50%;
    width: 58px;
    height: 24px;
    transform: translateX(-50%);
    border: 1px solid rgba(228, 191, 112, .7);
    border-radius: 45% 45% 18% 18%;
    background: linear-gradient(180deg, #554325, #201a13);
    box-shadow: 0 3px 13px rgba(0,0,0,.5);
  }

  .ace-gate__lamp-cap::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -7px;
    width: 34px;
    height: 9px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #ffd98a;
    box-shadow: 0 0 14px #ffd98a, 0 0 35px rgba(255, 205, 115, .52);
  }

  .ace-gate__lamp-glow {
    position: absolute;
    top: 43px;
    left: 50%;
    width: 230px;
    height: 260px;
    transform: translateX(-50%);
    clip-path: polygon(39% 0, 61% 0, 92% 100%, 8% 100%);
    background: linear-gradient(180deg, rgba(255, 221, 151, .26), rgba(255, 211, 126, .07) 72%, transparent);
    filter: blur(7px);
    opacity: .86;
  }

  .ace-gate__doorway {
    position: absolute;
    left: 50%;
    bottom: 17%;
    width: min(60vw, 258px);
    height: min(51svh, 430px);
    transform: translateX(-50%);
    transform-style: preserve-3d;
  }

  .ace-gate__future-light {
    position: absolute;
    inset: 10px 10px 7px;
    border-radius: 3px;
    background:
      radial-gradient(ellipse at 55% 48%, #ffffff 0%, #fff8dc 32%, #f4d996 60%, rgba(198, 159, 77, .22) 100%);
    box-shadow:
      0 0 24px rgba(255, 236, 174, .56),
      0 0 68px rgba(255, 220, 132, .25);
    filter: brightness(1.05);
    transition: filter .9s cubic-bezier(.16,.78,.18,1), transform .9s cubic-bezier(.16,.78,.18,1);
  }

  .ace-gate__frame {
    position: absolute;
    inset: 0;
    padding: 11px 11px 8px;
    border: 1px solid rgba(218, 188, 126, .27);
    border-radius: 5px 5px 2px 2px;
    background:
      linear-gradient(90deg, #151820, #3a3026 4%, #1b1c23 9%, #10141c 92%, #4a3926 97%, #16151a);
    box-shadow:
      0 28px 54px rgba(0,0,0,.52),
      0 0 0 7px rgba(5,8,13,.65),
      0 0 0 8px rgba(190,153,82,.14);
  }

  .ace-gate__door {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    transform-origin: 0 50%;
    transform: perspective(900px) rotateY(-5deg);
    border: 1px solid rgba(230, 206, 159, .17);
    border-radius: 2px;
    background:
      linear-gradient(90deg, rgba(255,255,255,.035), transparent 12%, rgba(0,0,0,.16) 88%),
      linear-gradient(180deg, #25334a 0%, #18263a 48%, #121d2c 100%);
    box-shadow:
      inset -14px 0 23px rgba(0,0,0,.38),
      inset 2px 0 0 rgba(232, 207, 157, .08),
      16px 0 18px rgba(255, 227, 157, .09);
    transition: transform 1.1s cubic-bezier(.17,.8,.19,1), filter .75s ease;
  }

  .ace-gate__door::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 48% 28%, rgba(100, 136, 188, .12), transparent 34%);
  }

  .ace-gate__panel {
    position: absolute;
    left: 12%;
    width: 76%;
    border: 1px solid rgba(220, 194, 146, .12);
    box-shadow: inset 0 0 0 5px rgba(0,0,0,.08);
  }

  .ace-gate__panel--top {
    top: 13%;
    height: 28%;
  }

  .ace-gate__panel--bottom {
    bottom: 10%;
    height: 38%;
  }

  .ace-gate__handle {
    position: absolute;
    top: 53%;
    right: 13%;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff0b6, #c49a3f 40%, #5e4519 82%);
    box-shadow: 0 0 9px rgba(218, 177, 85, .32);
  }

  .ace-gate__lock {
    position: absolute;
    top: calc(53% + 18px);
    right: calc(13% + 1px);
    width: 8px;
    height: 13px;
    border-radius: 50% 50% 3px 3px;
    background: linear-gradient(180deg, #d8b75f, #785719);
    box-shadow: 0 0 6px rgba(226, 188, 87, .22);
  }

  .ace-gate__floor-light {
    position: absolute;
    left: 50%;
    bottom: -9%;
    width: 86%;
    height: 12%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(255, 237, 184, .38), rgba(255, 220, 128, .08) 58%, transparent 73%);
    filter: blur(4px);
    opacity: .7;
    transition: opacity .7s ease, transform .9s cubic-bezier(.16,.78,.18,1);
  }

  .ace-gate__mat {
    position: absolute;
    left: 50%;
    bottom: 9.4%;
    z-index: 4;
    display: grid;
    place-items: center;
    width: min(55vw, 240px);
    height: 42px;
    transform: translateX(-50%) perspective(240px) rotateX(59deg);
    border: 1px solid rgba(205, 178, 122, .15);
    background: linear-gradient(180deg, #15191d, #0d1115);
    box-shadow: 0 18px 18px rgba(0,0,0,.42);
  }

  .ace-gate__mat span {
    color: rgba(218, 196, 152, .34);
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    font-style: italic;
    letter-spacing: .21em;
  }

  .ace-gate__key-button {
    position: absolute;
    left: 50%;
    bottom: -1%;
    z-index: 20;
    display: grid;
    justify-items: center;
    gap: 4px;
    width: 180px;
    transform: translateX(-50%);
    border: 0;
    outline: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .ace-gate__key-button:focus-visible {
    outline: 1px solid rgba(247, 218, 147, .72);
    outline-offset: 8px;
    border-radius: 12px;
  }

  .ace-gate__key {
    display: block;
    width: 138px;
    filter: drop-shadow(0 4px 7px rgba(0,0,0,.52)) drop-shadow(0 0 8px rgba(216, 182, 95, .16));
    transform-origin: 50% 50%;
    transition: filter .25s ease;
    animation: aceKeyFloat 2.9s ease-in-out infinite;
  }

  .ace-gate__key-button:hover .ace-gate__key,
  .ace-gate__key-button:focus-visible .ace-gate__key {
    filter: drop-shadow(0 5px 8px rgba(0,0,0,.48)) drop-shadow(0 0 14px rgba(243, 214, 137, .42));
  }

  .ace-gate__hint {
    color: rgba(242, 225, 193, .64);
    font-size: 10px;
    letter-spacing: .24em;
  }

  .ace-gate__whiteout {
    position: absolute;
    inset: -20%;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transform: scale(.5);
    background:
      radial-gradient(circle at 50% 54%, #ffffff 0%, #fffdf5 25%, #fff0c5 43%, rgba(200, 220, 255, .7) 62%, rgba(231, 198, 125, .24) 75%, transparent 83%);
    filter: blur(2px);
    transition:
      opacity .54s cubic-bezier(.08,.72,.18,1),
      transform .78s cubic-bezier(.08,.78,.18,1),
      filter .64s ease;
  }

  .ace-gate.is-unlocking .ace-gate__key {
    animation: aceInsertKey .64s cubic-bezier(.2,.72,.22,1) forwards;
  }

  .ace-gate.is-unlocking .ace-gate__hint {
    opacity: 0;
    transition: opacity .18s ease;
  }

  .ace-gate.is-opening .ace-gate__door {
    transform: perspective(900px) rotateY(-72deg);
    filter: brightness(1.12);
  }

  .ace-gate.is-opening .ace-gate__future-light {
    filter: brightness(2.15);
    transform: scale(1.06);
  }

  .ace-gate.is-opening .ace-gate__floor-light {
    opacity: 1;
    transform: translateX(-50%) scale(1.7);
  }

  .ace-gate.is-whiteout .ace-gate__whiteout {
    opacity: 1;
    transform: scale(2.1);
    filter: blur(0);
  }

  @keyframes aceKeyFloat {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-5px) rotate(2deg); }
  }

  @keyframes aceInsertKey {
    0% { transform: translate(0, 0) scale(1) rotate(0deg); opacity: 1; }
    48% { transform: translate(72px, -245px) scale(.62) rotate(-12deg); opacity: 1; }
    72% { transform: translate(72px, -245px) scale(.62) rotate(82deg); opacity: 1; }
    100% { transform: translate(72px, -245px) scale(.62) rotate(88deg); opacity: 0; }
  }

  @keyframes aceStars {
    from { transform: scale(1.15) translate3d(-.5%, -.5%, 0); }
    to { transform: scale(1.23) translate3d(.7%, .6%, 0); }
  }

  @media (max-height: 720px) {
    .ace-gate__stage {
      height: 610px;
      transform: translate(-50%, -46%) scale(.88);
    }
    .ace-gate.is-opening .ace-gate__stage {
      transform: translate(-50%, -46%) scale(.98);
    }
    .ace-gate.is-whiteout .ace-gate__stage {
      transform: translate(-50%, -46%) scale(1.24);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ace-gate *,
    .ace-gate *::before,
    .ace-gate *::after {
      animation-duration: .001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .12s !important;
    }
  }
</style>

<script>
  const gates = document.querySelectorAll<HTMLElement>('[data-ace-gate]');

  gates.forEach((gate) => {
    if (gate.dataset.bound === '1') return;
    gate.dataset.bound = '1';

    const button = gate.querySelector<HTMLButtonElement>('.ace-gate__key-button');
    const gateId = gate.dataset.gateId || 'default';
    const destination = gate.dataset.destination || 'inline';
    const params = new URLSearchParams(window.location.search);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let opening = false;

    const context = {
      sessionId: (() => {
        try {
          const key = 'ace_gate_session_id';
          let id = localStorage.getItem(key);
          if (!id) {
            id = crypto.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`;
            localStorage.setItem(key, id);
          }
          return id;
        } catch {
          return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        }
      })(),
      gateId,
      path: window.location.pathname,
      source: params.get('utm_source') || (document.referrer ? 'referral' : 'direct'),
      medium: params.get('utm_medium') || '',
      campaign: params.get('utm_campaign') || '',
      phaseHint: gate.dataset.phaseHint || params.get('phase') || '',
      goalHint: gate.dataset.goalHint || params.get('goal') || '',
    };

    const track = (eventName: string) => {
      fetch('/api/funnel/event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event: eventName, ...context }),
        keepalive: true,
      }).catch(() => {});
    };

    const dispatch = (name: string) => {
      window.dispatchEvent(new CustomEvent(name, { detail: { ...context, destination } }));
    };

    const finish = () => {
      gate.classList.add('is-finished');
      document.documentElement.style.overflow = '';
      track('ace_gate_transition');
      dispatch('ace:gate-opened');

      if (destination && destination !== 'inline') {
        window.setTimeout(() => {
          window.location.href = destination;
        }, 70);
      }
    };

    const openGate = () => {
      if (opening) return;
      opening = true;
      button?.setAttribute('disabled', 'true');
      track('ace_gate_key_touch');
      dispatch('ace:gate-key-touch');

      gate.classList.add('is-unlocking');
      window.setTimeout(() => {
        gate.classList.add('is-opening');
        track('ace_gate_unlock');
        dispatch('ace:gate-unlock');
      }, reducedMotion ? 30 : 310);

      window.setTimeout(() => {
        gate.classList.add('is-whiteout');
      }, reducedMotion ? 70 : 810);

      window.setTimeout(finish, reducedMotion ? 180 : 1420);
    };

    document.documentElement.style.overflow = 'hidden';
    track('ace_gate_view');
    dispatch('ace:gate-view');

    if (params.get('skip_gate') === '1') {
      gate.classList.add('is-whiteout');
      window.setTimeout(finish, reducedMotion ? 20 : 90);
      return;
    }

    button?.addEventListener('click', openGate);
  });
</script>
